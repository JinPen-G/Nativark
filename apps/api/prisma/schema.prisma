generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 官网演示预约是平台级线索，不挂租户/经营空间，不自动建立客户或会员。
model DemoRequest {
  id           String   @id @db.VarChar(36)
  requestKey   String   @unique @db.VarChar(36)
  payloadHash  String   @db.VarChar(64)
  name         String   @db.VarChar(80)
  contactType  String   @db.VarChar(16)
  contactValue String   @db.VarChar(160)
  company      String   @default("") @db.VarChar(120)
  message      String   @db.Text
  language     String   @db.VarChar(8)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@index([createdAt, id])
  @@map("platform_demo_requests")
}

enum TenantStatus {
  ACTIVE   @map("active")
  FROZEN   @map("frozen")
  DISABLED @map("disabled")
}

/// SPACE-01：经营空间状态。冻结与停用的语义与租户一致——
/// 冻结可恢复，停用是终态；两者都必须让成员进入被拒绝（SPACE-02 校验）。
enum WorkspaceStatus {
  ACTIVE   @map("active")
  FROZEN   @map("frozen")
  DISABLED @map("disabled")
}

enum OrganizationType {
  OPERATOR @map("operator")
  CAR_SHOP @map("car_shop")
  STORE    @map("store")
  STATION  @map("station")
}

enum RoleScope {
  OPERATOR @map("operator")
  CAR_SHOP @map("car_shop")
  STORE    @map("store")
  STATION  @map("station")
}

enum SystemDataScope {
  ALL          @map("all")
  ORGANIZATION @map("organization")
  STORE        @map("store")
  OWN          @map("own")
}

enum PermissionKind {
  MENU   @map("menu")
  ACTION @map("action")
  BUTTON @map("button")
}

enum ConfigStatus {
  DRAFT     @map("draft")
  EFFECTIVE @map("effective")
  ARCHIVED  @map("archived")
}

enum RentalCategoryCode {
  VEHICLE      @map("vehicle")
  CAMERA       @map("camera")
  CAMPING      @map("camping")
  CONSTRUCTION @map("construction")
}

enum RentalInventoryMode {
  SERIALIZED @map("serialized")
  QUANTITY   @map("quantity")
  CONSUMABLE @map("consumable")
  BUNDLE     @map("bundle")
}

enum RentalAssetState {
  AVAILABLE   @map("available")
  RESERVED    @map("reserved")
  RENTED      @map("rented")
  INSPECTION  @map("inspection")
  MAINTENANCE @map("maintenance")
  DISABLED    @map("disabled")
}

enum RentalOrderV1Status {
  DRAFT             @map("draft")
  RESERVED          @map("reserved")
  PICKUP_OVERDUE    @map("pickup_overdue")
  READY_FOR_PICKUP  @map("ready_for_pickup")
  RENTING           @map("renting")
  RETURN_INSPECTION @map("return_inspection")
  /// 归还后、结清前的待结算态。
  ///
  /// 共享契约里一直有 `RentalCoreOrderStatus.Settling`，这里却缺了对应成员：
  /// `finishReturn` 把订单推进到 settling，事实仓储再 `toUpperCase()` 交给 Prisma，
  /// 成员不存在于是写库直接失败——内存实现不校验枚举，所以专项测试全绿、真库归还挂。
  /// 位置放在归还检查之后、完成之前，与业务流程和共享契约的顺序一致。
  SETTLING          @map("settling")
  COMPLETED         @map("completed")
  CANCELLED         @map("cancelled")
  NO_SHOW           @map("no_show")
}

enum RentalReservationState {
  SOFT      @map("soft")
  CONFIRMED @map("confirmed")
  FULFILLED @map("fulfilled")
  RELEASED  @map("released")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")
}

