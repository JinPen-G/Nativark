  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  appearancePreference UserAppearancePreference?

  @@unique([tenantId, account])
  /// 供成员关系的复合外键引用：成员必须指向**同租户**的账号，
  /// 从库层杜绝「把别的租户的用户加进本空间」。
  @@unique([tenantId, id], map: "users_tenant_id_key")
  @@index([tenantId, organizationId])
}

/// 账户级外观偏好（跟随登录账户，与租户品牌色相互独立）：目前仅存管理后台主题色。
/// 一账户一条（userId 唯一），随账号删除级联清理；未设置时管理后台主色回退平台默认色。
model UserAppearancePreference {
  id         String   @id @default(uuid())
  userId     String   @unique(map: "user_appearance_preferences_user_key")
  /// 该账户的管理后台主题色（#RRGGBB）；未设置时回退平台默认色。与租户品牌色无关。
  themeColor String?  @db.VarChar(16)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_appearance_preferences")
}

model AuthSession {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash   String             @unique
  /// SPACE-02：会话的当前经营空间。**服务端唯一权威**——客户端提交的
  /// workspaceId 一律忽略，切换必须走 switch 接口重新校验成员资格。
  ///
  /// 可空：平台管理租户没有经营空间，其会话合法地没有当前空间。
  /// 跨租户防护不依赖这里的外键，而依赖 workspace_members 的复合外键：
  /// 「该账号在该空间有成员关系」已蕴含两者同租户。
  currentWorkspaceId String?
  /// AUTH-AUDIENCE-01：运营后台与员工小程序会话不可互换。
  audience           String             @default("operator") @db.VarChar(16)
  currentWorkspace   BusinessWorkspace? @relation(fields: [currentWorkspaceId], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@index([userId, expiresAt, revokedAt])
  @@index([currentWorkspaceId], map: "auth_sessions_workspace_idx")
  @@map("auth_sessions")
}

/// AUTH-LOCKOUT-01：跨进程共享的运营账号失败登录计数。只存带服务端密钥的登录标识摘要，
/// 不落租户编码、账号、手机号等原文；expiresAt 供惰性清理过期记录。
model AuthLoginFailure {
  id           String   @id @default(uuid())
  loginKeyHash String   @unique(map: "auth_login_failures_login_key_hash_key") @db.Char(64)
  failureCount Int      @default(0)
  firstFailedAt DateTime @db.DateTime(3)
  lockedUntil  DateTime? @db.DateTime(3)
  expiresAt    DateTime @db.DateTime(3)
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt], map: "auth_login_failures_expires_idx")
  @@map("auth_login_failures")
}

model Role {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  code                  String
  name                  String
  description           String?
  scope                 RoleScope
  fixedAllPermissions   Boolean           @default(false)
  enabledBusinessScopes Json
  buttonPermissions     Json?
  dataScope             SystemDataScope   @default(STORE)
  isActive              Boolean           @default(true)
  users                 User[]
  userAssignments       UserRole[]
  workspaceMembers      WorkspaceMember[]
  permissions           RolePermission[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  /// 供 WorkspaceMember 的复合外键引用，阻止跨租户角色授权。
  @@unique([tenantId, id], map: "roles_tenant_id_key")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  module      String
  kind        PermissionKind   @default(ACTION)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

/// SPACE-04：租户级共享客户主档。
///
/// 边界（需求 v1.2 第 41、180 行）：客户**身份**在 SaaS 租户内共享——基础联系方式、
/// 企业资料、基础实名认证只存一份，同一客户不必在第二个经营空间重复注册。
/// 而订单、优惠券、积分、会员等级和营销余额**按经营空间隔离**，因此那些表带
/// workspaceId 并各自建行，只通过 (tenantId, id) 指回本表。
///
/// 品类资质存在本表（共享资料），但「是否适用」要按目标空间的品类规则判断：
/// 驾驶证对 vehicle 空间有意义，对 camera 空间无意义。故本表只存事实，不存结论。
///
/// 与 Member 的关系：Member 是旧车辆域的会员表，仍在使用且已是租户级。
/// 本表不删不改 Member（迁移硬规则 5、7：不得删除或替换现有数据），
/// 而是新增租户级主档并把旧 Member 回填进来，由 sourceMemberId 保留对应关系。
model CustomerProfile {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerType         String
  name                 String
  phone                String
  phoneMasked          String
  email                String?
  /// 基础实名认证：租户内共享，不按空间重复认证。
  identityVerified     Boolean  @default(false)
  identityNoMasked     String?
  /// 基础画像主数据（全部选填）：性别、生日、来源渠道与常驻城市。
  /// 只用于运营检索与展示，不参与任何业务判定；未录入即为空，无需回填。
  gender               String?   @db.VarChar(16)
  birthday             DateTime? @db.Date
  sourceChannel        String?   @db.VarChar(32)
  region               String?   @db.VarChar(64)
  /// 后台账号创建该共享主档时的审计归属；客户端自助注册与历史数据为空。
  createdByUserId      String?  @db.VarChar(191)
  createdInWorkspaceId String?  @db.VarChar(191)
  /// 品类资质原始事实（如驾驶证、操作资格证），适用性由目标空间品类规则判断。
  qualifications       Json
  corporateName        String?
  corporateTaxNo       String?
  status               String   @default("active")
  /// 回填来源：旧车辆域 Member 的主键。用于对账与幂等回填，不参与业务判定。
  sourceMemberId       String?
  /// CUSTOMER-01A：本主档已被合并进哪个主档。非空即终态，不得再产生新业务。
  /// 权威事实在 customer_merge_mappings，这里冗余一份供高频判定，避免漏查映射表。
  mergedIntoCustomerId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  membership                     CustomerMembership?
  account                        CustomerAccount?
  corporateProfile               CustomerCorporateProfile?
  contacts                       CustomerContact[]
  authorizedAgents               CustomerAuthorizedAgent[]
  statusHistory                  CustomerStatusHistoryEntry[]
  riskRecords                    CustomerRiskRecord[]
  qualificationRefs              CustomerQualificationRef[]
  qualificationRevisions         CustomerQualificationRevision[]
  mergeAsSource                  CustomerMergeMapping[]             @relation("CustomerMergeSource")
  mergeAsTarget                  CustomerMergeMapping[]             @relation("CustomerMergeTarget")
  sensitiveAccess                CustomerSensitiveAccessAudit[]
  invoiceProfiles                CustomerCorporateInvoiceProfile[]
  contracts                      CustomerCorporateContract[]
  credit                         CustomerCorporateCredit?
  creditLedgerEntries            CustomerCorporateCreditLedger[]
  membershipReviews              CustomerMembershipReview[]
  clientAuthSessions             ClientAuthSession[]
  wechatIdentities               ClientWechatIdentity[]
  deliveryAddresses              CustomerDeliveryAddress[]
  deliverySnapshots              ClientOrderDeliverySnapshot[]
  corporateMembershipsAsCompany  CustomerCorporateMembership[]      @relation("CorporateMembershipCompany")
  corporateMembershipsAsPersonal CustomerCorporateMembership[]      @relation("CorporateMembershipPersonal")
  membershipPlanAssignments      CustomerMembershipPlanAssignment[]
  identityVerifications          CustomerIdentityVerification[]

  /// 供复合外键引用：让「权益/关系必须与客户同租户」可以在库层表达。
  /// 与 BusinessWorkspace 的 (tenantId, id) 同一手法。
  @@unique([tenantId, id], map: "customer_profiles_tenant_id_key")
  /// 同租户内手机号唯一 = 「同一客户不必重复注册」的库层保证。
  /// 不含 workspaceId：加了就等于允许同一手机号在两个空间各建一份主档，
  /// 与需求「租户内共享唯一客户主档」直接冲突。
  @@unique([tenantId, phone], map: "customer_profiles_tenant_phone_key")
  @@unique([tenantId, sourceMemberId], map: "customer_profiles_tenant_source_member_key")
  @@index([tenantId, status], map: "customer_profiles_tenant_status_idx")
  @@index([tenantId, createdInWorkspaceId, createdByUserId], map: "customer_profiles_creator_scope_idx")
  @@map("customer_profiles")
}

/// F17：实名结论的只追加审核记录。证件原文不入库；凭证影像通过文件服务保存并按客户权限下载。
model CustomerIdentityVerification {
  id                   String          @id @default(uuid())
  tenantId             String          @db.VarChar(191)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId           String          @db.VarChar(191)
  customer             CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  credentialType       String          @db.VarChar(32)
  result               String          @db.VarChar(16)
  evidenceFileAssetIds Json
  reason               String          @db.VarChar(500)
  reviewerUserId       String          @db.VarChar(191)
  reviewerName         String          @db.VarChar(120)
  reviewedAt           DateTime        @db.DateTime(3)
  verifiedAt           DateTime?       @db.DateTime(3)
  createdAt            DateTime        @default(now()) @db.DateTime(3)

  @@index([tenantId, customerId, reviewedAt], map: "customer_identity_verifications_customer_time_idx")
  @@map("customer_identity_verifications")
}

/// 租户统一会员关系：一个客户在租户内只有一份会员状态和等级。
/// 会员资格不按经营空间重复注册；权益适用性由每条权益的 tenant/workspaces/categories scope 决定。
model CustomerMembership {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// 租户级会员等级。
  levelName    String          @default("普通会员")
  /// pending_activation / active / suspended / risk_restricted / exited / closed。
  status       String          @default("active")
  firstOrderAt DateTime?
  /// 各限制态与终态的发生时间。解除限制不清空原时间戳，完整过程另追加状态历史。
  suspendedAt  DateTime?
  restrictedAt DateTime?
  exitedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tenantId, customerId], map: "customer_memberships_tenant_customer_key")
  @@index([tenantId, status], map: "customer_memberships_tenant_status_idx")
  @@map("customer_memberships")
}

/// CUSTOMER-01A：客户账号（需求 4.8.1）。
///
/// 与客户主档 1:1，但**必须是独立实体**：主档回答「客户是谁」，账号回答「客户如何登录」。
/// 停用账号阻止登录全部经营空间，且不删除主档与历史业务事实；
/// 而暂停租户会员关系只限制业务资格，不改写登录账号状态。
/// 两者共用一个状态字段是本任务明确要避免的建模错误。
model CustomerAccount {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// 登录标识（当前为手机号）。租户内唯一——同一手机号不得对应两个可登录账号。
  loginPhone         String
  loginPhoneMasked   String
  /// active / suspended / closed
  status             String          @default("active")
  suspendedAt        DateTime?
  closedAt           DateTime?
  /// 最近一次状态变更的原因与操作人。完整历史在 customer_status_history。
  lastReason         String?         @db.Text
  lastOperator       String?
  /// 新会员体系仅存口令哈希；管理端永不读取或回显原密码。
  passwordHash       String?
  passwordUpdatedAt  DateTime?
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  /// 一个客户主档至多一个账号：主档是身份，账号是该身份的登录方式。
  @@unique([tenantId, customerId], map: "customer_accounts_tenant_customer_key")
  @@unique([tenantId, loginPhone], map: "customer_accounts_tenant_login_key")
  @@index([tenantId, status], map: "customer_accounts_tenant_status_idx")
  @@map("customer_accounts")
}

/// CLIENT-CHANNEL-01：租户级客户端渠道配置。小程序与 APP 共用同一份品牌/客服/协议/帮助/发布服务；
/// 渠道凭证（微信 AppID/密钥）另存 MiniProgramChannel。一租户一条。
model ClientChannelProfile {
  id                   String                   @id @default(uuid())
  tenantId             String                   @unique(map: "client_channel_profiles_tenant_key")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revision             Int                      @default(1)
  brandName            String?                  @db.VarChar(191)
  brandLogoUrl         String?                  @db.VarChar(512)
  faviconUrl           String?                  @db.VarChar(512)
  customerServicePhone String?                  @db.VarChar(32)
  customerServiceHours String?                  @db.VarChar(64)
  /// 协议：名称/版本/外链/正文。正文在客户端内直接渲染（简单富文本），不内置占位协议。
  userAgreementName    String?                  @db.VarChar(64)
  userAgreementVersion String?                  @db.VarChar(64)
  userAgreementUrl     String?                  @db.VarChar(512)
  userAgreementBody    String?                  @db.MediumText
  privacyPolicyName    String?                  @db.VarChar(64)
  privacyPolicyVersion String?                  @db.VarChar(64)
  privacyPolicyUrl     String?                  @db.VarChar(512)
  privacyPolicyBody    String?                  @db.MediumText
  /// 帮助与客服页：说明与常见问题（JSON 数组 {question, answer}）。
  helpIntro            String?                  @db.Text
  helpFaqJson          Json?
  bannerTitle          String?                  @db.VarChar(64)
  bannerSubtitle       String?                  @db.VarChar(120)
  /// 客户端主题色（#RRGGBB）；客户端覆盖 --primary 系列，未设置则用系统默认蓝。
  themeColor           String?                  @db.VarChar(16)
  /// 管理后台基础控件圆角（8-20px，或极致圆角离散档 999px，旧字段/回退基准）；胶囊页签、圆形图标按钮等保留形态不由此强行改变。
  adminCornerRadius    Int?                     @db.UnsignedSmallInt
  /// 容器（卡片/弹窗/抽屉/表格）圆角（8-20px 或 999px）；留空回退 adminCornerRadius。
  adminContainerRadius Int?                     @db.UnsignedSmallInt
  /// 按钮/分段/页签/选中菜单圆角（8-20px 或 999px）；留空回退 adminCornerRadius。
  adminButtonRadius    Int?                     @db.UnsignedSmallInt
  /// 输入/选择/日期等录入控件圆角（8-20px 或 999px）；留空回退 adminCornerRadius。
  adminInputRadius     Int?                     @db.UnsignedSmallInt
  smsLoginEnabled      Boolean                  @default(true)
  passwordLoginEnabled Boolean                  @default(true)
  defaultWorkspaceId   String?
  publishedWorkspaces  ClientChannelWorkspace[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@map("client_channel_profiles")
}

/// 发布到客户端（小程序/APP）的服务空间；未发布的空间不因 active 自动上架，游客目录不可读。
model ClientChannelWorkspace {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId   String
  profile     ClientChannelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   BusinessWorkspace    @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict)
  enabled     Boolean              @default(true)
  createdAt   DateTime             @default(now())

  @@unique([tenantId, workspaceId], map: "client_channel_workspace_key")
  @@index([tenantId, enabled], map: "client_channel_workspace_scope_idx")
  @@map("client_channel_workspaces")
}

/// 品牌与外观（管理后台 UI 身份）：从客户端渠道配置拆出的独立领域。存品牌名/Logo/Favicon、主题色与四个圆角分组。
/// 一租户一条（tenantId 唯一），保存带 revision 乐观锁；主题色作用于客户端+管理后台，圆角作用于管理后台。
model TenantAppearanceProfile {
  id                   String   @id @default(uuid())
  tenantId             String   @unique(map: "tenant_appearance_profiles_tenant_key")
  revision             Int      @default(1)
  brandName            String?  @db.VarChar(120)
  brandLogoUrl         String?  @db.VarChar(512)
  faviconUrl           String?  @db.VarChar(512)
  /// 客户端与管理后台主色（#RRGGBB）。
  themeColor           String?  @db.VarChar(16)
  /// 旧的统一圆角（回退基准，8-40px 或 999px）。
  adminCornerRadius    Int?     @db.UnsignedSmallInt
  adminContainerRadius Int?     @db.UnsignedSmallInt
  adminButtonRadius    Int?     @db.UnsignedSmallInt
  adminInputRadius     Int?     @db.UnsignedSmallInt
  adminLoginJson       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("tenant_appearance_profiles")
}

/// WEBSITE-CHANNEL-01：租户级「web 官网渠道」配置。只存官网特有设定项（标语、Hero、辅助色、页脚、
/// 联系地址、底部 CTA、SEO、Powered by 开关与官网启用开关）；商户名/Logo/协议/客服/帮助/发布服务
/// 继续复用通用的 ClientChannelProfile，不在此重复。一租户一条（tenantId 唯一），保存带 revision 乐观锁。
model WebsiteChannelProfile {
  id               String   @id @default(uuid())
  tenantId         String   @unique(map: "website_channel_profiles_tenant_key")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revision         Int      @default(1)
  /// 官网渠道是否对外启用；关闭时公开启动接口不返回官网配置。
  enabled          Boolean  @default(false)
  slogan           String?  @db.VarChar(120)
  heroTitle        String?  @db.VarChar(120)
  heroDescription  String?  @db.VarChar(400)
  heroImageUrl     String?  @db.VarChar(512)
  /// 辅助/强调色（#RRGGBB）；主色仍取通用配置的 themeColor。
  secondaryColor   String?  @db.VarChar(16)
  footerText       String?  @db.VarChar(600)
  contactAddress   String?  @db.VarChar(256)
  ctaTitle         String?  @db.VarChar(120)
  ctaDescription   String?  @db.VarChar(400)
  seoTitle         String?  @db.VarChar(120)
  seoDescription   String?  @db.VarChar(400)
  seoKeywords      String?  @db.VarChar(256)
  /// 是否在页脚展示 “Powered by Rental OS”。
  showPoweredBy    Boolean  @default(true)
  /// 租户自定义官网域名（如 www.brand.com，小写、不含协议/路径）。全局唯一，用于按 Host 反查租户。
  customDomain     String?  @unique(map: "website_channel_profiles_domain_key") @db.VarChar(191)
  /// 品类入口图：JSON 数组 [{ code, imageUrl }]，code 为经营空间/服务编码；缺省时官网回落到该品类首个商品图。
  categoryImagesJson Json?
  /// 官网「为什么选择我们」卖点：JSON 数组 [{ icon?, title, description }]；缺省用前端通用文案。
  advantagesJson   Json?
  /// 官网「租赁流程」步骤：JSON 数组 [{ title, description }]；缺省用前端通用文案。
  stepsJson        Json?
  /// 官网「用户评价 / 客户案例」：JSON 数组 [{ name, context, text }]；缺省时该区块隐藏。
  testimonialsJson Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("website_channel_profiles")
}

/// WEBSITE-CHANNEL-04：租户官网品牌图片（Logo/Hero/品类入口图）。租户后台直接上传，字节存库、
/// 由公开接口按 tenantCode+assetId 提供，写回各配置的图片 URL 字段。数量少、体积小，直接入库更简单可靠。
model WebsiteAsset {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 用途：logo / hero / category，仅用于区分与审计，不影响公开可读性。
  scene      String   @db.VarChar(32)
  mimeType   String   @db.VarChar(64)
  sizeBytes  Int
  data       Bytes    @db.LongBlob
  createdAt  DateTime @default(now())

  @@index([tenantId], map: "website_assets_tenant_idx")
  @@map("website_assets")
}

/// MP-R1：租户绑定的微信小程序渠道凭证。密钥只保存加密值；品牌/协议/发布服务在 ClientChannelProfile。
model MiniProgramChannel {
  id              String                         @id @default(uuid())
  tenantId        String
  tenant          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appId           String                         @db.VarChar(191)
  appSecretEncrypted String?                     @db.Text
  enabled         Boolean                        @default(false)
  revision        Int                            @default(1)
  lastTestStatus  String                         @default("not_tested") @db.VarChar(32)
  lastTestAt      DateTime?
  lastTestError   String?                        @db.VarChar(500)
  identities      ClientWechatIdentity[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@unique([tenantId, appId], map: "mini_program_channels_tenant_app_key")
  @@unique([appId], map: "mini_program_channels_app_id_key")
  @@index([tenantId, enabled], map: "mini_program_channels_tenant_enabled_idx")
  @@map("mini_program_channels")
}

model ClientWechatIdentity {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId   String
  channel     MiniProgramChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CustomerProfile  @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  openId      String           @db.VarChar(191)
  unionId     String?          @db.VarChar(191)
  appId       String           @db.VarChar(191)
  boundAt     DateTime         @default(now())
  lastUsedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sessions    ClientAuthSession[]

  @@unique([tenantId, id], map: "client_wechat_identities_tenant_id_key")
  @@unique([tenantId, channelId, openId], map: "client_wechat_identity_open_key")
  @@unique([tenantId, channelId, customerId], map: "client_wechat_identity_customer_key")
  @@index([tenantId, customerId], map: "client_wechat_identity_customer_idx")
  @@map("client_wechat_identities")
}

/// MP-06：客户在租户内共享的配送地址簿。它不是联系人表：收件人/电话/地区/详细地址是配送事实，
/// 删除为软删除，已提交订单只引用当时的快照（client_order_delivery_snapshots）。
model CustomerDeliveryAddress {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  recipient   String          @db.VarChar(120)
  phone       String          @db.VarChar(32)
  phoneMasked String          @db.VarChar(32)
  countryCode String          @default("CN") @db.VarChar(8)
  province    String          @db.VarChar(64)
  city        String          @db.VarChar(64)
  district    String?         @db.VarChar(64)
  detail      String          @db.VarChar(255)
  postalCode  String?         @db.VarChar(16)
  latitude    Decimal?        @db.Decimal(10, 7)
  longitude   Decimal?        @db.Decimal(10, 7)
  /// 每客户最多一个有效默认地址；变更幂等。
  isDefault   Boolean         @default(false)
  /// active / deleted
  status      String          @default("active") @db.VarChar(16)
  /// 并发编辑校验版本。
  revision    Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, customerId, status], map: "customer_delivery_addresses_owner_idx")
  @@map("customer_delivery_addresses")
}

/// MP-06：报价/订单的配送地址快照。报价时固化（按 quoteId 唯一），订单创建后回填 orderId；
/// 快照不可变，地址簿后续修改或删除不影响历史订单。
model ClientOrderDeliverySnapshot {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict)
  customerId  String
  customer    CustomerProfile   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  quoteId     String            @unique(map: "client_order_delivery_snapshots_quote_key")
  orderId     String?           @unique(map: "client_order_delivery_snapshots_order_key")
  addressId   String?
  /// 完整收件信息（含明文电话，供运营配送）；客户端视图另行脱敏。
  snapshot    Json
  createdAt   DateTime          @default(now())

  @@index([tenantId, customerId], map: "client_order_delivery_snapshots_customer_idx")
  @@map("client_order_delivery_snapshots")
}
/// CLIENT-01：客户端注册验证码挑战。原验证码只保存哈希；开发环境可返回一次性验证码，生产环境由短信/邮件 provider 接管。
model ClientRegistrationChallenge {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 注册来源空间仅供追溯；注册资格与验证码幂等性均属于租户。
  sourceWorkspaceId     String?
  sourceWorkspace       BusinessWorkspace? @relation(fields: [tenantId, sourceWorkspaceId], references: [tenantId, id], onDelete: Restrict)
  method                String            @db.VarChar(16)
  /// registration / login / account_closure：验证码证明只能用于创建时声明的用途。
  purpose               String            @default("registration") @db.VarChar(32)
  identifierHash        String            @db.Char(64)
  maskedDestination     String            @db.VarChar(64)
  codeHash              String            @db.Char(64)
  status                String            @default("pending_verification") @db.VarChar(32)
  deliveryMode          String            @default("development") @db.VarChar(24)
  requestKey            String?
  attempts              Int               @default(0)
  expiresAt             DateTime
  verifiedAt            DateTime?
  verificationTokenHash String?           @db.Char(64)
  consumedAt            DateTime?
  registrationId        String?
  registeredCustomerId  String?
  registrationResult    String?           @db.VarChar(32)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([tenantId, requestKey], map: "client_registration_challenges_tenant_request_key")
  @@index([tenantId, identifierHash, createdAt], map: "client_registration_challenges_lookup_idx")
  @@index([tenantId, sourceWorkspaceId], map: "client_registration_challenges_source_workspace_idx")
  @@index([expiresAt, status], map: "client_registration_challenges_expiry_idx")
  @@map("client_registration_challenges")
}

/// CLIENT-01：客户端账号会话。与后台 AuthSession 分开，客户端 token 不能互换。
model ClientAuthSession {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String
  customer         CustomerProfile   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  workspaceId      String
  workspace        BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  refreshTokenHash String            @unique @db.Char(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  wechatIdentityId String?
  wechatIdentity   ClientWechatIdentity? @relation(fields: [tenantId, wechatIdentityId], references: [tenantId, id], onDelete: NoAction)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId, customerId, revokedAt], map: "client_auth_sessions_customer_idx")
  @@index([tenantId, workspaceId, revokedAt], map: "client_auth_sessions_workspace_idx")
  @@map("client_auth_sessions")
}

/// CLIENT-01：客户端 API 的跨实例固定时间窗限流桶。
///
/// 只保存服务端生成的 scopeKey，不保存 IP、手机号、客户令牌或其他可逆识别信息。
/// 公开认证接口按来源地址限流，登录后的接口按客户端会话限流；计数通过数据库
/// 的唯一键和原子递增实现，多 API 实例不会各自维护一份可绕过的内存计数。
model ClientApiRateBucket {
  id          String   @id @default(uuid())
  scopeKey    String   @db.Char(64)
  bucketStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scopeKey, bucketStart], map: "client_api_rate_bucket_key")
  @@index([bucketStart], map: "client_api_rate_bucket_expiry_idx")
  @@map("client_api_rate_buckets")
}

/// CUSTOMER-01A：企业客户资料（需求 4.8.4）。
///
/// 与主档 1:1，只在 `customerType = corporate` 时存在。个人与企业共用统一客户框架，
/// 但资料结构分开——把企业字段平铺进主档会让个人客户带一堆恒空列，
/// 也无法表达「企业必须有统一社会信用代码」这类只对企业成立的约束。
/// 开票、合同、授信与账期属 CUSTOMER-01C，本阶段只建企业身份本体。
model CustomerCorporateProfile {
  id                            String          @id @default(uuid())
  tenantId                      String
  tenant                        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                    String
  customer                      CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  legalName                     String
  /// 统一社会信用代码。需求 4.8.3 要求企业重复识别以它为主要依据，故租户内唯一。
  unifiedSocialCreditCode       String
  unifiedSocialCreditCodeMasked String
  registeredAddress             String?
  legalRepName                  String?
  legalRepPhoneMasked           String?
  industry                      String?
  scale                         String?
  status                        String          @default("active")
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  @@unique([tenantId, customerId], map: "customer_corporate_profiles_tenant_customer_key")
  @@unique([tenantId, unifiedSocialCreditCode], map: "customer_corporate_profiles_tenant_uscc_key")
  @@map("customer_corporate_profiles")
}

/// CUSTOMER-01C：企业开票资料（需求 4.8.4）。
///
/// 与企业资料分表而不是平铺：一家企业可能有多份开票资料（不同分支机构、专票/普票），
/// 且开票资料会随税务变更而版本化，平铺进企业资料就只能存最后一份、覆盖掉历史。
/// `isDefault` 标记默认使用的一份，同企业至多一份默认。
model CustomerCorporateInvoiceProfile {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// vat_special（增值税专用发票）/ vat_normal（普通发票）
  invoiceType        String
  /// 开票名称。通常等于法定名称，但允许分支机构使用自己的名称。
  title              String
  taxNo              String
  registeredAddress  String?
  bankName           String?
  bankAccountMasked  String?
  contactPhoneMasked String?
  receiveEmail       String?
  /// 同企业至多一份默认开票资料，用 defaultMarker 做「部分唯一」的替代方案：
  /// 默认行写 'default'、非默认写自身 id（MySQL 没有部分索引）。
  isDefault          Boolean         @default(false)
  defaultMarker      String
  status             String          @default("active")
  revision           Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([tenantId, customerId, defaultMarker], map: "customer_invoice_profiles_default_key")
  @@index([tenantId, customerId], map: "customer_invoice_profiles_tenant_customer_idx")
  @@map("customer_corporate_invoice_profiles")
}

/// CUSTOMER-01C：企业合同（需求 4.8.4）。
///
/// 合同是独立事实：一家企业可以同时持有多份有效合同（不同项目、不同期限），
/// 订单引用的是「下单当时生效的那一份」，因此合同必须能各自留存起止与状态。
model CustomerCorporateContract {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String
  customer         CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  contractNo       String
  name             String
  signedAt         DateTime?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  /// draft / active / expired / terminated
  status           String          @default("draft")
  /// 合同文件引用。原件不入库。
  fileRef          String?
  terminatedReason String?         @db.Text
  revision         Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([tenantId, contractNo], map: "customer_contracts_tenant_no_key")
  @@index([tenantId, customerId, status], map: "customer_contracts_customer_status_idx")
  @@map("customer_corporate_contracts")
}

/// CUSTOMER-01C / CORP-SETTLE-01A：企业授信与账期主档。
///
/// 主档保存额度和审批事实；订单占用、结算转应收、回款与释放全部追加到
/// CustomerCorporateCreditLedger，不在这张当前配置表上原地改金额。
model CustomerCorporateCredit {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// 授信额度。Decimal 而不是浮点：金额一律不用 float。
  creditLimit        Decimal         @db.Decimal(12, 2)
  /// 账期天数（月结 30 / 45 …）。
  settlementTermDays Int             @default(0)
  /// monthly / semi_monthly / per_order
  billingCycle       String          @default("monthly")
  /// active / suspended / revoked
  status             String          @default("active")
  approvedBy         String?
  approvedAt         DateTime?
  reason             String?         @db.Text
  revision           Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  /// 一家企业一条当前授信记录；额度调整走更新 + 状态历史，不新建行。
  @@unique([tenantId, customerId], map: "customer_credits_tenant_customer_key")
  @@map("customer_corporate_credits")
}

/// CORP-SETTLE-01A：企业授信追加式账务流水。
///
/// `reservedDelta` 与 `receivableDelta` 是账面变动，`reservedAfter` 与
/// `receivableAfter` 是写入时的可回放快照。订单、空间均只存引用字符串：授信
/// 账户属于租户，企业跨空间下单时仍共用同一额度，不把一笔企业额度拆成空间账户。
model CustomerCorporateCreditLedger {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String
  customer         CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  workspaceId      String?
  orderId          String?
  /// reserve / release / settle / payment / adjust
  entryType        String          @db.VarChar(24)
  amount           Decimal         @db.Decimal(12, 2)
  reservedDelta    Decimal         @db.Decimal(12, 2)
  receivableDelta  Decimal         @db.Decimal(12, 2)
  reservedAfter    Decimal         @db.Decimal(12, 2)
  receivableAfter  Decimal         @db.Decimal(12, 2)
  currency         String          @default("CNY") @db.VarChar(8)
  idempotencyKey   String          @db.VarChar(191)
  reason           String          @db.VarChar(500)
  operator         String?
  occurredAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@unique([tenantId, customerId, idempotencyKey], map: "customer_credit_ledger_idem_key")
  @@index([tenantId, customerId, occurredAt], map: "customer_credit_ledger_account_time_idx")
  @@index([tenantId, customerId, orderId], map: "customer_credit_ledger_order_idx")
  @@index([tenantId, workspaceId, orderId], map: "customer_credit_ledger_scope_order_idx")
  @@map("customer_corporate_credit_ledger")
}

/// CUSTOMER-01A：客户联系人（需求 4.8.4）。
///
/// 个人客户的紧急联系人与企业客户的企业联系人共用本表：两者都是「除客户本人以外、
/// 可被联系到的人」，字段一致。`kind` 区分用途，`linkedCustomerId` 允许指向另一份主档
/// ——需求明确「企业联系人可以同时是个人客户」，但那不等于该联系人就是责任主体。
model CustomerContact {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String
  customer         CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// emergency（个人紧急联系人）/ corporate（企业联系人）/ other
  kind             String
  name             String
  phone            String
  phoneMasked      String
  email            String?
  relation         String?
  /// 该联系人本身若也是本租户客户，指向其主档；仅作关联，不代表责任主体。
  linkedCustomerId String?
  isPrimary        Boolean         @default(false)
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, customerId], map: "customer_contacts_tenant_customer_idx")
  @@index([tenantId, phone], map: "customer_contacts_tenant_phone_idx")
  @@map("customer_contacts")
}

/// CUSTOMER-01A：授权经办人（需求 4.8.4）。
///
/// 经办人是「被客户授权代为办理业务的人」，与联系人不同：联系人只用于联系，
/// 经办人可以在订单上作为经办主体出现（CUSTOMER-01C）。因此它需要授权范围与有效期
/// ——没有有效期的授权在事后无法判断当时是否有效。
model CustomerAuthorizedAgent {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 委托方客户（通常是企业客户）。
  customerId       String
  customer         CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  agentName        String
  agentPhone       String
  agentPhoneMasked String
  agentIdNoMasked  String?
  /// 授权范围。结构化保存（可下单/可签约/可付款/可取还），便于后续按动作校验。
  authorityScope   Json
  validFrom        DateTime
  validTo          DateTime?
  status           String          @default("active")
  /// 授权凭证引用（授权书文件等）。敏感原件不入本表。
  evidenceRef      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, customerId], map: "customer_agents_tenant_customer_idx")
  @@index([tenantId, agentPhone], map: "customer_agents_tenant_phone_idx")
  @@map("customer_authorized_agents")
}

/// CUSTOMER-01A：客户状态历史（需求 4.8.6 末段、4.8.14）。
///
/// 只追加，不更新、不删除。`scope` 区分账号级与空间级：同一张表承载两者是刻意的——
/// 需求要求「支持按客户和经营空间还原完整时间线」，拆成两张表就得在读取侧再合并排序，
/// 而合并排序最容易出的错正是把空间级事件误算进账号级时间线。
///
/// 解除限制（release）同样是一条记录，绝不回改或删除原限制记录。
model CustomerStatusHistoryEntry {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// account | membership；历史 workspace 事件保持原值，不回写。
  scope       String
  /// 旧空间级事件保留来源；新增租户会员或账号事件为空。
  workspaceId String?
  /// activate / suspend / restrict / release / exit / close / reopen / merge
  action      String
  fromStatus  String?
  toStatus    String
  reason      String          @db.Text
  operator    String?
  /// 审批人。人工合并与注销按需求需要审批留痕。
  approver    String?
  at          DateTime
  createdAt   DateTime        @default(now())

  @@index([tenantId, customerId, at], map: "customer_status_history_customer_at_idx")
  @@index([tenantId, workspaceId, at], map: "customer_status_history_ws_at_idx")
  @@map("customer_status_history")
}

/// CUSTOMER-01A：客户风险记录（需求 4.8.6 的「风险受限」与 4.8.14 的风险审核授权）。
///
/// 风险是**独立事实**而不是主档上的一个布尔位：一个客户可能同时存在多条风险
/// （逾期、损坏争议、身份异常），各自有自己的处理状态与复核结论。
/// 压成一个字段就无法回答「因为哪条风险被限制」。
model CustomerRiskRecord {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// 风险作用范围：租户级风险影响全部空间，空间级只影响该空间。
  workspaceId String?
  riskType    String
  /// low / medium / high
  level       String
  detail      String          @db.Text
  /// 来源：manual（人工登记）/ system（规则命中）/ external（外部风控）
  source      String
  /// open / reviewing / closed
  status      String          @default("open")
  raisedBy    String?
  raisedAt    DateTime
  reviewedBy  String?
  reviewedAt  DateTime?
  closeReason String?         @db.Text
  closedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, customerId, status], map: "customer_risk_customer_status_idx")
  @@index([tenantId, workspaceId, status], map: "customer_risk_ws_status_idx")
  @@map("customer_risk_records")
}

/// CUSTOMER-01A：品类资质引用（需求 4.8.5）。
///
/// 本表只保存资质**原始事实的引用**（证件类型、有效期、脱敏号码、证据引用）。
/// **不**保存「是否适用于某空间」的结论——那由 SHARED-QUAL-01 按目标空间品类判断，
/// 本任务不得越界实现审核流程。需求明确：一个空间通过不得自动绕过另一个空间的适用性校验。
model CustomerQualificationRef {
  id                String                         @id @default(uuid())
  tenantId          String
  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          CustomerProfile                @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// 证件/资质类型（driver_license、operator_certificate…）。取值域由 SHARED-QUAL-01 收口。
  qualificationType String
  /// 证件号码只存脱敏值。原件与影像不入本表（需求 4.8.5 要求限制访问与脱敏展示）。
  referenceNoMasked String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  /// 租户级实名/资质核验结果。是否**适用**由目标空间判断，不在此表。
  verifiedAt        DateTime?
  /// not_submitted / pending / approved / rejected / expired / revoked（需求 4.8.5 六态）
  status            String                         @default("not_submitted")
  /// 最近一次提交来源：admin / app；不代表审核通过。
  source            String                         @default("manual") @db.VarChar(32)
  currentRevisionId String?                        @unique
  currentRevision   CustomerQualificationRevision? @relation("CurrentQualificationRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  evidenceRef       String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@unique([tenantId, customerId, qualificationType], map: "customer_qualification_refs_unique_type_key")
  @@index([tenantId, status], map: "customer_qualification_refs_tenant_status_idx")
  @@map("customer_qualification_refs")
}

/// 租户统一配置个人会员注册审核方式。
model CustomerMembershipRegistrationSettings {
  id               String   @id @default(uuid())
  tenantId         String   @unique(map: "customer_membership_registration_settings_tenantId_key")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// automatic / manual。默认人工审核，迁移时有冲突也采用人工审核。
  registrationMode String   @default("manual")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("customer_membership_registration_settings")
}

/// MEMBER-01B/01C：注册审核与证件审核均为只追加的独立任务。
model CustomerMembershipReview {
  id                    String                         @id @default(uuid())
  tenantId              String
  tenant                Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 来源空间不是会员归属，且不得因删除空间而丢失审核历史。
  sourceWorkspaceId     String?
  sourceWorkspace       BusinessWorkspace?             @relation(fields: [tenantId, sourceWorkspaceId], references: [tenantId, id], onDelete: Restrict)
  customerId            String
  customer              CustomerProfile                @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// registration / qualification
  reviewType            String
  qualificationType     String?
  /// pending / approved / rejected / supplement_required / cancelled
  status                String                         @default("pending")
  channel               String
  requestKey            String?
  payload               Json?
  reason                String?                        @db.Text
  reviewedBy            String?
  reviewedAt            DateTime?
  qualificationRevision CustomerQualificationRevision?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@unique([tenantId, requestKey], map: "customer_membership_reviews_tenant_request_key")
  @@index([tenantId, status, reviewType], map: "customer_membership_reviews_tenant_status_type_idx")
  @@index([tenantId, sourceWorkspaceId], map: "customer_membership_reviews_source_workspace_idx")
  @@index([tenantId, customerId, createdAt], map: "customer_membership_reviews_customer_created_idx")
  @@map("customer_membership_reviews")
}

/// MEMBER-01C：个人证件提交与重审的不可变版本历史。
///
/// CustomerQualificationRef 只保留当前有效事实；每次提交都在这里追加一份快照，
/// 审核结果只更新对应快照的审核字段，不覆盖历史。evidenceRef 仅是文件服务返回的
/// 不可变引用，不是本表保存的文件路径或可直接访问的 URL。
model CustomerQualificationRevision {
  id                   String                    @id @default(uuid())
  tenantId             String
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId          String
  workspace            BusinessWorkspace         @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict)
  customerId           String
  customer             CustomerProfile           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  qualificationType    String
  categoryCode         String
  capabilityCode       String?
  /// 提交时的空间/品类/能力范围快照，后续修改证件类型配置不改写历史。
  applicableScope      Json
  referenceNoMasked    String?
  issuedAt             DateTime?
  expiresAt            DateTime?
  evidenceRef          String?                   @db.VarChar(512)
  /// admin / app
  source               String                    @db.VarChar(32)
  submittedBy          String?
  submittedAt          DateTime                  @default(now())
  /// 当前这份证件快照的事实状态。
  qualificationStatus  String                    @default("pending") @db.VarChar(32)
  /// 对应审核任务状态。
  reviewStatus         String                    @default("pending") @db.VarChar(32)
  reviewReason         String?                   @db.Text
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewId             String?                   @unique
  review               CustomerMembershipReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  currentQualification CustomerQualificationRef? @relation("CurrentQualificationRevision")
  createdAt            DateTime                  @default(now())

  @@index([tenantId, workspaceId, customerId, qualificationType, submittedAt], map: "customer_qualification_revisions_scope_customer_type_idx")
  @@index([tenantId, customerId, createdAt], map: "customer_qualification_revisions_customer_created_idx")
  @@map("customer_qualification_revisions")
}

/// MEMBER-01C：经营空间的可维护证件类型注册表。品类或 capability 可以扩展它，会员主流程不写死车辆字段。
model CustomerMembershipQualificationType {
