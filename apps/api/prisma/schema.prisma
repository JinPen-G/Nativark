  /// personal / corporate
  targetType  String
  status      String                             @default("draft")
  createdAt   DateTime                           @default(now())
  updatedAt   DateTime                           @updatedAt
  versions    CustomerMembershipPlanVersion[]
  assignments CustomerMembershipPlanAssignment[]

  @@unique([tenantId, code], map: "customer_membership_plans_tenant_code_key")
  @@unique([tenantId, id], map: "customer_membership_plans_tenant_id_key")
  @@index([tenantId, targetType, status], map: "customer_membership_plans_scope_type_status_idx")
  @@map("customer_membership_plans")
