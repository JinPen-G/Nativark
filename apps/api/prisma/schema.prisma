model AsyncJob {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  jobType      String
  businessType String?
  businessId   String?
  status       String
  attempt      Int      @default(0)
  maxAttempts  Int      @default(3)
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  operator     String?
  payload      Json
  result       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, jobType, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, businessType, businessId])
}

model DocumentPrintJob {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  documentNo   String
  documentType String
  templateCode String
  businessType String
  businessId   String?
  status       String
  fileAssetId  String?
  operator     String?
  payload      Json
  result       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, documentNo])
  @@index([tenantId, documentType, createdAt])
  @@index([tenantId, businessType, businessId])
}

model TBoxDevice {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  cid             String
  simNo           String?
  model           String
  status          String   @default("unbound")
  boundVehicleId  String?
  boundPlateNo    String?
  vehicleModel    String?
  firmwareVersion String?
  appVersion      String?
  warrantyExpireAt DateTime?
  supportsIButton Boolean  @default(false)
  iButtonCode     String?
  powerOnAt       DateTime?
  lastHeartbeatAt DateTime?
  telemetry       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, cid])
  @@index([tenantId, status])
  @@index([tenantId, boundPlateNo])
}

model ReportExportJob {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  reportType  String
  fileName    String
  status      String   @default("completed")
  filters     Json
  rowCount    Int      @default(0)
  downloadUrl String?
  operator    String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([tenantId, reportType, createdAt])
  @@index([tenantId, status, createdAt])
}

model OpsEventLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  level     String
  category  String
  message   String
  payload   Json?
  traceId   String?
  createdAt DateTime @default(now())

  @@index([tenantId, level, createdAt])
  @@index([tenantId, category, createdAt])
}
