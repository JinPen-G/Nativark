/// PRICE-GROUP-01：面向客户的商业定价分组。型号与资产库存仍在 RentalItemGroup，
/// 分组只定义可承接该档价格的型号集合，同一型号可进入多个分组而不复制库存。
model RentalPricingGroup {
  id                 String                     @id @default(uuid())
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId        String
  workspace          BusinessWorkspace          @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  categoryCode       RentalCategoryCode
  category           RentalCategoryDefinition   @relation(fields: [categoryCode], references: [code])
  code               String
  name               String
  description        String?
  defaultPricingUnit String?
  status             String                     @default("enabled")
  version            Int                        @default(1)
  members            RentalPricingGroupMember[]
  orderLines         RentalOrderLine[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([workspaceId, code], map: "rental_pricing_groups_ws_code_key")
  @@unique([tenantId, workspaceId, id], map: "rental_pricing_groups_scope_id_key")
  @@index([tenantId, categoryCode, status], map: "rental_pricing_groups_scope_status_idx")
  @@map("rental_pricing_groups")
}

model RentalPricingGroupMember {
  id             String             @id @default(uuid())
  pricingGroupId String
  pricingGroup   RentalPricingGroup @relation(fields: [pricingGroupId], references: [id], onDelete: Cascade)
  itemGroupId    String
  itemGroup      RentalItemGroup    @relation(fields: [itemGroupId], references: [id], onDelete: Restrict)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  @@unique([pricingGroupId, itemGroupId], map: "rental_pricing_group_members_pair_key")
  @@index([itemGroupId], map: "rental_pricing_group_members_item_idx")
  @@map("rental_pricing_group_members")
}

