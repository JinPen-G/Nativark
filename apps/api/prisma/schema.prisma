  openingRevision         Int                        @default(0)
  recommendedVersionId    String?                    @db.VarChar(191)
  recommendedVersion      RentalCategoryVersion?     @relation("RecommendedCategoryVersion", fields: [code, recommendedVersionId], references: [categoryCode, id])
