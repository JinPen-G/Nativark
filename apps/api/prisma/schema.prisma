// Rental Core 事实表（RC-01）------------------------------------------------
// 事实完整规范化为真实列。仅 request/chargeLines/ruleSnapshot/variables 等
// 需求要求的不可变时点快照保留 JSON（需求 4.7）。

model RentalQuote {
  id                     String             @id @default(uuid())
  tenantId               String
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId      String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace        BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  quoteNo                String
  categoryCode           RentalCategoryCode
  /// RentalQuoteRequest：报价入参原样留存，用于下单时比对与复算。
  request                Json
  /// RentalQuoteChargeLine[]：费用行明细，是报价可解释性的依据。
  chargeLines            Json
  rentalAmount           Decimal            @db.Decimal(12, 2)
  discountAmount         Decimal            @db.Decimal(12, 2)
  couponAmount           Decimal            @db.Decimal(12, 2)
  serviceAmount          Decimal            @db.Decimal(12, 2)
  /// 履约费用合计（需求 4.4 公式的独立一项）。存量报价按 0 回填。
  fulfillmentAmount      Decimal            @default(0) @db.Decimal(12, 2)
  depositAmount          Decimal            @db.Decimal(12, 2)
  /// 预授权额度。与 depositAmount 互斥：预授权模式下押金为 0，钱是冻结的没有收。
  preAuthAmount          Decimal            @default(0) @db.Decimal(12, 2)
  payableAmount          Decimal            @db.Decimal(12, 2)
  pricingPlanVersion     String
  /// RentalPricingRate[]：本次报价实际命中的费率，使复算不依赖计划仍以该版本存在。
  /// 存量报价按空数组回填——它们当时确实没有保存费率，空数组是如实记录而非猜测。
  rateSnapshot           Json?
  ruleVersion            String
  ruleSnapshot           Json
  calendarVersion        String?
  appliedDiscountPlanIds Json
  customerCouponId       String?
  expiresAt              DateTime
  consumedAt             DateTime?
  consumedOrderId        String?
  createdAt              DateTime           @default(now())

  @@unique([workspaceId, quoteNo], map: "rental_quotes_tenant_quote_no_key")
  @@index([tenantId, expiresAt, consumedAt], map: "rental_quotes_tenant_expires_consumed_idx")
  @@index([consumedOrderId])
  @@map("rental_quotes")
}

