/// RC-04：通用租赁订单动作的业务幂等记录。
///
/// 为什么不复用 `OrderIdempotencyRecord`：那张表的 orderId 外键指向车辆兼容域的
/// `StoreRentalOrder`，承载不了 Rental Core 订单；改成双引用会造出双事实源表结构，
/// 与 RC-05「停止双事实源扩张」相悖。旧表留给车辆域，等 RC-05 收口。
model RentalOrderIdempotencyRecord {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId      String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace        BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  /// 订单创建时订单还不存在，因此可空；创建成功后回填，供按单追溯。
  orderId   String?
  order     RentalOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String
  idempotencyKey String
  /// 请求体指纹。同键但不同请求体属于调用方错误，必须报冲突而不是返回上一次的结果——
  /// 否则「改了金额重发同一个键」会静默拿到旧订单。
  requestHash String
  status    String   @default("succeeded")
  /// 首次成功的响应快照，重复请求据此原样返回，不重新推进状态。
  response  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, action, idempotencyKey], map: "rental_idempotency_tenant_action_key")
  @@index([tenantId, orderId, action], map: "rental_idempotency_tenant_order_action_idx")
  @@map("rental_order_idempotency_records")
}
