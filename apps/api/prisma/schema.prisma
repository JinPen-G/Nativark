/// integrations 域的 TBox 设备资产台账：SIM 卡、型号、固件/App 版本、保修与 iButton。
/// 经 `/integrations/tbox-devices` 暴露，Prisma 访问器为 `prisma.tBoxDevice`。
/// 注意：与 `TboxDevice`（车辆兼容域的运行台账）是两张不同的表，
/// 模型名仅差一个大小写字母，访问器写错会静默读写另一张表。合并归属 RC-05。
model TBoxDevice {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  cid              String
  simNo            String?
  model            String
  status           String    @default("unbound")
  boundVehicleId   String?
  boundPlateNo     String?
  vehicleModel     String?
  firmwareVersion  String?
  appVersion       String?
  warrantyExpireAt DateTime?
  supportsIButton  Boolean   @default(false)
  iButtonCode      String?
  powerOnAt        DateTime?
  lastHeartbeatAt  DateTime?
  telemetry        Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, cid])
  @@index([tenantId, status])
  @@index([tenantId, boundPlateNo])
}

model RentalCategoryDefinition {
