  organizations             OrganizationUnit[]
  users                     User[]
  roles                     Role[]
  stations                  StoreStation[]
  vehicleGroups             VehicleGroup[]
  vehicles                  Vehicle[]
  vehicleTransferTasks      VehicleTransferTask[]
  tboxDevices               TboxDevice[]
  members                   Member[]
  corporates                Corporate[]
  membershipPlans           MembershipPlan[]
  orders                    StoreRentalOrder[]
  dispatchEvents            DispatchEvent[]
  filterPresets             FilterPreset[]
  monthlyBills              CorporateMonthlyBill[]
  rentalRuleSets            RentalRuleSet[]
  pricingPlans              PricingPlan[]
  priceAdjustmentSchedules  PriceAdjustmentSchedule[]
  marketingPlans            MarketingPlan[]
  quoteSnapshots            PricingQuoteSnapshot[]
  configVersions            ConfigVersion[]
  systemParameterSets       SystemParameterSet[]
  integrations              IntegrationCredential[]
  files                     FileAsset[]
  notificationTemplates     NotificationTemplate[]
  notificationLogs          NotificationSendLog[]
  adapterLogs               ExternalAdapterLog[]
  asyncJobs                 AsyncJob[]
  printJobs                 DocumentPrintJob[]
  integrationTboxDevices    TBoxDevice[]
  logs                      OperationLog[]
  reportExportJobs          ReportExportJob[]
  opsEventLogs              OpsEventLog[]
  rentalProfile             TenantRentalProfile?
  rentalLocations           RentalFulfillmentLocation[]
  rentalItemGroups          RentalItemGroup[]
  rentalAssets              RentalAsset[]
  rentalStockBalances       RentalStockBalance[]
  rentalOrders              RentalOrder[]
  rentalReservations        RentalReservation[]
  rentalInspectionTemplates RentalInspectionTemplate[]
  rentalInspectionRecords   RentalInspectionRecord[]
  rentalCouponTemplates     RentalCouponTemplate[]
  rentalOperators           RentalFulfillmentOperator[]
  rentalBusinessSettings    RentalTenantBusinessSettings[]
  rentalQuotes              RentalQuote[]
  rentalCustomerCoupons     RentalCustomerCoupon[]
  rentalRewardEntries       RentalRewardLedgerEntry[]
  rentalBenefitAccounts     RentalBenefitAccount[]
  rentalReferrals           RentalReferral[]
  rentalNotificationTemplates RentalNotificationTemplate[]
  rentalNotificationLogs    RentalNotificationLog[]
  rentalPricingPlans        RentalPricingPlan[]
  rentalDiscountPlans       RentalDiscountPlan[]
  rentalValueAddedServices  RentalValueAddedService[]
  rentalRuleVersions        RentalRuleVersion[]
  rentalBusinessCalendars   RentalBusinessCalendar[]
