  @@unique([tenantId, corporateCustomerId, personalCustomerId], map: "customer_corporate_memberships_tenant_company_person_key")
  @@index([tenantId, personalCustomerId, status], map: "customer_corporate_memberships_person_scope_status_idx")
  @@map("customer_corporate_memberships")
}

/// MEMBER-01E：新会员方案主体。版本内容不回写本表，已发布版本必须不可变。
model CustomerMembershipPlan {
