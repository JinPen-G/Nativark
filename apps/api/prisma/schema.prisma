/// CORE-EXT-02A：经营空间的 capability **实例**。
///
/// 为什么必须独立成表：早前空间能力直接读品类定义的 `defaultCapabilities` 数组，于是
/// 「品类声明了这个 code」== 「这个空间已启用该功能」。那让只有 code、没有可执行模块的
/// 能力被当成可用功能，也没有任何地方能表达暂停、停用、配置版本与升级审计。
///
/// 「没有实例行」与「实例为 disabled」是两种不同事实：前者从未启用过，后者停用且留有审计。
model WorkspaceCapabilityInstance {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId           String
  /// 复合外键保证空间与实例同租户，杜绝把能力实例挂到别的租户的空间上。
  workspace             BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  /// capability code。只校验它在注册表里，不做数据库枚举——注册表是代码里的唯一事实源。
  code                  String
  /// enabled / paused / disabled。
  status                String
  /// 启用时锁定的实现版本，来自注册表的 implementationVersion；升级即换这个值并留审计。
  implementationVersion String
  /// 配置版本号，每次改配置递增；报价与订单快照引用它来解释「当时按哪一版配置判定」。
  configVersion         String
  /// 该能力的配置值，形状由注册表的 configSchema 描述。
  config                Json
  /// 乐观并发：写入以读到的 revision 为条件，冲突返回 409。
  revision              Int               @default(0)
  enabledAt             DateTime?
  pausedAt              DateTime?
  disabledAt            DateTime?
  updatedBy             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  /// 同一空间同一能力只能有一个实例（需求：同空间实例与版本唯一）。
  @@unique([workspaceId, code], map: "workspace_capability_instances_ws_code_key")
  @@index([tenantId, code], map: "workspace_capability_instances_tenant_code_idx")
  @@map("workspace_capability_instances")
}

/// CORE-EXT-02A：capability 生命周期审计（只追加）。
/// 启用、暂停、停用、升级与改配置各留一行，永不改写——审计是事实而不是可变配置。
model WorkspaceCapabilityAuditEntry {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId           String
  workspace             BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  code                  String
  /// enable / pause / disable / upgrade / configure
  action                String
  fromStatus            String?
  toStatus              String
  implementationVersion String?
  configVersion         String?
  /// 本次变更后的完整配置快照。关系数据不能只靠 configVersion 追溯。
  configSnapshot        Json?
  reason                String            @db.Text
  operator              String?
  at                    DateTime
  createdAt             DateTime          @default(now())

  @@index([workspaceId, code], map: "workspace_capability_audits_ws_code_idx")
  @@index([tenantId, at], map: "workspace_capability_audits_tenant_at_idx")
  @@map("workspace_capability_audits")
}

/// CORE-EXT-02B：capability Hook 的执行审计。
///
/// 一次判定里每个执行过的能力一行。存在的理由是验收要求「可选提示可审计」——
/// 一条被放行但带提示的判定，事后必须能查出是哪个能力、哪个版本、在哪个节点、
/// 基于什么依据给出的提示。
///
/// 四类产物用 JSON 列而不是四张子表：它们只被整体读取（"这次判定发生了什么"），
/// 不需要按内部字段检索；拆表会让一次判定的写入变成五次，而它们必须在
/// **同一事务**里落库才能保证事务回滚后不留半成品。
model CapabilityHookAuditEntry {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId           String
  workspace             BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  /// 七个触发点之一
  point                 String
  capability            String
  implementationVersion String
  configVersion         String
  /// allow / warn / block
  decision              String
  /// 能力自身抛异常时为真；必选能力此时必然 block。
  failed                Boolean           @default(false)
  /// 判定对象，供按订单/报价追溯。order / quote / item_group / asset
  subjectType           String
  subjectId             String
  blockReasons          Json?
  notices               Json?
  linkedTasks           Json?
  feeBases              Json?
  operator              String?
  at                    DateTime
  createdAt             DateTime          @default(now())

  @@index([workspaceId, point], map: "capability_hook_audits_ws_point_idx")
  @@index([tenantId, subjectType, subjectId], map: "capability_hook_audits_tenant_subject_idx")
  @@index([tenantId, at], map: "capability_hook_audits_tenant_at_idx")
  @@map("capability_hook_audits")
}

model RentalCouponTemplate {
  id                         String                 @id @default(uuid())
  tenantId                   String
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId                String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                  BusinessWorkspace      @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  code                       String
  name                       String
  discountType               String
  discountValue              Decimal                @db.Decimal(12, 2)
  minimumSpend               Decimal                @db.Decimal(12, 2)
  maximumDiscount            Decimal?               @db.Decimal(12, 2)
  appliesTo                  String                 @default("rental")
  stackableWithDiscountPlans Boolean                @default(true)
  totalQuota                 Int
  claimedQuantity            Int                    @default(0)
  perCustomerLimit           Int                    @default(1)
  /// MKT-01B：每人**使用**次数上限。与 perCustomerLimit（每人领取次数）分开：
  /// 需求把两者并列要求，一个字段表达不了「可领 3 张、只能用 1 张」。
  perCustomerUseLimit        Int                    @default(1)
  /// MKT-01B：总优惠预算。为空表示不限。
  totalBudget                Decimal?               @db.Decimal(12, 2)
  /// MKT-01B：已锁定与已核销优惠金额。可用预算 = totalBudget - lockedBudget - redeemedBudget。
  lockedBudget               Decimal                @default(0) @db.Decimal(12, 2)
  redeemedBudget             Decimal                @default(0) @db.Decimal(12, 2)
  claimFrom                  DateTime
  claimTo                    DateTime
  effectiveFrom              DateTime
  effectiveTo                DateTime
  applicableRentalFrom       DateTime?
  applicableRentalTo         DateTime?
  applicableItemGroupIds     Json
  status                     String                 @default("draft")
  version                    String
  customerCoupons            RentalCustomerCoupon[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@unique([workspaceId, code], map: "rental_coupon_templates_ws_code_key")
  @@index([tenantId, status, effectiveFrom, effectiveTo], map: "rental_coupon_templates_tenant_status_effective_idx")
  @@map("rental_coupon_templates")
}

model RentalFulfillmentLocation {
  id                 String                     @id @default(uuid())
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId        String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace          BusinessWorkspace          @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  /// ACCESS-DATA-01：履约地点明确归属一个租户组织；空值不继承，组织范围默认不可见。
  organizationId     String?                    @db.VarChar(191)
  organization       OrganizationUnit?          @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  code               String
  name               String
  type               String
  operatorId         String?
  operator           RentalFulfillmentOperator? @relation(fields: [operatorId], references: [id])
  operatorType       String?
  operatorName       String?
  parentLocationId   String?
  capabilities       Json
  address            String?
  /// 行政区划主数据（选填）：便于按地区检索与在客户端展示，不参与任何业务判定。
  province           String?                    @db.VarChar(64)
  city               String?                    @db.VarChar(64)
  district           String?                    @db.VarChar(64)
  /// 门店时区，默认由录入端填 Asia/Shanghai；选填，不影响既有报价与履约逻辑。
  timezone           String?                    @db.VarChar(64)
  /// 门店坐标（客户端按位置排序与地图导航）；可空，未录入则客户端不显示距离。
  latitude           Decimal?                   @db.Decimal(10, 7)
  longitude          Decimal?                   @db.Decimal(10, 7)
  contactName        String?
  contactPhone       String?
  businessHours      String?
  status             String                     @default("enabled")
  assets             RentalAsset[]
  stockBalances      RentalStockBalance[]
  stockLedgerEntries RentalStockLedgerEntry[]
  orders             RentalOrder[]
  reservations       RentalReservation[]
  serviceCapacities  RentalServiceCapacity[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([workspaceId, code], map: "rental_locations_ws_code_key")
  @@unique([tenantId, workspaceId, id], map: "rental_locations_scope_id_key")
  @@index([tenantId, status])
  @@index([tenantId, workspaceId, organizationId], map: "rental_locations_tenant_ws_org_idx")
  @@index([operatorId])
  @@map("rental_fulfillment_locations")
}

model RentalItemGroup {
