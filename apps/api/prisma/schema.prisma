  rentalOrderChanges                RentalOrderChange[]
  rentalOrderDocumentSnapshots      RentalOrderDocumentSnapshot[]
  rentalBusinessCalendars           RentalBusinessCalendar[]
  rentalCalendarOverrideAudits      RentalCalendarOverrideAuditEntry[]
  rentalPriceVersions               RentalPriceVersion[]
  rentalPriceAdjustmentPlans        RentalPriceAdjustmentPlan[]
  workspaceCapabilityInstances      WorkspaceCapabilityInstance[]
  workspaceCapabilityAudits         WorkspaceCapabilityAuditEntry[]
  capabilityHookAudits              CapabilityHookAuditEntry[]
  rentalIdempotencyRecords          RentalOrderIdempotencyRecord[]
  customerProfiles                  CustomerProfile[]
  customerIdentityVerifications     CustomerIdentityVerification[]
  memberships                       CustomerMembership[]
  customerAccounts                  CustomerAccount[]
  customerCorporateProfiles         CustomerCorporateProfile[]
  customerContacts                  CustomerContact[]
  customerAuthorizedAgents          CustomerAuthorizedAgent[]
  customerStatusHistory             CustomerStatusHistoryEntry[]
  customerRiskRecords               CustomerRiskRecord[]
  customerQualificationRefs         CustomerQualificationRef[]
  customerQualificationRevisions    CustomerQualificationRevision[]
  customerMergeMappings             CustomerMergeMapping[]
  customerSensitiveAccess           CustomerSensitiveAccessAudit[]
  customerInvoiceProfiles           CustomerCorporateInvoiceProfile[]
  customerContracts                 CustomerCorporateContract[]
  customerCredits                   CustomerCorporateCredit[]
  customerCreditLedgerEntries       CustomerCorporateCreditLedger[]
  membershipRegistrationSettings    CustomerMembershipRegistrationSettings?
  membershipReviews                 CustomerMembershipReview[]
