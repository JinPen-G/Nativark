}

/// 品类身份之外的版本层。已发布正文只允许插入，不能更新；应用服务与专项验收执行不可变保护。
model RentalCategoryVersion {
  id               String                              @id @db.VarChar(191)
  categoryCode     RentalCategoryCode
  category         RentalCategoryDefinition            @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  versionLabel     String                              @db.VarChar(64)
  structureVersion Int                                 @default(1)
  sourceVersionId  String?                             @db.VarChar(191)
  sourceKind       String                              @db.VarChar(32)
  status           String                              @db.VarChar(24)
  revision         Int                                 @default(0)
  definition       Json
  dependencyDigest Json?
  publishedAt      DateTime?
  publishedBy      String?                             @db.VarChar(191)
  publishReason    String?                             @db.VarChar(512)
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  policy           RentalCategoryVersionPolicy?
  workspaces       BusinessWorkspace[]
  quotes           RentalQuote[]
  orders           RentalOrder[]
  preparations     RentalCategoryAdoptionPreparation[]
  recommendedFor   RentalCategoryDefinition[]          @relation("RecommendedCategoryVersion")

  @@unique([categoryCode, id], map: "rental_category_versions_code_id_key")
  @@unique([categoryCode, versionLabel], map: "rental_category_versions_code_label_key")
  @@index([categoryCode, status], map: "rental_category_versions_code_status_idx")
  @@map("rental_category_versions")
}

