generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE   @map("active")
  FROZEN   @map("frozen")
  DISABLED @map("disabled")
}

enum OrganizationType {
  OPERATOR @map("operator")
  CAR_SHOP @map("car_shop")
  STORE    @map("store")
  STATION  @map("station")
}

enum RoleScope {
  OPERATOR @map("operator")
  CAR_SHOP @map("car_shop")
  STORE    @map("store")
  STATION  @map("station")
}

enum StoreRentalMode {
  STORE_RENTAL     @map("store_rental")
  SELF_SERVICE_24H @map("self_service_24h")
}

enum OrderMainStatus {
  PENDING_PAYMENT     @map("pending_payment")
  RESERVED            @map("reserved")
  PICKUP_OVERDUE      @map("pickup_overdue")
  INSPECTING          @map("inspecting")
  RENTING             @map("renting")
  RENEWING            @map("renewing")
  OVERDUE             @map("overdue")
  ACCIDENT_PROCESSING @map("accident_processing")
  SETTLEMENT_PENDING  @map("settlement_pending")
  PAYMENT_DUE         @map("payment_due")
  REFUND_PENDING      @map("refund_pending")
  COMPLETED           @map("completed")
  CANCELLED           @map("cancelled")
  NO_SHOW             @map("no_show")
  REJECTED            @map("rejected")
  CLOSED              @map("closed")
}

enum DispatchStatus {
  PENDING          @map("pending")
  PRE_ASSIGNED     @map("pre_assigned")
  LOCKED           @map("locked")
  MANUAL_REASSIGNED @map("manual_reassigned")
  UPGRADED         @map("upgraded")
  MANUAL_REQUIRED  @map("dispatch_manual_required")
}

enum PaymentStatus {
  UNPAID          @map("unpaid")
  DEPOSIT_PAID    @map("deposit_paid")
  MONTHLY_BILLING @map("monthly_billing")
  PARTIAL_PAID    @map("partial_paid")
  PAID            @map("paid")
  PAYMENT_DUE     @map("payment_due")
  REFUND_PENDING  @map("refund_pending")
  REFUNDED        @map("refunded")
}

enum BillingMode {
  CUSTOMER_PAY @map("customer_pay")
  MONTHLY      @map("monthly")
}

enum SystemDataScope {
  ALL          @map("all")
  ORGANIZATION @map("organization")
  STORE        @map("store")
  OWN          @map("own")
}

enum PermissionKind {
  MENU   @map("menu")
  ACTION @map("action")
  BUTTON @map("button")
}

enum ConfigStatus {
  DRAFT     @map("draft")
  EFFECTIVE @map("effective")
  ARCHIVED  @map("archived")
}

enum VehicleOperationStatus {
  IDLE        @map("idle")
  RESERVED    @map("reserved")
  RENTING     @map("renting")
  CONTROLLED  @map("controlled")
  MAINTENANCE @map("maintenance")
  DISABLED    @map("disabled")
}

enum VehicleServiceType {
  STORE_STANDARD @map("STORE_STANDARD")
  STORE_24H      @map("STORE_24H")
}

enum MemberStatus {
  PENDING_REVIEW @map("pending_review")
  ACTIVE         @map("active")
  SUSPENDED      @map("suspended")
  BLACKLISTED    @map("blacklisted")
}

enum MemberReviewStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum CorporateStatus {
  ACTIVE   @map("active")
  PAUSED   @map("paused")
  DISABLED @map("disabled")
}

enum SettlementMode {
  MONTHLY @map("monthly")
  PREPAID @map("prepaid")
}

enum MonthlyBillStatus {
  DRAFT          @map("draft")
  POSTED         @map("posted")
  PARTIALLY_PAID @map("partially_paid")
  PAID           @map("paid")
  VOID           @map("void")
}

enum FinanceDocumentType {
  INVOICE @map("invoice")
  RECEIPT @map("receipt")
}

enum FinanceDocumentStatus {
  DRAFT  @map("draft")
  ISSUED @map("issued")
  SENT   @map("sent")
  VOIDED @map("voided")
}

enum FinanceManualAdjustmentDirection {
  CHARGE @map("charge")
  REFUND @map("refund")
  WAIVER @map("waiver")
}

enum FinanceManualAdjustmentStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
  POSTED   @map("posted")
}

enum FinancePreAuthorizationStatus {
  PENDING            @map("pending")
  FROZEN             @map("frozen")
  PARTIALLY_CAPTURED @map("partially_captured")
  CAPTURED           @map("captured")
  RELEASED           @map("released")
  EXPIRED            @map("expired")
  FAILED             @map("failed")
}

enum FinancePreAuthorizationChannel {
  ONLINE   @map("online")
  OFFLINE  @map("offline")
  INTERNAL @map("internal")
}

enum FeeStage {
  PICKUP            @map("pickup")
  RENTAL            @map("rental")
  RETURN_SETTLEMENT @map("return_settlement")
  CANCELLATION      @map("cancellation")
  POST_CHARGE       @map("post_charge")
}

enum FeeDirection {
  CHARGE @map("charge")
  REFUND @map("refund")
  WAIVER @map("waiver")
}

enum FeeStatus {
  PENDING         @map("pending")
  SETTLED         @map("settled")
  WAIVED          @map("waived")
  MONTHLY_BILLING @map("monthly_billing")
  VOIDED          @map("voided")
}

model Tenant {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  status         TenantStatus        @default(ACTIVE)
  organizations  OrganizationUnit[]
  users          User[]
  roles          Role[]
  stations       StoreStation[]
  vehicleGroups  VehicleGroup[]
  vehicles       Vehicle[]
  vehicleTransferTasks VehicleTransferTask[]
  tboxDevices    TboxDevice[]
  members        Member[]
  corporates     Corporate[]
  membershipPlans MembershipPlan[]
  orders         StoreRentalOrder[]
  dispatchEvents DispatchEvent[]
  filterPresets FilterPreset[]
  monthlyBills   CorporateMonthlyBill[]
  rentalRuleSets RentalRuleSet[]
  pricingPlans   PricingPlan[]
  priceAdjustmentSchedules PriceAdjustmentSchedule[]
  marketingPlans MarketingPlan[]
  quoteSnapshots PricingQuoteSnapshot[]
  configVersions ConfigVersion[]
  systemParameterSets SystemParameterSet[]
  integrations   IntegrationCredential[]
  files          FileAsset[]
  notificationTemplates NotificationTemplate[]
  notificationLogs NotificationSendLog[]
  adapterLogs    ExternalAdapterLog[]
  asyncJobs      AsyncJob[]
  printJobs      DocumentPrintJob[]
  integrationTboxDevices TBoxDevice[]
  logs           OperationLog[]
  reportExportJobs ReportExportJob[]
  opsEventLogs   OpsEventLog[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model OrganizationUnit {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  parentId  String?
  parent    OrganizationUnit? @relation("OrgTree", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("OrgTree")
  type      OrganizationType
  code      String
  name      String
  status    String            @default("enabled")
  users     User[]
  vehicles  Vehicle[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
}

model User {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  organizationId String?
  organization   OrganizationUnit? @relation(fields: [organizationId], references: [id])
  roleId         String?
  role           Role?             @relation(fields: [roleId], references: [id])
  account        String
  displayName    String
  phone          String?
  passwordHash   String
  isPlatformAdmin Boolean          @default(false)
  isActive       Boolean           @default(true)
  roleAssignments UserRole[]
  createdOrders  StoreRentalOrder[] @relation("OrderCreator")
  logs           OperationLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([tenantId, account])
  @@index([tenantId, organizationId])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  scope       RoleScope
  fixedAllPermissions Boolean  @default(false)
  enabledBusinessScopes Json
  buttonPermissions Json?
  dataScope   SystemDataScope  @default(STORE)
  isActive    Boolean          @default(true)
  users       User[]
  userAssignments UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  module      String
  kind        PermissionKind    @default(ACTION)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model StoreStation {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  parentStoreName String
  type            String              @default("store_counter")
  status          String              @default("enabled")
  serviceStatus   String              @default("normal")
  address         String?
  serviceTypes    Json
  metadata        Json?
  pickupOrders    StoreRentalOrder[]  @relation("PickupStation")
  returnOrders    StoreRentalOrder[]  @relation("ReturnStation")
  currentVehicles Vehicle[]           @relation("VehicleCurrentStation")
  calendarDays    StationCalendarDay[]
  capacitySnapshots StationCapacitySnapshot[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, parentStoreName, status])
}

model VehicleGroup {
  id        String              @id @default(uuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  seats     Int
  brand     String?
  model     String?
  energyType String?
  transmission String?
  luggageCount Int?
  status    String              @default("enabled")
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  vehicles  Vehicle[]
  orders    StoreRentalOrder[]

  @@unique([tenantId, code])
}

model Vehicle {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  storeId        String?
  store          OrganizationUnit? @relation(fields: [storeId], references: [id])
  currentStationId String?
  currentStation StoreStation?     @relation("VehicleCurrentStation", fields: [currentStationId], references: [id])
  vehicleGroupId String
  vehicleGroup   VehicleGroup      @relation(fields: [vehicleGroupId], references: [id])
  plateNo        String
  vin            String?
  assetCompanyName String?
  color          String?
  cid            String?
  isSpecial      Boolean           @default(false)
  enabled        Boolean           @default(true)
  operationStatus VehicleOperationStatus @default(IDLE)
  currentServiceType VehicleServiceType @default(STORE_STANDARD)
  serviceTypes   Json
  mileage        Int               @default(0)
  status         String
  metadata       Json?
  orders         StoreRentalOrder[]
  locationEvents VehicleLocationEvent[]
  conditionPhotos VehicleConditionPhotoRecord[]
  maintenanceRecords VehicleMaintenanceRecord[]
  accidentRecords VehicleAccidentRecord[]
  credentialRecords VehicleCredentialRecord[]
  onboardItems   VehicleOnboardItem[]
  statusChangeRecords VehicleStatusChangeRecord[]
  attachmentRecords VehicleAttachmentRecord[]
  tboxDevice     TboxDevice?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([tenantId, plateNo])
  @@index([tenantId, storeId, status])
  @@index([tenantId, currentStationId, operationStatus])
}

model VehicleLocationEvent {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  type        String
  occurredAt  DateTime
  storeName   String
  stationName String
  mileage     Int
  source      String   @default("manual")
  operator    String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, occurredAt])
}

model VehicleConditionPhotoRecord {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  scene     String
  remark    String
  photos    Json
  operator  String?
  createdAt DateTime @default(now())

  @@index([vehicleId, createdAt])
}

model VehicleMaintenanceRecord {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  type        String
  vendor      String
  mileage     Int
  costAmount  Decimal  @db.Decimal(12, 2)
  status      String
  nextDueAt    DateTime?
  nextDueMileage Int?
  attachments Json?
  remark      String?
  operator    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId, status])
}

model VehicleAccidentRecord {
  id                  String   @id @default(uuid())
  vehicleId            String
  vehicle              Vehicle  @relation(fields: [vehicleId], references: [id])
  description          String
  claimStatus          String
  estimatedCostAmount  Decimal  @db.Decimal(12, 2)
  reportNo             String?
  operator             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([vehicleId, claimStatus])
}

model VehicleTransferTask {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  taskNo            String
  status            String             @default("pending")
  sourceStoreName   String
  sourceStationName String
  targetStoreName   String
  targetStationName String
  targetServiceType VehicleServiceType @default(STORE_STANDARD)
  vehicleCount      Int                @default(0)
  reason            String?
  operator          String?
  items             Json
  createdAt         DateTime           @default(now())
  approvedAt        DateTime?
  departedAt        DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  completedAt       DateTime?

  @@unique([tenantId, taskNo])
  @@index([tenantId, status, createdAt])
}

model VehicleStatusChangeRecord {
  id                  String   @id @default(uuid())
  vehicleId           String
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id])
  fromEnabled         Boolean
  toEnabled           Boolean
  fromOperationStatus String
  toOperationStatus   String
  reason              String?
  operator            String?
  impactedOrderCount  Int      @default(0)
  impactedOrderNos    Json
  createdAt           DateTime @default(now())

  @@index([vehicleId, createdAt])
  @@index([toOperationStatus, createdAt])
}

model VehicleAttachmentRecord {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  category  String
  name      String
  url       String
  source    String   @default("manual")
  operator  String?
  remark    String?
  createdAt DateTime @default(now())

  @@index([vehicleId, category])
  @@index([vehicleId, createdAt])
}

model VehicleCredentialRecord {
  id             String   @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
  credentialType String
  credentialName String
  certNo         String
  status         String
  issueAt        DateTime?
  expiresAt      DateTime?
  reminderDays   Int      @default(30)
  attachments    Json
  operator       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vehicleId, credentialType])
  @@index([vehicleId, status])
}

model VehicleOnboardItem {
  id               String   @id @default(uuid())
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  category         String
  itemName         String
  standardQuantity Int      @default(1)
  actualQuantity   Int      @default(1)
  status           String   @default("normal")
  priceAmount      Decimal  @default(0) @db.Decimal(12, 2)
  checkedAt        DateTime @default(now())
  operator         String?
  remark           String?

  @@index([vehicleId, category])
  @@index([vehicleId, status])
}

model TboxDevice {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  cid             String
  provider        String
  modelNo         String
  status          String              @default("active")
  onlineStatus    String              @default("unknown")
  boundVehicleId  String?             @unique
  boundVehicle    Vehicle?            @relation(fields: [boundVehicleId], references: [id])
  batteryLevel    Int?
  signalStrength  Int?
  lastHeartbeatAt DateTime?
  metadata        Json?
  commandLogs     TboxCommandRecord[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, cid])
  @@index([tenantId, status, onlineStatus])
}

model TboxCommandRecord {
  id             String     @id @default(uuid())
  deviceId       String
  device         TboxDevice @relation(fields: [deviceId], references: [id])
  command        String
  status         String
  vehiclePlateNo String?
  operator       String?
  requestPayload Json?
  responsePayload Json?
  createdAt      DateTime   @default(now())

  @@index([deviceId, createdAt])
  @@index([status, createdAt])
}

model StationCalendarDay {
  id             String       @id @default(uuid())
  stationId      String
  station        StoreStation @relation(fields: [stationId], references: [id])
  date           DateTime
  businessStatus String       @default("open")
  openTime       String       @default("09:00")
  closeTime      String       @default("20:00")
  capacityLimit  Int?
  note           String?
  operator       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([stationId, date])
  @@index([stationId, businessStatus])
}

model StationCapacitySnapshot {
  id                    String       @id @default(uuid())
  stationId             String
  station               StoreStation @relation(fields: [stationId], references: [id])
  date                  DateTime
  totalSpaces           Int          @default(0)
  capacityLimit         Int?
  availableSpaces       Int          @default(0)
  reservedSpaces        Int          @default(0)
  occupiedVehicles      Int          @default(0)
  controlledVehicles    Int          @default(0)
  maintenanceVehicles   Int          @default(0)
  disabledVehicles      Int          @default(0)
  rentingVehicles       Int          @default(0)
  pendingPickupVehicles Int          @default(0)
  pendingReturnVehicles Int          @default(0)
  pickupQueueVehicles   Int          @default(0)
  returnQueueVehicles   Int          @default(0)
  queueVehicles         Int          @default(0)
  turnoverBufferMinutes Int          @default(60)
  estimatedWaitMinutes  Int          @default(0)
  pressureLevel         String       @default("normal")
  pressureReason        String?      @db.VarChar(512)
  businessStatus        String       @default("open")
  closedByCalendar      Boolean      @default(false)
  operator              String?
  source                String       @default("system")
  createdAt             DateTime     @default(now())

  @@index([stationId, date])
  @@index([stationId, createdAt])
}

model MembershipPlan {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  status          ConfigStatus @default(DRAFT)
  levelRules      Json
  benefits        Json
  effectiveAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Member {
  id                    String             @id @default(uuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id])
  name                  String
  phone                 String
  phoneMasked           String
  email                 String?
  source                String
  levelName             String
  status                MemberStatus       @default(PENDING_REVIEW)
  reviewStatus          MemberReviewStatus @default(PENDING)
  tags                  Json
  pointsBalance         Int                @default(0)
  totalOrders           Int                @default(0)
  totalSpendAmount      Decimal            @default(0) @db.Decimal(12, 2)
  identityVerified      Boolean            @default(false)
  driverLicenseVerified Boolean            @default(false)
  identityNoMasked      String?
  driverLicenseNoMasked String?
  birthday              DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  riskNote              String?
  notes                 String?
  lastOrderAt           DateTime?
  orders                StoreRentalOrder[]
  riskEvents            MemberRiskEvent[]
  timeline              MemberTimelineEvent[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, status, reviewStatus])
}

model MemberRiskEvent {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  action    String
  reason    String
  operator  String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

model MemberTimelineEvent {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  type      String
  title     String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

model Corporate {
  id                         String                 @id @default(uuid())
  tenantId                   String
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id])
  shortName                  String
  fullName                   String
  status                     CorporateStatus        @default(ACTIVE)
  creditLimitAmount          Decimal                @default(0) @db.Decimal(12, 2)
  creditWarningAmount        Decimal                @default(0) @db.Decimal(12, 2)
  accountPeriodDays          Int                    @default(30)
  billingCycleDay            Int                    @default(25)
  settlementMode             SettlementMode         @default(MONTHLY)
  contactName                String?
  contactPhone               String?
  billingEmail               String?
  statementEmail             String?
  reconciliationContactName  String?
  reconciliationContactPhone String?
  autoGenerateStatement      Boolean                @default(true)
  invoiceTitle               String?
  linkedStores               Json
  notes                      String?
  activeOrderCount           Int                    @default(0)
  lastOrderAt                DateTime?
  contacts                   CorporateContact[]
  contracts                  CorporateContract[]
  orders                     StoreRentalOrder[]
  monthlyBills               CorporateMonthlyBill[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@unique([tenantId, shortName])
  @@index([tenantId, status])
}

model CorporateContact {
  id          String    @id @default(uuid())
  corporateId String
  corporate   Corporate @relation(fields: [corporateId], references: [id])
  name        String
  title       String?
  phone       String?
  email       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([corporateId])
}

model CorporateContract {
  id             String    @id @default(uuid())
  corporateId    String
  corporate      Corporate @relation(fields: [corporateId], references: [id])
  contractNo     String
  contractName   String
  status         String
  startDate      DateTime?
  endDate        DateTime?
  amount         Decimal   @default(0) @db.Decimal(12, 2)
  linkedStores   Json
  statementEmail String?
  attachments    Json
  remark         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([corporateId, contractNo])
}

model CorporateMonthlyBill {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  corporateId   String
  corporate     Corporate            @relation(fields: [corporateId], references: [id])
  billNo        String
  period        String
  status        MonthlyBillStatus    @default(DRAFT)
  orderCount    Int                  @default(0)
  totalAmount   Decimal              @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal              @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal              @default(0) @db.Decimal(12, 2)
  dueDate       DateTime
  lineItems     CorporateMonthlyBillLine[]
  settlements   CorporateMonthlyBillSettlement[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([tenantId, billNo])
  @@index([corporateId, period])
}

model CorporateMonthlyBillLine {
