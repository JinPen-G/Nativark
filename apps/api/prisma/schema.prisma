/// SPACE-01：经营空间。
///
/// 需求 3：一个 SaaS 租户可建立多个经营空间，每个空间只经营一种品类。
/// 空间是业务隔离边界，不替代租户——所有经营事实最终同时带 tenantId 与 workspaceId
/// （事实的空间化属 SPACE-03，本任务只建主档与兼容层）。
///
/// 品类在创建时确定且不通过普通设置切换（需求 3）：变更品类必须新建空间或显式迁移，
/// 因此这里不提供"改品类"的写接口。
model BusinessWorkspace {
  id           String              @id
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  name         String
  /// 唯一经营品类。外键指向品类定义表，杜绝写入未定义品类。
  categoryCode RentalCategoryCode
  category     RentalCategoryDefinition @relation(fields: [categoryCode], references: [code])
  status       WorkspaceStatus     @default(ACTIVE)
  /// 兼容层标记：升级前建立的既有业务全部归属租户的默认空间。
  /// 每租户至多一个，由下方 partial-unique 的替代方案（defaultMarker）保证。
  isDefault    Boolean             @default(false)
  /// 用于"每租户只能有一个默认空间"的唯一约束。
  /// MySQL 没有部分索引，因此默认空间写 'default'、非默认写自身 id：
  /// 前者在租户内必然冲突，后者天然唯一。
  defaultMarker String
  members      WorkspaceMember[]
  authSessions AuthSession[]
  operationLogs OperationLog[]
  customerWorkspaceLinks CustomerWorkspaceLink[]
  coreStateSnapshot RentalCoreStateSnapshot?
  businessStateSnapshot RentalBusinessStateSnapshot?
  // SPACE-03：经营事实的反向关系。字段仅供 Prisma 关系解析，不用于查询。
  rentalCouponTemplates       RentalCouponTemplate[]
  rentalFulfillmentLocations  RentalFulfillmentLocation[]
  rentalItemGroups            RentalItemGroup[]
  rentalAssets                RentalAsset[]
  rentalStockBalances         RentalStockBalance[]
  rentalOrders                RentalOrder[]
  rentalReservations          RentalReservation[]
  rentalInspectionTemplates   RentalInspectionTemplate[]
  rentalInspectionRecords     RentalInspectionRecord[]
  rentalFulfillmentOperators  RentalFulfillmentOperator[]
  rentalTenantBusinessSettingss RentalTenantBusinessSettings[]
  rentalPricingPlans          RentalPricingPlan[]
  rentalDiscountPlans         RentalDiscountPlan[]
  rentalValueAddedServices    RentalValueAddedService[]
  rentalRuleVersions          RentalRuleVersion[]
  rentalBusinessCalendars     RentalBusinessCalendar[]
  rentalNotificationTemplates RentalNotificationTemplate[]
  rentalQuotes                RentalQuote[]
  rentalCustomerCoupons       RentalCustomerCoupon[]
  rentalRewardLedgerEntrys    RentalRewardLedgerEntry[]
  rentalBenefitAccounts       RentalBenefitAccount[]
  rentalReferrals             RentalReferral[]
  rentalNotificationLogs      RentalNotificationLog[]
  rentalOrderIdempotencyRecords RentalOrderIdempotencyRecord[]
  attributeUniqueValues RentalAttributeUniqueValue[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, code], map: "business_workspaces_tenant_code_key")
  @@unique([tenantId, defaultMarker], map: "business_workspaces_tenant_default_key")
  /// 供成员关系的复合外键引用，保证成员只能指向同租户的空间。
  @@unique([tenantId, id], map: "business_workspaces_tenant_id_key")
  @@index([categoryCode], map: "business_workspaces_category_idx")
  @@index([tenantId, status], map: "business_workspaces_tenant_status_idx")
  @@map("business_workspaces")
}

/// SPACE-01：账号与经营空间的成员关系。
///
/// 需求 3/4.1：账号归属租户，通过成员关系进入一个或多个空间，并可在不同空间
/// 拥有不同角色与数据范围。因此角色和数据范围记在成员关系上，而不是复用
/// `User.roleId`（那是租户级的旧模型，升级后作为默认值保留）。
///
/// 跨租户防护由**复合外键**在库层完成，而不是靠应用层校验：
/// (tenantId, workspaceId) 必须存在于 business_workspaces(tenantId, id)，
/// (tenantId, userId) 必须存在于 User(tenantId, id)。
/// 于是「A 租户的空间关联 B 租户的用户」在数据库层就写不进去。
model WorkspaceMember {
  tenantId    String
  workspaceId String
  userId      String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  user        User              @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  /// 该账号在本空间的角色。空表示沿用租户级默认角色（升级兼容）。
  roleId      String?
  role        Role?             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  /// 该账号在本空间的数据范围。空表示沿用角色自带范围。
  dataScope   SystemDataScope?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@id([workspaceId, userId])
  @@index([tenantId, userId], map: "workspace_members_tenant_user_idx")
  @@index([tenantId, roleId], map: "workspace_members_role_idx")
  @@map("workspace_members")
}

model RentalCoreStateSnapshot {
  /// SPACE-03：主键改为经营空间。
  ///
  /// 原主键是 tenantId，于是同租户只有一份快照——非默认空间根本没有存档，
  /// 而 persist 又必须固定写默认空间，否则会互相覆盖（实测过：在第二空间触发
  /// persist 会把它的状态写进租户级行、抹掉默认空间的存档）。
  /// 主键换成空间后，每个空间各有自己的恢复副本，persist 也不必再挑空间。
  workspaceId String  @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  state     Json
  updatedAt DateTime @updatedAt

  /// 一个经营空间至多一份快照；同时供 BusinessWorkspace 侧的一对一反向关系使用。
  @@unique([tenantId, workspaceId], map: "core_snapshot_tenant_ws_key")
  @@index([tenantId], map: "core_snapshot_tenant_idx")
  @@map("rental_core_state_snapshots")
}

model RentalBusinessStateSnapshot {
  /// SPACE-03：主键改为经营空间。
  ///
  /// 原主键是 tenantId，于是同租户只有一份快照——非默认空间根本没有存档，
  /// 而 persist 又必须固定写默认空间，否则会互相覆盖（实测过：在第二空间触发
  /// persist 会把它的状态写进租户级行、抹掉默认空间的存档）。
  /// 主键换成空间后，每个空间各有自己的恢复副本，persist 也不必再挑空间。
  workspaceId String  @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  state     Json
  updatedAt DateTime @updatedAt

  /// 一个经营空间至多一份快照；同时供 BusinessWorkspace 侧的一对一反向关系使用。
  @@unique([tenantId, workspaceId], map: "business_snapshot_tenant_ws_key")
  @@index([tenantId], map: "business_snapshot_tenant_idx")
  @@map("rental_business_state_snapshots")
}

model OrganizationUnit {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  parentId  String?
  parent    OrganizationUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("OrgTree")
  type      OrganizationType
  code      String
  name      String
  status    String             @default("enabled")
  users     User[]
  vehicles  Vehicle[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
}

model User {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  organizationId  String?
  organization    OrganizationUnit?  @relation(fields: [organizationId], references: [id])
  roleId          String?
  role            Role?              @relation(fields: [roleId], references: [id])
  account         String
  displayName     String
  phone           String?
  passwordHash    String
  isSaasAdmin     Boolean            @default(false)
  isPlatformAdmin Boolean            @default(false)
  isActive        Boolean            @default(true)
  mustChangePassword Boolean         @default(true)
  tokenVersion    Int                @default(1)
  passwordChangedAt DateTime?
  lastLoginAt     DateTime?
  roleAssignments UserRole[]
  workspaceMembers WorkspaceMember[]
  authSessions    AuthSession[]
  createdOrders   StoreRentalOrder[] @relation("OrderCreator")
  logs            OperationLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, account])
  /// 供成员关系的复合外键引用：成员必须指向**同租户**的账号，
  /// 从库层杜绝「把别的租户的用户加进本空间」。
  @@unique([tenantId, id], map: "users_tenant_id_key")
  @@index([tenantId, organizationId])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  /// SPACE-02：会话的当前经营空间。**服务端唯一权威**——客户端提交的
  /// workspaceId 一律忽略，切换必须走 switch 接口重新校验成员资格。
  ///
  /// 可空：平台管理租户没有经营空间，其会话合法地没有当前空间。
  /// 跨租户防护不依赖这里的外键，而依赖 workspace_members 的复合外键：
  /// 「该账号在该空间有成员关系」已蕴含两者同租户。
  currentWorkspaceId String?
  currentWorkspace   BusinessWorkspace? @relation(fields: [currentWorkspaceId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt, revokedAt])
  @@index([currentWorkspaceId], map: "auth_sessions_workspace_idx")
  @@map("auth_sessions")
}

model Role {
  id                    String           @id @default(uuid())
  tenantId              String
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  code                  String
  name                  String
  description           String?
  scope                 RoleScope
  fixedAllPermissions   Boolean          @default(false)
  enabledBusinessScopes Json
  buttonPermissions     Json?
  dataScope             SystemDataScope  @default(STORE)
  isActive              Boolean          @default(true)
  users                 User[]
  userAssignments       UserRole[]
  workspaceMembers      WorkspaceMember[]
  permissions           RolePermission[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  /// 供 WorkspaceMember 的复合外键引用，阻止跨租户角色授权。
  @@unique([tenantId, id], map: "roles_tenant_id_key")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  module      String
  kind        PermissionKind   @default(ACTION)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model StoreStation {
  id                String                    @id @default(uuid())
  tenantId          String
  tenant            Tenant                    @relation(fields: [tenantId], references: [id])
  code              String
  name              String
  parentStoreName   String
  type              String                    @default("store_counter")
  status            String                    @default("enabled")
  serviceStatus     String                    @default("normal")
  address           String?
  serviceTypes      Json
  metadata          Json?
  pickupOrders      StoreRentalOrder[]        @relation("PickupStation")
  returnOrders      StoreRentalOrder[]        @relation("ReturnStation")
  currentVehicles   Vehicle[]                 @relation("VehicleCurrentStation")
  calendarDays      StationCalendarDay[]
  capacitySnapshots StationCapacitySnapshot[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, parentStoreName, status])
}

model VehicleGroup {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  seats        Int
  brand        String?
  model        String?
  energyType   String?
  transmission String?
  luggageCount Int?
  status       String             @default("enabled")
  metadata     Json?
