/// 会员方案授予事实。企业员工订单将以它和企业关系构造权益快照。
model CustomerMembershipPlanAssignment {
  id            String                        @id @default(uuid())
  tenantId      String
  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      CustomerProfile               @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  planId        String
  plan          CustomerMembershipPlan        @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)
  planVersionId String
  planVersion   CustomerMembershipPlanVersion @relation(fields: [tenantId, planVersionId], references: [tenantId, id], onDelete: Restrict)
  /// manual / system / corporate_contract
  source        String
  status        String                        @default("active")
  effectiveFrom DateTime                      @default(now())
  effectiveTo   DateTime?
  reason        String?                       @db.Text
  grantedBy     String?
  revokedBy     String?
  revokedAt     DateTime?
  revokeReason  String?                       @db.Text
  snapshot      Json
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([tenantId, customerId, status], map: "customer_membership_plan_assignments_scope_customer_status_idx")
  @@map("customer_membership_plan_assignments")
}

/// CUSTOMER-01A：客户合并映射（需求 4.8.3）。
///
/// 合并后订单、支付、合同与历史事件继续引用**原**主档，因此必须永久保留
/// 「原主档 → 保留主档」的映射，否则历史引用会变成悬空 id。
/// 两侧客户都用 (tenantId, customerId) 复合外键指向主档——这是「禁止跨租户合并」的
/// **库层**保证，而不是只靠服务层判断。
model CustomerMergeMapping {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 被合并掉的主档（合并后为终态）。
  sourceCustomerId   String
  sourceCustomer     CustomerProfile @relation("CustomerMergeSource", fields: [tenantId, sourceCustomerId], references: [tenantId, id], onDelete: Cascade)
  /// 保留的主档。
  targetCustomerId   String
  targetCustomer     CustomerProfile @relation("CustomerMergeTarget", fields: [tenantId, targetCustomerId], references: [tenantId, id], onDelete: Cascade)
  reason             String          @db.Text
  operator           String?
  approver           String?
  /// 合并时的字段差异与取舍快照。需求要求保存字段差异，事后要能解释保留了谁的值。
  fieldDiff          Json?
  /// 合并时两侧空间会员关系的快照。各空间权益分别保留，不得因合并转成跨空间权益。
  membershipSnapshot Json?
  mergedAt           DateTime
  createdAt          DateTime        @default(now())

  /// 一份主档只能被合并一次：允许合并两次等于让历史引用指向一条已失效的链。
  @@unique([tenantId, sourceCustomerId], map: "customer_merge_mappings_source_key")
  @@index([tenantId, targetCustomerId], map: "customer_merge_mappings_target_idx")
  @@map("customer_merge_mappings")
}

/// CUSTOMER-01B：敏感资料访问审计（需求 4.8.5 / 4.8.14）。
///
/// 与状态历史分开是刻意的：状态历史回答「谁改了什么」，每行都要求 toStatus；
/// 一次纯读取没有目标状态，硬塞一个假状态会污染状态时间线。
/// 访问审计回答「谁看过什么」，只追加，不更新、不删除。
model CustomerSensitiveAccessAudit {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 从哪个空间发起。主档租户内共享，跨空间读取是允许的，但必须能按空间还原访问时间线。
  workspaceId String?
  customerId  String
  customer    CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// identity_no / qualification_ref / contact_phone / corporate_uscc …
  field       String
  /// list / detail / export / reveal
  action      String
  /// true = 看到明文（需单独授权）；false = 只看到脱敏值。追责粒度不同。
  revealed    Boolean         @default(false)
  operator    String?
  /// 依据的权限码。事后要能解释「他当时凭什么能看」。
  permission  String?
  reason      String?         @db.Text
  at          DateTime
  createdAt   DateTime        @default(now())

  @@index([tenantId, customerId, at], map: "customer_sensitive_access_customer_at_idx")
  @@index([tenantId, workspaceId, at], map: "customer_sensitive_access_ws_at_idx")
  @@index([tenantId, operator, at], map: "customer_sensitive_access_operator_at_idx")
  @@map("customer_sensitive_access_audits")
}

model OperationLog {
  id            String             @id @default(uuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  userId        String?
  user          User?              @relation(fields: [userId], references: [id])
  /// 租赁订单引用。RC-04 的审计事件走这一列。
  ///
  /// 这里曾经还有一个 `orderId`，外键指向早期单品类订单实体；那一层随历史单品类
  /// 模块整体下线后已经删除，审计只剩这一个订单口径。
  /// 不新建审计表：本表已有 tenantId/userId/action/detail 与平台审计查询，
  /// 再建一张只会造出第二个审计事实源。
  rentalOrderId String?
  rentalOrder   RentalOrder?       @relation(fields: [rentalOrderId], references: [id])
  /// SPACE-03：经营空间归属。
  ///
  /// 可空：平台域审计（租户创建、冻结、平台配置）不属于任何经营空间，
  /// 强制 NOT NULL 会逼出一个假的归属。经营域审计必须带值。
  /// onDelete 用 Restrict 而不是 Cascade：审计不能随经营空间被删而消失。
  /// 也不能用 SetNull——复合外键里的 tenantId 是必填列，Prisma 不允许。
  /// 产品上空间只冻结/停用、不硬删，因此 Restrict 不会挡住正常操作。
  workspaceId   String?
  workspace     BusinessWorkspace? @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict)
  action        String
  detail        Json
  createdAt     DateTime           @default(now())

  @@index([tenantId, action, createdAt])
  @@index([tenantId, rentalOrderId, createdAt])
  @@index([tenantId, workspaceId, createdAt], map: "OperationLog_tenant_workspace_created_idx")
}

model SystemParameterSet {
