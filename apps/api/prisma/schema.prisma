/// SPACE-01：经营空间。
///
/// 需求 3：一个 SaaS 租户可建立多个经营空间，每个空间只经营一种品类。
/// 空间是业务隔离边界，不替代租户——所有经营事实最终同时带 tenantId 与 workspaceId
/// （事实的空间化属 SPACE-03，本任务只建主档与兼容层）。
///
/// 品类在创建时确定且不通过普通设置切换（需求 3）：变更品类必须新建空间或显式迁移，
/// 因此这里不提供"改品类"的写接口。
model BusinessWorkspace {
  id                                String                                  @id
  tenantId                          String
  tenant                            Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                              String
  name                              String
  /// 唯一经营品类。外键指向品类定义表，杜绝写入未定义品类。
  categoryCode                      RentalCategoryCode
  category                          RentalCategoryDefinition                @relation(fields: [categoryCode], references: [code])
  /// 当前采用的不可变品类定义；存量空间由兼容迁移绑定 legacy 基线。
  categoryVersionId                 String?                                 @db.VarChar(191)
  categoryVersion                   RentalCategoryVersion?                 @relation(fields: [categoryCode, categoryVersionId], references: [categoryCode, id])
  categoryAdoptionRevision          Int                                     @default(0)
  categoryAdoptions                 RentalCategoryAdoptionAudit[]
  categoryPreparations              RentalCategoryAdoptionPreparation[]
  status                            WorkspaceStatus                         @default(ACTIVE)
  /// 兼容层标记：升级前建立的既有业务全部归属租户的默认空间。
  /// 每租户至多一个，由下方 partial-unique 的替代方案（defaultMarker）保证。
  isDefault                         Boolean                                 @default(false)
  /// 用于"每租户只能有一个默认空间"的唯一约束。
  /// MySQL 没有部分索引，因此默认空间写 'default'、非默认写自身 id：
  /// 前者在租户内必然冲突，后者天然唯一。
  defaultMarker                     String
  /// CORE-EXT-02C：运行模式 production / demo / development。
  /// 决定「缺品类必选能力」是提示还是服务端拒绝业务写入。
  /// 默认 development：存量空间此前从未被门禁约束，直接标 production 会让它们立刻停业。
  /// 新建空间由应用层显式传 production（创建时会同事务初始化必选能力）。
  runMode                           String                                  @default("development")
  members                           WorkspaceMember[]
  authSessions                      AuthSession[]
  operationLogs                     OperationLog[]
  membershipReviews                 CustomerMembershipReview[]
  customerQualificationRevisions    CustomerQualificationRevision[]
  membershipQualificationTypes      CustomerMembershipQualificationType[]
  clientRegistrationChallenges      ClientRegistrationChallenge[]
  clientAuthSessions                ClientAuthSession[]
  clientChannelPublications         ClientChannelWorkspace[]
  clientOrderDeliverySnapshots      ClientOrderDeliverySnapshot[]
  coreStateSnapshot                 RentalCoreStateSnapshot?
  businessStateSnapshot             RentalBusinessStateSnapshot?
  // SPACE-03：经营事实的反向关系。字段仅供 Prisma 关系解析，不用于查询。
  rentalCouponTemplates             RentalCouponTemplate[]
  rentalFulfillmentLocations        RentalFulfillmentLocation[]
  rentalItemGroups                  RentalItemGroup[]
  rentalPricingGroups               RentalPricingGroup[]
  rentalAssets                      RentalAsset[]
  rentalAssetStatusHistories        RentalAssetStatusHistory[]
  rentalStockBalances               RentalStockBalance[]
  rentalStockDispositions           RentalStockDisposition[]
  rentalStockLedgerEntries          RentalStockLedgerEntry[]
  rentalWorkOrders                  RentalWorkOrder[]
  rentalOrders                      RentalOrder[]
  rentalReservations                RentalReservation[]
  rentalInspectionTemplates         RentalInspectionTemplate[]
  rentalInspectionRecords           RentalInspectionRecord[]
  aiInspectionDrafts                AiInspectionDraft[]
  aiBusinessFailureEvents           AiBusinessFailureOutbox[]
  aiAutomationSubjects              AiAutomationSubject[]
  aiKnowledgePolicyAuthorities      AiKnowledgePolicyManagementAuthority[]
  aiClientSceneMaterials            AiClientSceneMaterial[]
  aiClientTaskPolicies              AiClientTaskPolicy[]
  aiInspectionEvidenceBindings      AiInspectionEvidenceBinding[]
  rentalFulfillmentOperators        RentalFulfillmentOperator[]
  rentalTenantBusinessSettingss     RentalTenantBusinessSettings[]
  approvedSettingsChanges           RentalApprovedSettingsChange[]
  rentalPricingPlans                RentalPricingPlan[]
  rentalDiscountPlans               RentalDiscountPlan[]
  rentalValueAddedServices          RentalValueAddedService[]
  rentalValueAddedServiceVersions   RentalValueAddedServiceVersion[]
  rentalServiceCapacities           RentalServiceCapacity[]
  rentalServiceReservations         RentalServiceReservation[]
  rentalRuleVersions                RentalRuleVersion[]
  rentalRuleVersionAudits           RentalRuleVersionAudit[]
  rentalFundingEvents               RentalFundingEvent[]
  rentalCarrierShipmentEvents       RentalCarrierShipmentEvent[]
  rentalOfflinePaymentRegistrations RentalOfflinePaymentRegistration[]
  rentalPaymentIntents              RentalPaymentIntent[]
  rentalPaymentRefunds              RentalPaymentRefund[]
  paymentReconciliationBatches      PaymentReconciliationBatch[]
  rentalOrderExtensions             RentalOrderExtension[]
  rentalOrderChanges                RentalOrderChange[]
  rentalOrderDocumentSnapshots      RentalOrderDocumentSnapshot[]
  rentalBusinessCalendars           RentalBusinessCalendar[]
  rentalCalendarOverrideAudits      RentalCalendarOverrideAuditEntry[]
  rentalPriceVersions               RentalPriceVersion[]
  rentalPriceAdjustmentPlans        RentalPriceAdjustmentPlan[]
  rentalNotificationTemplates       RentalNotificationTemplate[]
  rentalQuotes                      RentalQuote[]
  rentalCustomerCoupons             RentalCustomerCoupon[]
  rentalRewardLedgerEntrys          RentalRewardLedgerEntry[]
  rentalBenefitAccounts             RentalBenefitAccount[]
  rentalReferrals                   RentalReferral[]
  rentalNotificationLogs            RentalNotificationLog[]
  rentalNotificationRateBuckets     RentalNotificationRateBucket[]
  rentalOrderIdempotencyRecords     RentalOrderIdempotencyRecord[]
  workspaceCapabilityInstances      WorkspaceCapabilityInstance[]
  workspaceCapabilityAudits         WorkspaceCapabilityAuditEntry[]
  capabilityHookAudits              CapabilityHookAuditEntry[]
  attributeUniqueValues             RentalAttributeUniqueValue[]
  aiScopes                          AiScope[]
  createdAt                         DateTime                                @default(now())
  updatedAt                         DateTime                                @updatedAt

  @@unique([tenantId, code], map: "business_workspaces_tenant_code_key")
  @@unique([tenantId, defaultMarker], map: "business_workspaces_tenant_default_key")
  /// 供成员关系的复合外键引用，保证成员只能指向同租户的空间。
  @@unique([tenantId, id], map: "business_workspaces_tenant_id_key")
  @@index([categoryCode], map: "business_workspaces_category_idx")
  @@index([tenantId, status], map: "business_workspaces_tenant_status_idx")
  @@map("business_workspaces")
}

enum AiProviderProfileRole {
  DEFAULT    @map("default")
  REASONING  @map("reasoning")
  VISION     @map("vision")
  EMBEDDING  @map("embedding")
}

/// Revisioned dual-mode tenant configuration; encrypted BYOK is retained when
/// platform mode is selected. Legacy system-rules data is never deleted here.
model AiTenantModelConfiguration {
  tenantId             String   @id @db.VarChar(191)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mode                 String   @default("platform_managed") @db.VarChar(32)
  revision             Int      @default(1) @db.UnsignedInt
  settings             Json?
  credentialsEncrypted String?  @db.Text
  createdAt            DateTime @default(now()) @db.DateTime(3)
  updatedAt            DateTime @updatedAt @db.DateTime(3)

  @@map("ai_tenant_model_configurations")
}

/// Server-resolved profile. credentialRef is a vault reference, never a key.
/// CAS is enforced by the revision predicate in the repository and migration
/// uniqueness prevents two profiles with the same role in one owner scope.
model AiProviderProfile {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  scopeId            String                 @db.VarChar(36)
  scopeKind          AiScopeKind
  profileKey         String                 @db.VarChar(64)
  role               AiProviderProfileRole  @default(DEFAULT)
  serviceMode        String                 @default("tenant_managed") @db.VarChar(32)
  protocol           String                 @db.VarChar(64)
  provider           String                 @db.VarChar(128)
  model              String                 @db.VarChar(256)
  credentialRef      String                 @db.VarChar(191)
  configRevision     Int                    @default(1) @db.UnsignedInt
  enabled            Boolean                @default(true)
  allowedCapabilities Json
  createdAt          DateTime               @default(now()) @db.DateTime(3)
  updatedAt          DateTime               @updatedAt
  disabledAt         DateTime?
  scope              AiScope                @relation(fields: [scopeId, scopeKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  capabilityEvidence  AiProviderCapabilityEvidence[]
  textProbeReceipts    AiTextCapabilityReceipt[]
  platformConnection  AiPlatformModelConnection?

  @@unique([scopeId, scopeKind, profileKey], map: "ai_provider_profiles_scope_key")
  @@unique([scopeId, scopeKind, role], map: "ai_provider_profiles_scope_role")
  @@index([scopeKind, serviceMode, enabled], map: "ai_provider_profiles_route_idx")
  @@map("ai_provider_profiles")
}

model AiTextCapabilityReceipt {
  id              String   @id @default(uuid()) @db.VarChar(36)
  scopeId         String   @db.VarChar(36)
  profileId       String   @db.VarChar(36)
  operationId     String   @db.VarChar(128)
  descriptor      Json
  descriptorHash  String   @db.Char(64)
  observation     Json?
  observationHash String?  @db.Char(64)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  profile         AiProviderProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ai_text_capability_profile_fk")

  @@unique([scopeId, operationId], map: "ai_text_capability_scope_operation_key")
  @@index([profileId], map: "ai_text_capability_profile_idx")
  @@map("ai_text_capability_receipts")
}

/// Server-only platform vault. Profile revision and this row are committed together.
model AiPlatformModelConnection {
  profileId            String            @id @db.VarChar(36)
  profile              AiProviderProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configRevision       Int               @db.UnsignedInt
  baseUrl              String            @db.VarChar(2048)
  maxOutputTokens      Int               @db.UnsignedInt
  credentialsEncrypted String            @db.Text
  createdAt            DateTime          @default(now()) @db.DateTime(3)
  updatedAt            DateTime          @updatedAt @db.DateTime(3)

  @@map("ai_platform_model_connections")
}

/// Capability evidence is revision-bound. A provider configuration change makes
/// older evidence stale without mutating history or granting an implicit fallback.
model AiProviderCapabilityEvidence {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  profileId          String             @db.VarChar(36)
  scopeId            String             @db.VarChar(36)
  scopeKind          AiScopeKind
  capability         String             @db.VarChar(64)
  status             String             @db.VarChar(32)
  source             String             @db.VarChar(32)
  observedRevision   Int                @db.UnsignedInt
  evidenceHash       String             @db.VarChar(128)
  checkedAt          DateTime           @db.DateTime(3)
  expiresAt          DateTime?
  details            Json?
  profile            AiProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt

  @@unique([profileId, capability], map: "ai_provider_capability_evidence_profile_capability_key")
  @@index([scopeId, scopeKind, capability, observedRevision], map: "ai_provider_capability_evidence_route_idx")
  @@map("ai_provider_capability_evidence")
}

/// Durable admission record for an AI dispatch. Unknown is a first-class state:
/// it cannot be silently retried or treated as a successful business action.
model AiInvocationAdmission {
  id             String   @id @default(uuid()) @db.VarChar(36)
  tenantId       String   @db.VarChar(191)
  workspaceId    String   @db.VarChar(191)
  actorId        String   @db.VarChar(191)
  callId         String   @db.VarChar(128)
  requestHash    String   @db.VarChar(128)
  profileId      String?  @db.VarChar(36)
  status         String   @db.VarChar(32)
  dispatchId     String?  @db.VarChar(128)
  unknownReason  String?  @db.VarChar(128)
  expiresAt      DateTime @db.DateTime(3)
  admittedAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt
  revokedAt      DateTime?
  completedAt    DateTime?
  accountingReceipts AiGatewayAccountingReceipt[]

  @@unique([tenantId, workspaceId, id], map: "ai_invocation_admission_scope_id")
  @@unique([tenantId, callId], map: "ai_invocation_admission_tenant_call_key")
  @@index([tenantId, workspaceId, status], map: "ai_invocation_admission_scope_status_idx")
  @@index([status, expiresAt], map: "ai_invocation_admission_expiry_idx")
  @@map("ai_invocation_admissions")
}

model AiUsageReservation {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tenantId        String   @db.VarChar(191)
  workspaceId     String   @db.VarChar(191)
  callId          String   @db.VarChar(128)
  idempotencyKey  String   @db.VarChar(128)
  status          String   @db.VarChar(32)
  reservedUnits   Int      @db.UnsignedInt
  actualInput     Int?     @db.UnsignedInt
  actualOutput    Int?     @db.UnsignedInt
  unknownReason   String?  @db.VarChar(128)
  expiresAt       DateTime @db.DateTime(3)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt
  settledAt       DateTime?

  @@unique([tenantId, idempotencyKey], map: "ai_usage_reservation_tenant_key")
  @@unique([tenantId, callId], map: "ai_usage_reservation_tenant_call_key")
  @@index([tenantId, workspaceId, status], map: "ai_usage_reservation_scope_status_idx")
  @@map("ai_usage_reservations")
}

model AiUsageLedgerEntry {
  id             String   @id @default(uuid()) @db.VarChar(36)
  reservationId  String   @db.VarChar(36)
  tenantId       String   @db.VarChar(191)
  eventKey       String   @db.VarChar(128)
  kind           String   @db.VarChar(32)
  inputUnits     Int      @default(0) @db.UnsignedInt
  outputUnits    Int      @default(0) @db.UnsignedInt
  createdAt      DateTime @default(now()) @db.DateTime(3)

  @@unique([reservationId, eventKey], map: "ai_usage_ledger_reservation_event_key")
  @@index([tenantId, createdAt], map: "ai_usage_ledger_tenant_created_idx")
  @@map("ai_usage_ledger_entries")
}

/// Non-financial binding for one already-authorized Gateway step; no prompt body is stored.
model AiGatewayInvocation {
  id                String   @id @default(uuid()) @db.VarChar(36)
  scopeId           String   @db.VarChar(36)
  taskId            String   @db.VarChar(36)
  runId             String   @db.VarChar(36)
  stepId            String   @db.VarChar(36)
  actionId          String   @db.VarChar(191)
  stepFingerprint   String   @db.Char(64)
  actorId           String   @db.VarChar(191)
  callId            String   @db.VarChar(128)
  sceneCode         String   @db.VarChar(128)
  mode              String   @db.VarChar(8)
  intentHash        String   @db.Char(64)
  registrationHash  String   @db.Char(64)
  configuration     Json
  configurationHash String   @db.Char(64)
