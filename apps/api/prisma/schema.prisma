  @@unique([workspaceId, workNo], map: "rental_work_orders_ws_no_key")
  @@unique([workspaceId, dispositionId, type], map: "rental_work_orders_disp_type_key")
  @@index([tenantId, workspaceId, status, type])
  @@index([orderId, inspectionId])
  @@map("rental_work_orders")
