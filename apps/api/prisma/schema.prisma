  code               String
  name               String
  categoryCode       String
  capabilityCode     String?
  requiredForBooking Boolean           @default(false)
  status             String            @default("enabled")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([workspaceId, code], map: "customer_membership_qualification_types_workspace_code_key")
  @@index([tenantId, workspaceId, status], map: "customer_membership_qualification_types_scope_status_idx")
  @@map("customer_membership_qualification_types")
}

/// MEMBER-01D：企业管理员与员工均引用真实个人会员，不单独创建账号。
model CustomerCorporateMembership {
