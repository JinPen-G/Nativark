  locationId          String
  location            RentalFulfillmentLocation @relation(fields: [locationId], references: [id])
  onHandQuantity      Int                       @default(0)
  reservedQuantity    Int                       @default(0)
  maintenanceQuantity Int                       @default(0)
  updatedAt           DateTime                  @updatedAt

  @@unique([workspaceId, itemGroupId, locationId], map: "rental_stock_ws_group_location_key")
  @@index([tenantId, locationId])
