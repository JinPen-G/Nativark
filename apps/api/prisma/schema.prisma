model RentalOrder {
  /// 报价采用的品类版本；旧事实无证据则保留 NULL。
  categoryVersionId             String?                        @db.VarChar(191)
  categoryVersion               RentalCategoryVersion?         @relation(fields: [categoryCode, categoryVersionId], references: [categoryCode, id], onDelete: Restrict)
  id                            String                         @id @default(uuid())
  tenantId                      String
  tenant                        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId                   String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                     BusinessWorkspace              @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderNo                       String
  assignment                    Json?
  categoryCode                  RentalCategoryCode
  status                        RentalOrderV1Status            @default(RESERVED)
  customerType                  String
  customerId                    String?
  customerName                  String
  contactPhone                  String?
  /// 新会员体系：预约身份、企业员工关系、主体和权益的不可变快照。
  membershipSnapshot            Json?
  /// 会员方案本次实际生效、跳过与金额分摊的不可变结果。只存会员关系不足以解释订单减免。
  membershipBenefitEvaluations  Json?
  fulfillmentMode               String
  fulfillmentLocationId         String
  fulfillmentLocation           RentalFulfillmentLocation      @relation(fields: [fulfillmentLocationId], references: [id])
  /// 履约地点与归还地点的名称按需求 4.3 存为下单时快照，主档改名不得篡改历史订单。
  fulfillmentLocationName       String
  fulfillmentLocationSnapshot   Json?
  returnLocationId              String?
  returnLocationName            String?
  returnLocationSnapshot        Json?
  /// 配送/上门类（customer_address 品类）订单的收货地址快照（含明文电话）；自取、车辆据点类为空。
  deliveryAddressSnapshot       Json?
  startAt                       DateTime
  /// SHIP-01：凭客户签收凭证确认的实际租赁起点，仅承运寄送订单使用。
  actualRentalStartAt           DateTime?
  endAt                         DateTime
  /// 当前约定归还时间：最近一次已生效续租的 newEndAt；没有续租时与 endAt 相同。
  ///
  /// 需求 4.6.9 明确「延期不得直接修改原订单结束时间」，因此 endAt 永远是原始约定，
  /// 逾期判定与占用冲突检查一律读本列。可空：存量订单没有它，读取侧回落到 endAt。
  effectiveEndAt                DateTime?
  /// SHIP-01：承运寄送订单当前约定归还时点，签收时平移原租期，续租后更新。
  carrierRentalDueAt            DateTime?
  /// 报价快照：订单已内联保存 quoteNo/版本/规则/费用行，因此不对 rental_quotes 建外键，
  /// 避免把订单生命周期耦合到报价行的存续（报价可过期清理，订单事实必须长存）。
  quoteId                       String
  quoteNo                       String
  pricingPlanVersion            String
  ruleVersion                   String
  ruleSnapshot                  Json
  /// 报价继承的完整检查模板；存量无证据保留 NULL，不回填当前模板。
  inspectionTemplateSnapshots   Json?
  calendarVersion               String?
  /// RentalQuoteCalendarDay[]：从报价拷贝的逐日计价依据。
  /// 需求 4.5.7「订单始终使用订单快照」，因此与 ruleSnapshot 一样在订单上留一份，
  /// 报价被清理或日历改版后订单仍可复算。可空：存量订单没有这份快照。
  calendarSnapshot              Json?
  /// CORE-EXT-02D：RentalWorkspaceCapabilitySnapshotEntry[]。下单时固化的已启用能力版本快照，
  /// 在途环节 Hook 判定都用它，升级或暂停能力都不改写这张订单。可空：存量订单没有这份快照。
  capabilitySnapshot            Json?
  /// Review P1-5：RentalCapabilityDecisionSnapshot[]。下单时从报价拷贝的判断记录，
  /// 下单侧只能引用、不得凭空重构。
  capabilityDecisions           Json?
  /// Review P1-6：RentalCapabilityExceptionSnapshot[]。带风险继续的完整例外快照
  /// （原因、确认人、权限、时间、被确认的判断 id、版本与当时器材组合）。
  /// 审计里不能只剩 confirmed: true，否则配货与后续履约无从还原风险已被裁决。
  capabilityExceptions          Json?
  /// MKT-02A：从报价拷贝的服务、价格、资格、计划时段与条款正文快照。
  /// 可空仅用于迁移前存量订单；新订单必须直接继承报价快照。
  serviceSnapshots              Json?
  /// PRICE-03：订单继承报价命中的不可变价格版本引用。
  priceVersionId                String?
  priceVersion                  String?
  /// CUSTOMER-01C：订单主体（需求 4.8.4「订单必须明确签约主体、付款主体、使用人或经办人，
  /// 不能只保存一个联系人代替企业责任主体」）。
  ///
  /// 四个角色各存一个可索引的 id 列 + 一份 `subjectSnapshot` 快照：
  ///   * id 列用于「这个客户作为签约主体/使用人的订单」这类按角色反查；
  ///   * 快照保存下单当时的名称、脱敏证件与授权范围——主体后续改名或授权到期
  ///     都不得篡改历史订单（与 fulfillmentLocationSnapshot 同一手法）。
  /// 全部可空：存量订单没有主体拆分，读取侧回落到 customerId 作为三个主体。
  contractSubjectCustomerId     String?
  payerSubjectCustomerId        String?
  userSubjectCustomerId         String?
  agentId                       String?
  subjectSnapshot               Json?
  chargeLines                   Json
  /// 待人工裁定的费用审核单（逾期人工催收、提前归还人工审核退款）。
  /// 只要还有 pending 的就不许结清——否则「人工审核」这个规则选项等于静默免除。
  feeReviews                    Json?
  rentalAmount                  Decimal                        @db.Decimal(12, 2)
  discountAmount                Decimal                        @db.Decimal(12, 2)
  couponAmount                  Decimal                        @db.Decimal(12, 2)
  serviceAmount                 Decimal                        @db.Decimal(12, 2)
  /// 履约费用合计。与报价同口径，便于订单侧逐项对账。
  fulfillmentAmount             Decimal                        @default(0) @db.Decimal(12, 2)
  depositAmount                 Decimal                        @db.Decimal(12, 2)
  /// 预授权额度。需求 4.4.7 起与 depositAmount 独立，可同时非零。
  preAuthAmount                 Decimal                        @default(0) @db.Decimal(12, 2)
  /// 同 rental_quotes.legacyDepositUnverified：存量混口径且无法可靠判定归属的订单标记。
  legacyDepositUnverified       Boolean                        @default(false)
  /// 无法判定归属的存量保证金额原值。正式 depositAmount/preAuthAmount 均不得承载该笔。
  legacyDepositUnverifiedAmount Decimal                        @default(0) @db.Decimal(12, 2)
  payableAmount                 Decimal                        @db.Decimal(12, 2)
  adjustmentAmount              Decimal                        @db.Decimal(12, 2)
  finalPayableAmount            Decimal                        @db.Decimal(12, 2)
  /// 价内税税率（小数，13% 存 0.1300）与按 finalPayableAmount 反算的税额。
  /// 价内税是对含税额的拆分，不追加金额，因此不进 chargeLines；押金不计税。
  /// 规则未配税时为 0，存量订单迁移后同样是 0，复算结果不变。
  taxRate                       Decimal                        @default(0) @db.Decimal(6, 4)
  taxAmount                     Decimal                        @default(0) @db.Decimal(12, 2)
  /// 结算币种快照（需求 §948）。事实来源是经营空间的业务设置，订单只存下单当时的那一份。
  currency                      String                         @default("CNY") @db.VarChar(8)
  totalAmount                   Decimal                        @db.Decimal(12, 2)
  cancellationReason            String?
  cancelledAt                   DateTime?
  pickupOverdueAt               DateTime?
  noShowNoticeAt                DateTime?
  noShowAt                      DateTime?
  noShowReason                  String?
  completedAt                   DateTime?
  createdBy                     String
  lines                         RentalOrderLine[]
  reservations                  RentalReservation[]
  allocations                   RentalAllocation[]
  inspections                   RentalInspectionRecord[]
  stockDispositions             RentalStockDisposition[]
  workOrders                    RentalWorkOrder[]
  idempotencyRecords            RentalOrderIdempotencyRecord[]
  serviceReservations           RentalServiceReservation[]
  fundingEvents                 RentalFundingEvent[]
  carrierShipmentEvents         RentalCarrierShipmentEvent[]
  offlinePaymentRegistrations   RentalOfflinePaymentRegistration[]
  paymentIntents                RentalPaymentIntent[]
  paymentRefunds                RentalPaymentRefund[]
  extensions                    RentalOrderExtension[]
  changes                       RentalOrderChange[]
  documentSnapshots             RentalOrderDocumentSnapshot[]
  auditLogs                     OperationLog[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@unique([workspaceId, orderNo], map: "rental_orders_ws_order_no_key")
  @@unique([tenantId, workspaceId, id], map: "rental_orders_scope_id_key")
  @@index([tenantId, status, startAt])
  @@index([tenantId, customerType, customerId])
  @@index([tenantId, quoteId])
  /// CUSTOMER-01C：按主体角色反查订单。合并与注销（01D）都需要「这个客户
  /// 作为签约主体/付款主体/使用人有哪些订单」，没有索引就只能全表扫。
  @@index([tenantId, contractSubjectCustomerId], map: "rental_orders_contract_subject_idx")
  @@index([tenantId, payerSubjectCustomerId], map: "rental_orders_payer_subject_idx")
  @@index([tenantId, userSubjectCustomerId], map: "rental_orders_user_subject_idx")
  @@map("rental_orders")
}

/// DOC-PRINT-01：订单客户凭证的不可变服务端快照。
///
/// 同一订单、空间、凭证类型和内容哈希只归档一次；订单后续发生续租、归还、
/// 部分取消或结算变化时，会产生新的哈希和新的历史版本，旧版本不被覆盖。
/// snapshot/html 只保存已脱敏的客户可读内容，不保存规则、成本、完整资金流水
/// 或内部权限事实。正式 PDF/FileAsset 归档仍由后续切片承接。
model RentalOrderDocumentSnapshot {
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId          String
  workspace             BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId              String
  order                RentalOrder   @relation(fields: [tenantId, workspaceId, orderId], references: [tenantId, workspaceId, id], onDelete: Cascade, map: "rental_order_document_snapshots_tenant_ws_order_fkey")
  documentType         String        @db.VarChar(32)
  templateCode         String        @db.VarChar(64)
  documentNo           String        @db.VarChar(191)
  sourceOrderUpdatedAt DateTime
  snapshotAt           DateTime
  contentHash          String        @db.Char(64)
  snapshot             Json
  html                 String        @db.LongText
  createdAt            DateTime      @default(now())

  @@unique([tenantId, workspaceId, orderId, documentType, contentHash], map: "rental_order_document_snapshots_content_key")
  @@index([tenantId, workspaceId, orderId, documentType, createdAt], map: "rental_order_document_snapshots_history_idx")
  @@map("rental_order_document_snapshots")
}

/// RULE-01B：押金与预授权的模拟资金事件（需求 4.4.7 line 527、4.6.3）。
///
/// 只追加：押金与预授权的每一次发起、追加、抵扣、退款、释放、失败都是独立一行，
/// 不通过修改原报价/订单明细表达。provider 恒为明确标记的 mock——未接真实支付供应商前
/// 不得把内部状态展示为真实收款或真实预授权（需求 4.6.3）。
/// 幂等：`(workspaceId, orderId, instrument, action, idempotencyKey)` 唯一，重复提交只落一条。
/// 不进入订单状态机：本表记录资金事实，不改写 rental_orders.status（RULE-01B 边界）。
model RentalFundingEvent {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId        String
  order          RentalOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// deposit（实收押金）| preauthorization（冻结额度）。两者独立记账。
  instrument     String            @db.VarChar(20)
  /// initiate | append | capture | refund | release | fail。
  action         String            @db.VarChar(20)
  amount         Decimal           @db.Decimal(12, 2)
  /// 该 instrument 在本事件后的余额，落库便于对账，避免每次都重放全流水。
  balanceAfter   Decimal           @db.Decimal(12, 2)
  provider       String            @default("mock")
    /// offline_cash / offline_transfer；预授权内部动作和 Provider 回调可以为空。
  paymentMethod  String?           @db.VarChar(24)
  idempotencyKey String
  reason         String            @db.VarChar(500)
  operator       String?
  failureCode    String?
  at             DateTime
  createdAt      DateTime          @default(now())

  @@unique([workspaceId, orderId, instrument, action, idempotencyKey], map: "rental_funding_events_idem_key")
  @@index([tenantId, workspaceId, orderId], map: "rental_funding_events_scope_idx")
  @@index([orderId, instrument, at], map: "rental_funding_events_instrument_idx")
  @@map("rental_funding_events")
}

/// SHIP-01：承运寄送的只追加里程碑。计租使用签收/揽收事件，库存只在仓库实物验收后释放。
model RentalCarrierShipmentEvent {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId           String
  workspace             BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId               String
  order                 RentalOrder       @relation(fields: [tenantId, workspaceId, orderId], references: [tenantId, workspaceId, id], onDelete: Cascade, map: "rental_carrier_shipment_events_tenant_ws_order_fkey")
  type                  String            @db.VarChar(32)
  occurredAt            DateTime
  carrierName           String            @db.VarChar(120)
  trackingNumber        String            @db.VarChar(191)
  evidenceFileAssetIds  Json
  recordedBy            String            @db.VarChar(191)
  idempotencyKey        String            @db.VarChar(191)
  createdAt             DateTime          @default(now())

  @@unique([tenantId, workspaceId, idempotencyKey], map: "rental_carrier_shipment_events_idem_key")
  @@index([tenantId, workspaceId, orderId, occurredAt], map: "rental_carrier_shipment_events_order_time_idx")
  @@map("rental_carrier_shipment_events")
}

/// 员工先登记、具备结算权限的人员再确认；待确认期间不进入任何资金余额。
model RentalOfflinePaymentRegistration {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId        String
  workspace          BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId            String
  order              RentalOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  instrument         String            @db.VarChar(20)
  amount             Decimal           @db.Decimal(12, 2)
  paymentMethod      String            @db.VarChar(24)
  reason             String            @db.VarChar(500)
  evidenceFileAssetId String?          @db.VarChar(191)
  status             String            @default("pending") @db.VarChar(16)
  idempotencyKey     String            @db.VarChar(191)
  registeredBy       String?
  registeredAt       DateTime          @default(now())
  confirmedBy        String?
  confirmedAt        DateTime?
  fundingEventId     String?           @db.VarChar(191)

  @@unique([workspaceId, orderId, idempotencyKey], map: "rental_offline_payments_idem_key")
  @@index([tenantId, workspaceId, status, registeredAt], map: "rental_offline_payments_pending_idx")
  @@index([orderId, status], map: "rental_offline_payments_order_idx")
  @@map("rental_offline_payment_registrations")
}

/// EXT-01D：租户真实支付意图。第一阶段只承接普通租赁款，押金与预授权
/// 继续走独立的资金事件链，不能把支付成功误当成预授权已冻结。
model RentalPaymentIntent {
  id                    String                @id @default(uuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId           String
  workspace             BusinessWorkspace     @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId               String
  order                 RentalOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  instrument            String                @db.VarChar(24)
  provider              String                @db.VarChar(40)
  method                String                @db.VarChar(24)
  amount                Decimal               @db.Decimal(12, 2)
  currency              String                @default("CNY") @db.VarChar(8)
  merchantOrderNo       String                @unique(map: "rental_payment_intents_merchant_order_no_key")
  idempotencyKey        String                @db.VarChar(191)
  idempotencyHash       String                @db.Char(64)
  status                String                @default("pending") @db.VarChar(32)
  checkoutUrl           String?               @db.Text
  externalTransactionId String?               @db.VarChar(191)
  responseJson          Json?
  expiresAt             DateTime
  paidAt                DateTime?
  failureReason         String?               @db.VarChar(500)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  refunds               RentalPaymentRefund[]

  @@unique([tenantId, workspaceId, orderId, instrument, idempotencyHash], map: "rental_payment_intents_scope_idem_key")
  @@index([tenantId, provider, status], map: "rental_payment_intents_provider_status_idx")
  @@index([tenantId, workspaceId, orderId, status], map: "rental_payment_intents_order_status_idx")
  @@map("rental_payment_intents")
}

/// EXT-01D：真实支付退款单。退款申请、第三方受理、实际退款和内部租金资金事件
/// 分开记录；只有确认第三方退款成功后，才允许写入 rental_funding_events 的 refund。
/// 同一支付单支持多次部分退款，但每个幂等键只产生一张退款单。
model RentalPaymentRefund {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        BusinessWorkspace   @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId          String
  order            RentalOrder         @relation(fields: [tenantId, workspaceId, orderId], references: [tenantId, workspaceId, id], onDelete: Cascade)
  paymentIntentId  String
  paymentIntent    RentalPaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  provider         String              @db.VarChar(40)
  method           String              @db.VarChar(24)
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @db.VarChar(8)
  merchantRefundNo String              @unique(map: "rental_payment_refunds_merchant_no_key")
  idempotencyKey   String              @db.VarChar(191)
  idempotencyHash  String              @db.Char(64)
  /// pending | accepted | succeeded | funding_pending | failed | closed
  status           String              @default("pending") @db.VarChar(32)
  revision         Int                 @default(1) @db.UnsignedInt
  aiFailureEvents  AiBusinessFailureOutbox[] @relation("AiFailureRefund")
  externalRefundId String?             @db.VarChar(191)
  externalStatus   String?             @db.VarChar(40)
  responseJson     Json?
  reason           String              @db.VarChar(500)
  requestedBy      String?
  failureReason    String?             @db.VarChar(500)
  acceptedAt       DateTime?
  succeededAt      DateTime?
  fundedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([tenantId, workspaceId, id], map: "rental_payment_refunds_scope_id_key")
  @@unique([paymentIntentId, idempotencyHash], map: "rental_payment_refunds_intent_idem_key")
  @@index([tenantId, workspaceId, orderId, status], map: "rental_payment_refunds_order_status_idx")
  @@index([tenantId, provider, status, updatedAt], map: "rental_payment_refunds_provider_status_idx")
  @@map("rental_payment_refunds")
}

/// EXT-01D：已验签的第三方支付通知。先以提供方事件幂等，再推进租金资金事实。
model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String    @db.VarChar(40)
  eventId         String    @db.VarChar(191)
  paymentIntentId String?   @db.VarChar(191)
  payloadHash     String    @db.Char(64)
  status          String    @db.VarChar(24)
  errorMessage    String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, eventId], map: "payment_webhook_events_provider_event_key")
  @@index([tenantId, provider, createdAt], map: "payment_webhook_events_scope_created_idx")
  @@map("payment_webhook_events")
}

/// EXT-01D：支付平台对账文件导入批次。文件只作为外部账单证据保存摘要，
/// 不直接改写支付意图、退款单或资金事件；差异必须由财务人工确认。
model PaymentReconciliationBatch {
  id               String                       @id @default(uuid())
  tenantId         String
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        BusinessWorkspace            @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  provider         String                       @db.VarChar(40)
  fileName         String                       @db.VarChar(180)
  fileSha256       String                       @db.Char(64)
  status           String                       @db.VarChar(24)
  totalRows        Int
  matchedRows      Int                          @default(0)
  differenceRows   Int                          @default(0)
  acknowledgedRows Int                          @default(0)
  importedBy       String?
  importedAt       DateTime                     @default(now())
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  lines            PaymentReconciliationLine[]

  @@unique([tenantId, workspaceId, provider, fileSha256], map: "payment_reconciliation_batch_file_key")
  @@index([tenantId, workspaceId, status, importedAt], map: "payment_reconciliation_batch_scope_idx")
  @@map("payment_reconciliation_batches")
}

/// 对账文件中的标准化单行。localRecordId 只引用当前空间内的支付意图或退款单，
/// differenceCodes 是可解释的差异事实；reviewStatus 不会改变任何资金事实。
model PaymentReconciliationLine {
  id                String                    @id @default(uuid())
  batchId           String
  batch             PaymentReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber         Int
  kind              String                    @db.VarChar(16)
  merchantOrderNo   String                    @db.VarChar(191)
  merchantRefundNo  String?                   @db.VarChar(191)
  externalId        String?                   @db.VarChar(191)
  statementStatus   String                    @db.VarChar(80)
  normalizedStatus  String                    @db.VarChar(24)
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String                    @db.VarChar(8)
  occurredAt        DateTime?
  localRecordId     String?                   @db.VarChar(191)
  localStatus       String?                   @db.VarChar(32)
  differenceCodes   Json
  differenceDetail  String?                   @db.VarChar(1000)
  reviewStatus      String                    @default("not_required") @db.VarChar(24)
  reviewReason      String?                   @db.VarChar(500)
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([batchId, rowNumber], map: "payment_reconciliation_line_row_key")
  @@index([batchId, reviewStatus], map: "payment_reconciliation_line_review_idx")
  @@map("payment_reconciliation_lines")
}

/// 续租 / 延期记录（需求 4.6.9）。
///
/// 只追加，不可编辑：它是「这段延长的时间按哪一版价格、哪一版规则算的」的唯一凭据。
/// 原订单的 endAt 一律不动（需求原文：延期是订单变更，不得直接修改原订单结束时间），
/// 订单当前该还的时间由 rental_orders.effectiveEndAt 表达，只有本表 status=effective 才推进它。
/// 幂等：`(workspaceId, orderId, idempotencyKey)` 唯一，重复提交只落一条。
model RentalOrderExtension {
  /// 本次续租实际采用的品类政策和计价实现；历史无证据保留 NULL。
  executionBasis   Json?
  /// 原价格/优惠全租期重算结果、差额明细与退款审核。
  pricingSnapshot  Json?
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId          String
  order            RentalOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 同一订单内从 1 开始递增。订单费用明细的 code 用它去重（extension:1、extension:2…）。
  sequence         Int
  /// pending_payment | effective | cancelled | expired。只有 effective 推进 effectiveEndAt。
  status           String            @db.VarChar(20)
  originalEndAt    DateTime
  newEndAt         DateTime
  /// 增量期的计费单位数，按订单原本的计价单位计。
  billableUnits    Decimal           @db.Decimal(12, 2)
  rentalAmount     Decimal           @db.Decimal(12, 2)
  serviceAmount    Decimal           @db.Decimal(12, 2)
  /// 押金 / 预授权差额 = 按新租期应收 − 已收，可为 0。走资金台账收取，不进 payableAmount。
  depositDelta     Decimal           @db.Decimal(12, 2)
  preAuthDelta     Decimal           @db.Decimal(12, 2)
  payableAmount    Decimal           @db.Decimal(12, 2)
  currency         String            @default("CNY") @db.VarChar(8)
  /// 申请时命中的空间级价格版本（需求 4.6.9：新增部分用申请时的价格与日历）。
  priceVersionId   String?
  priceVersion     String?
  ruleVersion      String
  /// RentalPricingRate[]：申请时命中的费率本体，供事后复算这一段。
  rateSnapshot     Json
  ruleSnapshot     Json
  /// RentalQuoteCalendarDay[]：增量期逐日计价依据。
  calendarSnapshot Json
  /// RentalQuoteServiceSnapshot[]：本次续租新增的增值服务。生效时据此确认容量并合并进订单快照。
  serviceSnapshots Json?
  /// immediate（需客户补款后生效）| monthly（企业月结，检查通过即生效）。申请时快照。
  settlementMode   String            @db.VarChar(20)
  idempotencyKey   String
  memo             String?           @db.VarChar(500)
  paidAt           DateTime?
  effectiveAt      DateTime?
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([workspaceId, orderId, idempotencyKey], map: "rental_order_extensions_idem_key")
  @@unique([orderId, sequence], map: "rental_order_extensions_seq_key")
  @@index([tenantId, workspaceId, orderId], map: "rental_order_extensions_scope_idx")
  @@index([orderId, status, newEndAt], map: "rental_order_extensions_status_idx")
  @@map("rental_order_extensions")
}

/// ORDER-CHANGE-01A：订单变更只追加记录。
///
/// 第一阶段只承接取货前整条订单行取消。原订单、原订单行和原报价快照不删除、不覆盖，
/// 变更后的价格差、资源释放、客户确认与前后快照均落在本表，供订单详情和后续退款/对账回放。
model RentalOrderChange {
  id               String             @id @default(uuid())
  tenantId         String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace         BusinessWorkspace  @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId          String
  order            RentalOrder         @relation(fields: [tenantId, workspaceId, orderId], references: [tenantId, workspaceId, id], onDelete: Cascade)
  sequence         Int
  type             String             @db.VarChar(32)
  status           String             @db.VarChar(24)
  request          Json
  beforeSnapshot   Json
  afterSnapshot    Json
  diff             Json
  refundAmount     Decimal            @default(0) @db.Decimal(12, 2)
  additionalAmount Decimal            @default(0) @db.Decimal(12, 2)
  depositDelta     Decimal            @default(0) @db.Decimal(12, 2)
  preAuthDelta     Decimal            @default(0) @db.Decimal(12, 2)
  idempotencyKey   String             @db.VarChar(191)
  requestedBy      String
  appliedBy        String?
  requestedAt      DateTime           @default(now())
  appliedAt        DateTime?
  createdAt        DateTime           @default(now())

  @@unique([workspaceId, orderId, idempotencyKey], map: "rental_order_changes_idem_key")
  @@unique([orderId, sequence], map: "rental_order_changes_seq_key")
  @@index([tenantId, workspaceId, orderId, createdAt], map: "rental_order_changes_scope_idx")
  @@map("rental_order_changes")
}

model RentalOrderLine {
  id                             String              @id @default(uuid())
  orderId                        String
  order                          RentalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemGroupId                    String
  itemGroup                      RentalItemGroup     @relation(fields: [itemGroupId], references: [id])
  pricingGroupId                 String?
  pricingGroup                   RentalPricingGroup? @relation(fields: [pricingGroupId], references: [id], onDelete: Restrict)
  pricingGroupCode               String?
  pricingGroupName               String?
  /// 客户按组预约或指定准确型号；旧订单默认按组预约。
  reservationPrecision           String              @default("group") @db.VarChar(20)
  /// 下单时的成员范围，分组后续增删型号不改写历史订单。
  pricingGroupMemberItemGroupIds Json?
  /// 商品编码与名称存为下单时快照，主档改名不影响历史订单行。
  itemGroupCode                  String
  itemGroupName                  String
  inventoryMode                  RentalInventoryMode
  quantity                       Int
  cancelledQuantity              Int                 @default(0)
  unitPrice                      Decimal             @db.Decimal(12, 2)
  amount                         Decimal             @db.Decimal(12, 2)
  note                           String?
  reservations                   RentalReservation[]
  allocations                    RentalAllocation[]
  createdAt                      DateTime            @default(now())

  @@index([orderId, itemGroupId])
  @@index([pricingGroupId])
  @@map("rental_order_lines")
}

model RentalReservation {
  id               String                    @id @default(uuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId      String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace        BusinessWorkspace         @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId          String
  order            RentalOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId      String
  orderLine        RentalOrderLine           @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  itemGroupId      String
  itemGroup        RentalItemGroup           @relation(fields: [itemGroupId], references: [id])
  locationId       String
  location         RentalFulfillmentLocation @relation(fields: [locationId], references: [id])
  quantity         Int
  releasedQuantity Int                       @default(0)
  startAt          DateTime
  endAt            DateTime
  status           RentalReservationState    @default(SOFT)
  expiresAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([tenantId, itemGroupId, locationId, startAt, endAt, status], map: "rental_reservations_tenant_group_loc_period_status_idx")
  @@index([orderId, orderLineId])
  @@map("rental_reservations")
}

model RentalAllocation {
  id          String           @id @default(uuid())
  orderId     String
  order       RentalOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   RentalOrderLine  @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  itemGroupId String?
  itemGroup   RentalItemGroup? @relation(fields: [itemGroupId], references: [id])
  assetId     String?
  asset       RentalAsset?     @relation(fields: [assetId], references: [id])
  /// 资产编号存为分配时快照，资产改号不影响历史分配记录。
  assetNo     String?
  quantity    Int              @default(1)
  status      String           @default("allocated")
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orderId, orderLineId])
  @@index([itemGroupId, status])
  @@index([assetId, status])
  @@map("rental_allocations")
}

model RentalInspectionTemplate {
  id           String                   @id @default(uuid())
  tenantId     String
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId  String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace    BusinessWorkspace        @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  categoryCode RentalCategoryCode
  category     RentalCategoryDefinition @relation(fields: [categoryCode], references: [code])
  code         String
  name         String
  stage        String
  version      String
  fields       Json
  enabled      Boolean                  @default(true)
  records      RentalInspectionRecord[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([workspaceId, code, version], map: "rental_inspection_tpl_ws_code_ver_key")
  @@index([tenantId, categoryCode, stage, enabled], map: "rental_inspection_templates_tenant_category_stage_idx")
  @@map("rental_inspection_templates")
}

model RentalInspectionRecord {
  id                String                   @id @default(uuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId       String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace         BusinessWorkspace        @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId           String
  order             RentalOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage             String
  templateId        String
  template          RentalInspectionTemplate @relation(fields: [templateId], references: [id])
  stockDispositions RentalStockDisposition[]
  templateCode      String
  templateVersion   String
  results           Json
  exceptions        Json
  attachments       Json
  operator          String
  createdAt         DateTime                 @default(now())
  revision          Int                      @default(1) @db.UnsignedInt
  updatedAt         DateTime                 @default(now()) @updatedAt @db.DateTime(3)
  failureEvents     AiBusinessFailureOutbox[] @relation("AiFailureInspection")

  @@unique([tenantId, workspaceId, id, orderId], map: "rental_inspection_event_source_key")
  @@index([tenantId, orderId, stage])
  @@map("rental_inspection_records")
}

// Rental Core 配置表（RC-01）------------------------------------------------
// 配置采用「规范化标识列 + 版本化 JSON 明细」：租户、编码、版本、状态和生效区间
// 是真实列，可被查询与 join；深层嵌套的规则明细放 JSON。这与被替换掉的
// 「一个租户所有事实挤在一行 JSON」的巨型聚合是两回事。

model RentalFulfillmentOperator {
  id             String                      @id @default(uuid())
  tenantId       String
  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId    String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace      BusinessWorkspace           @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  code           String
  name           String
  type           String
  contactName    String?
  contactPhone   String?
  settlementMode String?
  status         String                      @default("enabled")
  locations      RentalFulfillmentLocation[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([workspaceId, code], map: "rental_operators_ws_code_key")
  @@index([tenantId, status])
  @@map("rental_fulfillment_operators")
}

model RentalTenantBusinessSettings {
  /// SPACE-03：主键改为经营空间。
  ///
  /// 原主键是 tenantId，于是同租户两个空间抢同一行——第二个空间保存业务设置
  /// 会直接覆盖第一个空间的支付、逾期、履约规则。业务设置属于经营空间。
  workspaceId   String             @id
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace     BusinessWorkspace  @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  categoryCode  RentalCategoryCode
  configVersion String
  settingsRevision Int @default(1) @db.UnsignedInt
  /// TenantRentalBusinessSettings 的 pricing/fulfillment/deposit 等嵌套配置块。
  settings      Json
  updatedBy     String
  updatedAt     DateTime           @updatedAt

  @@index([tenantId], map: "rental_business_settings_tenant_idx")
  @@map("rental_tenant_business_settings")
}

model RentalApprovedSettingsChange {
  id                       String @id @default(uuid()) @db.VarChar(36)
  tenantId                 String
  workspaceId              String
  actorId                  String @db.VarChar(191)
  changeKey                String @db.VarChar(128)
  baseRevision             Int @db.UnsignedInt
  baseSettingsHash         String @db.Char(64)
  categoryVersionId        String @db.VarChar(191)
  categoryAdoptionRevision Int
  beforeNotifications      Json
  afterNotifications       Json
  changeHash               String @db.Char(64)
  expiresAt                DateTime @db.DateTime(3)
  createdAt                DateTime @default(now()) @db.DateTime(3)
  workspace BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  operations RentalApprovedSettingsOperation[]

  @@unique([workspaceId, actorId, changeKey], map: "approved_settings_change_key")
  @@unique([tenantId, workspaceId, id, changeHash], map: "approved_settings_change_binding")
  @@map("rental_approved_settings_changes")
}

model RentalApprovedSettingsOperation {
  id             String @id @default(uuid()) @db.VarChar(36)
  tenantId       String
  workspaceId    String
  actorId        String @db.VarChar(191)
  operationKey   String @db.VarChar(191)
  commandHash    String @db.Char(64)
  changeId       String @db.VarChar(36)
  changeHash     String @db.Char(64)
  baseRevision   Int @db.UnsignedInt
  resultRevision Int @db.UnsignedInt
  resultHash     String @db.Char(64)
  approvalRef    Json
  createdAt      DateTime @default(now()) @db.DateTime(3)
  change RentalApprovedSettingsChange @relation(fields: [tenantId, workspaceId, changeId, changeHash], references: [tenantId, workspaceId, id, changeHash], onDelete: Restrict, onUpdate: Restrict, map: "approved_settings_operation_change_fk")

  @@unique([workspaceId, operationKey], map: "approved_settings_operation_key")
  @@unique([workspaceId, changeId], map: "approved_settings_change_once")
  @@index([tenantId, workspaceId, changeId, changeHash], map: "rental_approved_settings_operations_change_binding_idx")
  @@map("rental_approved_settings_operations")
}

model RentalPricingPlan {
  id              String                      @id @default(uuid())
  tenantId        String
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId     String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace       BusinessWorkspace           @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  categoryCode    RentalCategoryCode
  code            String
  name            String
  currency        String                      @default("CNY")
  status          String                      @default("draft")
  version         String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  /// RentalPricingRate[]：按商品组的单位价、倍率、押金、起租量和超额用量费。
  rates           Json
  /// RentalFulfillmentFee[]：按履约方式的履约费与异地归还附加费（需求 4.4）。
  /// 与 rates 同为「版本化 JSON 明细」，随计划版本一起发布与快照。
  fulfillmentFees Json?
  /// PRICE-03：该计划的不可变版本历史（v1 起，只追加）。
  /// PRICE-03：针对该计划的调价计划。
  adjustmentPlans RentalPriceAdjustmentPlan[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([workspaceId, code, version], map: "rental_pricing_plans_tenant_code_version_key")
  @@index([tenantId, status, effectiveFrom, effectiveTo], map: "rental_pricing_plans_tenant_status_effective_idx")
  @@map("rental_pricing_plans")
}

/// PRICE-03：不可变价格版本（需求 4.4.3，Codex 复审 P1-2 空间级粒度）。
///
/// 每一行是某一生效时点、**当前经营空间全部有效商品价格**的完整、不可变结果
/// （覆盖空间内全部"商品 × 计价单位"，跨计划聚合）；每次调价追加新行，旧版本
/// 永久保留。计划行只是编辑与变更来源，不再承载版本链——禁止
/// 「计划行就地修改 + version+1 + 旧值消失」的伪版本路径。
model RentalPriceVersion {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  /// 空间内原子序号（1 起）。字符串版本号在 v10 之后排序不可靠，故只存整数。
  sequence      Int
  effectiveFrom DateTime
  /// 该版本的完整费率结果：空间内全部有效"商品 × 计价单位"（不只是差异）。
  rates         Json
  changeReason  String?
  createdBy     String?
  createdAt     DateTime          @default(now())

  @@unique([workspaceId, sequence])
  @@index([workspaceId, effectiveFrom])
  @@map("rental_price_versions")
}

/// PRICE-03：调价计划（需求 4.4.3）。
///
/// 只保存差异（op + 受影响行）；确认（立即）或到期（定时）执行时基于当前版本
/// 生成完整新版本。状态机：草稿 → 待生效 → 已生效；草稿/待生效可取消；
/// 执行异常进入执行失败。已生效不可编辑、撤回或删除。
model RentalPriceAdjustmentPlan {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  planId          String
  plan            RentalPricingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  code            String
  name            String
  /// 草稿 / 待生效 / 已生效 / 已取消 / 执行失败。
  status          String            @default("draft")
  /// RentalPriceAdjustmentChange[]：差异（op + 受影响商品 + 值）。
  changes         Json
  /// 定时执行的生效时刻；缺省 = 立即执行。
  scheduledAt     DateTime?
  resultVersionId String?
  /// 确认（进入待生效）时锁定的基础版本：到期执行必须仍基于它，否则结果与确认展示不符。
  baseVersionId   String?
  /// 确认时基于基础版本算出的完整最终费率：到期执行直接采用，不重放差异。
  finalRates      Json?
  /// 主动取消的原因。与 failureReason（执行失败原因）分开，语义不得混用。
  cancelReason    String?
  changeReason    String
  createdBy       String?
  confirmedBy     String?
  confirmedAt     DateTime?
  failureReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([workspaceId, code])
  @@index([planId, status, scheduledAt])
  @@map("rental_price_adjustment_plans")
}

model RentalDiscountPlan {
  id                        String             @id @default(uuid())
  tenantId                  String
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId               String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                 BusinessWorkspace  @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  categoryCode              RentalCategoryCode
  code                      String
  name                      String
  status                    String             @default("draft")
  discountType              String
  discountValue             Decimal            @db.Decimal(12, 2)
  minimumSpend              Decimal            @db.Decimal(12, 2)
  /// MKT-01A：满额固定减免的门槛，仅 discountType = threshold_amount 使用。
  thresholdAmount           Decimal?           @db.Decimal(12, 2)
  maximumDiscount           Decimal?           @db.Decimal(12, 2)
  /// MKT-01A：优惠作用的费用对象（rental / fulfillment / service）。
  /// 押金、预授权与异常费用不在取值域内——需求禁止普通优惠减免它们。
  appliesTo                 String             @default("rental")
  /// MKT-01A：互斥组。空表示自成一组，只与自己互斥。
  exclusiveGroup            String?
  /// MKT-01A：是否允许与其他优惠方案同时应用。默认 false 保持存量「一次只用一个」口径。
  stackableWithOtherPlans   Boolean            @default(false)
  customerScope             String             @default("all")
  applicableItemGroupIds    Json
  /// MKT-01C：面向客户的定价分组范围；空数组表示全部。
  applicablePricingGroupIds Json
  applicableDayTypes        Json
  priority                  Int                @default(0)
  stackableWithCoupon       Boolean            @default(true)
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  version                   String
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@unique([workspaceId, code, version], map: "rental_discount_plans_tenant_code_version_key")
  @@index([tenantId, status, priority], map: "rental_discount_plans_tenant_status_priority_idx")
  @@index([workspaceId, exclusiveGroup], map: "rental_discount_plans_group_idx")
  @@map("rental_discount_plans")
}

/// MKT-02B：增值服务容量窗口（需求 4.4.11「容量、资源与预留」）。
///
/// 粒度 = 经营空间 × 服务 × 地点 × 时间范围。容量必须落到真实履约地点，避免空地点
/// 在多个地点同时被重复解释。可用量 = totalCapacity - reservedQuantity - usedQuantity。
/// 预留与已用分两列：需求要求分别记录「已预留数量、已确认数量」，合成一列就分不清
/// 「占着还没履约」与「已经用掉」，取消时也不知道该退哪一部分。
model RentalServiceCapacity {
  id               String                     @id @default(uuid())
  tenantId         String
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        BusinessWorkspace          @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  serviceId        String
  service          RentalValueAddedService    @relation(fields: [tenantId, workspaceId, serviceId], references: [tenantId, workspaceId, id], onDelete: Restrict)
  locationId       String
  location         RentalFulfillmentLocation  @relation(fields: [tenantId, workspaceId, locationId], references: [tenantId, workspaceId, id], onDelete: Restrict)
  windowStart      DateTime
  windowEnd        DateTime
  totalCapacity    Int
  reservedQuantity Int                        @default(0)
  usedQuantity     Int                        @default(0)
  status           String                     @default("enabled")
  reservations     RentalServiceReservation[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([workspaceId, serviceId, locationId, windowStart, windowEnd], map: "rental_service_capacities_window_key")
  @@unique([tenantId, workspaceId, id], map: "rental_service_capacities_scope_id_key")
  @@index([tenantId, workspaceId, serviceId, windowStart], map: "rental_service_capacities_scope_idx")
  @@map("rental_service_capacities")
}

/// MKT-02B：容量预留流水。一条 = 某订单对某容量窗口的一次占用。
/// 释放与转已用都按它反查，不靠重算——重算会在服务配置或价格变动后退错数量。
/// `idempotencyKey` 唯一，因此同一订单同一服务的重复预留请求落在同一行，重试不会重复占用。
model RentalServiceReservation {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      BusinessWorkspace       @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  capacityId     String
  capacity       RentalServiceCapacity   @relation(fields: [tenantId, workspaceId, capacityId], references: [tenantId, workspaceId, id], onDelete: Restrict)
  serviceId      String
  service        RentalValueAddedService @relation(fields: [tenantId, workspaceId, serviceId], references: [tenantId, workspaceId, id], onDelete: Restrict)
  orderId        String
  order          RentalOrder             @relation(fields: [tenantId, workspaceId, orderId], references: [tenantId, workspaceId, id], onDelete: Restrict)
  quantity       Int
  /// reserved（软预留）→ confirmed（订单确认）→ used（已履约），或 released / expired。
  status         String                  @default("reserved")
  idempotencyKey String
  reservedAt     DateTime                @default(now())
  expiresAt      DateTime?
  confirmedAt    DateTime?
  usedAt         DateTime?
  releasedAt     DateTime?
  releaseReason  String?

  @@unique([tenantId, idempotencyKey], map: "rental_service_reservations_idempotency_key")
  @@index([tenantId, orderId, status], map: "rental_service_reservations_order_idx")
  @@index([capacityId, status], map: "rental_service_reservations_capacity_idx")
  @@map("rental_service_reservations")
}

model RentalValueAddedService {
  id                         String                           @id @default(uuid())
  tenantId                   String
  tenant                     Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId                String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                  BusinessWorkspace                @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  categoryCode               RentalCategoryCode
  code                       String
  name                       String
  serviceType                String
  billingUnit                String
  price                      Decimal                          @db.Decimal(12, 2)
  /// MKT-02A：最小可选份数。可重复选择的服务用它表达「至少两份」。
  minimumQuantity            Int                              @default(1)
  maximumQuantity            Int                              @default(1)
  coverageLimit              Decimal?                         @db.Decimal(12, 2)
  deductible                 Decimal?                         @db.Decimal(12, 2)
  /// 条款正文与版本按需求 4.4 随订单保存快照，此处是当前主档。
  termsVersion               String
  terms                      String                           @db.Text
  applicableItemGroupIds     Json
  /// MKT-02A：适用履约方式与地点。空数组＝不限制，与 applicableItemGroupIds 同口径。
  applicableFulfillmentModes Json?
  applicableLocationIds      Json?
  customerScope              String                           @default("all")
  /// MKT-02A：客户可选 / 系统推荐 / 条件强制（需求 4.4.11）。
  selectionMode              String                           @default("optional")
  /// MKT-02A：条件强制服务的触发规则。改变商品、履约方式或金额后必须重新判断，
  /// 因此只存条件本身，不缓存判断结果。
  mandatoryRule              Json?
  /// MKT-02A：第三方保险接入状态，仅 serviceType = insurance 使用。取值只有
  /// simulated / reserved——未接入真实服务商前不得展示已投保或虚构保单号；
  /// 损坏免赔（damage_waiver）配它即冒充保险，服务端拒绝。
  insuranceProviderStatus    String?
  insuranceProviderName      String?
  /// MKT-02B：启用后报价必须提供服务时段与地点，并通过容量检查。
  requiresCapacity           Boolean                          @default(false)
  status                     String                           @default("enabled")
  version                    String
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  versions                   RentalValueAddedServiceVersion[]
  capacities                 RentalServiceCapacity[]
  reservations               RentalServiceReservation[]

  @@unique([workspaceId, code, version], map: "rental_value_added_services_tenant_code_version_key")
  @@unique([tenantId, workspaceId, id], map: "rental_value_added_services_scope_id_key")
  @@index([tenantId, status, serviceType], map: "rental_value_added_services_tenant_status_type_idx")
  @@index([workspaceId, status, selectionMode], map: "rental_value_added_services_selection_idx")
  @@map("rental_value_added_services")
}

/// MKT-02A Review：服务主档保存当前版本；本表只追加保存每次发布的完整不可变事实。
/// 报价与订单仍内联正文快照，避免历史查询依赖主档或版本行继续存在。
model RentalValueAddedServiceVersion {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      BusinessWorkspace       @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  serviceId      String
  service        RentalValueAddedService @relation(fields: [tenantId, workspaceId, serviceId], references: [tenantId, workspaceId, id], onDelete: Restrict)
  serviceVersion String
  termsVersion   String
  snapshot       Json
  createdAt      DateTime                @default(now())

  @@unique([serviceId, serviceVersion], map: "rental_value_added_service_versions_service_version_key")
  @@index([tenantId, workspaceId, serviceId, createdAt], map: "rental_value_added_service_versions_scope_idx")
  @@map("rental_value_added_service_versions")
}

/// RULE-01A：规则版本审计（只追加）。发布、恢复、作废各记一条，含原因、操作者与前后状态。
/// 独立成表而不是挂在版本行上：挂在行上只能留最后一次操作，恢复与作废的历史会被覆盖，
/// 而需求 4.6.14 要求发布与人工覆盖「填写原因并记录完整审计」。
model RentalRuleVersionAudit {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  ruleVersionId String
  ruleVersion   RentalRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  version       String
  /// publish（发布）/ restore（恢复旧版生成新草稿）/ void（作废）/ supersede（被替代）。
  action        String
  fromStatus    String?
  toStatus      String
  reason        String            @db.VarChar(500)
  operator      String?
  at            DateTime
  createdAt     DateTime          @default(now())

  @@index([tenantId, workspaceId, at], map: "rental_rule_version_audits_scope_idx")
  @@index([ruleVersionId, at], map: "rental_rule_version_audits_version_idx")
  @@map("rental_rule_version_audits")
}

model RentalRuleVersion {
  id                  String                   @id @default(uuid())
  tenantId            String
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId         String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace           BusinessWorkspace        @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  categoryCode        RentalCategoryCode
  version             String
  status              String                   @default("draft")
  /// RentalRuleConfig：payment/fulfillment/overdue/cancellation/qualification/damage 六个规则块。
  config              Json
  changeReason        String
  createdBy           String
  /// RULE-01A：规则生效时点。报价按**租期开始时间**匹配覆盖该时点的已发布规则
  /// （需求 4.6.1），因此这是匹配键；靠「唯一一条 published」匹配表达不了未来生效。
  effectiveFrom       DateTime?
  createdAt           DateTime                 @default(now())
  publishedAt         DateTime?
  publishedBy         String?
  supersededAt        DateTime?
  previousVersion     String?
  /// RULE-01A：恢复旧版必须生成**新版本**（需求 4.6.1），这里记它来自哪一版。
  restoredFromVersion String?
  restoreReason       String?
  voidedAt            DateTime?
  voidedBy            String?
  voidReason          String?
  audits              RentalRuleVersionAudit[]

  @@unique([workspaceId, version], map: "rental_rule_versions_tenant_version_key")
  @@index([tenantId, status, publishedAt], map: "rental_rule_versions_tenant_status_published_idx")
  @@index([workspaceId, status, effectiveFrom], map: "rental_rule_versions_effective_idx")
  @@map("rental_rule_versions")
}

/// 公共官方日历来源（需求 4.5.2/4.5.8）。
///
/// 平台级资源，**不属于任何租户**：官方节假日数据是公共基础来源，由 SaaS 平台管理员
/// 维护，不得由经营空间直接导入原始数据、也不得导入后自动影响全部经营空间。
/// 因此这里没有 tenantId/workspaceId——加上它们就等于又把公共数据切回租户私有。
model OfficialCalendarSource {
  id        String   @id @default(uuid())
  /// 目前只有中国大陆；预留以便后续接其他地区的公共假日数据。
  region    String   @default("CN")
  /// 来源机构或文件名，例如「国务院办公厅年度放假通知」。
  name      String
  /// 官方公告地址，必须 HTTPS——来源不可验证的数据不该进入公共来源库。
  url       String
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions OfficialCalendarSourceVersion[]

  @@unique([region, name], map: "official_calendar_sources_region_name_key")
  @@map("official_calendar_sources")
}

/// 公共官方日历的**来源版本**（需求 4.5.2：「官方日历再次调整时必须形成新的来源版本；
/// 已发布的经营空间日历、有效报价和订单不得被静默覆盖」）。
///
/// 只追加：同一来源同一年度的每次调整都新增一行，旧版本保留，供空间日历追溯自己
/// 当初引用的是哪一版官方数据。
model OfficialCalendarSourceVersion {
  id                 String                 @id @default(uuid())
  sourceId           String
  /// Restrict 而非 Cascade：来源版本声明为「只追加、旧版本保留」，若允许级联删除，
  /// 直接删来源就会连带清空全部不可变历史版本，与不可变承诺相悖。来源只能停用，
  /// 仍有版本时不得删除（当前也没有删除来源的 API，这是数据库层的兜底）。
  source             OfficialCalendarSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  year               Int
  /// 来源版本号，由平台按 1.0/1.1… 递增。展示用；排序与并发分配一律用 sequence。
  version            String
  /// 版本序号（1 起）。字符串版本号在 1.10 之后会被字典序排到 1.9 之前，
  /// 因此列表排序与「下一个版本号」分配都用这个整数，并靠唯一键把并发登记挡成冲突。
  sequence           Int
  /// 登记当时的来源信息**快照**。
  ///
  /// 不能在读取历史版本时去 join 来源主档：主档允许改名称、URL、地区，一改就会让
  /// 昨天登记的旧版本显示成新名称、新 URL，租户引用旧版本时也拿到改后的信息——
  /// 与「来源版本不可变、可历史追溯」冲突。主档继续维护，但不得改写历史版本的含义。
  sourceNameSnapshot String
  sourceUrlSnapshot  String
  regionSnapshot     String
  /// 官方公告的发布日期，与导入时间不同：追溯要能区分「官方什么时候发的」与「我们什么时候入的库」。
  publishedAt        DateTime
  importedAt         DateTime               @default(now())
  importedBy         String?
  /// ImportRentalCalendarDayInput[]：该版本的整年官方日期（法定节假日与调休工作日）。
  days               Json
  createdAt          DateTime               @default(now())

  @@unique([sourceId, year, version], map: "official_calendar_source_versions_source_year_version_key")
  /// 并发登记的关口：两个平台管理员同时算出同一个 sequence 时，其中一个必然撞唯一键，
  /// 由服务层转成明确的 409/重试，而不是靠"先查后写"这种在并发下必然出错的时序。
  @@unique([sourceId, year, sequence], map: "official_calendar_source_versions_source_year_sequence_key")
  @@index([year], map: "official_calendar_source_versions_year_idx")
  @@map("official_calendar_source_versions")
}

model RentalBusinessCalendar {
  id                       String            @id @default(uuid())
  tenantId                 String
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId              String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  year                     Int
  region                   String            @default("CN")
  version                  String
  status                   String            @default("draft")
  sourceName               String?
  sourceUrl                String?
  sourcePublishedAt        DateTime?
  /// 引用的公共官方来源版本（需求 4.5.7：发布记录必须保存官方来源版本）。
  /// 只存标识与版本号，不存外键：来源注册表是平台级资源，租户日历行不该在删除
  /// 公共来源时被级联影响——追溯需要的是「当时引用了哪一版」这个事实。
  sourceVersionId          String?
  sourceVersion            String?
  importedAt               DateTime?
  publishedAt              DateTime?
  /// 需求 4.5.7：已发布版本不可原地修改，被取代时只标记，不删除。
  supersededAt             DateTime?
  publishedBy              String?
  changeReason             String?
  previousVersion          String?
  /// 需求 4.5.7「恢复旧规则也必须以旧内容生成新的发布版本，不得删除新版本或把旧版本
  /// 原地改回」。这两列记录本草稿是从哪个历史版本恢复出来的以及恢复原因；
  /// 被恢复的那个版本本身不做任何改动。
  restoredFromVersion      String?
  restoreReason            String?
  /// 作废审计（需求 4.5.7）。只有草稿可作废；记录时间、操作人与原因。
  voidedAt                 DateTime?
  voidedBy                 String?
  voidReason               String?
  /// RentalCalendarPublishDiff：发布时相对上一已发布版本的日期差异（新增/移除/变更）。
  /// 发布当时算好存下——事后重算要求被替代的旧版本仍能被定位，而追溯往往只有版本号。
  publishDiff              Json?
  /// RentalCalendarOverrideAudit[]：人工覆盖与撤销的审计流水（需求 4.5.3）。
  /// 不写回当天：撤销后该日期已不是人工覆盖，把撤销原因留在那一行会自相矛盾。
  overrideAudits           Json?
  /// String[]：最近一次官方导入中因存在人工覆盖而未写入的日期。
  /// 导入不覆盖人工覆盖，但运营必须知道官方改了这几天而覆盖仍然生效。
  importPreservedOverrides Json?
  /// RentalCalendarDay[]：整年按日的类型、倍率与停业标记。定价按年整体加载，
  /// 拆成每年 365 行没有查询收益，因此保留为该年配置行的明细。
  days                     Json
  /// 乐观锁版本号（并发编辑保护）。整年日期在同一个 JSON 字段里，两个编辑人同时改
  /// 不同日期都会复制全年再写回，后写者会整体覆盖先写者。写入以「读到的 revision」
  /// 为条件，不匹配即 409。version 解决不了这件事：同一草稿内连续编辑共用一个版本号。
  revision                 Int               @default(0)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  /// 需求 4.5.7：同一年度要同时容纳草稿、已发布与已被替代的多个版本，
  /// 因此唯一键必须含 version。原键 (workspaceId, year) 只允许一行，
  /// 结构上就无法保留历史版本，也逼得"编辑已发布日历"只能原地改。
  @@unique([workspaceId, year, version], map: "rental_business_calendars_ws_year_version_key")
  @@index([workspaceId, year, status], map: "rental_business_calendars_ws_year_status_idx")
  @@index([tenantId, status])
  @@map("rental_business_calendars")
}

/// 人工覆盖与撤销的审计流水（需求 4.5.3 + 4.5.8「完整审计」）。
///
/// 为什么必须独立成表：早前这些记录塞在年度日历行的 `overrideAudits` JSON 里，
/// 而 JSON 会随整年日历一起被反复重写，实现只能靠 `slice(-500)` 截断，
/// 最早的记录被静默删除——与「完整审计」直接冲突。审计是**只追加**的事实，
/// 不属于年度日历这份可变配置，因此按条落行、永不改写、永不截断。
model RentalCalendarOverrideAuditEntry {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId String
  /// 复合外键保证空间与事实同租户，杜绝把审计挂到别的租户的空间上。
  workspace   BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  year        Int
  /// 记录发生在哪一个年度版本上，供版本详情按版本回放。
  version     String
  /// 被调整的营业日期，`YYYY-MM-DD`。
  date        String
  /// `override` 建立人工覆盖 / `revert` 撤销人工覆盖。
  action      String
  reason      String            @db.Text
  operator    String?
  at          DateTime
  /// RentalCalendarDaySnapshot：调整前后的取值，供差异回放。
  before      Json?
  after       Json?
  /// 范围覆盖的批次标识（需求 4.5.9：一次范围提交共用原因/操作者/时间/批次）。
  /// 单日编辑为 NULL。同一批次的日期各落一行，批次号把回放聚合成一次操作。
  batchId     String?
  createdAt   DateTime          @default(now())

  @@index([workspaceId, year, version])
  @@index([workspaceId, year, date])
  @@index([tenantId, year])
  @@map("rental_calendar_override_audits")
}

model RentalNotificationTemplate {
  id                   String                  @id @default(uuid())
  tenantId             String
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId          String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace            BusinessWorkspace       @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  eventCode            String
  channel              String
  name                 String
  title                String
  body                 String                  @db.Text
  /// 短信服务商模板编码。模板正文仍由本系统保存，编码只用于实际投递。
  providerTemplateCode String?
  variableSchema       Json
  status               String                  @default("enabled")
  version              String
  logs                 RentalNotificationLog[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([workspaceId, eventCode, channel, version], map: "rental_notification_templates_tenant_event_channel_ver_key")
  @@index([tenantId, status, eventCode], map: "rental_notification_templates_tenant_status_event_idx")
  @@map("rental_notification_templates")
}

// Rental Core 事实表（RC-01）------------------------------------------------
// 事实完整规范化为真实列。仅 request/chargeLines/ruleSnapshot/variables 等
// 需求要求的不可变时点快照保留 JSON（需求 4.7）。

model RentalQuote {
  /// 可选服务器原操作绑定；存量无证据不回填，不向客户端报价DTO透传。
  originalOperationKey           String? @db.VarChar(64)
  originalInputHash              String? @db.VarChar(64)
  /// 报价实际采用的品类版本，不回填无法证明的存量。
  categoryVersionId             String?                        @db.VarChar(191)
  categoryVersion               RentalCategoryVersion?         @relation(fields: [categoryCode, categoryVersionId], references: [categoryCode, id], onDelete: Restrict)
  /// 原价续租所需的报价时区、倍率开关与计价日历。
  pricingContext                Json?
  id                            String             @id @default(uuid())
  tenantId                      String
  tenant                        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId                   String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                     BusinessWorkspace  @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  quoteNo                       String
  categoryCode                  RentalCategoryCode
  /// RentalQuoteRequest：报价入参原样留存，用于下单时比对与复算。
  request                       Json
  /// 新会员体系：由服务端解析的预约身份、企业关系和权益快照。
  membershipSnapshot            Json?
  /// 会员方案本次实际生效、跳过与金额分摊的不可变结果；确认下单时同步拷进订单。
  membershipBenefitEvaluations  Json?
  /// RentalQuoteChargeLine[]：费用行明细，是报价可解释性的依据。
  chargeLines                   Json
  rentalAmount                  Decimal            @db.Decimal(12, 2)
  discountAmount                Decimal            @db.Decimal(12, 2)
  couponAmount                  Decimal            @db.Decimal(12, 2)
  serviceAmount                 Decimal            @db.Decimal(12, 2)
  /// 履约费用合计（需求 4.4 公式的独立一项）。存量报价按 0 回填。
  fulfillmentAmount             Decimal            @default(0) @db.Decimal(12, 2)
  depositAmount                 Decimal            @db.Decimal(12, 2)
  /// 预授权额度。需求 4.4.7 起与 depositAmount **独立**，可同时非零（收押金且冻结额度）。
  preAuthAmount                 Decimal            @default(0) @db.Decimal(12, 2)
  payableAmount                 Decimal            @db.Decimal(12, 2)
  /// 本次实收 = 租赁应付 + 应付押金（需求 4.4.1）。预授权额度不计入。
  receivableAmount              Decimal            @default(0) @db.Decimal(12, 2)
  /// 价内税税率与按 payableAmount 反算的税额（押金不计税）。规则未配税时为 0。
  taxRate                       Decimal            @default(0) @db.Decimal(6, 4)
  taxAmount                     Decimal            @default(0) @db.Decimal(12, 2)
  /// 结算币种快照（需求 §948）。取报价时经营空间的币种。
  currency                      String             @default("CNY") @db.VarChar(8)
  /// 存量「押金/预授权混在 depositAmount」的记录中，无法从规则快照可靠判定归属的那些。
  /// 只由纠正迁移置位、应用写入不碰它：金额归属未确认前，该笔不得计入 receivableAmount，
  /// 需要财务人工确认后再定性。为 false 表示归属已明确（或本就是新口径记录）。
  legacyDepositUnverified       Boolean            @default(false)
  /// 无法判定归属的存量保证金额原值；待财务确认前不进入押金、预授权或本次实收。
  legacyDepositUnverifiedAmount Decimal            @default(0) @db.Decimal(12, 2)
  pricingPlanVersion            String
  /// RentalPricingRate[]：本次报价实际命中的费率，使复算不依赖计划仍以该版本存在。
  /// 存量报价按空数组回填——它们当时确实没有保存费率，空数组是如实记录而非猜测。
  rateSnapshot                  Json?
  ruleVersion                   String
  ruleSnapshot                  Json
  /// 报价时启用的完整取还检查模板；空数组与历史无证据 NULL 分开。
  inspectionTemplateSnapshots   Json?
  calendarVersion               String?
  /// RentalQuoteCalendarDay[]：命中营业日期的结构化依据（需求 4.5.6）。
  /// 可空且不回填：存量报价只存了拼接的 calendarVersion，其中没有逐日信息，
  /// 无法反推类型、状态与实际价格；留 NULL 是如实记录"当时没有"。
  calendarSnapshot              Json?
  /// string[]：命中年度里官方日历尚未确认的提示（需求 4.5.2）。可空且不回填：
  /// 存量报价按当时口径生成，无法回填出"当时是否提示过"，编造一个会误导追溯。
  calendarWarnings              Json?
  appliedDiscountPlanIds        Json
  /// MKT-01A：逐优惠方案的评估结论（已应用/未应用及原因、基数、公式、版本、空间）。
  /// 随报价固化：方案后续改配置、调优先级或停用都不得改变这张报价的解释。
  discountEvaluations           Json?
  /// MKT-02A：命中的增值服务快照（服务、价格、单位数、资格判据、条款正文与版本）。
  /// 服务后续改价、改条款或停用都不得改变这张报价与由它下单的订单。
  serviceSnapshots              Json?
  /// MKT-01B：报价实际命中的客户券权益与计算过程；模板后续修改不得改变历史报价。
  couponEvaluation              Json?
  /// CORE-EXT-02D：RentalWorkspaceCapabilitySnapshotEntry[]。报价生成时已启用能力的版本快照，
  /// 下单时拷进订单。可空：存量报价没有这份快照，留 NULL 是如实记录"当时没有"。
  capabilitySnapshot            Json?
  /// Review P1-5：RentalCapabilityDecisionSnapshot[]。报价阶段的兼容性判断记录，
  /// 含风险代码、提示、证据与费用依据；下单时被引用。
  capabilityDecisions           Json?
  /// PRICE-03：报价命中的不可变价格版本（空间级）。可空：存量报价无此事实，不回填。
  priceVersionId                String?
  priceVersion                  String?
  customerCouponId              String?
  expiresAt                     DateTime
  consumedAt                    DateTime?
  consumedOrderId               String?
  createdAt                     DateTime           @default(now())

  @@unique([workspaceId, quoteNo], map: "rental_quotes_tenant_quote_no_key")
  @@unique([tenantId, workspaceId, originalOperationKey], map: "rental_quotes_original_operation_key")
  @@index([tenantId, expiresAt, consumedAt], map: "rental_quotes_tenant_expires_consumed_idx")
  @@index([consumedOrderId])
  @@map("rental_quotes")
}

model RentalCustomerCoupon {
  id                         String               @id @default(uuid())
  tenantId                   String
  tenant                     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId                String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                  BusinessWorkspace    @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  customerId                 String
  templateId                 String
  template                   RentalCouponTemplate @relation(fields: [templateId], references: [id])
  /// 模板编码与名称存为领取时快照，模板改名不影响已发出的券。
  templateCode               String
  templateName               String
  /// MKT-01B：发放当时的模板版本，供券指回它固化的那一版配置。
  templateVersion            String
  /// MKT-01B：发放时固化的权益快照。模板后续改面值、暂停或结束都不得改变已发券
  /// （需求 4.4.10）。报价计算一律读这里，不回读模板。
  discountType               String
  discountValue              Decimal              @db.Decimal(12, 2)
  minimumSpend               Decimal              @db.Decimal(12, 2)
  maximumDiscount            Decimal?             @db.Decimal(12, 2)
  appliesTo                  String               @default("rental")
  stackableWithDiscountPlans Boolean              @default(true)
  applicableItemGroupIds     Json
  /// MKT-01B：发放原因（系统事件、运营定向、客户领取、奖励发放等）。
  grantReason                String
  status                     String               @default("claimed")
  claimedAt                  DateTime             @default(now())
  applicableRentalFrom       DateTime?
  applicableRentalTo         DateTime?
  effectiveFrom              DateTime
  effectiveTo                DateTime
  lockedOrderId              String?
  lockedAt                   DateTime?
  /// MKT-01B：锁定时预占的优惠金额。释放按它退还预算，不按「当前重算值」退，
  /// 否则价格或规则变动后预算会漂移。
  lockedDiscountAmount       Decimal?             @db.Decimal(12, 2)
  redeemedOrderId            String?
  redeemedAt                 DateTime?
  releasedAt                 DateTime?
  releaseReason              String?
  expiredAt                  DateTime?
  voidedAt                   DateTime?
  voidReason                 String?

  @@index([tenantId, customerId, status], map: "rental_customer_coupons_tenant_customer_status_idx")
  @@index([tenantId, templateId, customerId], map: "rental_customer_coupons_tenant_template_customer_idx")
  @@index([lockedOrderId])
  @@index([redeemedOrderId])
  @@index([tenantId, templateId, status], map: "rental_customer_coupons_template_status_idx")
  @@map("rental_customer_coupons")
}

model RentalRewardLedgerEntry {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId         String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace           BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  customerId          String
  rewardType          String
  amount              Decimal           @db.Decimal(12, 2)
  triggerType         String
  /// 业务幂等键：同一租户同一键只允许入账一次，防重复发奖。
  idempotencyKey      String
  relatedCustomerId   String?
  status              String            @default("granted")
  reason              String
  benefitReferenceIds Json?
  appliedAt           DateTime?
  reversedAt          DateTime?
  createdAt           DateTime          @default(now())

  @@unique([workspaceId, idempotencyKey], map: "rental_reward_ledger_tenant_idempotency_key")
  @@index([tenantId, customerId, createdAt], map: "rental_reward_ledger_tenant_customer_created_idx")
  @@index([tenantId, triggerType, status], map: "rental_reward_ledger_tenant_trigger_status_idx")
  @@map("rental_reward_ledger_entries")
}

model RentalBenefitAccount {
  tenantId                   String
  tenant                     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId                String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace                  BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  customerId                 String
  /// SPACE-04：**刻意不加**到 customer_profiles 的外键。
  ///
  /// 原因：rental 域的 customerId 目前是自由标识（grantReward 等接口不校验客户存在，
  /// 注册奖励可以发给一个尚未建档的 customerId）。加外键会让这些既有路径直接 500，
  /// 而唯一的修好办法是从任意 customerId 自动补建客户主档——那等于凭空编造
  /// 身份数据，需求没有授权，也违背「共享客户主档是唯一身份来源」的本意。
  ///
  /// 正确做法是先让 rental 域改为引用共享主档（属 CUSTOMER-01 的范围），再加约束。
  /// 在此之前保持无外键，避免用一个更差的实现去满足一条约束。
  pointsBalance              Decimal           @default(0) @db.Decimal(12, 2)
  /// 营销余额不是可提现或储值资金账户（需求 4.8）。
  marketingBalance           Decimal           @default(0) @db.Decimal(12, 2)
  availableRewardCouponCount Int               @default(0)
  updatedAt                  DateTime          @updatedAt

  @@id([workspaceId, customerId])
  @@index([tenantId, customerId], map: "rental_benefit_accounts_tenant_customer_idx")
  @@map("rental_benefit_accounts")
}

model RentalReferral {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId        String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace          BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  inviteeCustomerId  String
  referrerCustomerId String
  registeredAt       DateTime          @default(now())

  @@unique([workspaceId, inviteeCustomerId], map: "rental_referrals_tenant_invitee_key")
  @@index([tenantId, referrerCustomerId], map: "rental_referrals_tenant_referrer_idx")
  @@map("rental_referrals")
}

model RentalNotificationLog {
  id                   String                     @id @default(uuid())
  tenantId             String
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId          String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace            BusinessWorkspace          @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  templateId           String
  template             RentalNotificationTemplate @relation(fields: [templateId], references: [id])
  templateVersion      String
  eventCode            String
  channel              String
  /// 发送目标按需求 4.9 脱敏后留存。
  recipient            String
  /// 真实短信重试所需的收件人密文；AES-GCM 加密，绝不返回给管理端。
  recipientEncrypted   String?                    @db.Text
  /// EXT-02：用于服务端频率限制的不可逆 HMAC 指纹，不返回给管理端。
  recipientFingerprint String?                    @db.Char(64)
  renderedTitle        String
  renderedBody         String                     @db.Text
  variables            Json
  status               String                     @default("queued")
  revision             Int                        @default(1) @db.UnsignedInt
  aiFailureEvents      AiBusinessFailureOutbox[]  @relation("AiFailureNotification")
  provider             String
  providerMessageId    String?
  errorMessage         String?
  attempts             Int                        @default(0)
  /// 真实短信投递的下一次重试时间；NULL 表示当前不可重试或已完成。
  nextAttemptAt        DateTime?
  lastAttemptAt        DateTime?
  /// 投递租约到期时间：认领时写入且不消耗 attempts；进程崩溃后租约到期即可再次认领。
  /// attempts 只在记录投递结果时递增，因此崩溃不会吃掉重试次数。
  leaseUntil           DateTime?
  maxAttempts          Int                        @default(3)
  /// NOTICE-01A：触发本条通知的业务对象（如 order / <订单id>）。
  /// 手工发送没有业务对象，因此可空。
  businessObjectType   String?
  businessObjectId     String?
  /// NOTICE-01A：空间级幂等键，形如 `<eventCode>:<businessObjectId>`。
  /// 由业务事件驱动的通知带键，手工发送不带（NULL）。MySQL 唯一索引对 NULL
  /// 互不冲突，因此手工发送不受去重约束，而同一业务事件重放不会二次落库。
  idempotencyKey       String?
  sentAt               DateTime?
  createdAt            DateTime                   @default(now())

  @@unique([tenantId, workspaceId, id], map: "rental_notification_logs_scope_id_key")
  @@unique([workspaceId, idempotencyKey], map: "rental_notification_logs_ws_idempotency_key")
  @@index([tenantId, eventCode, createdAt], map: "rental_notification_logs_tenant_event_created_idx")
  @@index([tenantId, status, createdAt], map: "rental_notification_logs_tenant_status_created_idx")
  @@index([templateId])
  @@index([tenantId, workspaceId, status, nextAttemptAt], map: "rental_notification_logs_ws_retry_idx")
  @@index([tenantId, workspaceId, channel, recipientFingerprint, createdAt], map: "rental_notification_logs_sms_rate_idx")
  @@map("rental_notification_logs")
}

/// EXT-02：短信发送频率桶。只保存不可逆收件人指纹，不保存手机号明文。
/// 固定时间桶由服务端原子递增，避免单个租户或手机号在重试/事件重放时打爆供应商。
model RentalNotificationRateBucket {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  scopeKey    String            @db.VarChar(128)
  bucketStart DateTime
  count       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([tenantId, workspaceId, scopeKey, bucketStart], map: "rental_notification_rate_bucket_key")
  @@index([tenantId, workspaceId, bucketStart], map: "rental_notification_rate_bucket_scope_idx")
  @@map("rental_notification_rate_buckets")
}

/// RC-04：通用租赁订单动作的业务幂等记录。
///
/// 为什么不复用 `OrderIdempotencyRecord`：那张表的 orderId 外键指向历史单品类订单实体，
/// 承载不了 Rental Core 订单；改成双引用会造出双事实源表结构，与 RC-05「停止双事实源扩张」相悖。
/// 旧表留给历史数据，等 RC-05 收口。
model RentalOrderIdempotencyRecord {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId    String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace      BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  /// 订单创建时订单还不存在，因此可空；创建成功后回填，供按单追溯。
  orderId        String?
  order          RentalOrder?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action         String
  idempotencyKey String
  /// 请求体指纹。同键但不同请求体属于调用方错误，必须报冲突而不是返回上一次的结果——
  /// 否则「改了金额重发同一个键」会静默拿到旧订单。
  requestHash    String
  status         String            @default("succeeded")
  /// 首次成功的响应快照，重复请求据此原样返回，不重新推进状态。
  response       Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([workspaceId, action, idempotencyKey], map: "rental_idempotency_tenant_action_key")
  @@index([tenantId, orderId, action], map: "rental_idempotency_tenant_order_action_idx")
  @@map("rental_order_idempotency_records")
}

// ===========================================================================
// SUB-01B：SaaS 版本订阅与 PRO 升级专项 — 数据层（枚举 + 模型）。
// 枚举值字符串必须与 packages/shared/src/subscription.ts 只读契约一致；
// 服务状态不落库，由 startAt/endAt 实时推导（§2/§4.2）。金额一律可空并独立带
// 币种（VarChar(8)），缺失表示"待确认/待公布"，不退化为 0/默认（§14.2）。
// ===========================================================================

/// 系统版本：对外只有基础版/PRO 两个（§2）。
enum SubscriptionPlan {
  STANDARD @map("standard")
  PRO      @map("pro")
}

/// 当前套餐来源（§4.1/§7.4）。
enum SubscriptionSource {
  SALE                @map("sale")
  PILOT               @map("pilot")
  HISTORICAL_REGISTER @map("historical_register")
  TEMP_EXTENSION      @map("temp_extension")
}

/// 期限分段状态：当前段/待生效段/历史段（§4.1）。与服务状态分离，不烘进版本。
enum SubscriptionSegmentStatus {
  CURRENT    @map("current")
  SCHEDULED  @map("scheduled")
  HISTORICAL @map("historical")
}

/// 功能目录上线状态（§3.3）。
enum FeatureReleaseStatus {
  PLANNED  @map("planned")
  PILOT    @map("pilot")
  RELEASED @map("released")
  PAUSED   @map("paused")
  RETIRED  @map("retired")
}

/// 功能默认/当前归属（§3.3）；仅用于规划展示，不在业务逻辑硬编码 PRO。
enum FeatureOwnership {
  STANDARD @map("standard")
  PRO      @map("pro")
}

/// 升级/续费申请类型（§7.2）。
enum SubscriptionRequestType {
  UPGRADE_PRO     @map("upgrade_pro")
  RENEW_STANDARD  @map("renew_standard")
  RENEW_PRO       @map("renew_pro")
  UPGRADE_CONSULT @map("upgrade_consult")
  NEXT_STANDARD   @map("next_standard")
  NO_RENEW        @map("no_renew")
}

/// 申请状态（§7.3）；不设"报价中/等待接受"等额外状态。
enum SubscriptionRequestStatus {
  PENDING   @map("pending")
  PROCESSED @map("processed")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")
}

/// 订阅审计事件类型（§5.2「订阅变更记录」）；平台级目录/价格/公共下放事件租户可空。
enum SubscriptionEventType {
  PROVISION       @map("provision")
  UPGRADE         @map("upgrade")
  RENEW           @map("renew")
  DOWNGRADE       @map("downgrade")
  TEMP_EXTENSION  @map("temp_extension")
  TERM_CORRECTION @map("term_correction")
  PUBLIC_GRANT    @map("public_grant")
  PUBLIC_REVOKE   @map("public_revoke")
  TENANT_GRANT    @map("tenant_grant")
  TENANT_REVOKE   @map("tenant_revoke")
  CATALOG_UPDATE  @map("catalog_update")
  PRICE_UPDATE    @map("price_update")
}

/// 租户当前订阅（单例，tenantId 唯一）。统一起止 [startAt, endAt) 半开区间（§4.1）；
/// 服务状态不落库，由 startAt/endAt + 当前时间实时推导。缺失日期=待平台确认，非永久（§4.6）。
model TenantSubscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revision           Int                @default(1)
  plan               SubscriptionPlan
  source             SubscriptionSource
  startAt            DateTime?
  endAt              DateTime?
  /// 服务时区（IANA）；不随经营空间切换（§4.1.3）。
  serviceTimeZone    String?            @db.VarChar(64)
  billingAnniversary DateTime?
  /// 本期确认金额；null=待确认，不落 0（§5.2/§14.2）。
  currentAmount      Decimal?           @db.Decimal(12, 2)
  currentCurrency    String?            @db.VarChar(8)
  currentTaxInclusive Boolean?
  sourceReason       String?            @db.VarChar(512)
  handledAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("tenant_subscriptions")
}

/// 订阅期限分段（当前/待生效/历史），支撑续费、降级排期与历史追溯（§4.1/§4.2）。
model TenantSubscriptionSegment {
  id        String                    @id @default(uuid())
  tenantId  String
  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    SubscriptionSegmentStatus
  plan      SubscriptionPlan
  source    SubscriptionSource
  startAt   DateTime?
  endAt     DateTime?
  amount    Decimal?                  @db.Decimal(12, 2)
  currency  String?                   @db.VarChar(8)
  taxInclusive Boolean?
  billingAnniversary DateTime?
  reason    String?                   @db.VarChar(512)
  createdAt DateTime                  @default(now())

  @@index([tenantId, status])
  @@map("tenant_subscription_segments")
}

/// 专业功能目录（平台级，非租户特定）：版本归属、适用品类、上线状态、外部费用与启用前提（§3.3/§6）。
model SubscriptionFeatureCatalog {
  code             String               @id
  name             String
  module           String
  /// 适用品类编码数组（JSON）。
  categories       Json
  defaultOwnership FeatureOwnership
  currentOwnership FeatureOwnership
  releaseStatus    FeatureReleaseStatus @default(PLANNED)
  valueText        String?              @db.Text
  prerequisiteText String?              @db.Text
  /// 外部/按量费用说明；另计不自动扣费（§3.3/§14.2 S-D09）。
  externalFeeNote  String?              @db.Text
  contentVersion   String?              @db.VarChar(64)
  effectiveAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("subscription_feature_catalog")
}

/// 租户级功能特批授权（§3.5「tenant_specific」）：不要求整体升级 PRO，不改统一有效期。
model TenantFeatureGrant {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureCode   String
  effectiveAt   DateTime  @default(now())
  operator      String?   @db.VarChar(191)
  reason        String?   @db.VarChar(512)
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())

  @@unique([tenantId, featureCode])
  @@index([tenantId])
  @@map("tenant_feature_grants")
}

/// 升级/续费/咨询申请与办理记录（§7）。dedupeKey 按租户去重同类未关闭申请。
model SubscriptionRequest {
  id              String                    @id @default(uuid())
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            SubscriptionRequestType
  targetPlan      SubscriptionPlan?
  status          SubscriptionRequestStatus @default(PENDING)
  contactName     String?                   @db.VarChar(120)
  contactPhone    String?                   @db.VarChar(32)
  /// 意向模块/品类（JSON）。
  moduleIntent    Json?
  note            String?                   @db.Text
  /// 处理过程时间线（JSON 数组 {at,status,note}）。
  timeline        Json?
  publicReason    String?                   @db.VarChar(512)
  dedupeKey       String
  /// 实际办理金额；null=未办理/待确认，不落 0（§14.2）。
  handledAmount   Decimal?                  @db.Decimal(12, 2)
  handledCurrency String?                   @db.VarChar(8)
  handledTaxInclusive Boolean?
  linkedEventId   String?                   @db.VarChar(191)
  periodText      String?                   @db.VarChar(191)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
  @@map("subscription_requests")
}

/// 订阅审计事件（只追加，不更新/删除）。平台级目录/价格/公共下放事件 tenantId 可空。
model SubscriptionEvent {
  id           String                @id @default(uuid())
  tenantId     String?
  tenant       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         SubscriptionEventType
  beforeJson   Json?
  afterJson    Json?
  amount       Decimal?              @db.Decimal(12, 2)
  currency     String?               @db.VarChar(8)
  handlingNote String?               @db.Text
  reason       String?               @db.VarChar(512)
  operator     String?               @db.VarChar(191)
  effectiveAt  DateTime?
  createdAt    DateTime              @default(now())

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@map("subscription_events")
}

/// 标准套餐年费（平台级，每版一条）。未发布显示"价格待公布"，不落 0/虚构原价（§5.2/§14.2 S-D01）。
model SubscriptionStandardPrice {
  id           String           @id @default(uuid())
  plan         SubscriptionPlan @unique
  annualFee    Decimal?         @db.Decimal(12, 2)
  currency     String?          @db.VarChar(8)
  taxInclusive Boolean?
  published    Boolean          @default(false)
  priceVersion String?          @db.VarChar(64)
  note         String?          @db.Text
  updatedAt    DateTime         @updatedAt

  @@map("subscription_standard_prices")
}

// AIN-03/S01: additive metadata only. CHECK constraints live in the paired migration.
// No provider credentials, chat body or business facts are stored here; references reauthorize on read.
enum AiScopeKind {
  PLATFORM  @map("platform")
  TENANT    @map("tenant")
  WORKSPACE @map("workspace")
}

enum AiAudience {
  OPERATOR   @map("operator")
  STAFF      @map("staff")
  CLIENT     @map("client")
  AUTOMATION @map("automation")
}

enum AiActorKind {
  SAAS_ADMIN @map("saas_admin")
  USER       @map("user")
  CUSTOMER   @map("customer")
  AUTOMATION @map("automation")
}

enum AiTaskStatus {
  QUEUED               @map("queued")
  RUNNING              @map("running")
  WAITING_INPUT        @map("waiting_input")
  WAITING_CONFIRMATION @map("waiting_confirmation")
  WAITING_EXTERNAL     @map("waiting_external")
  CANCEL_REQUESTED     @map("cancel_requested")
  SUCCEEDED            @map("succeeded")
  PARTIALLY_SUCCEEDED  @map("partially_succeeded")
  FAILED               @map("failed")
  CANCELLED            @map("cancelled")
}

enum AiStepStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  UNKNOWN   @map("unknown")
  CANCELLED @map("cancelled")
}

enum AiStepEffect {
  NONE      @map("none")
  POSSIBLE  @map("possible")
  COMMITTED @map("committed")
}

enum AiProposalStatus {
  PENDING_CONFIRMATION @map("pending_confirmation")
  CONFIRMED            @map("confirmed")
  SUPERSEDED           @map("superseded")
  CANCELLED            @map("cancelled")
  EXPIRED              @map("expired")
}

enum AiApprovalDecision {
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum AiApprovalConsumptionStatus {
  RESERVED         @map("reserved")
  COMMITTED        @map("committed")
  UNKNOWN          @map("unknown")
  FAILED_NO_EFFECT @map("failed_no_effect")
}

enum AiTaskOriginalRequestStatus {
  STORED  @map("stored")
  REVOKED @map("revoked")
}

/// Creation input is immutable; expiry/revocation never deletes the task or business receipt.
model AiTaskOriginalRequest {
  id                       String @id @default(uuid()) @db.VarChar(36)
  scopeId                  String @db.VarChar(36)
  audience                 AiAudience
  ownerKind                AiActorKind
  ownerId                  String @db.VarChar(191)
  contractVersion          String @db.VarChar(64)
  sceneCode                String @db.VarChar(64)
  sceneVersion             String @db.VarChar(64)
  requestKey               String @db.VarChar(128)
  revision                 Int @db.UnsignedInt
  payload                  Json
  contentHash              String @db.Char(64)
  authorizationBindingHash String @db.Char(64)
  policyRevision           Int @db.UnsignedInt
  policyHash               String @db.Char(64)
  previousRequestId        String? @db.VarChar(36)
  status                   AiTaskOriginalRequestStatus @default(STORED)
  expiresAt                DateTime @db.DateTime(3)
  createdAt                DateTime @default(now()) @db.DateTime(3)
  scope                    AiScope @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previous                 AiTaskOriginalRequest? @relation("OriginalRequestVersions", fields: [scopeId, previousRequestId], references: [scopeId, id], onDelete: Restrict, onUpdate: Restrict)
  reissues                 AiTaskOriginalRequest[] @relation("OriginalRequestVersions")
  quoteSelections          AiTaskQuoteSelection[]

  @@unique([scopeId, id], map: "ai_original_requests_scope_id")
  @@unique([scopeId, audience, ownerKind, ownerId, requestKey], map: "ai_original_requests_request_key")
  @@index([scopeId, audience, ownerKind, ownerId, createdAt], map: "ai_original_requests_owner")
  @@map("ai_task_original_requests")
}

/// Human quote choice is not approval; payload is immutable after selection.
model AiTaskQuoteSelection {
  id                       String @id @default(uuid()) @db.VarChar(36)
  scopeId                  String @db.VarChar(36)
  taskId                   String @db.VarChar(36)
  runId                    String @db.VarChar(36)
  originalRequestId        String @db.VarChar(36)
  originalInputHash        String @db.Char(64)
  audience                 AiAudience
  ownerKind                AiActorKind
  ownerId                  String @db.VarChar(191)
  contractVersion          String @db.VarChar(64)
  selectionKey             String @db.VarChar(128)
  revision                 Int @db.UnsignedInt
  quoteId                  String @db.VarChar(191)
  quoteHash                String @db.Char(64)
  quoteBasis               Json
  payload                  Json
  inputHash                String @db.Char(64)
  selectionFingerprint     String @db.Char(64)
  authorizationBindingHash String @db.Char(64)
  expiresAt                DateTime @db.DateTime(3)
  createdAt                DateTime @default(now()) @db.DateTime(3)
  supersededAt             DateTime? @db.DateTime(3)
  original                 AiTaskOriginalRequest @relation(fields: [scopeId, originalRequestId], references: [scopeId, id], onDelete: Restrict, onUpdate: Restrict)
  run                      AiRun @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scopeId, audience, ownerKind, ownerId, selectionKey], map: "ai_quote_selection_key")
  @@unique([scopeId, taskId, runId, revision], map: "ai_quote_selection_revision")
  @@index([scopeId, taskId, runId, supersededAt], map: "ai_quote_selection_active")
  @@map("ai_task_quote_selections")
}

/// Explicit scope root; nulls are only legal in the branches enforced by the migration.
model AiScope {
  id          String             @id @default(uuid()) @db.VarChar(36)
  kind        AiScopeKind
  /// Canonical length-prefixed ASCII key; never a caller-selected capability.
  scopeKey    String             @unique(map: "ai_scopes_key") @db.VarChar(512)
  tenantId    String?
  workspaceId String?
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace   BusinessWorkspace? @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  tasks       AiTask[]
  profiles    AiProviderProfile[]
  budgetPolicies AiBudgetPolicy[]
  taskPlanPolicies AiTaskPlanPolicy[]
  originalRequests AiTaskOriginalRequest[]
  automationManagementGrants AiAutomationManagementGrant[]
  automationPolicyPreparations AiAutomationPolicyPreparation[]
  automationPolicyManagementOperations AiAutomationPolicyManagementOperation[]
  automationInputs AiAutomationInput[]
  createdAt   DateTime           @default(now()) @db.DateTime(3)

  @@unique([id, tenantId, workspaceId], map: "ai_scopes_id_workspace_key")
  @@unique([id, kind], map: "ai_scopes_id_kind")
  @@index([tenantId, workspaceId], map: "ai_scopes_tenant_workspace")
  @@map("ai_scopes")
}

/// Owner IDs are audit references, not permanent authorization; AIN-04 resolves the live subject.
model AiTask {
  id                  String          @id @default(uuid()) @db.VarChar(36)
  scopeId             String          @db.VarChar(36)
  scopeKind           AiScopeKind
  scope               AiScope         @relation(fields: [scopeId, scopeKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  audience            AiAudience
  ownerKind           AiActorKind
  ownerId             String          @db.VarChar(191)
  policyId            String?         @db.VarChar(191)
  policyRevision      Int?            @db.UnsignedInt
  policyExpiresAt     DateTime?       @db.DateTime(3)
  contractVersion     String          @db.VarChar(64)
  sceneCode           String          @db.VarChar(128)
  sceneVersion        String          @db.VarChar(64)
  traceId             String          @db.VarChar(191)
  status              AiTaskStatus    @default(QUEUED)
  revision            Int             @default(1) @db.UnsignedInt
  /// Allocated with the task mutation transaction; never expose a global cross-tenant sequence.
  eventCursor         BigInt          @default(0) @db.UnsignedBigInt
  inputRef            String?         @db.VarChar(191)
  /// Frozen creation input evidence; nullable only for tasks written before this migration.
  inputRevision       Int?            @db.UnsignedInt
  inputHash           String?         @db.Char(64)
  creationKey         String?         @db.VarChar(128)
  creationFingerprint String?         @db.Char(64)
  resultRef           String?         @db.VarChar(191)
  cancelRequestedAt   DateTime?       @db.DateTime(3)
  /// Hide conversation metadata without cascading into approvals or business records.
  archivedAt          DateTime?       @db.DateTime(3)
  createdAt           DateTime        @default(now()) @db.DateTime(3)
  updatedAt           DateTime        @updatedAt @db.DateTime(3)
  runs                AiRun[]
  steps               AiStep[]
  proposals           AiProposal[]
  events              AiTaskEvent[]
  executionBudget     AiTaskExecutionBudget?
  actionPolicies      AiTaskActionPolicy[]
  automationInputs    AiAutomationInput[]
  automationReviewOperations AiAutomationReviewOperation[]

  @@unique([scopeId, id], map: "ai_tasks_scope_id")
  @@unique([scopeId, id, ownerKind], map: "ai_tasks_scope_actor_kind")
  @@unique([scopeId, audience, ownerKind, ownerId, creationKey], map: "ai_tasks_creation_key")
  @@index([traceId], map: "ai_tasks_trace")
  @@index([scopeId, audience, ownerKind, ownerId, createdAt], map: "ai_tasks_owner")
  @@index([scopeId, status, updatedAt], map: "ai_tasks_status")
  @@map("ai_tasks")
}

/// A run is a lease/attempt, not a new business action or a new budget allowance.
model AiRun {
  id                String       @id @default(uuid()) @db.VarChar(36)
  scopeId           String       @db.VarChar(36)
  taskId            String       @db.VarChar(36)
  task              AiTask       @relation(fields: [scopeId, taskId, actorKind], references: [scopeId, id, ownerKind], onDelete: Restrict, onUpdate: Restrict)
  /// Effective principal is distinct from the process holding the lease; this is audit, not durable permission.
  actorKind         AiActorKind
  actorId           String       @db.VarChar(191)
  authorizedAt      DateTime     @db.DateTime(3)
  sequence          Int          @db.UnsignedInt
  status            AiTaskStatus @default(QUEUED)
  revision          Int          @default(1) @db.UnsignedInt
  /// Decimal(20,0) round-trips the C04 string token without JS number precision loss.
  fencingToken      Decimal      @default(0) @db.Decimal(20, 0)
  leaseOwnerId      String?      @db.VarChar(191)
  leaseExpiresAt    DateTime?    @db.DateTime(3)
  /// Versioned resolved route reference, not Base URL/key or an Agent-selected model.
  gatewayRouteRef   String?      @db.VarChar(191)
  promptVersion     String?      @db.VarChar(191)
  startedAt         DateTime?    @db.DateTime(3)
  endedAt           DateTime?    @db.DateTime(3)
  createdAt         DateTime     @default(now()) @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @db.DateTime(3)
  steps             AiStep[]
  gatewayInvocations AiGatewayInvocation[]
  executionCharges   AiTaskExecutionCharge[]
  executionPlan      AiTaskRunPlan?
  actionInputs       AiTaskActionInput[]
  quoteSelections    AiTaskQuoteSelection[]
  executionPhases    AiTaskExecutionPhaseStart[]
  reprepareTargets   AiApprovalReprepare[]
  inputReceiptId     String? @db.VarChar(36)
  inputReceipt       AiTaskInputReceipt? @relation("AiRunInputContinuation", fields: [scopeId, taskId, inputReceiptId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_runs_input_receipt_fkey")
  resourceOriginRunId String? @db.VarChar(36)
  resourceOrigin     AiRun? @relation("AiRunResourceOrigin", fields: [scopeId, taskId, resourceOriginRunId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_runs_resource_origin_fkey")
  resourceSuccessors AiRun[] @relation("AiRunResourceOrigin")

  automationInputs  AiAutomationInput[]
  automationReviewOperations AiAutomationReviewOperation[]
  @@unique([scopeId, taskId, inputReceiptId], map: "ai_runs_input_receipt_key")
  @@index([scopeId, taskId, resourceOriginRunId], map: "ai_runs_resource_origin_idx")
  @@unique([scopeId, taskId, id], map: "ai_runs_scope_task_id")
  @@unique([scopeId, taskId, sequence], map: "ai_runs_sequence")
  @@index([status, leaseExpiresAt], map: "ai_runs_recovery")
  @@map("ai_runs")
}

/// One logical action across retries; the original run/action/fingerprint association is stable.
model AiStep {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  scopeId             String             @db.VarChar(36)
  taskId              String             @db.VarChar(36)
  runId               String             @db.VarChar(36)
  task                AiTask             @relation(fields: [scopeId, taskId], references: [scopeId, id], onDelete: Restrict, onUpdate: Restrict)
  run                 AiRun              @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  sequence            Int                @db.UnsignedInt
  actionId            String             @db.VarChar(191)
  requestFingerprint  String             @db.Char(64)
  toolCode            String             @db.VarChar(191)
  toolVersion         String             @db.VarChar(191)
  status              AiStepStatus       @default(PENDING)
  effect              AiStepEffect       @default(NONE)
  revision            Int                @default(1) @db.UnsignedInt
  inputRef            String?            @db.VarChar(191)
  resultRef           String?            @db.VarChar(191)
  errorCode           String?            @db.VarChar(64)
  createdAt           DateTime           @default(now()) @db.DateTime(3)
  updatedAt           DateTime           @updatedAt @db.DateTime(3)
  proposalActions     AiProposalAction[]
  reprepareTargets    AiApprovalReprepare[]
  gatewayInvocations  AiGatewayInvocation[]
  executionCharges    AiTaskExecutionCharge[]
  resultArtifacts     AiTaskResultArtifact[]
  executionPhases     AiTaskExecutionPhaseStart[]

  @@unique([scopeId, taskId, id], map: "ai_steps_scope_task_id")
  @@unique([scopeId, taskId, actionId], map: "ai_steps_action")
  @@unique([scopeId, taskId, actionId, requestFingerprint], map: "ai_steps_action_fingerprint")
  @@unique([scopeId, runId, sequence], map: "ai_steps_sequence")
  @@index([scopeId, taskId, status], map: "ai_steps_task_status")
  @@map("ai_steps")
}

/// Mutable proposal head; only its current immutable version can be confirmed/consumed.
model AiProposal {
  id              String              @id @default(uuid()) @db.VarChar(36)
  scopeId         String              @db.VarChar(36)
  taskId          String              @db.VarChar(36)
  task            AiTask              @relation(fields: [scopeId, taskId], references: [scopeId, id], onDelete: Restrict, onUpdate: Restrict)
  stateRevision   Int                 @default(1) @db.UnsignedInt
  currentRevision Int?                @db.UnsignedInt
  currentVersion  AiProposalVersion?  @relation("AiProposalCurrent", fields: [scopeId, taskId, id, currentRevision], references: [scopeId, taskId, proposalId, revision], onDelete: Restrict, onUpdate: Restrict)
  status          AiProposalStatus    @default(PENDING_CONFIRMATION)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)
  versions        AiProposalVersion[] @relation("AiProposalVersions")

  @@unique([scopeId, taskId, id], map: "ai_proposals_scope_task_id")
  @@index([scopeId, taskId, status], map: "ai_proposals_task_status")
  @@map("ai_proposals")
}

/// Strict C05 metadata/ref payload, never raw prompts, credentials or copied business bodies.
model AiProposalVersion {
  scopeId      String             @db.VarChar(36)
  taskId       String             @db.VarChar(36)
  proposalId   String             @db.VarChar(36)
  revision     Int                @db.UnsignedInt
  proposal     AiProposal         @relation("AiProposalVersions", fields: [scopeId, taskId, proposalId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  payloadHash  String             @db.Char(64)
  payload      Json
  expiresAt    DateTime           @db.DateTime(3)
  createdAt    DateTime           @default(now()) @db.DateTime(3)
  currentFor   AiProposal[]       @relation("AiProposalCurrent")
  actions      AiProposalAction[]
  approvals    AiApproval[]
  executionPhaseReceipts AiTaskExecutionPhaseReceipt[]
  originalReprepares AiApprovalReprepare[] @relation("AiReprepareOriginal")
  replacementReprepares AiApprovalReprepare[] @relation("AiReprepareReplacement")

  @@id([scopeId, proposalId, revision])
  @@unique([scopeId, taskId, proposalId, revision], map: "ai_proposal_versions_scope_task")
  @@unique([scopeId, taskId, proposalId, revision, payloadHash], map: "ai_proposal_versions_hash")
  @@map("ai_proposal_versions")
}

/// Materialized action references allow DB foreign keys; written atomically with the C05 payload.
model AiProposalAction {
  scopeId            String                  @db.VarChar(36)
  taskId             String                  @db.VarChar(36)
  proposalId         String                  @db.VarChar(36)
  proposalRevision   Int                     @db.UnsignedInt
  actionId           String                  @db.VarChar(191)
  sequence           Int                     @db.UnsignedInt
  requestFingerprint String                  @db.Char(64)
  proposalVersion    AiProposalVersion       @relation(fields: [scopeId, taskId, proposalId, proposalRevision], references: [scopeId, taskId, proposalId, revision], onDelete: Restrict, onUpdate: Restrict)
  step               AiStep                  @relation(fields: [scopeId, taskId, actionId, requestFingerprint], references: [scopeId, taskId, actionId, requestFingerprint], onDelete: Restrict, onUpdate: Restrict)
  consumptions       AiApprovalConsumption[]
  snapshots          AiApprovedOrderSnapshot[]
  reprepares         AiApprovalReprepare[]

  @@id([scopeId, proposalId, proposalRevision, actionId])
  @@unique([scopeId, taskId, proposalId, proposalRevision, actionId, requestFingerprint], map: "ai_proposal_actions_binding")
  @@unique([scopeId, proposalId, proposalRevision, sequence], map: "ai_proposal_actions_sequence")
  @@map("ai_proposal_actions")
}

enum AiApprovedOrderSnapshotKind {
  INPUT   @map("input")
  PREVIEW @map("preview")
}

/// Immutable bodies referenced by a proposal action; storage never grants approval.
model AiApprovedOrderSnapshot {
  scopeId           String                      @db.VarChar(36)
  taskId            String                      @db.VarChar(36)
  proposalId        String                      @db.VarChar(36)
  proposalRevision  Int                         @db.UnsignedInt
  actionId          String                      @db.VarChar(191)
  actionFingerprint String                      @db.Char(64)
  kind              AiApprovedOrderSnapshotKind
  recordId          String                      @db.VarChar(191)
  revision          Int                         @db.UnsignedInt
  contentHash       String                      @db.Char(64)
  payload           Json
  actorKind         AiActorKind
  actorId           String                      @db.VarChar(191)
  audience          AiAudience
  createdAt         DateTime                    @default(now()) @db.DateTime(3)
  action            AiProposalAction            @relation(fields: [scopeId, taskId, proposalId, proposalRevision, actionId, actionFingerprint], references: [scopeId, taskId, proposalId, proposalRevision, actionId, requestFingerprint], onDelete: Restrict, onUpdate: Restrict, map: "ai_approved_order_snapshots_action_fkey")

  @@id([scopeId, recordId, revision])
  @@unique([scopeId, taskId, proposalId, proposalRevision, actionId, kind], map: "ai_approved_order_snapshots_action_kind")
  @@map("ai_approved_order_snapshots")
}

/// Immutable approval decision. Revocation is checked through proposal head/current authority.
model AiApproval {
  id               String                  @id @default(uuid()) @db.VarChar(36)
  scopeId          String                  @db.VarChar(36)
  taskId           String                  @db.VarChar(36)
  proposalId       String                  @db.VarChar(36)
  proposalRevision Int                     @db.UnsignedInt
  payloadHash      String                  @db.Char(64)
  proposalVersion  AiProposalVersion       @relation(fields: [scopeId, taskId, proposalId, proposalRevision, payloadHash], references: [scopeId, taskId, proposalId, revision, payloadHash], onDelete: Restrict, onUpdate: Restrict)
  audience         AiAudience
  actorKind        AiActorKind
  actorId          String                  @db.VarChar(191)
  decision         AiApprovalDecision
  issuedAt         DateTime                @db.DateTime(3)
  expiresAt        DateTime                @db.DateTime(3)
  consumptions     AiApprovalConsumption[]
  executionPhaseStarts AiTaskExecutionPhaseStart[] @relation("ExecutionPhaseStartDecision")
  executionPhaseReceipts AiTaskExecutionPhaseReceipt[] @relation("ExecutionPhaseReceiptDecision")

  @@unique([scopeId, taskId, id], map: "ai_approvals_scope_task_id")
  @@unique([scopeId, taskId, id, proposalId, proposalRevision], map: "ai_approvals_binding")
  @@unique([scopeId, proposalId, proposalRevision, actorKind, actorId], map: "ai_approvals_actor_decision")
  @@map("ai_approvals")
}

/// One action consumption across proposal/approval retries; Core remains the business idempotency authority.
model AiApprovalConsumption {
  scopeId                String                      @db.VarChar(36)
  taskId                 String                      @db.VarChar(36)
  actionId               String                      @db.VarChar(191)
  approvalId             String                      @db.VarChar(36)
  proposalId             String                      @db.VarChar(36)
  proposalRevision       Int                         @db.UnsignedInt
  actionFingerprint      String                      @db.Char(64)
  approval               AiApproval                  @relation(fields: [scopeId, taskId, approvalId, proposalId, proposalRevision], references: [scopeId, taskId, id, proposalId, proposalRevision], onDelete: Restrict, onUpdate: Restrict)
  action                 AiProposalAction            @relation(fields: [scopeId, taskId, proposalId, proposalRevision, actionId, actionFingerprint], references: [scopeId, taskId, proposalId, proposalRevision, actionId, requestFingerprint], onDelete: Restrict, onUpdate: Restrict)
  businessIdempotencyKey  String                      @db.VarChar(191)
  status                 AiApprovalConsumptionStatus @default(RESERVED)
  resultRef              String?                     @db.VarChar(191)
  createdAt              DateTime                    @default(now()) @db.DateTime(3)
  updatedAt              DateTime                    @updatedAt @db.DateTime(3)

  @@id([scopeId, taskId, actionId])
  @@index([scopeId, businessIdempotencyKey], map: "ai_consumptions_business_key")
  @@map("ai_approval_consumptions")
}

model AiApprovalReprepare {
  id                     String @id @db.VarChar(36)
  scopeId                String @db.VarChar(36)
  operationKey           String @db.VarChar(191)
  commandHash            String @db.Char(64)
  actorId                String @db.VarChar(191)
  audience               AiAudience
  originalTaskId         String @db.VarChar(36)
  originalProposalId     String @db.VarChar(36)
  originalRevision       Int @db.UnsignedInt
  originalPayloadHash    String @db.Char(64)
  originalActionId       String @db.VarChar(191)
  originalFingerprint    String @db.Char(64)
  replacementTaskId      String @db.VarChar(36)
  replacementRunId       String @db.VarChar(36)
  replacementActionId    String @db.VarChar(191)
  replacementFingerprint String @db.Char(64)
  replacementInputRef    String @db.VarChar(36)
  originalInputRef       String @db.VarChar(191)
  quoteSelectionRef      String @db.VarChar(36)
  planHash               String @db.Char(64)
  proofHash              String @db.Char(64)
  replacementProposalId  String @db.VarChar(36)
  replacementRevision    Int @db.UnsignedInt
  replacementPayloadHash String @db.Char(64)
  createdAt              DateTime @default(now()) @db.DateTime(3)
  originalVersion AiProposalVersion @relation("AiReprepareOriginal", fields: [scopeId, originalTaskId, originalProposalId, originalRevision, originalPayloadHash], references: [scopeId, taskId, proposalId, revision, payloadHash], onDelete: Restrict, onUpdate: Restrict, map: "ai_reprepares_original_version_fk")
  originalAction AiProposalAction @relation(fields: [scopeId, originalTaskId, originalProposalId, originalRevision, originalActionId, originalFingerprint], references: [scopeId, taskId, proposalId, proposalRevision, actionId, requestFingerprint], onDelete: Restrict, onUpdate: Restrict, map: "ai_reprepares_original_action_fk")
  replacementRun AiRun @relation(fields: [scopeId, replacementTaskId, replacementRunId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_reprepares_replacement_run_fk")
  replacementStep AiStep @relation(fields: [scopeId, replacementTaskId, replacementActionId, replacementFingerprint], references: [scopeId, taskId, actionId, requestFingerprint], onDelete: Restrict, onUpdate: Restrict, map: "ai_reprepares_replacement_step_fk")
  replacementVersion AiProposalVersion @relation("AiReprepareReplacement", fields: [scopeId, replacementTaskId, replacementProposalId, replacementRevision, replacementPayloadHash], references: [scopeId, taskId, proposalId, revision, payloadHash], onDelete: Restrict, onUpdate: Restrict, map: "ai_reprepares_replacement_version_fk")

  @@unique([scopeId, operationKey], map: "ai_reprepares_operation_key")
  @@unique([scopeId, originalTaskId, originalProposalId, originalRevision], map: "ai_reprepares_original_key")
  @@unique([scopeId, replacementTaskId, replacementActionId], map: "ai_reprepares_replacement_key")
  @@map("ai_approval_reprepares")
}

/// Append in the task mutation transaction; each task has its own string-serialized cursor.
model AiTaskEvent {
  cursor       BigInt   @db.UnsignedBigInt
  scopeId      String   @db.VarChar(36)
  taskId       String   @db.VarChar(36)
  task         AiTask   @relation(fields: [scopeId, taskId], references: [scopeId, id], onDelete: Restrict, onUpdate: Restrict)
  taskRevision Int      @db.UnsignedInt
  type         String   @db.VarChar(32)
  /// Minimal C04 payload/reference only; every event read must reauthorize.
  payload      Json
  occurredAt   DateTime @db.DateTime(3)

  @@id([scopeId, taskId, cursor])
  @@map("ai_task_events")
}
