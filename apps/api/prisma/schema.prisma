}

/// STOCK-OPS-01：数量库存的追加式日常作业流水。余额是当前快照，本表记录每次入库、盘点、调拨、报损和退出的来源与前后值。
model RentalStockLedgerEntry {
  id                  String                    @id @default(uuid())
  tenantId            String
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId         String
  workspace           BusinessWorkspace         @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  operationId         String                    @db.VarChar(191)
  entryKind           String                    @db.VarChar(8)
  operationType       String                    @db.VarChar(24)
  itemGroupId         String
  itemGroup           RentalItemGroup           @relation(fields: [itemGroupId], references: [id], onDelete: Restrict)
  locationId          String
  location            RentalFulfillmentLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantityDelta       Int
  onHandBefore        Int
  onHandAfter         Int
  maintenanceDelta    Int                       @default(0)
  reservedQuantity    Int
  maintenanceQuantity Int
  reason              String                    @db.VarChar(500)
  batchNo             String?                   @db.VarChar(100)
  sourceDocumentNo    String?                   @db.VarChar(100)
  sourceOrderId       String?                   @db.VarChar(191)
  sourceInspectionId  String?                   @db.VarChar(191)
  sourceDispositionId String?                   @db.VarChar(191)
  idempotencyKey      String                    @db.VarChar(191)
  requestFingerprint  String                    @db.Char(64)
  operator            String                    @db.VarChar(191)
  createdAt           DateTime                  @default(now())

  @@unique([workspaceId, idempotencyKey, entryKind], map: "rental_stock_ledger_idem_entry_key")
  @@index([tenantId, workspaceId, itemGroupId, locationId, createdAt], map: "rental_stock_ledger_scope_created_idx")
  @@index([tenantId, workspaceId, batchNo, createdAt], map: "rental_stock_ledger_batch_idx")
  @@index([tenantId, workspaceId, sourceDocumentNo, createdAt], map: "rental_stock_ledger_document_idx")
  @@index([tenantId, workspaceId, sourceOrderId, createdAt], map: "rental_stock_ledger_order_idx")
  @@index([tenantId, workspaceId, sourceInspectionId, createdAt], map: "rental_stock_ledger_inspection_idx")
  @@index([tenantId, workspaceId, sourceDispositionId, createdAt], map: "rental_stock_ledger_disposition_idx")
  @@index([workspaceId, operationId], map: "rental_stock_ledger_operation_idx")
  @@map("rental_stock_ledger_entries")
}

/// STOCK-CLOSE-01：每批实际归还后的库存处置事实。
model RentalStockDisposition {
  id               String                  @id @default(uuid())
  tenantId         String
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        BusinessWorkspace       @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  orderId          String
  order            RentalOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspectionId     String?
  inspection       RentalInspectionRecord? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  returnBatchKey   String                  @db.VarChar(191)
  dedupeKey        String                  @db.VarChar(191)
  itemGroupId      String                  @db.VarChar(191)
  locationId       String                  @db.VarChar(191)
  assetId          String?                 @db.VarChar(191)
  quantity         Int
  receivedAt       DateTime
  bufferUntil      DateTime
  status           String                  @db.VarChar(20)
  blockReason      String?                 @db.VarChar(500)
  restoredQuantity Int                     @default(0)
  restoredAt       DateTime?
  restoredBy       String?                 @db.VarChar(191)
  workOrders       RentalWorkOrder[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([workspaceId, dedupeKey], map: "rental_stock_disp_batch_resource_key")
  // MySQL utf8mb4 下四个 191 字符列已接近 3072 字节上限，不能再把 status 拼进同一索引。
  @@index([tenantId, workspaceId, itemGroupId, locationId], map: "rental_stock_dispositions_scope_idx")
  @@index([tenantId, workspaceId, status], map: "rental_stock_dispositions_scope_status_idx")
  @@index([orderId, inspectionId])
  @@map("rental_stock_dispositions")
}

/// SHARED-WORK-01A：清洁、整备、校准和维修共用的最小养护工单事实。
