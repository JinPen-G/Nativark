  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corporateCustomerId String
  corporateCustomer   CustomerProfile   @relation("CorporateMembershipCompany", fields: [tenantId, corporateCustomerId], references: [tenantId, id], onDelete: Cascade)
  personalCustomerId  String
