model RentalNotificationLog {
  id                String                     @id @default(uuid())
  tenantId          String
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SPACE-03：经营空间归属。与 tenantId 并存（需求 3：经营事实同时包含两者）。
  workspaceId      String
  /// 复合外键保证空间与事实同租户，杜绝把事实挂到别的租户的空间上。
  workspace        BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  templateId        String
  template          RentalNotificationTemplate @relation(fields: [templateId], references: [id])
  templateVersion   String
  eventCode         String
  channel           String
  /// 发送目标按需求 4.9 脱敏后留存。
  recipient         String
