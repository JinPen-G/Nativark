  /// 模板编码与名称存为领取时快照，模板改名不影响已发出的券。
  templateCode    String
  templateName    String
  status          String               @default("claimed")
  claimedAt       DateTime             @default(now())
  effectiveFrom   DateTime
  effectiveTo     DateTime
  lockedOrderId   String?
  lockedAt        DateTime?
  redeemedOrderId String?
  redeemedAt      DateTime?
  releasedAt      DateTime?

  @@index([tenantId, customerId, status], map: "rental_customer_coupons_tenant_customer_status_idx")
  @@index([tenantId, templateId, customerId], map: "rental_customer_coupons_tenant_template_customer_idx")
  @@index([lockedOrderId])
  @@index([redeemedOrderId])
  @@map("rental_customer_coupons")
