/// EXT-01C：短时对象存储上传会话。FileAsset 先进入 pending_upload，
/// 只有服务端完成对象存在性确认后才变为 active。
model FileUploadSession {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileAssetId     String    @unique
  fileAsset       FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  provider        String    @db.VarChar(40)
  storageKey      String    @db.VarChar(500)
  status          String    @default("pending_upload") @db.VarChar(24)
  idempotencyKey  String?
  expiresAt       DateTime
  completedAt     DateTime?
  failureReason   String?   @db.VarChar(500)
  /// 过期对象清理状态。cleanup_in_progress 防止并发清理重复处理同一会话。
  cleanupAttempts Int       @default(0)
  lastCleanupAt   DateTime?
  cleanupError    String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey], map: "file_upload_sessions_scope_idem_key")
  @@index([tenantId, status, expiresAt], map: "file_upload_sessions_scope_status_idx")
  @@map("file_upload_sessions")
}

