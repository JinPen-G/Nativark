  tenant                Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                String
  plan                  CustomerMembershipPlan             @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
