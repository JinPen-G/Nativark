{
  "name": "@rental-os/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build -w @rental-os/core-host && npm run build -w @rental-os/example-tickets-core",
    "dev": "nest start --watch",
    "prebuild": "npm run build -w @rental-os/core-host && npm run build -w @rental-os/example-tickets-core",
    "build": "nest build",
    "prelint": "npm run build -w @rental-os/core-host && npm run build -w @rental-os/example-tickets-core",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@rental-os/mcp-server": "0.1.0",
    "@rental-os/shared": "0.1.0",
    "@rental-os/core-contracts": "0.1.0",
    "@rental-os/core-host": "0.1.0",
    "@rental-os/example-tickets-core": "0.1.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2"
  }
}
