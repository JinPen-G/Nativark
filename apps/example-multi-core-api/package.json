{
  "name": "@rental-os/example-multi-core-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "公共底座与Rental及工单的双Core受控宿主",
  "scripts": {
    "prebuild": "npm run build -w @rental-os/rental-api && npm run build -w @rental-os/example-tickets-core",
    "build": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.json --mode rental",
    "prelint": "npm run prebuild",
    "lint": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.json --mode rental --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@rental-os/core-contracts": "0.1.0",
    "@rental-os/example-tickets-core": "0.1.0",
    "@rental-os/rental-api": "0.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "5.9.3"
  }
}
