{
  "name": "@rental-os/example-tickets-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "公共底座与轻量工单Core的受控示范宿主",
  "scripts": {
    "prebuild": "npm run build -w @rental-os/platform-api && npm run build -w @rental-os/example-tickets-core",
    "build": "tsc -p tsconfig.json",
    "prelint": "npm run build -w @rental-os/platform-api && npm run build -w @rental-os/example-tickets-core",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "prepare:deployment": "node dist/prepare-deployment.js",
    "register:permissions": "node dist/register-permissions.js"
  },
  "dependencies": {
    "@rental-os/platform-contracts": "0.1.0",
    "@rental-os/platform-api": "0.1.0",
    "@rental-os/platform-server": "0.1.0",
    "@rental-os/platform-core-host": "0.1.0",
    "@rental-os/core-host": "0.1.0",
    "@rental-os/core-contracts": "0.1.0",
    "@rental-os/example-tickets-core": "0.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0"
  }
}
