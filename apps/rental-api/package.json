{
  "name": "@rental-os/rental-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "公共底座与Rental Core的独立宿主，显式选择无AI或AI组合",
  "exports": {
    "./package": {
      "types": "./dist/package.d.ts",
      "default": "./dist/package.js"
    },
    "./http-policy": {
      "types": "./dist/http-policy.d.ts",
      "default": "./dist/http-policy.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    }
  },
  "typesVersions": {
    "*": {
      "package": [
        "dist/package.d.ts"
      ],
      "http-policy": [
        "dist/http-policy.d.ts"
      ],
      "openapi": [
        "dist/openapi.d.ts"
      ]
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @rental-os/platform-api && npm run build -w @rental-os/rental-core && npm run build -w @rental-os/ai-native-data",
    "build": "tsc -p tsconfig.json",
    "prebuild:ai": "npm run prebuild && npm run build -w @rental-os/ai-native-server",
    "build:ai": "tsc -p tsconfig.ai.json",
    "prelint": "npm run prebuild",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prelint:ai": "npm run prebuild:ai",
    "lint:ai": "tsc -p tsconfig.ai.json --noEmit",
    "start": "node dist/main.js",
    "start:ai": "node dist-ai/ai-main.js",
    "prepare:deployment": "node dist/prepare-deployment.js"
  },
  "dependencies": {
    "@rental-os/platform-api": "0.1.0",
    "@rental-os/platform-contracts": "0.1.0",
    "@rental-os/platform-server": "0.1.0",
    "@rental-os/platform-core-host": "0.1.0",
    "@rental-os/core-contracts": "0.1.0",
    "@rental-os/core-host": "0.1.0",
    "@rental-os/rental-core": "0.1.0",
    "@rental-os/shared": "0.1.0",
    "@rental-os/ai-native-data": "0.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "@rental-os/ai-native-server": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@rental-os/ai-native-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "5.9.3"
  }
}
