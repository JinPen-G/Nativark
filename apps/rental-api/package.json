{
  "name": "@rental-os/rental-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "公共底座与Rental Core的独立宿主，显式选择无AI或AI组合",
  "exports": {
    "./package": {
      "types": "./dist/package.d.ts",
      "default": "./dist/package.js"
    },
    "./http-policy": {
      "types": "./dist/http-policy.d.ts",
      "default": "./dist/http-policy.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./assembly": {
      "types": "./dist/assembly.d.ts",
      "default": "./dist/assembly.js"
    },
    "./app-module": {
      "types": "./dist/app.module.d.ts",
      "default": "./dist/app.module.js"
    },
    "./additional-cores": {
      "types": "./dist/additional-cores.d.ts",
      "default": "./dist/additional-cores.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./ai-app-module": {
      "types": "./dist-ai/ai-app.module.d.ts",
      "default": "./dist-ai/ai-app.module.js"
    },
    "./mcp-bootstrap": {
      "types": "./dist-mcp/mcp-bootstrap.d.ts",
      "default": "./dist-mcp/mcp-bootstrap.js"
    },
    "./mcp-composition": {
      "types": "./dist-mcp/mcp-composition.d.ts",
      "default": "./dist-mcp/mcp-composition.js"
    }
  },
  "typesVersions": {
    "*": {
      "package": [
        "dist/package.d.ts"
      ],
      "http-policy": [
        "dist/http-policy.d.ts"
      ],
      "openapi": [
        "dist/openapi.d.ts"
      ],
      "assembly": [
        "dist/assembly.d.ts"
      ],
      "app-module": [
        "dist/app.module.d.ts"
      ],
      "additional-cores": [
        "dist/additional-cores.d.ts"
      ],
      "bootstrap": [
        "dist/bootstrap.d.ts"
      ],
      "ai-app-module": [
        "dist-ai/ai-app.module.d.ts"
      ],
      "mcp-bootstrap": [
        "dist-mcp/mcp-bootstrap.d.ts"
      ],
      "mcp-composition": [
        "dist-mcp/mcp-composition.d.ts"
      ]
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @rental-os/platform-api && npm run build -w @rental-os/rental-core && npm run build -w @rental-os/ai-native-data",
    "build": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.json --mode rental",
    "prebuild:ai": "npm run prebuild && npm run build -w @rental-os/ai-native-server",
    "build:ai": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.ai.json --mode rental-ai",
    "prelint": "npm run prebuild",
    "lint": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.json --mode rental --noEmit",
    "prelint:ai": "npm run prebuild:ai",
    "lint:ai": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.ai.json --mode rental-ai --noEmit",
    "start": "node dist/main.js",
    "start:ai": "node dist-ai/ai-main.js",
    "prepare:deployment": "node dist/prepare-deployment.js",
    "prebuild:mcp": "npm run prebuild:ai && npm run build -w @rental-os/mcp-server && npm run build -w @rental-os/rental-mcp-host",
    "build:mcp": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.mcp.json --mode rental-ai",
    "prelint:mcp": "npm run prebuild:mcp",
    "lint:mcp": "node ../../scripts/build-selected-prisma.cjs --project tsconfig.mcp.json --mode rental-ai --noEmit"
  },
  "dependencies": {
    "@rental-os/platform-api": "0.1.0",
    "@rental-os/platform-contracts": "0.1.0",
    "@rental-os/platform-server": "0.1.0",
    "@rental-os/platform-core-host": "0.1.0",
    "@rental-os/core-contracts": "0.1.0",
    "@rental-os/core-host": "0.1.0",
    "@rental-os/rental-core": "0.1.9",
    "@rental-os/shared": "0.1.0",
    "@rental-os/ai-native-data": "0.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "@rental-os/ai-native-server": "0.1.0",
    "@rental-os/mcp-server": "0.1.0",
    "@rental-os/rental-mcp-host": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@rental-os/ai-native-server": {
      "optional": true
    },
    "@rental-os/mcp-server": {
      "optional": true
    },
    "@rental-os/rental-mcp-host": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "5.9.3"
  }
}
