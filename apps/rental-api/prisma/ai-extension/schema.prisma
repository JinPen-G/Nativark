  fulfillmentOrderId String? @db.VarChar(191)
  configurationKind String? @db.VarChar(24)
  configurationId String? @db.VarChar(191)
  configurationProfileTenantId String? @db.VarChar(191)
  configurationSnapshotWorkspaceId String? @db.VarChar(191)
  configurationSettingsWorkspaceId String? @db.VarChar(191)
  sectionCode String? @db.VarChar(64)
  dueAt DateTime? @db.DateTime(3)
  locationId String? @db.VarChar(191)
  sourceHash String? @db.Char(64)
  sourcePolicyId String? @db.VarChar(191)
  sourcePolicyRevision Int? @db.UnsignedInt
  resourceRevision Int      @db.UnsignedInt
  orderId          String?  @db.VarChar(191)
  failureCode      String   @db.VarChar(32)
  traceId          String   @db.VarChar(191)
  causationId      String   @db.VarChar(191)
  deduplicationKey String   @db.Char(64)
  occurredAt       DateTime @db.DateTime(3)
  expiresAt        DateTime @db.DateTime(3)
  status           String   @default("pending") @db.VarChar(24)
  attempts         Int      @default(0) @db.UnsignedInt
  fence            Int      @default(0) @db.UnsignedInt
  leaseOwner       String?  @db.VarChar(128)
  leaseUntil       DateTime? @db.DateTime(3)
  nextAttemptAt    DateTime @default(now()) @db.DateTime(3)
  lastErrorCode    String?  @db.VarChar(32)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  updatedAt        DateTime @updatedAt @db.DateTime(3)
  workspace        BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_workspace_fk")
  notification     RentalNotificationLog? @relation("AiFailureNotification", fields: [tenantId, workspaceId, notificationId], references: [tenantId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_notification_fk")
  refund           RentalPaymentRefund? @relation("AiFailureRefund", fields: [tenantId, workspaceId, refundId], references: [tenantId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_refund_fk")
  inspection       RentalInspectionRecord? @relation("AiFailureInspection", fields: [tenantId, workspaceId, inspectionId, orderId], references: [tenantId, workspaceId, id, orderId], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_inspection_fk")
  fulfillmentOrder RentalOrder? @relation("AiFailureFulfillment", fields: [tenantId, workspaceId, fulfillmentOrderId], references: [tenantId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_fulfillment_fk")
  fulfillmentLocation RentalFulfillmentLocation? @relation("AiFailureLocation", fields: [tenantId, workspaceId, locationId], references: [tenantId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_location_fk")
  configurationProfile TenantRentalProfile? @relation("AiFailureConfigurationProfile", fields: [configurationProfileTenantId], references: [tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_config_profile_fk")
  configurationSnapshot RentalCoreStateSnapshot? @relation("AiFailureConfigurationSnapshot", fields: [tenantId, configurationSnapshotWorkspaceId], references: [tenantId, workspaceId], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_config_snapshot_fk")
  configurationSettings RentalTenantBusinessSettings? @relation("AiFailureConfigurationSettings", fields: [tenantId, configurationSettingsWorkspaceId], references: [tenantId, workspaceId], onDelete: Restrict, onUpdate: Restrict, map: "ai_failure_outbox_config_settings_fk")

  automationInputs AiAutomationInput[]
  @@unique([tenantId, workspaceId, id], map: "ai_failure_outbox_scope_id_key")
  @@unique([tenantId, workspaceId, deduplicationKey], map: "ai_failure_outbox_dedup_key")
  @@index([tenantId, workspaceId, status, nextAttemptAt], map: "ai_failure_outbox_due_idx")
  @@index([tenantId, workspaceId, inspectionId, exceptionId], map: "ai_failure_outbox_inspection_idx")
  @@index([tenantId, workspaceId, fulfillmentOrderId], map: "ai_failure_outbox_fulfillment_idx")
  @@index([tenantId, workspaceId, configurationKind, configurationId, sectionCode], map: "ai_failure_outbox_config_idx")
  @@map("ai_business_failure_outbox")

}

