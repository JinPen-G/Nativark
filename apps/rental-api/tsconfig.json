{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": false,
    "paths": {
      "@prisma/client": [
        "./generated/client/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "dist-ai",
    "generated",
    "src/ai-*.ts",
    "src/mcp-*.ts",
    "dist-mcp"
  ]
}
