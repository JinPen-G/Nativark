.asset-photo { height: 390rpx; margin: 16rpx 32rpx 0; border-radius: var(--radius); background: #F0F6FF; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.asset-photo image { width: 100%; height: 100%; }
.asset-summary { padding-top: 20rpx; }
.asset-summary > .row { margin-bottom: 18rpx; }
.asset-details { box-shadow: none; border: 1rpx solid var(--border); }
.asset-copy { color: var(--primary); }
.theme-dark .asset-photo { background: var(--surface); }
.screen > .section { padding-left: 24rpx; padding-right: 24rpx; }
.asset-photo { margin-left: 24rpx; margin-right: 24rpx; height: 330rpx; }
.asset-details { padding: 18rpx; border-radius: 16rpx; }
.asset-details .kv { min-height: 55rpx; }
.asset-actions { display: flex; gap: 12rpx; }
.asset-actions .btn { flex: 1; border-radius: 12rpx; }
.asset-quick-grid { display: flex; justify-content: space-between; gap: 8rpx; }
.asset-quick { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; padding: 4rpx 0 8rpx; }
.asset-quick__icon { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: #EAF2FF; }
.asset-quick__icon--green { background: var(--success-weak); }
.asset-quick__icon--orange { background: var(--warning-weak); }
.asset-quick__icon--purple { background: rgba(124, 92, 255, 0.14); }
.asset-quick__label { margin-top: 10rpx; color: var(--text); font-size: var(--font-mini); text-align: center; white-space: nowrap; }
.asset-section-head { margin-bottom: 12rpx; font-size: var(--font-subtitle); font-weight: var(--fw-bold); }
.asset-history-card { padding: 4rpx 18rpx; border: 1rpx solid var(--border); box-shadow: none; }
.asset-rental-row { align-items: center; padding: 14rpx 0; }
.asset-rental-row + .asset-rental-row { border-top: 1rpx solid var(--border); }
.asset-rental-thumb { width: 96rpx; height: 96rpx; margin-right: 16rpx; flex: 0 0 auto; overflow: hidden; border-radius: 10rpx; background: var(--primary-weak); }
.asset-rental-thumb image { width: 100%; height: 100%; }
.theme-dark .asset-quick__icon { background: var(--surface); }
