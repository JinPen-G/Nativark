<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen screen--flat {{themeClass}}">
  <nav-bar title="{{context.terminology.collectionLabel || '库存查询'}}"></nav-bar>
  <view class="section"><view class="search search--surface"><ui-icon name="search" size="30" color="muted"></ui-icon><input class="search__input" placeholder="搜索{{context.terminology.identifierLabel || '编号'}}、{{context.terminology.serialLabel || '序列号'}}或{{context.terminology.itemGroupLabel || '型号'}}" value="{{keyword}}" confirm-type="search" bindinput="onKeyword" /><view wx:if="{{keyword}}" class="search__clear" bindtap="onClearKeyword">清除</view></view></view>
  <view class="section section--tight"><view class="row row--between"><view class="muted" bindtap="onOpenLocation">{{locationLabel}} ▾</view><view class="row"><view wx:if="{{canManage}}" class="link" bindtap="onCreate">新增{{context.terminology.assetLabel || '物品'}}</view><view class="link ml-16" bindtap="onLedger">出入库记录</view></view></view></view>
  <view wx:if="{{itemGroupId}}" class="section section--tight"><view class="chip chip--soft" bindtap="onClearGroup">{{itemGroupName || '当前型号'}} ×</view></view>
  <scroll-view scroll-x class="section section--tight"><view class="chips"><view class="chip {{status === item.key ? 'chip--active' : ''}}" wx:for="{{chips}}" wx:key="key" data-key="{{item.key}}" bindtap="onChip">{{item.label}}</view></view></scroll-view>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view wx:if="{{balances.length}}" class="section section--tight"><view class="card"><view class="row row--between" bindtap="onToggleBalances"><view class="subtitle">数量库存（{{balances.length}}）</view><ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view><block wx:if="{{balancesOpen}}"><view class="cell" wx:for="{{balances}}" wx:key="key"><view class="cell__body"><view class="cell__title">{{item.itemGroupName}}</view><view class="cell__desc">{{item.locationName}} · 在手 {{item.onHand}} · 已预留 {{item.reserved}}</view></view><view class="strong">可用 {{item.available}}</view></view></block></view></view>
    <view class="section section--tight"><view class="card" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="onAsset"><view class="row"><view class="asset-thumb"><image wx:if="{{item.imagePath}}" src="{{item.imagePath}}" mode="aspectFill"></image><ui-icon wx:else name="{{placeholderIcon}}" size="48" color="muted"></ui-icon></view><view class="grow"><view class="subtitle">{{item.itemGroupName}}</view><view class="muted small mt-4">{{item.assetNo}} · {{item.serialNo}}</view><view class="muted small mt-4">{{item.locationName}}</view></view><status-tag label="{{item.statusLabel}}" tone="{{item.statusTone}}" small="{{true}}"></status-tag></view></view></view>
  </block>
  <sheet visible="{{showLocationSheet}}" title="选择{{context.terminology.fulfillmentLabel || '地点'}}" bind:close="onCloseLocation"><view class="option {{!context.currentLocationId ? 'option--selected' : ''}}" data-id="" bindtap="onPickLocation"><view class="grow"><view class="subtitle">全部{{context.terminology.fulfillmentLabel || '地点'}}</view></view><view class="option__check"></view></view><view class="option mt-12 {{context.currentLocationId === item.id ? 'option--selected' : ''}}" wx:for="{{context.locations}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickLocation"><view class="grow"><view class="subtitle">{{item.name}}</view></view><view class="option__check"></view></view></sheet>
</view>
