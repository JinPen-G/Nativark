.screen > .section { padding-left: 32rpx; padding-right: 32rpx; }
.seg { height: 76rpx; padding: 0 12rpx; justify-content: space-between; }
.seg__item { padding: 0 12rpx; font-size: 25rpx; }
.seg__item--active::after { left: 12rpx; right: 12rpx; }
.orders-toolbar-section { padding-bottom: 12rpx; }
.orders-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 56rpx; padding-top: 16rpx; }
.orders-toolbar__scope { flex: 1; min-width: 0; overflow: hidden; color: var(--secondary); font-size: 22rpx; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.orders-toolbar__create { display: flex; align-items: center; justify-content: flex-end; flex: 0 0 auto; min-height: 40rpx; padding-left: 8rpx; font-size: 24rpx; white-space: nowrap; }
.search__input { font-size: 26rpx; color: var(--text); min-height: 52rpx; }
.orders-search-row { display: flex; align-items: center; gap: 12rpx; }
.orders-search { flex: 1; min-width: 0; background: #F2F6FC; border: 0; padding: 8rpx 18rpx; }
.orders-filter { width: 58rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.order-card { border: 1rpx solid var(--border); box-shadow: none; padding: 22rpx; border-radius: 18rpx; }
.order-card + .order-card { margin-top: 12rpx; }
.order-card__body { align-items: center; margin-top: 12rpx; }
.order-card__thumb { width: 100rpx; height: 100rpx; margin-right: 16rpx; background: #F5F8FD; }
.order-card__no { font-size: 22rpx; color: var(--secondary); font-weight: 500; }
.order-card__meta { font-size: 20rpx; margin-top: 3rpx; }
.order-card__items { font-size: 24rpx; margin-top: 3rpx; }
.theme-dark .orders-search { background: var(--surface); border: 1rpx solid var(--line); }
