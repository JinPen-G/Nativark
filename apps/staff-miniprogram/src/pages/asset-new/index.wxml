<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}"><nav-bar title="{{id ? '编辑' : '新增'}}{{assetLabel}}"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else><view class="section"><view class="card"><view class="subtitle">基本信息</view>
    <view class="field"><view class="field__label field__label--required">{{assetLabel}}型号</view><picker range="{{groups}}" range-key="name" bindchange="onGroupChange"><view class="field__picker">{{itemGroupName || '选择型号'}}<ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view></picker></view>
    <view class="field"><view class="field__label field__label--required">{{assetLabel}}编号</view><input class="field__input" placeholder="输入编号" value="{{assetNo}}" data-field="assetNo" bindinput="onInput" /></view>
    <view wx:if="{{supportsSerialNo}}" class="field"><view class="field__label">序列号{{requiresSerialNo ? ' *' : ''}}</view><input class="field__input" placeholder="{{requiresSerialNo ? '必填' : '可选'}}" value="{{serialNo}}" data-field="serialNo" bindinput="onInput" /></view>
    <view class="field"><view class="field__label field__label--required">所在地点</view><picker range="{{locations}}" range-key="name" bindchange="onLocationChange"><view class="field__picker">{{locationName || '选择地点'}}<ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view></picker></view>
  </view></view>
  <view wx:if="{{fields.length}}" class="section section--tight"><view class="card"><view class="subtitle">品类属性</view><view class="field" wx:for="{{fields}}" wx:key="code"><view class="field__label">{{item.label}}{{item.required ? ' *' : ''}}</view><switch wx:if="{{item.type === 'boolean'}}" checked="{{item.checked}}" data-index="{{index}}" bindchange="onFieldBool" /><picker wx:elif="{{item.type === 'select'}}" range="{{item.options}}" data-index="{{index}}" bindchange="onFieldSelect"><view class="field__picker">{{item.value || '请选择'}}<ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view></picker><picker wx:elif="{{item.type === 'date'}}" mode="date" value="{{item.value}}" data-index="{{index}}" bindchange="onFieldDate"><view class="field__picker">{{item.value || '请选择日期'}}</view></picker><input wx:else class="field__input" type="{{item.type === 'number' ? 'digit' : 'text'}}" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldInput" /></view></view></view>
  <view wx:if="{{error}}" class="section"><view class="notice notice--danger">{{error}}</view></view>
  <view class="bottom-bar"><button class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="onSave">{{busy ? '保存中…' : '保存' + assetLabel}}</button></view></block>
</view>
