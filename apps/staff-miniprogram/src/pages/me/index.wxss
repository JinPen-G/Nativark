.ml-24 { margin-left: 24rpx; }
.me-cards { align-items: stretch; }
.me-card { display: flex; flex-direction: column; align-items: center; text-align: center; min-height: 148rpx; padding: 16rpx 6rpx; box-shadow: none; }
.me-card .quick__icon { width: 64rpx; height: 64rpx; }
.me-card__title { margin-top: 10rpx; font-size: var(--font-secondary); font-weight: var(--fw-semibold); color: var(--text); }
.me-card__hint { margin-top: 4rpx; font-size: var(--font-mini); color: var(--secondary); }
.menu { box-shadow: none; border: 1rpx solid var(--border); padding-top: 0; padding-bottom: 0; }
.menu .cell__title { font-size: var(--font-body); }
.avatar-lg { width: 104rpx; height: 104rpx; }
.screen > .section--tight { padding-bottom: 12rpx; }
