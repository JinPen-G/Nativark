.ml-24 { margin-left: 24rpx; }
.me-card { display: flex; flex-direction: column; align-items: flex-start; padding: 24rpx 20rpx; }
.me-card { align-items: center; text-align: center; padding: 20rpx 8rpx; box-shadow: none; }
.me-card .quick__icon { width: 72rpx; height: 72rpx; }
.menu { box-shadow: none; border: 1rpx solid var(--border); padding-top: 0; padding-bottom: 0; }
.avatar-lg { background: #E8F0FF; }
.me-card__title { margin-top: 14rpx; font-size: 28rpx; font-weight: 600; color: var(--text); }
.me-card__hint { margin-top: 4rpx; font-size: 22rpx; color: var(--secondary); }
