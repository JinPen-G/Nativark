<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}">
  <nav-bar title="待处理工单"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="section work-order-top"><view class="card work-order-summary"><view class="row row--between"><view class="title">{{type}}</view><status-tag label="{{status}}" tone="{{tone}}" small="{{true}}"></status-tag></view><view class="work-order-meta">{{workNo}}<text>创建时间：{{createdAt}}</text></view><view wx:if="{{showProgress}}" class="steps"><view class="steps__item {{index < progressStep ? 'steps__item--done' : index === progressStep ? 'steps__item--active' : ''}}" wx:for="{{progressLabels}}" wx:key="*this"><view class="steps__dot">{{index < progressStep ? '✓' : index + 1}}</view><view class="steps__label">{{item}}</view></view></view></view></view>
    <view class="section section--tight"><view class="card work-order-info"><view class="subtitle">基本信息</view><view class="kv"><text class="kv__label">工单类型</text><text class="kv__value">{{type}}</text></view><view wx:if="{{orderId}}" class="cell work-order-link" hover-class="btn-hover" bindtap="onOrder"><view class="cell__body"><view class="cell__desc">关联订单</view><view class="cell__title">#{{orderNo}}</view></view><ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view><view class="work-item"><view class="work-item__thumb"><image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit"></image><ui-icon wx:else name="box" size="44" color="muted"></ui-icon></view><view class="grow"><view class="work-item__label">{{itemName}}</view><view wx:if="{{assetNo}}" class="muted small mt-4">{{assetLabel}}编号 {{assetNo}}</view><view wx:if="{{assetSerialNo}}" class="muted small mt-4">SN {{assetSerialNo}}</view><view class="muted small mt-4">数量 ×{{quantity}}</view></view><ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view><view class="kv"><text class="kv__label">处理地点</text><text class="kv__value">{{locationName}}</text></view><view class="kv"><text class="kv__label">处理人</text><text class="kv__value">{{assignee}}</text></view><view wx:if="{{customerName}}" class="kv"><text class="kv__label">关联客户</text><text class="kv__value">{{customerName}} {{customerPhone}}</text></view></view></view>
    <view class="section section--tight"><view class="card work-order-info"><view class="subtitle">问题描述</view><view class="work-order-reason">{{reason}}</view></view></view>
    <view wx:if="{{photos.length}}" class="section section--tight"><view class="card work-order-info"><view class="row row--between"><view class="subtitle">现场图片</view><view class="muted small">{{photos.length}} 张</view></view><view class="work-order-photos"><image wx:for="{{photos}}" wx:key="id" wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill"></image></view></view></view>
    <view wx:if="{{result}}" class="section section--tight"><view class="card work-order-info"><view class="subtitle">处理结果</view><view class="work-order-reason">{{result}}</view></view></view>
    <view wx:if="{{canSubmit}}" class="section section--tight"><view class="card"><view class="field__label">处理结果</view><textarea class="field__textarea" maxlength="500" placeholder="记录维修、清洁或整备结果" value="{{result}}" bindinput="onResult"></textarea><view class="row row--between evidence-heading"><view class="muted small">现场凭证（可选，最多 9 张）</view><view class="link small" bindtap="onChooseEvidence">添加照片</view></view><view wx:if="{{evidenceToUpload.length}}" class="work-order-photos"><view wx:for="{{evidenceToUpload}}" wx:key="id" class="work-order-photo-draft"><image src="{{item.path}}" mode="aspectFill"></image><text data-index="{{index}}" catchtap="onRemoveEvidence">×</text></view></view></view></view>
    <view wx:if="{{history.length}}" class="section section--tight"><view class="card"><view class="subtitle">处理记录</view><view class="cell" wx:for="{{history}}" wx:key="id"><view class="cell__body"><view class="cell__title">{{item.action}}</view><view class="cell__desc">{{item.detail}} · {{item.createdAt}}</view></view></view></view></view>
    <view wx:if="{{error}}" class="section"><view class="notice notice--danger">{{error}}</view></view>
    <view wx:if="{{canClaim || canStart || canSubmit || canReview}}" class="bottom-bar"><button wx:if="{{canClaim}}" class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="onClaim">领取工单</button><button wx:if="{{canStart}}" class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="onStart">开始处理</button><button wx:if="{{canSubmit}}" class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="onSubmit">提交验收</button><view wx:if="{{canReview}}" class="btn-row grow"><button class="btn btn--outline" data-decision="rejected" disabled="{{busy}}" bindtap="onReview">驳回</button><button class="btn btn--primary" data-decision="approved" disabled="{{busy}}" bindtap="onReview">验收通过</button></view></view>
  </block>
</view>
