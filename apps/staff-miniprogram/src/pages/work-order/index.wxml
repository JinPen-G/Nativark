<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}">
  <nav-bar title="工单详情"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="section"><view class="card"><view class="row row--between"><view class="title">{{type}}</view><status-tag label="{{status}}" tone="{{tone}}" small="{{true}}"></status-tag></view><view class="muted small mt-8">{{workNo}}</view><view wx:if="{{showProgress}}" class="steps mt-16"><view class="steps__item {{index < progressStep ? 'steps__item--done' : index === progressStep ? 'steps__item--active' : ''}}" wx:for="{{progressLabels}}" wx:key="*this"><view class="steps__dot">{{index + 1}}</view><view class="steps__label">{{item}}</view></view></view><view class="kv mt-16"><text class="kv__label">问题描述</text><text class="kv__value">{{reason}}</text></view><view class="kv"><text class="kv__label">数量</text><text class="kv__value">{{quantity}}</text></view><view wx:if="{{result}}" class="kv"><text class="kv__label">处理结果</text><text class="kv__value">{{result}}</text></view><view class="cell" bindtap="onOrder"><view class="cell__body"><view class="cell__title">查看关联订单</view></view><ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view></view></view>
    <view class="section section--tight"><view class="card"><view class="kv"><text class="kv__label">处理人</text><text class="kv__value">{{assignee}}</text></view></view></view>
    <view wx:if="{{canSubmit}}" class="section section--tight"><view class="card"><view class="field__label">处理结果</view><textarea class="field__textarea" maxlength="500" placeholder="记录维修、清洁或整备结果" value="{{result}}" bindinput="onResult"></textarea><view class="muted small">凭证上传待员工文件接口开通后启用</view></view></view>
    <view wx:if="{{history.length}}" class="section section--tight"><view class="card"><view class="subtitle">处理记录</view><view class="cell" wx:for="{{history}}" wx:key="id"><view class="cell__body"><view class="cell__title">{{item.action}}</view><view class="cell__desc">{{item.detail}} · {{item.createdAt}}</view></view></view></view></view>
    <view wx:if="{{error}}" class="section"><view class="notice notice--danger">{{error}}</view></view>
    <view wx:if="{{canClaim || canStart || canSubmit || canReview}}" class="bottom-bar"><button wx:if="{{canClaim}}" class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="onClaim">领取工单</button><button wx:if="{{canStart}}" class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="onStart">开始处理</button><button wx:if="{{canSubmit}}" class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="onSubmit">提交验收</button><view wx:if="{{canReview}}" class="btn-row grow"><button class="btn btn--outline" data-decision="rejected" disabled="{{busy}}" bindtap="onReview">驳回</button><button class="btn btn--primary" data-decision="approved" disabled="{{busy}}" bindtap="onReview">验收通过</button></view></view>
  </block>
</view>
