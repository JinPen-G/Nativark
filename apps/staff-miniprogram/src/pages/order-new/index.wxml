<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}"><nav-bar title="新建订单"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="section"><view class="card"><view class="subtitle">客户信息</view><view class="form-row"><text class="form-row__label">客户类型</text><picker class="form-row__control" range="{{customerTypes}}" bindchange="onCustomerType">{{customerType === 'personal' ? '个人' : '企业'}}</picker></view><view class="form-row"><text class="form-row__label">客户名称 *</text><input class="form-row__input" placeholder="请输入客户名称" value="{{customerName}}" data-field="customerName" bindinput="onInput"/></view><view class="form-row"><text class="form-row__label">联系电话</text><input class="form-row__input" type="number" placeholder="请输入联系电话" value="{{phone}}" data-field="phone" bindinput="onInput"/></view></view></view>
    <view class="section section--tight"><view class="card"><view class="subtitle">租赁{{itemLabel}}</view><view class="form-row"><text class="form-row__label">型号 *</text><picker class="form-row__control" range="{{groups}}" range-key="name" bindchange="onGroup">{{groupName || '请选择型号'}}</picker></view><view class="form-row"><text class="form-row__label">数量 *</text><input class="form-row__input" type="number" value="{{quantity}}" data-field="quantity" bindinput="onInput"/></view></view></view>
    <view class="section section--tight"><view class="card"><view class="subtitle">租期与交付</view><view class="form-row"><text class="form-row__label">领取地点 *</text><picker class="form-row__control" range="{{locations}}" range-key="name" bindchange="onLocation">{{locationName || '请选择地点'}}</picker></view><view class="form-row"><text class="form-row__label">履约方式 *</text><picker class="form-row__control" range="{{modes}}" range-key="label" bindchange="onMode">{{modeLabel || '请选择方式'}}</picker></view><view class="form-row"><text class="form-row__label">开始日期</text><picker class="form-row__control" mode="date" value="{{startDate}}" start="{{today}}" data-field="startDate" bindchange="onDate">{{startDate}}</picker></view><view class="form-row"><text class="form-row__label">开始时间</text><picker class="form-row__control" mode="time" value="{{startTime}}" data-field="startTime" bindchange="onDate">{{startTime}}</picker></view><view class="form-row"><text class="form-row__label">结束日期</text><picker class="form-row__control" mode="date" value="{{endDate}}" start="{{today}}" data-field="endDate" bindchange="onDate">{{endDate}}</picker></view><view class="form-row"><text class="form-row__label">结束时间</text><picker class="form-row__control" mode="time" value="{{endTime}}" data-field="endTime" bindchange="onDate">{{endTime}}</picker></view><view class="muted small mt-12">{{zoneHint}}</view></view></view>
    <view wx:if="{{quoteNo}}" class="section section--tight"><view class="card"><view class="subtitle">服务端报价 #{{quoteNo}}</view><view class="kv mt-12"><text class="kv__label">本次应收</text><text class="kv__value">{{quoteText}}</text></view><view class="kv"><text class="kv__label">其中押金</text><text class="kv__value">{{depositText}}</text></view></view></view>
    <view wx:if="{{error}}" class="section small" style="color:var(--danger)">{{error}}</view>
    <view class="section section--tight"><button class="btn btn--ghost btn--block" loading="{{busy}}" disabled="{{busy}}" bindtap="onQuote">获取报价</button><button wx:if="{{quoteNo}}" class="btn btn--primary btn--block mt-12" loading="{{busy}}" disabled="{{busy}}" bindtap="onCreate">确认创建订单</button></view>
  </block>
</view>
