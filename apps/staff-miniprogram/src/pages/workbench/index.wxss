/* 设计图：浅蓝横幅、独立快捷入口和轻量待办列表。 */
.hero--workbench { min-height: 214rpx; display: flex; align-items: center; background: #EAF3FF; color: #142A55; box-shadow: none; padding: 28rpx 30rpx; }
.hero--workbench .hero__copy { width: 57%; position: relative; z-index: 1; }
.hero--workbench .hero__title { font-size: 36rpx; line-height: 1.28; font-weight: 700; }
.hero--workbench .hero__subtitle { margin-top: 12rpx; color: #506381; font-size: 22rpx; line-height: 1.4; opacity: 1; }
.hero--workbench .hero__art { right: 12rpx; top: 12rpx; bottom: 12rpx; transform: none; width: 40%; height: auto; border-radius: 16rpx; background: #F8FBFF; overflow: hidden; }
.hero__photo { width: 100%; height: 100%; }
.quick-panel { padding: 4rpx 0; }
.quick-panel .quick { padding-top: 12rpx; padding-bottom: 12rpx; }
.quick-panel .quick__icon { width: 76rpx; height: 76rpx; border-radius: 22rpx; }
.quick-panel .quick__label { font-size: 22rpx; margin-top: 10rpx; white-space: nowrap; }
.todo-panel { background: var(--surface); border-radius: var(--radius); padding: 0 20rpx; box-shadow: var(--shadow); }
.todo-panel .todo { min-height: 78rpx; }
.quick-panel--common { padding-top: 0; }
.quick-panel--common .quick__icon { background: var(--primary-weak); }
.theme-dark .hero--workbench { background: #1B2C45; color: var(--text); }
.theme-dark .hero--workbench .hero__subtitle { color: var(--secondary); }
.theme-dark .hero--workbench .hero__art { background: #F8FBFF; }
