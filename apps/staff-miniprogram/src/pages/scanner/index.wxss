.scanner { position: relative; height: 100vh; overflow: hidden; background: #17202D; color: #FFFFFF; }
.scanner__camera { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.scanner__preview { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.scanner__shade { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(8, 16, 29, 0.52); pointer-events: none; }
.scanner__top { position: absolute; top: 0; left: 0; right: 0; height: 180rpx; display: flex; align-items: flex-end; justify-content: space-between; padding: 0 34rpx 16rpx; }
.scanner__close { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.scanner__guide { position: absolute; left: 0; right: 0; top: 27%; text-align: center; font-size: var(--font-body); line-height: 1.7; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.6); }
.scanner__frame { position: absolute; left: 17%; top: 38%; width: 66%; height: 240rpx; background: rgba(255,255,255,0.04); }
.scanner__corner { position: absolute; width: 46rpx; height: 46rpx; border: 6rpx solid #2F96FF; }
.scanner__corner--tl { left: 0; top: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 12rpx; }
.scanner__corner--tr { right: 0; top: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 12rpx; }
.scanner__corner--bl { left: 0; bottom: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 12rpx; }
.scanner__corner--br { right: 0; bottom: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 12rpx; }
.scanner__line { position: absolute; top: 50%; left: 2%; right: 2%; height: 3rpx; background: #48B4FF; box-shadow: 0 0 18rpx #44A7FF; }
.scanner__error { position: absolute; left: 50%; bottom: calc(208rpx + env(safe-area-inset-bottom)); transform: translateX(-50%); padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(20, 24, 32, .62); color: rgba(255,255,255,.88); font-size: var(--font-mini); white-space: nowrap; text-align: center; }
.scanner__toolbar { position: absolute; left: 10%; right: 10%; bottom: calc(100rpx + env(safe-area-inset-bottom)); display: flex; justify-content: space-between; }
.scanner__tool { display: flex; flex-direction: column; align-items: center; gap: 10rpx; font-size: var(--font-mini); min-width: 130rpx; }
.scanner__tool-icon { width: 74rpx; height: 74rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; }
.scanner__hint { position: absolute; left: 8%; right: 8%; bottom: calc(28rpx + env(safe-area-inset-bottom)); padding: 12rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,0.14); text-align: center; font-size: var(--font-mini); }
