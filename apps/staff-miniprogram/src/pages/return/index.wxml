<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}"><nav-bar title="{{returnLabel}}验收"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="return-steps"><view class="return-step return-step--done"><text>✓</text><view>{{pickupLabel}}完成</view></view><view class="return-step return-step--active"><text>2</text><view>{{itemLabel}}{{returnLabel}}</view></view><view class="return-step"><text>3</text><view>验收检查</view></view><view class="return-step"><text>4</text><view>订单完成</view></view></view>
    <view class="section"><view class="card return-summary"><view class="kv"><text class="kv__label">订单编号</text><text class="kv__value">#{{orderNo}}</text></view><view class="kv"><text class="kv__label">客户名称</text><text class="kv__value">{{customer}} {{phone}}</text></view><view class="kv"><text class="kv__label">租赁时间</text><text class="kv__value">{{period}}</text></view><view class="kv"><text class="kv__label">{{returnLabel}}地点</text><text class="kv__value">{{returnLocation}}</text></view></view></view>
    <view class="section section--tight"><view class="card">
      <view class="row row--between"><view class="subtitle">{{itemLabel}}{{returnLabel}}验收</view><button wx:if="{{hasBulk}}" class="btn btn--small btn--secondary" bindtap="onBulkPass">批量通过</button></view>
      <view class="muted small mt-4">{{templateName}}</view>
      <view wx:if="{{!allocations.length}}" class="muted mt-12">暂无可归还的已领取资源，请刷新订单核对。</view>
      <view class="device" wx:for="{{allocations}}" wx:for-item="alloc" wx:for-index="ai" wx:key="id">
        <view class="device__head"><switch checked="{{alloc.selected}}" data-index="{{ai}}" bindchange="onToggleAllocation" color="#1677FF"/><view class="grow ml-12"><view class="subtitle">{{alloc.title}}</view><view class="muted small">{{alloc.identifier}} · 待还 {{alloc.max}}</view></view><input class="return-quantity" type="number" value="{{alloc.quantity}}" data-index="{{ai}}" bindinput="onQuantity"/></view>
        <view class="form-row" wx:for="{{alloc.fields}}" wx:for-item="field" wx:for-index="fi" wx:key="code"><view class="form-row__label">{{field.label}}{{field.required ? ' *' : ''}}</view><view class="form-row__control"><switch checked="{{field.checked}}" data-ai="{{ai}}" data-fi="{{fi}}" bindchange="onFieldBool" color="#1677FF"/></view></view>
      </view>
      <view wx:if="{{sharedFields.length}}" class="shared-head muted small">整单检查项</view>
      <view class="form-row" wx:for="{{sharedFields}}" wx:key="code"><view class="form-row__label">{{item.label}}{{item.required ? ' *' : ''}}</view><view class="form-row__control"><picker wx:if="{{item.type === 'select'}}" range="{{item.options}}" data-index="{{index}}" bindchange="onFieldSelect"><text class="form-row__value">{{item.value || '请选择'}}</text></picker><input wx:elif="{{item.type === 'number'}}" class="form-row__input" type="digit" placeholder="填写数值" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldInput"/><input wx:elif="{{item.type === 'text'}}" class="form-row__input" placeholder="填写检查结果" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldInput"/><view wx:elif="{{item.type === 'photo'}}" class="inspection-photos"><view class="photo-grid"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id" src="{{photo.path}}" mode="aspectFill"/></view><button class="btn btn--secondary btn--small" data-index="{{index}}" disabled="{{uploading || item.photos.length >= 5}}" bindtap="onChooseEvidencePhoto">{{uploading ? '正在上传…' : item.photos.length ? '继续添加照片' : '拍摄 / 选择照片'}}</button><text class="muted tiny">最多 5 张，上传成功后才可提交</text></view></view></view>
      <view wx:if="{{noTemplate}}" class="muted mt-12">当前品类无启用的{{returnLabel}}检查模板，确认后直接交接。</view>
    </view></view>
    <view class="section section--tight"><view class="card">
      <view class="section-title">费用结算</view>
      <view class="kv"><text class="kv__label">租金</text><money-text amount="{{feeRent}}" currency="{{currency}}"></money-text></view>
      <view class="kv"><text class="kv__label">损坏赔偿 · 异常费用</text><money-text amount="{{feeException}}" currency="{{currency}}"></money-text></view>
      <view class="kv"><text class="kv__label">其他</text><money-text amount="{{feeOther}}" currency="{{currency}}" signed="{{true}}"></money-text></view>
      <view class="kv"><text class="kv__label strong">实付金额</text><money-text amount="{{feeFinal}}" currency="{{currency}}" tone="primary"></money-text></view>
      <view class="muted small mt-4">损坏赔偿等异常费用最终以商户结算为准。</view>
    </view></view>
    <view class="section section--tight"><view class="card signature-card"><view class="row row--between"><view class="subtitle">客户现场签字 *</view><button class="link small signature-clear" bindtap="onClearSignature">清除重签</button></view><view class="muted small">请客户核对归还物品及检查结果后，在下方签名确认。</view><canvas canvas-id="returnSignature" class="signature-pad" style="width:{{signatureWidth}}px;height:{{signatureHeight}}px" width="{{signatureWidth}}" height="{{signatureHeight}}" disable-scroll="true" bindtouchstart="onSignatureStart" bindtouchmove="onSignatureMove" bindtouchend="onSignatureEnd"></canvas><view class="signature-status muted tiny">{{signatureFileAssetId ? '签字已上传，可提交' : signatureDrawn ? '已签名，提交时会安全上传' : '签字为必填项'}}</view></view></view>
    <view wx:if="{{error}}" class="section small" style="color:var(--danger)">{{error}}</view>
    <view class="bottom-bar"><button class="btn btn--primary btn--block" loading="{{busy}}" disabled="{{busy || uploading || !allocations.length}}" bindtap="onSubmit">确认{{returnLabel}}</button></view>
  </block>
  <ai-inspection-assist id="ai-inspection-assist" hidden="{{!aiInspectionVisible}}" />
</view>
