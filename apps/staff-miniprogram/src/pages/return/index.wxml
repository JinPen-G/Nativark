<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}"><nav-bar title="办理归还"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="section"><view class="card"><view class="title">#{{orderNo}}</view><view class="muted mt-8">{{customer}} · 归还地点：{{returnLocation}}</view><view class="subtitle mt-16">本次归还{{itemLabel}}</view><view wx:if="{{!allocations.length}}" class="muted mt-12">暂无可归还的已领取资源，请刷新订单核对。</view><view class="cell" wx:for="{{allocations}}" wx:key="id"><switch checked="{{item.selected}}" data-index="{{index}}" bindchange="onToggleAllocation" color="#1677FF"/><view class="cell__body ml-12"><view class="cell__title">{{item.label}}</view><view class="cell__desc">待还 {{item.max}}</view></view><input class="return-quantity" type="number" value="{{item.quantity}}" data-index="{{index}}" bindinput="onQuantity"/></view></view></view>
    <view class="section section--tight"><view class="card"><view class="subtitle">归还检查 · {{templateName}}</view><view wx:if="{{noTemplate}}" class="muted mt-12">当前品类无启用的归还检查模板，确认后直接交接。</view><view class="form-row" wx:for="{{fields}}" wx:key="code"><view class="form-row__label">{{item.label}}{{item.required ? ' *' : ''}}</view><view class="form-row__control"><switch wx:if="{{item.type === 'boolean'}}" checked="{{item.checked}}" data-index="{{index}}" bindchange="onFieldBool" color="#1677FF"/><picker wx:elif="{{item.type === 'select'}}" range="{{item.options}}" data-index="{{index}}" bindchange="onFieldSelect"><text class="form-row__value">{{item.value || '请选择'}}</text></picker><input wx:elif="{{item.type === 'number'}}" class="form-row__input" type="digit" placeholder="填写数值" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldInput"/><input wx:elif="{{item.type === 'text'}}" class="form-row__input" placeholder="填写检查结果" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldInput"/><text wx:else class="muted small">需在后台上传照片</text></view></view></view></view>
    <view wx:if="{{error}}" class="section small" style="color:var(--danger)">{{error}}</view>
    <view class="bottom-bar"><button class="btn btn--primary btn--block" loading="{{busy}}" disabled="{{busy || !allocations.length}}" bindtap="onSubmit">确认归还</button></view>
  </block>
</view>
