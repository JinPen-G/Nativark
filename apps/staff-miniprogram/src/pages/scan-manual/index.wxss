/* 手动输入 / 历史记录 */
.seg--even { height: 88rpx; padding: 0 20rpx; }
.seg--even .seg__item { flex: 0 0 50%; justify-content: center; font-size: var(--font-secondary); }
.seg--even .seg__item--active::after { left: 31%; right: 31%; height: 4rpx; }
.manual-input { background: var(--surface); border: 1rpx solid var(--line); }
.manual-input__scan { margin-left: 8rpx; padding-left: 16rpx; border-left: 1rpx solid var(--border); }
.card { box-shadow: none; border: 1rpx solid var(--border); }
.sec-head__title { font-size: var(--font-body); }
.hist-thumb { width: 78rpx; height: 78rpx; border-radius: var(--radius-sm); background: var(--page); overflow: hidden; margin-right: 14rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
.hist-thumb image { width: 100%; height: 100%; }
