/* 手动输入 / 历史记录 */
.seg--even .seg__item { flex: 1; justify-content: center; }
.manual-input { background: var(--surface); border: 1rpx solid var(--line); }
.manual-input { background: #F2F6FC; border: 0; border-radius: 14rpx; }
.manual-input__scan { margin-left: 8rpx; padding-left: 16rpx; border-left: 1rpx solid var(--border); }
.hist-thumb { width: 96rpx; height: 96rpx; border-radius: var(--radius-sm); background: var(--page); overflow: hidden; margin-right: 20rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
.hist-thumb image { width: 100%; height: 100%; }
.card { box-shadow: none; border: 1rpx solid var(--border); }
.theme-dark .manual-input { background: var(--surface); border: 1rpx solid var(--line); }
