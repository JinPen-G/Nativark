<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}"><nav-bar title="{{id ? '编辑客户' : '新增客户'}}"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="section"><view class="card"><view class="subtitle">基本资料</view><view class="form-row"><text class="form-row__label">客户类型</text><picker class="form-row__control" range="{{types}}" disabled="{{id !== ''}}" bindchange="onType">{{customerType === 'personal' ? '个人' : '企业'}}</picker></view><view class="form-row"><text class="form-row__label">姓名/名称 *</text><input class="form-row__input" value="{{name}}" placeholder="请填写" data-field="name" bindinput="onInput"/></view><view class="form-row"><text class="form-row__label">联系电话{{id ? '' : ' *'}}</text><input class="form-row__input" type="number" value="{{phone}}" placeholder="{{phoneHint || '请填写'}}" data-field="phone" bindinput="onInput"/></view><view wx:if="{{id}}" class="muted small mt-12">留空表示保留原号码；现有号码仅显示脱敏值。</view><view class="form-row"><text class="form-row__label">邮箱</text><input class="form-row__input" value="{{email}}" placeholder="选填" data-field="email" bindinput="onInput"/></view><view wx:if="{{customerType === 'corporate'}}" class="form-row"><text class="form-row__label">企业名称 *</text><input class="form-row__input" value="{{corporateName}}" placeholder="请填写企业名称" data-field="corporateName" bindinput="onInput"/></view><view wx:if="{{customerType === 'personal'}}" class="form-row"><text class="form-row__label">地区</text><input class="form-row__input" value="{{region}}" placeholder="选填" data-field="region" bindinput="onInput"/></view></view></view>
    <view wx:if="{{error}}" class="section small" style="color:var(--danger)">{{error}}</view>
    <view class="section section--tight"><button class="btn btn--primary btn--block" loading="{{busy}}" disabled="{{busy}}" bindtap="onSave">保存客户资料</button></view>
  </block>
</view>
