<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen screen--flat {{themeClass}}">
  <nav-bar title="客户详情"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="section customer-head">
      <view class="avatar-lg customer-avatar">{{initial}}</view>
      <view class="grow ml-16"><view class="row"><view class="title">{{name}}</view><view class="pill ml-8">{{typeBadge}}</view></view><view class="muted mt-4">{{phoneMasked}}</view><view class="muted small">{{type}} · 合作 {{cooperationCount}} 次</view></view>
    </view>
    <view class="customer-tabs">
      <view class="customer-tab {{tab === 'info' ? 'customer-tab--active' : ''}}" data-tab="info" bindtap="onTab">客户信息</view>
      <view class="customer-tab {{tab === 'orders' ? 'customer-tab--active' : ''}}" data-tab="orders" bindtap="onTab">租赁订单</view>
      <view class="customer-tab {{tab === 'service' ? 'customer-tab--active' : ''}}" data-tab="service" bindtap="onTab">服务记录</view>
    </view>
    <block wx:if="{{tab === 'info'}}">
      <view class="section"><view class="card customer-card"><view class="row row--between"><view class="subtitle">基本信息</view><view wx:if="{{canEdit}}" class="link" bindtap="onEdit">编辑</view></view><view class="kv"><text class="kv__label">姓名</text><text class="kv__value">{{name}}</text></view><view class="kv"><text class="kv__label">手机号</text><text class="kv__value">{{phoneMasked}}</text></view><view wx:if="{{email}}" class="kv"><text class="kv__label">邮箱</text><text class="kv__value">{{email}}</text></view><view wx:if="{{identityNoMasked}}" class="kv"><text class="kv__label">身份证号</text><text class="kv__value">{{identityNoMasked}}</text></view><view class="kv"><text class="kv__label">客户类型</text><text class="kv__value">{{type}}</text></view><view class="kv"><text class="kv__label">状态</text><text class="kv__value">{{status}}</text></view><view class="kv"><text class="kv__label">注册时间</text><text class="kv__value">{{registeredAt}}</text></view><view wx:if="{{corporateName}}" class="kv"><text class="kv__label">企业</text><text class="kv__value">{{corporateName}}</text></view></view></view>
      <view class="section section--tight"><view class="card customer-card"><view class="subtitle">联系地址</view><view class="customer-address"><ui-icon name="pin" size="30" color="primary"></ui-icon><text>{{address || '暂无地址信息'}}</text></view></view></view>
      <view class="section section--tight"><view class="row row--between customer-section-title"><view class="subtitle">客户订单</view><view class="link" data-tab="orders" bindtap="onTab">查看更多 ›</view></view><view class="card customer-card"><view wx:if="{{!orders.length}}" class="muted">暂无可查看的订单</view><view class="cell" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrder"><view class="cell__body"><view class="cell__title">#{{item.orderNo}}</view><view class="cell__desc">{{item.status}}</view></view><ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view></view></view>
    </block>
    <view wx:elif="{{tab === 'orders'}}" class="section"><view class="card customer-card"><view wx:if="{{!orders.length}}" class="muted">暂无可查看的订单</view><view class="cell" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrder"><view class="cell__body"><view class="cell__title">#{{item.orderNo}}</view><view class="cell__desc">{{item.status}}</view></view><ui-icon name="chevron-right" size="28" color="muted"></ui-icon></view></view></view>
    <view wx:else class="section"><view class="card customer-card muted">当前暂无可查看的服务记录</view></view>
    <view class="bottom-bar customer-actions"><button class="btn btn--secondary" bindtap="onCall">联系客户</button><button wx:if="{{canCreateOrder}}" class="btn btn--primary" bindtap="onNewOrder">新建订单</button></view>
  </block>
</view>
