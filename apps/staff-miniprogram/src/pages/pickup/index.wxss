.screen { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.card { box-shadow: none; border: 1rpx solid var(--border); }
.card > .subtitle { font-weight: 700; padding-bottom: 8rpx; }
.form-row { min-height: 86rpx; }
.form-row__label { width: 48%; font-size: 25rpx; }
.form-row__control { justify-content: flex-end; }
.screen > .section { padding-left: 24rpx; padding-right: 24rpx; }
.screen .card { padding: 18rpx; border-radius: 16rpx; }
.handover-steps { display: flex; justify-content: space-around; margin: 16rpx 24rpx 4rpx; padding: 12rpx 0; background: var(--surface); border-radius: 14rpx; }
.handover-step { flex: 1; text-align: center; color: var(--secondary); font-size: 20rpx; }
.handover-step text { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin: 0 auto 5rpx; border-radius: 50%; background: var(--line); color: var(--secondary); font-size: 20rpx; }
.handover-step--active { color: var(--primary); font-weight: 600; }
.handover-step--active text { background: var(--primary); color: #fff; }
.pickup-summary .kv { min-height: 51rpx; }
.pickup-summary .kv__value { max-width: 65%; text-align: right; font-size: 22rpx; }
.pickup-line { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.pickup-line__thumb { width: 80rpx; height: 80rpx; background: var(--primary-weak); border-radius: 10rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.pickup-line__thumb image { width: 100%; height: 100%; }
.bottom-bar .btn { border-radius: 12rpx; }
.handover-step { position: relative; z-index: 1; }
.handover-step:not(:last-child)::after { content: ""; position: absolute; z-index: -1; top: 16rpx; left: calc(50% + 19rpx); right: calc(-50% + 19rpx); height: 2rpx; background: var(--line); }
.handover-step--active:not(:last-child)::after { background: var(--line); }
.inspection-photos { display: flex; flex-direction: column; align-items: flex-start; gap: 10rpx; width: 100%; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.photo-grid image { width: 132rpx; height: 132rpx; border-radius: 10rpx; background: var(--page); }
.signature-card { margin-bottom: 24rpx; }
.signature-pad { display: block; margin-top: 18rpx; border: 1rpx dashed var(--border); border-radius: 12rpx; background: #fff; touch-action: none; }
.signature-clear { padding: 0; background: transparent; }
.signature-status { text-align: right; margin-top: 8rpx; }
