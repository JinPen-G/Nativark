<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}"><nav-bar title="{{pickupLabel}}登记"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>
  <block wx:else>
    <view class="handover-steps"><view class="handover-step handover-step--active"><text>1</text><view>{{pickupLabel}}登记</view></view><view class="handover-step"><text>2</text><view>{{itemLabel}}检查</view></view><view class="handover-step"><text>3</text><view>确认交付</view></view><view class="handover-step"><text>4</text><view>完成</view></view></view>
    <view class="section"><view class="card pickup-summary"><view class="kv"><text class="kv__label">订单编号</text><text class="kv__value">#{{orderNo}}</text></view><view class="kv"><text class="kv__label">客户名称</text><text class="kv__value">{{customer}} {{phone}}</text></view><view class="kv"><text class="kv__label">租赁时间</text><text class="kv__value">{{period}}</text></view><view class="kv"><text class="kv__label">{{pickupLabel}}地点</text><text class="kv__value">{{location}}</text></view></view></view>
    <view class="section section--tight"><view class="card">
      <view class="row row--between"><view class="subtitle">{{itemLabel}}{{pickupLabel}}检查</view><button wx:if="{{hasBulk}}" class="btn btn--small btn--secondary" bindtap="onBulkPass">批量通过</button></view>
      <view class="muted small mt-4">{{templateName}}</view>
      <view wx:if="{{noTemplate}}" class="muted mt-12">当前品类无启用的{{pickupLabel}}检查模板，确认后直接交接。</view>
      <view class="device" wx:for="{{groups}}" wx:for-item="group" wx:for-index="gi" wx:key="allocationId">
        <view class="device__head"><view class="device__thumb"><image wx:if="{{group.imagePath}}" src="{{group.imagePath}}" mode="aspectFit"></image><ui-icon wx:else name="box" size="40" color="muted"></ui-icon></view><view class="grow"><view class="subtitle">{{group.title}}</view><view class="muted small">{{group.identifier}}</view></view></view>
        <view class="form-row" wx:for="{{group.fields}}" wx:for-item="field" wx:for-index="fi" wx:key="code"><view class="form-row__label">{{field.label}}{{field.required ? ' *' : ''}}</view><view class="form-row__control"><switch checked="{{field.checked}}" data-gi="{{gi}}" data-fi="{{fi}}" bindchange="onFieldBool" color="#1677FF"/></view></view>
      </view>
      <view wx:if="{{sharedFields.length}}" class="shared-head muted small">整单检查项</view>
      <view class="form-row" wx:for="{{sharedFields}}" wx:key="code"><view class="form-row__label">{{item.label}}{{item.required ? ' *' : ''}}</view><view class="form-row__control"><picker wx:if="{{item.type === 'select'}}" range="{{item.options}}" data-index="{{index}}" bindchange="onFieldSelect"><text class="form-row__value">{{item.value || '请选择'}}</text></picker><input wx:elif="{{item.type === 'number'}}" class="form-row__input" type="digit" placeholder="填写数值" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldInput"/><input wx:elif="{{item.type === 'text'}}" class="form-row__input" placeholder="填写检查结果" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldInput"/><view wx:elif="{{item.type === 'photo'}}" class="inspection-photos"><view class="photo-grid"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id" src="{{photo.path}}" mode="aspectFill"/></view><button class="btn btn--secondary btn--small" data-index="{{index}}" disabled="{{uploading || item.photos.length >= 5}}" bindtap="onChooseEvidencePhoto">{{uploading ? '正在上传…' : item.photos.length ? '继续添加照片' : '拍摄 / 选择照片'}}</button><text class="muted tiny">最多 5 张，上传成功后才可提交</text></view></view></view>
    </view></view>
    <view class="section section--tight"><view class="card signature-card"><view class="row row--between"><view class="subtitle">客户现场签字 *</view><button class="link small signature-clear" bindtap="onClearSignature">清除重签</button></view><view class="muted small">请客户核对订单及交付物品后，在下方签名确认。</view><canvas canvas-id="pickupSignature" class="signature-pad" style="width:{{signatureWidth}}px;height:{{signatureHeight}}px" width="{{signatureWidth}}" height="{{signatureHeight}}" disable-scroll="true" bindtouchstart="onSignatureStart" bindtouchmove="onSignatureMove" bindtouchend="onSignatureEnd"></canvas><view class="signature-status muted tiny">{{signatureFileAssetId ? '签字已上传，可提交' : signatureDrawn ? '已签名，提交时会安全上传' : '签字为必填项'}}</view></view></view>
    <view class="section section--tight"><view class="card">
      <view class="section-title">交接门禁</view>
      <view class="muted small mt-4">以下为提交前的门禁核对，最终由服务端在提交时校验。</view>
      <view class="gate" wx:for="{{gates}}" wx:for-item="gate" wx:key="key"><view class="grow"><view class="body">{{gate.label}}</view><view wx:if="{{gate.hint}}" class="muted small">{{gate.hint}}</view></view><status-tag label="{{gate.status}}" tone="{{gate.tone}}" small="{{true}}"></status-tag></view>
      <view class="gate"><view class="grow"><view class="body">交接确认</view><view class="muted small">客户现场签字完成即视为交接确认。</view></view><status-tag label="{{signatureFileAssetId ? '已确认' : signatureDrawn ? '已签字' : '待签字'}}" tone="{{signatureFileAssetId ? 'success' : signatureDrawn ? 'info' : 'warning'}}" small="{{true}}"></status-tag></view>
    </view></view>
    <view wx:if="{{error}}" class="section small" style="color:var(--danger)">{{error}}</view>
    <view class="bottom-bar"><button class="btn btn--primary btn--block" loading="{{busy}}" disabled="{{busy || uploading}}" bindtap="onSubmit">确认{{pickupLabel}}并交付</button></view>
  </block>
</view>
