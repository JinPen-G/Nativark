<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen screen--flat {{themeClass}}">
  <nav-bar title="商品资料"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}"
    message="{{view.message}}" action-text="{{view.actionText}}" secondary-text="{{view.secondaryText}}" bind:action="onRetry"></state-view>
  <view wx:else class="section">
    <view class="title">{{name}}</view>
    <view class="muted mt-8">{{code}} · {{status}}</view>
    <view class="mt-16">单位：{{unit}}</view>
    <button class="btn btn--secondary btn--small mt-16" bindtap="onRetry">重新读取</button>
  </view>
</view>
