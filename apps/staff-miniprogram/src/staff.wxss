/* 员工端共享样式：设计图中反复出现的版式。全部走 var(--token)，深浅色自动跟随。 */

/* 顶部英雄卡（工作台 / 扫码首页） */
.hero { position: relative; overflow: hidden; border-radius: var(--radius); padding: 32rpx 32rpx 36rpx; background: linear-gradient(135deg, #1677FF 0%, #4C9BFF 60%, #7FB8FF 100%); color: #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.25); }
.hero__title { font-size: var(--font-page-title); font-weight: var(--fw-bold); line-height: 1.25; }
.hero__subtitle { margin-top: 10rpx; font-size: var(--font-caption); opacity: 0.9; }
.hero__art { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); width: 160rpx; height: 160rpx; display: flex; align-items: center; justify-content: center; border-radius: 32rpx; background: rgba(255, 255, 255, 0.16); }
.hero--soft { background: linear-gradient(135deg, #EAF2FF 0%, #F4F8FF 100%); color: var(--text); box-shadow: none; }
.hero--soft .hero__subtitle { color: var(--secondary); opacity: 1; }

/* 四宫格快捷入口 */
.quick-grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.quick { width: 25%; padding: 16rpx 8rpx; display: flex; flex-direction: column; align-items: center; }
.quick__icon { width: 88rpx; height: 88rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; background: var(--primary-weak); }
.quick__icon--green { background: var(--success-weak); }
.quick__icon--orange { background: var(--warning-weak); }
.quick__icon--purple { background: rgba(124, 92, 255, 0.12); }
.quick__icon--teal { background: rgba(15, 163, 177, 0.12); }
.quick__icon--red { background: var(--danger-weak); }
.quick__label { margin-top: 12rpx; font-size: 24rpx; color: var(--text); text-align: center; }
.quick__hint { font-size: 20rpx; color: var(--muted); margin-top: 4rpx; }

/* 计数瓦片（今日待办） */
.tiles { display: flex; margin: 0 -8rpx; }
.tile { flex: 1; margin: 0 8rpx; padding: 24rpx 20rpx; border-radius: var(--radius); background: var(--primary-weak); }
.tile--green { background: var(--success-weak); }
.tile--orange { background: var(--warning-weak); }
.tile--red { background: var(--danger-weak); }
.tile__num { font-size: 44rpx; font-weight: 700; line-height: 1; color: var(--primary); }
.tile--green .tile__num { color: var(--success); }
.tile--orange .tile__num { color: var(--warning); }
.tile--red .tile__num { color: var(--danger); }
.tile__label { margin-top: 10rpx; font-size: 24rpx; color: var(--secondary); }

/* 待办行 */
.todo { display: flex; align-items: center; min-height: 88rpx; padding: 12rpx 0; }
.todo + .todo { border-top: 1rpx solid var(--border); }
.todo__icon { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex: 0 0 auto; background: var(--primary-weak); }
.todo__icon--warning { background: var(--warning-weak); }
.todo__icon--danger { background: var(--danger-weak); }
.todo__icon--info { background: var(--primary-weak); }
.todo__icon--purple { background: rgba(124, 92, 255, 0.12); }
.todo__icon--muted { background: var(--page); }
.todo__title { flex: 1; font-size: var(--font-body); color: var(--text); }
.todo__desc { font-size: 22rpx; color: var(--secondary); margin-top: 4rpx; }
.badge { min-width: 36rpx; height: 36rpx; padding: 0 10rpx; border-radius: 18rpx; background: var(--danger); color: #FFFFFF; font-size: 22rpx; display: inline-flex; align-items: center; justify-content: center; }
.badge--muted { background: var(--muted); }

/* 区块标题行 */
.sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.sec-head__title { font-size: var(--font-section); font-weight: var(--fw-semibold); color: var(--text); display: flex; align-items: center; }
.sec-head__more { display: inline-flex; align-items: center; font-size: var(--font-caption); color: var(--secondary); }

/* 页签（订单筛选） */
.seg { display: flex; align-items: center; height: 88rpx; background: var(--surface); padding: 0 16rpx; }
.seg__item { position: relative; padding: 0 20rpx; height: 100%; display: flex; align-items: center; font-size: 28rpx; color: var(--secondary); }
.seg__item--active { color: var(--primary); font-weight: 600; }
.seg__item--active::after { content: ""; position: absolute; left: 20rpx; right: 20rpx; bottom: 0; height: 6rpx; border-radius: 3rpx; background: var(--primary); }

/* 订单卡片 */
.order-card { background: var(--surface); border-radius: var(--radius); padding: 24rpx; box-shadow: var(--shadow); }
.order-card + .order-card { margin-top: 16rpx; }
.order-card__head { display: flex; align-items: center; justify-content: space-between; }
.order-card__no { font-size: 28rpx; font-weight: 600; color: var(--text); }
.order-card__body { display: flex; margin-top: 16rpx; }
.order-card__thumb { width: 128rpx; height: 128rpx; border-radius: var(--radius-sm); background: var(--page); overflow: hidden; margin-right: 20rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
.order-card__thumb image { width: 100%; height: 100%; }
.order-card__meta { font-size: 24rpx; color: var(--secondary); margin-top: 6rpx; }
.order-card__items { font-size: 26rpx; color: var(--text); margin-top: 6rpx; }

/* 步骤条 */
.steps { display: flex; align-items: flex-start; padding: 8rpx 0 4rpx; }
.steps__item { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
.steps__dot { width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--line); color: var(--secondary); font-size: 22rpx; display: flex; align-items: center; justify-content: center; z-index: 1; }
.steps__item--active .steps__dot { background: var(--primary); color: #FFFFFF; }
.steps__item--done .steps__dot { background: var(--primary); color: #FFFFFF; }
.steps__label { margin-top: 10rpx; font-size: 22rpx; color: var(--secondary); white-space: nowrap; }
.steps__item--active .steps__label { color: var(--primary); font-weight: 600; }
.steps__item--done .steps__label { color: var(--text); }
.steps__item::before { content: ""; position: absolute; top: 20rpx; left: -50%; right: 50%; height: 4rpx; background: var(--line); }
.steps__item:first-child::before { display: none; }
.steps__item--done::before, .steps__item--active::before { background: var(--primary); }

/* 检查清单行 */
.check-row { display: flex; align-items: center; min-height: 72rpx; padding: 8rpx 0; }
.check-row__label { flex: 1; font-size: 26rpx; color: var(--text); }
.check-row__ok { width: 36rpx; height: 36rpx; border-radius: 50%; background: var(--success); color: #FFFFFF; font-size: 22rpx; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; }
.check-row__todo { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid var(--line); margin-right: 12rpx; }
.check-row__value { font-size: 26rpx; color: var(--secondary); margin-right: 8rpx; }

/* 时间线 */
.timeline { padding-left: 8rpx; }
.tl { display: flex; padding-bottom: 28rpx; position: relative; }
.tl::before { content: ""; position: absolute; left: 74rpx; top: 40rpx; bottom: 0; width: 2rpx; background: var(--line); }
.tl:last-child::before { display: none; }
.tl__date { width: 64rpx; flex: 0 0 auto; font-size: 22rpx; color: var(--secondary); line-height: 1.4; }
.tl__dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--primary); margin: 8rpx 20rpx 0 0; flex: 0 0 auto; }
.tl__body { flex: 1; }
.tl__title { font-size: 28rpx; color: var(--text); display: flex; align-items: center; }
.tl__desc { font-size: 24rpx; color: var(--secondary); margin-top: 6rpx; line-height: 1.5; }
.tl__month { font-size: 26rpx; font-weight: 600; color: var(--text); margin: 8rpx 0 16rpx; }

/* 表单行（标签左、控件右） */
.form-row { display: flex; align-items: center; min-height: 96rpx; padding: 0 0; border-bottom: 1rpx solid var(--border); }
.form-row:last-child { border-bottom: 0; }
.form-row__label { width: 176rpx; flex: 0 0 auto; font-size: 28rpx; color: var(--text); }
.form-row__label--required::after { content: " *"; color: var(--danger); }
.form-row__control { flex: 1; display: flex; align-items: center; justify-content: flex-end; min-width: 0; }
.form-row__input { flex: 1; text-align: right; font-size: 28rpx; color: var(--text); min-height: 60rpx; }
.form-row__value { font-size: 28rpx; color: var(--text); text-align: right; }
.form-row__placeholder { color: var(--muted); }
.form-row__hint { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }
.form-section { font-size: 28rpx; font-weight: 600; color: var(--text); margin: 24rpx 0 8rpx; }

/* 头像 */
.avatar-lg { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--primary-weak); display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 600; color: var(--primary); }

/* 信息胶囊（角色/状态） */
.pill { display: inline-flex; align-items: center; height: 40rpx; padding: 0 16rpx; border-radius: 20rpx; background: var(--primary-weak); color: var(--primary); font-size: 22rpx; margin-left: 12rpx; }
