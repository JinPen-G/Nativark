{
  "pages": [
    "pages/login/index",
    "pages/workspace/index",
    "pages/workbench/index",
    "pages/orders/index",
    "pages/scan/index",
    "pages/scanner/index",
    "pages/me/index",
    "pages/subscription/index",
    "pages/order/index",
    "pages/order-new/index",
    "pages/allocate/index",
    "pages/reviews/index",
    "pages/pickup/index",
    "pages/return/index",
    "pages/work-orders/index",
    "pages/work-order/index",
    "pages/scan-result/index",
    "pages/scan-manual/index",
    "pages/assets/index",
    "pages/asset/index",
    "pages/asset-ledger/index",
    "pages/asset-new/index",
    "pages/customers/index",
    "pages/customer/index",
    "pages/customer-edit/index",
    "pages/password/index",
    "pages/history/index",
    "pages/about/index"
  ],
  "window": {
    "navigationStyle": "custom",
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTextStyle": "@navText",
    "navigationBarTitleText": "Rental OS 员工端",
    "backgroundColor": "@pageBg",
    "backgroundTextStyle": "@bgText",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      { "pagePath": "pages/workbench/index", "text": "工作台", "iconPath": "assets/tab/home.png", "selectedIconPath": "assets/tab/home-active.png" },
      { "pagePath": "pages/orders/index", "text": "订单", "iconPath": "assets/tab/orders.png", "selectedIconPath": "assets/tab/orders-active.png" },
      { "pagePath": "pages/scan/index", "text": "扫码", "iconPath": "assets/tab/scan.png", "selectedIconPath": "assets/tab/scan-active.png" },
      { "pagePath": "pages/me/index", "text": "我的", "iconPath": "assets/tab/me.png", "selectedIconPath": "assets/tab/me-active.png" }
    ]
  },
  "lazyCodeLoading": "requiredComponents",
  "darkmode": true,
  "themeLocation": "theme.json",
  "style": "v2",
  "permission": {
    "scope.camera": {
      "desc": "用于扫描订单码与资产条码"
    }
  },
  "sitemapLocation": "sitemap.json"
}
