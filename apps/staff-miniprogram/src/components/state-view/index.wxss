.state { padding: 64rpx 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.state--compact { padding: 32rpx; }
.state--loading { align-items: stretch; text-align: left; }
.state__icon { width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--primary-weak); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: var(--fw-bold); margin-bottom: 24rpx; } /* font-size 特殊展示：状态大图标字形，非文本层级 */
.state__icon--error { background: var(--danger-weak); color: var(--danger); }
.state__icon--blocked { background: var(--warning-weak); color: var(--warning); }
.state__title { font-size: var(--font-subtitle); font-weight: var(--fw-semibold); color: var(--text); }
.state__message { font-size: var(--font-secondary); color: var(--secondary); margin-top: 12rpx; line-height: 1.6; }
.state__actions { margin-top: 32rpx; display: flex; flex-direction: column; width: 100%; max-width: 480rpx; }
.state__actions .btn + .btn { margin-top: 16rpx; }
