<view class="ai-proposal-confirm" aria-label="人工确认提案"><text>{{proposal.title || '提案不可用'}}</text><text wx:if="{{expired}}">提案已过期</text><checkbox disabled="{{disabled || expired}}" checked="{{checked}}" bindchange="onCheck">我已阅读提案</checkbox><button disabled="{{disabled || pending || expired || !checked}}" bindtap="onConfirm">{{pending ? '提交中…' : '确认并继续'}}</button></view>
