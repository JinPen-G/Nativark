.ai-supplement-input { padding: 24rpx; }
.ai-supplement-input__field { margin-bottom: 24rpx; }
.ai-supplement-input__label { display: block; margin-bottom: 10rpx; color: var(--text, #1f2937); font-size: 28rpx; }
.ai-supplement-input input { box-sizing: border-box; width: 100%; padding: 18rpx; border: 1rpx solid var(--border, #e5e7eb); border-radius: 12rpx; }
.ai-supplement-input__error { display: block; margin-top: 8rpx; color: var(--danger, #dc2626); font-size: 24rpx; }
.ai-supplement-input button { border-radius: 999rpx; background: var(--primary, #2563eb); color: #fff; }
