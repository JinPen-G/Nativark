<view class="ai-status-panel" aria-live="polite"><text class="title">{{state === 'unknown' ? '结果待核对' : state === 'budget_exhausted' ? '额度不足' : state === 'capability_unavailable' ? '能力不可用' : state === 'read_failed' ? '读取失败' : 'AI服务不可用'}}</text><text wx:if="{{message}}">{{message}}</text><button wx:if="{{actionText}}" disabled="{{disabled || !actionAvailable}}" bindtap="onAction">{{actionText}}</button><button disabled="{{disabled || !manualAvailable}}" bindtap="onManual">{{manualText}}</button></view>
