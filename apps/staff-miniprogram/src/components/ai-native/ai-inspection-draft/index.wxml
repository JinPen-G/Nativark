<view class="ai-inspection-draft" aria-label="检查草稿"><text>候选与人工值均待核实，不代表业务检查事实</text><view wx:for="{{visibleItems}}" wx:key="key"><text>{{item.label}}</text><text>候选：{{item.candidate}}</text><text>人工值：{{item.humanValue}}</text><text>来源：{{item.sourceLabel}}</text><input wx:if="{{!readonly}}" data-key="{{item.key}}" aria-label="{{item.label}}" bindinput="onHumanInput"/></view><view wx:for="{{visibleMissing}}" wx:key="*this">待核实：{{item}}</view></view>
