.ai-task-card { margin: 24rpx; padding: 28rpx; border-radius: 20rpx; background: var(--card, #fff); color: var(--text, #1f2937); box-shadow: 0 8rpx 28rpx rgba(0,0,0,.06); }
.ai-task-card--disabled { opacity: .58; }
.ai-task-card__head, .ai-task-card__meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ai-task-card__title { font-size: 32rpx; font-weight: 600; }
.ai-task-card__status, .ai-task-card__notice { color: var(--primary, #2563eb); font-size: 26rpx; }
.ai-task-card__summary, .ai-task-card__meta, .ai-task-card__exit { display: block; margin-top: 16rpx; color: var(--secondary, #6b7280); font-size: 26rpx; line-height: 1.5; }
.ai-task-card__notice { display: block; margin-top: 16rpx; }
.ai-task-card__button { margin: 24rpx 0 0; border-radius: 999rpx; background: var(--primary, #2563eb); color: #fff; font-size: 28rpx; }
.ai-task-card__button[disabled] { opacity: .5; }
