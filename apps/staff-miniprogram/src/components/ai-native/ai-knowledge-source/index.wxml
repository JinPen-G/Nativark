<view class="ai-knowledge-source" aria-label="知识来源"><view wx:for="{{sources}}" wx:key="id" class="source"><text class="title">{{item.title || '来源不可用'}}</text><text>版本：{{item.version || '未知'}}</text><text>定位：{{item.location || '未知'}}</text><text wx:if="{{item.status === 'withdrawn'}}">已撤回</text><text wx:elif="{{item.status === 'no_access'}}">无权限</text><button wx:else data-source="{{item}}" bindtap="onOpen">查看来源</button></view></view>
