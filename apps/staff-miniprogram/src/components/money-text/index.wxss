.money { display: inline-flex; align-items: baseline; font-weight: var(--fw-bold); color: var(--text); white-space: nowrap; }
.money--small { font-size: var(--font-secondary); font-weight: var(--fw-medium); }
.money--normal { font-size: var(--font-subtitle); }
.money--large { font-size: 44rpx; } /* 特殊展示：价格大号，非文本层级 */
.money--price { color: var(--price); }
.money--primary { color: var(--primary); }
.money--negative { color: var(--success); }
.money__prefix { font-weight: var(--fw-regular); font-size: var(--font-secondary); color: var(--secondary); margin-right: 8rpx; }
.money__symbol { font-size: 0.75em; margin-right: 2rpx; } /* 特殊展示：货币符号随数字相对缩放，非文本层级 */
.money__note { font-size: var(--font-mini); font-weight: var(--fw-regular); color: var(--warning); margin-left: 4rpx; }
