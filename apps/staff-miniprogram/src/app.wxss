@import "./staff.wxss";
/* 视觉 Token：按 V2 设计稿（清爽蓝白、圆角卡片、红色价格）。 */
page {
  --primary: #1677FF;
  --primary-weak: #EAF2FF;
  --primary-dark: #0F5FDB;
  --on-primary: #FFFFFF;
  --page: #F5F7FA;
  --surface: #FFFFFF;
  --text: #1F2329;
  --secondary: #8A94A6;
  --muted: #B4BBC8;
  --border: #EEF1F5;
  --line: #E5E9F0;
  --price: #FF4D3A;
  --success: #22A06B;
  --success-weak: #E8F7EF;
  --warning: #E8890C;
  --warning-weak: #FFF4E0;
  --danger: #E5484D;
  --danger-weak: #FDECEC;
  --navy: #1E2B4F;
  --gold: #F5C15C;
  --skeleton-start: #EEF1F5;
  --skeleton-mid: #F7F8FA;
  --radius: 20rpx;
  --radius-sm: 12rpx;
  --radius-pill: 999rpx;
  --shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.05);
  /* 统一排版 token：全端字号/字重只在这里配置，页面一律用语义类（.title/.subtitle/.section-title/.body/.caption…），
   * 不在页面里写死 font-size/font-weight。特例（品牌大数字、价格）另有专用类。 */
  --font-page-title: 40rpx;   /* 页面主标题 */
  --font-title: 36rpx;        /* 卡片/区块主标题 */
  --font-section: 32rpx;      /* 二级标题（区块标题） */
  --font-subtitle: 30rpx;     /* 三级标题/条目标题 */
  --font-body: 28rpx;         /* 正文 */
  --font-secondary: 26rpx;    /* 次要说明 */
  --font-caption: 24rpx;      /* 辅助/小字 */
  --font-mini: 22rpx;         /* 角标/极小字 */
  --fw-bold: 700;
  --fw-semibold: 600;
  --fw-medium: 500;
  --fw-regular: 400;
  --line-tight: 1.35;
  --line-normal: 1.5;
  background: var(--page);
  color: var(--text);
  font-size: var(--font-body);
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 深色模式：跟随系统。只翻转中性色（背景/卡片/文字/边框/阴影），品牌主色与状态色保持一致。
 * 走 var(--token) 的元素自动跟随；图标由 ui-icon 按语义色板另行处理。租户主题色仍由 page-meta 覆盖 --primary。 */
/* 深色令牌集中一处：系统深色（media）与用户强制深色（.theme-dark）共用同一组值。 */
.theme-dark {
  --primary-weak: rgba(59, 144, 255, 0.18);
  --page: #14161A;
  --surface: #1E2127;
  --text: #E6E8EB;
  --secondary: #9AA3B2;
  --muted: #5A6373;
  --border: #2A2E36;
  --line: #333842;
  --success-weak: #123024;
  --warning-weak: #33280F;
  --danger-weak: #3A1E1F;
  --shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
  --skeleton-start: #2A2E36;
  --skeleton-mid: #333842;
}
@media (prefers-color-scheme: dark) {
  /* 跟随系统：未被用户强制为浅色时套用深色令牌。 */
  page {
    --primary-weak: rgba(59, 144, 255, 0.18);
    --page: #14161A;
    --surface: #1E2127;
    --text: #E6E8EB;
    --secondary: #9AA3B2;
    --muted: #5A6373;
    --border: #2A2E36;
    --line: #333842;
    --success-weak: #123024;
    --warning-weak: #33280F;
    --danger-weak: #3A1E1F;
    --shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
    --skeleton-start: #2A2E36;
    --skeleton-mid: #333842;
  }
}
/* page-meta 的 root-class 用于覆盖系统深色：强制浅色时恢复浅色令牌。单独写 class 选择器，避免依赖 WXSS 对 :not 的支持。 */
.theme-light {
  --primary-weak: #EAF2FF;
  --page: #F5F7FA;
  --surface: #FFFFFF;
  --text: #1F2329;
  --secondary: #8A94A6;
  --muted: #B4BBC8;
  --border: #EEF1F5;
  --line: #E5E9F0;
  --success-weak: #E8F7EF;
  --warning-weak: #FFF4E0;
  --danger-weak: #FDECEC;
  --shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.05);
  --skeleton-start: #EEF1F5;
  --skeleton-mid: #F7F8FA;
}

view, text, button, input, textarea, picker, scroll-view, image, navigator, swiper, switch {
  box-sizing: border-box;
}

/* 布局 */
.screen { min-height: 100vh; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); background: var(--page); color: var(--text); }
.screen--flat { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.section { padding: 16rpx 32rpx; }
.section--tight { padding-top: 0; }
.card { background: var(--surface); border-radius: var(--radius); padding: 24rpx; box-shadow: var(--shadow); }
.card + .card { margin-top: 20rpx; }
.card--flat { box-shadow: none; }
.row { display: flex; align-items: center; }
.row--between { justify-content: space-between; }
.row--top { align-items: flex-start; }
.row--center { justify-content: center; }
.row--wrap { flex-wrap: wrap; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; min-width: 0; }
.shrink { flex: 0 0 auto; }
/* 间距：WXSS 不支持通配符选择器，用“容器负外边距 + 子元素正外边距”实现，首个子元素回到原位。 */
.gap-8 { margin-left: -8rpx; }
.gap-8 > view, .gap-8 > text, .gap-8 > button, .gap-8 > image, .gap-8 > input, .gap-8 > picker, .gap-8 > switch, .gap-8 > status-tag, .gap-8 > money-text, .gap-8 > ui-icon { margin-left: 8rpx; }
.gap-16 { margin-left: -16rpx; }
.gap-16 > view, .gap-16 > text, .gap-16 > button, .gap-16 > image, .gap-16 > input, .gap-16 > picker, .gap-16 > switch, .gap-16 > status-tag, .gap-16 > money-text, .gap-16 > ui-icon { margin-left: 16rpx; }
.stack { margin-top: -16rpx; }
.stack > view, .stack > button, .stack > text, .stack > image, .stack > input, .stack > picker { margin-top: 16rpx; }
.stack-8 { margin-top: -8rpx; }
.stack-8 > view, .stack-8 > button, .stack-8 > text, .stack-8 > image, .stack-8 > input, .stack-8 > picker { margin-top: 8rpx; }
.mt-4 { margin-top: 4rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-12 { margin-left: 12rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-12 { margin-right: 12rpx; }
.mr-16 { margin-right: 16rpx; }

/* 文字 */
/* 文字：全部引用排版 token，页面不再写死字号字重 */
.title { font-size: var(--font-title); font-weight: var(--fw-bold); line-height: var(--line-tight); }
.title--page { font-size: var(--font-page-title); font-weight: var(--fw-bold); }
.subtitle { font-size: var(--font-subtitle); font-weight: var(--fw-semibold); }
.body { font-size: var(--font-body); }
.caption { font-size: var(--font-caption); color: var(--secondary); }
.muted { color: var(--secondary); font-size: var(--font-secondary); }
.small { font-size: var(--font-caption); }
.tiny { font-size: var(--font-mini); }
.strong { font-weight: var(--fw-semibold); }
.bold { font-weight: var(--fw-bold); }
.danger-text { color: var(--danger); }
.success-text { color: var(--success); }
.warning-text { color: var(--warning); }
.primary-text { color: var(--primary); }
.price-text { color: var(--price); }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.clamp-2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.center { text-align: center; }
.section-title { font-size: var(--font-section); font-weight: var(--fw-bold); }
.section-head { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0 16rpx; }
.section-link { display: flex; align-items: center; color: var(--secondary); font-size: 26rpx; min-height: 56rpx; }

/* 价格：¥ 小、数字大、单位灰 */
.price { display: inline-flex; align-items: baseline; color: var(--price); font-weight: 700; white-space: nowrap; }
.price__symbol { font-size: 24rpx; margin-right: 2rpx; }
.price__number { font-size: 32rpx; }
.price__unit { font-size: 24rpx; color: var(--secondary); font-weight: 400; margin-left: 4rpx; }
.price--large .price__symbol { font-size: 28rpx; }
.price--large .price__number { font-size: 40rpx; }
.price--large .price__unit { font-size: 26rpx; }
.price--pending { color: var(--primary); font-size: 24rpx; font-weight: 500; }

/* 键值行 */
.kv { display: flex; justify-content: space-between; align-items: flex-start; padding: 14rpx 0; font-size: 28rpx; }
.kv + .kv { border-top: 1rpx solid var(--border); }
.kv__label { color: var(--secondary); flex: 0 0 auto; margin-right: 24rpx; }
.kv__value { text-align: right; flex: 1; min-width: 0; word-break: break-all; }
.kv__value--strong { font-weight: 700; }

/* 按钮 */
.btn { display: flex; align-items: center; justify-content: center; height: 88rpx; padding: 0 32rpx; border-radius: var(--radius-pill); font-size: 30rpx; font-weight: 600; background: var(--surface); color: var(--text); border: 1rpx solid var(--line); line-height: 1; margin: 0; }
.btn::after { border: none; }
.btn--primary { background: var(--primary); color: var(--on-primary); border-color: var(--primary); }
.btn--secondary { background: var(--primary-weak); color: var(--primary); border-color: var(--primary-weak); }
.btn--outline { background: var(--surface); color: var(--primary); border-color: var(--primary); }
.btn--danger { background: var(--surface); color: var(--danger); border-color: var(--danger); }
.btn--ghost { background: transparent; border-color: transparent; color: var(--primary); }
.btn--cta { height: 96rpx; font-size: 32rpx; }
.btn--block { width: 100%; }
.btn--small { height: 60rpx; padding: 0 28rpx; font-size: 26rpx; font-weight: 500; }
.btn[disabled], .btn--disabled { opacity: 0.45; }
.btn-hover { opacity: 0.85; }
.btn-row { display: flex; }
.btn-row > .btn + .btn { margin-left: 16rpx; }
.btn-row > .btn { flex: 1; }

/* 表单 */
.field { padding: 8rpx 0; }
.field + .field { border-top: 1rpx solid var(--border); }
.field__label { font-size: 26rpx; color: var(--secondary); padding: 8rpx 0 4rpx; }
.field__label--required::after { content: " *"; color: var(--danger); }
.field__control { min-height: 96rpx; display: flex; align-items: center; font-size: 28rpx; }
.field__input { width: 100%; height: 96rpx; font-size: 28rpx; }
.field__textarea { width: 100%; min-height: 160rpx; font-size: 28rpx; padding: 16rpx 0; }
.field__picker { width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: space-between; }
.field__error { color: var(--danger); font-size: 24rpx; padding-bottom: 8rpx; }
.field__hint { color: var(--secondary); font-size: 24rpx; padding-bottom: 8rpx; }
.input-box { background: var(--page); border-radius: var(--radius-sm); padding: 0 24rpx; height: 96rpx; display: flex; align-items: center; }
.input-box input { flex: 1; height: 96rpx; font-size: 28rpx; }

/* 搜索框 */
.search { display: flex; align-items: center; background: var(--page); border-radius: var(--radius-pill); padding: 0 28rpx; height: 76rpx; }
.search--surface { background: var(--surface); border: 1rpx solid var(--line); }
.search__input { flex: 1; height: 76rpx; font-size: 28rpx; margin-left: 12rpx; }
.search__placeholder { color: var(--muted); }
.search__clear { color: var(--secondary); font-size: 24rpx; padding-left: 16rpx; }

/* 提示条 */
.notice { padding: 16rpx 24rpx; border-radius: var(--radius-sm); font-size: 26rpx; line-height: 1.5; }
.notice--info { background: var(--primary-weak); color: var(--primary); }
.notice--warning { background: var(--warning-weak); color: var(--warning); }
.notice--danger { background: var(--danger-weak); color: var(--danger); }
.notice--success { background: var(--success-weak); color: var(--success); }
.notice--neutral { background: var(--page); color: var(--secondary); }

/* 选项 */
.option { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 16rpx 24rpx; border: 2rpx solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
.option + .option { margin-top: 12rpx; }
.option--selected { border-color: var(--primary); background: var(--primary-weak); }
.option--disabled { opacity: 0.5; }
.option__check { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid var(--line); flex: 0 0 auto; margin-left: 16rpx; }
.option--selected .option__check { border-color: var(--primary); background: var(--primary); box-shadow: inset 0 0 0 6rpx var(--on-primary); }

/* 双选切换（取还方式） */
.toggle { display: flex; }
.toggle__item { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--line); border-radius: var(--radius-sm); font-size: 28rpx; color: var(--text); background: var(--surface); }
.toggle__item + .toggle__item { margin-left: 16rpx; }
.toggle__item--active { border-color: var(--primary); color: var(--primary); background: var(--primary-weak); font-weight: 600; }
.toggle__item--disabled { opacity: 0.45; }

/* 芯片 / 标签页 */
.chips { display: flex; flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; }
.chip { display: inline-flex; align-items: center; height: 60rpx; padding: 0 24rpx; border-radius: var(--radius-pill); background: var(--page); color: var(--text); font-size: 26rpx; margin-right: 16rpx; flex: 0 0 auto; }
.chip--active { background: var(--primary); color: var(--on-primary); }
.chip--soft { background: var(--primary-weak); color: var(--primary); height: 48rpx; padding: 0 16rpx; font-size: 22rpx; margin-right: 12rpx; }
.tabs { display: flex; overflow-x: auto; white-space: nowrap; }
.tab { position: relative; display: inline-flex; align-items: center; justify-content: center; height: 80rpx; padding: 0 8rpx; margin-right: 40rpx; font-size: 28rpx; color: var(--secondary); flex: 0 0 auto; }
.tab--active { color: var(--primary); font-weight: 600; }
.tab--active::after { content: ""; position: absolute; left: 20%; right: 20%; bottom: 0; height: 6rpx; border-radius: 3rpx; background: var(--primary); }

/* 固定底栏 */
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--surface); border-top: 1rpx solid var(--border); padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; z-index: 20; }
.bottom-bar__summary { flex: 1; min-width: 0; }
.bottom-bar__action { flex: 0 0 auto; margin-left: 24rpx; min-width: 260rpx; }

/* 图片 */
.thumb { position: relative; width: 100%; padding-top: 100%; background: var(--page); border-radius: var(--radius-sm); overflow: hidden; }
.thumb--wide { padding-top: 75%; }
.thumb__img { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.thumb__placeholder { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 22rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--primary-weak); display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 44rpx; font-weight: 700; overflow: hidden; flex: 0 0 auto; }
.avatar image { width: 100%; height: 100%; }

/* 骨架 */
.skeleton { background: linear-gradient(90deg, var(--skeleton-start) 25%, var(--skeleton-mid) 50%, var(--skeleton-start) 75%); background-size: 400% 100%; animation: skeleton 1.4s ease infinite; border-radius: 8rpx; }
.skeleton--line { height: 28rpx; margin: 12rpx 0; }
.skeleton--block { height: 200rpx; }
@keyframes skeleton { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
@media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }

/* 步进器 */
.stepper { display: inline-flex; align-items: center; }
.stepper__btn { width: 56rpx; height: 56rpx; border-radius: 50%; border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--text); }
.stepper__btn--disabled { color: var(--muted); }
.stepper__value { min-width: 64rpx; text-align: center; font-size: 28rpx; font-weight: 600; }

/* 列表单元 */
.cell { display: flex; align-items: center; min-height: 104rpx; padding: 18rpx 0; }
.cell + .cell { border-top: 1rpx solid var(--border); }
.cell__icon { width: 40rpx; height: 40rpx; margin-right: 24rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
.cell__body { flex: 1; min-width: 0; }
.cell__title { font-size: 30rpx; }
.cell__desc { font-size: 24rpx; color: var(--secondary); margin-top: 4rpx; }
.cell__extra { color: var(--secondary); font-size: 26rpx; margin-left: 16rpx; flex: 0 0 auto; }
.cell__chevron { margin-left: 12rpx; flex: 0 0 auto; }

/* 商品行（分类列表） */
.item-row { display: flex; align-items: center; padding: 24rpx 0; }
.item-row + .item-row { border-top: 1rpx solid var(--border); }
.item-row__thumb { width: 152rpx; height: 152rpx; border-radius: var(--radius-sm); background: var(--page); overflow: hidden; flex: 0 0 auto; margin-right: 24rpx; position: relative; }
.item-row__thumb image { width: 100%; height: 100%; }
.item-row__body { flex: 1; min-width: 0; }
.item-row__name { font-size: 30rpx; font-weight: 600; }
.item-row__desc { font-size: 24rpx; color: var(--secondary); margin-top: 6rpx; }
.item-row__price { margin-top: 12rpx; }

/* 商品卡（网格） */
.grid { display: flex; flex-wrap: wrap; margin-left: -16rpx; }
.grid__item { width: calc(33.333% - 16rpx); margin-left: 16rpx; margin-bottom: 20rpx; background: var(--surface); border-radius: var(--radius); padding: 12rpx; box-shadow: var(--shadow); }
.grid__item--half { width: calc(50% - 16rpx); }
.grid__name { font-size: 26rpx; font-weight: 500; margin-top: 12rpx; min-height: 72rpx; }
.grid__price { margin-top: 8rpx; }

/* 协议勾选 */
.consent { display: flex; align-items: flex-start; padding: 16rpx 0; font-size: 26rpx; color: var(--secondary); }
.consent checkbox { transform: scale(0.85); margin-right: 8rpx; margin-top: -4rpx; }
.consent__link { color: var(--primary); }

.link { color: var(--primary); }
.tap-area { min-height: 88rpx; display: flex; align-items: center; }
.divider { height: 1rpx; background: var(--border); margin: 16rpx 0; }
