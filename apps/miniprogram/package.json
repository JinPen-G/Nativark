{
  "name": "@rental-os/miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "Rental OS 微信小程序客户端（原生 + TypeScript）。包内只含公开配置，不含任何密钥。",
  "scripts": {
    "prebuild": "npm run build -w @rental-os/rental-api",
    "build": "node scripts/build.cjs",
    "pretypecheck": "npm run build -w @rental-os/rental-api",
    "typecheck": "node scripts/build.cjs --check",
    "test": "node --test ../../tests/miniprogram-static.test.cjs"
  },
  "devDependencies": {
    "memfs": "3.5.3",
    "miniprogram-api-typings": "5.2.3",
    "terser-webpack-plugin": "5.5.0",
    "typescript": "^5.6.3",
    "webpack": "5.106.2"
  },
  "dependencies": {
    "@rental-os/rental-core": "0.1.3"
  }
}
