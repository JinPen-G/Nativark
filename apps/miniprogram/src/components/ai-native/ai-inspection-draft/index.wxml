<view class="ai-inspection-draft" aria-label="检查草稿"><view wx:for="{{items}}" wx:key="key" class="ai-inspection-draft__row"><text>{{item.label || '检查项不可用'}}</text><text>候选：{{item.candidate || '不可用'}}</text><text>人工值：{{item.humanValue || '待核实'}}</text><text class="source">来源：{{item.sourceLabel || '来源不可用'}}</text></view><view wx:for="{{missing}}" wx:key="*this" class="missing">待核实：{{item}}</view></view>
