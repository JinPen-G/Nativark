<view class="scene-directory" aria-label="当前 AI 场景" aria-busy="{{busy}}">
  <button class="btn btn--block mt-8" disabled="{{busy}}" loading="{{busy}}" bindtap="onOpen">{{open ? '重新核对 AI 场景' : '查看当前 AI 场景'}}</button>
  <view wx:if="{{message}}" role="status" class="body mt-8">{{message}}</view>
  <block wx:if="{{open}}">
    <view class="body mt-8">目录只读，不授予任务或业务执行权限；普通选品和预约仍可继续。</view>
    <view wx:if="{{observedAt}}" class="muted tiny mt-8">观察时间：{{observedAt}}</view>
    <view wx:if="{{!busy && !message && !rows.length}}" role="status" class="body mt-8">本页没有场景，请使用原人工入口。</view>
    <view wx:for="{{rows}}" wx:key="id" class="scene-directory__row">
      <view class="subtitle">{{item.title}}</view>
      <view role="status" class="body">{{item.status}} · {{item.risk}}</view>
      <view class="body scene-directory__text">{{item.goal}}</view>
      <view class="muted tiny scene-directory__text">{{item.confirmation}}</view>
      <button class="link" data-id="{{item.id}}" aria-expanded="{{item.details}}" bindtap="onDetails">{{item.details ? '收起来源与限制' : '来源、权限与限制'}}</button>
      <view wx:if="{{item.details}}" class="scene-directory__text">
        <view>已登记工具：{{item.tools}}</view><view>原权限要求：{{item.permissions}}</view>
        <view>最多返回数：{{item.results}}</view><view>原来源：{{item.source}}</view>
        <view>人工出口：{{item.manual}}</view><view>脱敏限制：{{item.redaction}}</view>
      </view>
    </view>
    <view wx:if="{{hasPrevious || hasNext}}" class="scene-directory__pages">
      <button class="btn btn--small" disabled="{{busy || !hasPrevious}}" bindtap="onPrevious">上一页</button>
      <text>{{pageIndex + 1}}</text><button class="btn btn--small" disabled="{{busy || !hasNext}}" bindtap="onNext">下一页</button>
    </view>
    <button class="btn btn--block mt-8" bindtap="onClose">收起场景目录</button>
  </block>
</view>
