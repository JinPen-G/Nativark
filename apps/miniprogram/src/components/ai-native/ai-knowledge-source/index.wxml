<view class="ai-knowledge-source" aria-label="知识来源"><view wx:for="{{visibleSources}}" wx:key="id"><text>{{item.title}}</text><text>版本：{{item.version}}</text><text>定位：{{item.location}}</text><text>{{item.statusLabel}}</text><button disabled="{{item.status !== 'published' || opening || !openHandler}}" data-id="{{item.id}}" bindtap="onOpen">查看来源</button></view><text role="alert" wx:if="{{errorLabel}}">{{errorLabel}}</text></view>
