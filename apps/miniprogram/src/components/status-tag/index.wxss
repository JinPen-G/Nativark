.tag { display: inline-flex; align-items: center; height: 44rpx; padding: 0 16rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: 500; line-height: 1; white-space: nowrap; }
.tag--small { height: 36rpx; padding: 0 12rpx; font-size: 22rpx; }
.tag--neutral { background: #F5F7FA; color: #8A94A6; }
.tag--info { background: #EAF2FF; color: #1677FF; }
.tag--success { background: #E8F7EF; color: #22A06B; }
.tag--warning { background: #FFF4E0; color: #E8890C; }
.tag--danger { background: #FDECEC; color: #E5484D; }
