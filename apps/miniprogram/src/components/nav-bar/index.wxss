.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: #FFFFFF; }
.nav--transparent { background: transparent; }
.nav__brand { display: flex; align-items: center; padding-left: 32rpx; }
.nav__logo { height: 52rpx; width: 226rpx; }
.nav__title-row { position: relative; display: flex; align-items: center; justify-content: center; }
.nav__back { position: absolute; left: 12rpx; top: 0; bottom: 0; width: 88rpx; display: flex; align-items: center; justify-content: center; }
.nav__title { font-size: 34rpx; font-weight: 600; color: #1F2329; max-width: 60%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.nav__placeholder { width: 100%; }
