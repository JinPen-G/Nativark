:host { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: block; }
.lazy-image__img, .lazy-image__skeleton, .lazy-image__ph { position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; }
.lazy-image__img { display: block; }
.lazy-image__ph { display: flex; align-items: center; justify-content: center; background: var(--page); }
.lazy-image__text { color: var(--muted); font-size: var(--font-mini); }
