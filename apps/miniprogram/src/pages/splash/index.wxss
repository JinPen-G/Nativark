.splash {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
  background: #EAF2FF;
}

/* 背景铺满整屏（设计稿的白/浅蓝渐变底）。 */
.splash__bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 品牌锁定图（圆环 + Rental OS + Build a Rental World.）：靠上排布，不垂直居中。 */
.splash__brand {
  position: absolute;
  top: 18vh;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 2;
}
/* logo 是含留白的方形成品图，显示宽取 560rpx；不改其内部构图。 */
.splash__logo {
  width: 560rpx;
  animation: splash-in 0.6s ease-out both;
}

/* 底部蓝色波浪装饰。 */
.splash__wave {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  z-index: 1;
}

.splash__foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(88rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}
.splash__ring {
  width: 64rpx;
  height: 64rpx;
  animation: splash-spin 0.9s linear infinite;
}
.splash__hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #5B6B8C;
  letter-spacing: 1rpx;
}

@keyframes splash-in {
  from { opacity: 0; transform: translateY(20rpx) scale(0.94); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes splash-spin {
  to { transform: rotate(360deg); }
}
