.gallery { position: relative; background: var(--surface); }
.gallery__swiper, .gallery__img { width: 100%; height: 640rpx; }
.gallery__img { background: var(--page); }
.gallery__placeholder { width: 100%; height: 640rpx; background: var(--page); display: flex; align-items: center; justify-content: center; color: var(--muted); }
.gallery__back { position: absolute; left: 24rpx; top: 24rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.92); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08); }
.gallery__tools { position: absolute; right: 24rpx; top: 24rpx; display: flex; }
.gallery__tool { width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.92); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08); margin-left: 16rpx; padding: 0; }
.gallery__tool--share { position: relative; }
.gallery__share-icon { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; z-index: 1; pointer-events: none; }
.gallery__share-button { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; line-height: 1; font-size: 0; z-index: 2; } /* font-size:0 为透明覆盖按钮消除内联空白，非文本层级 */
.gallery__share-button::after { display: none; border: 0; }
.gallery__counter { position: absolute; right: 24rpx; bottom: 24rpx; height: 40rpx; padding: 0 16rpx; border-radius: 20rpx; background: rgba(0, 0, 0, 0.45); color: #FFFFFF; font-size: var(--font-mini); display: flex; align-items: center; }
.section--surface { background: var(--surface); margin-top: 16rpx; padding: 28rpx 32rpx; }
.stats { display: flex; }
.stats__item { flex: 1; min-width: 0; background: var(--page); border-radius: 12rpx; padding: 16rpx; }
.stats__item + .stats__item { margin-left: 16rpx; }
.stats__label { font-size: var(--font-mini); color: var(--secondary); }
.stats__value { font-size: var(--font-body); font-weight: var(--fw-semibold); margin-top: 6rpx; }
.store__icon { width: 96rpx; height: 96rpx; border-radius: 16rpx; background: var(--primary-weak); display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex: 0 0 auto; }
.bottom-bar .btn { min-width: 0; }
