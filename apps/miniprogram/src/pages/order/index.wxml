<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}">
  <nav-bar title="订单详情"></nav-bar>
  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>

  <block wx:elif="{{order}}">
    <view class="section">
      <view class="card head">
        <view class="row row--between">
          <view class="title">{{presentation.label}}</view>
          <view class="row gap-8">
            <status-tag wx:for="{{presentation.sub}}" wx:key="*this" label="{{item}}" tone="warning" small="{{true}}"></status-tag>
          </view>
        </view>
        <view class="muted mt-8">{{presentation.hint}}</view>
        <view wx:if="{{overdue}}" class="notice notice--danger mt-16">已超过约定归还时间，请尽快归还或申请续租；逾期费用以商户规则为准。</view>
        <view class="muted small mt-16">订单号 {{order.orderNo}}</view>
      </view>
    </view>

    <view class="section section--tight">
      <view class="card">
        <view class="subtitle">租期</view>
        <view class="kv mt-8"><view class="kv__label">约定领取</view><view class="kv__value">{{startText}}</view></view>
        <view class="kv"><view class="kv__label">{{extended ? '原约定归还' : '约定归还'}}</view><view class="kv__value">{{endText}}</view></view>
        <view wx:if="{{extended}}" class="kv"><view class="kv__label">当前归还时间</view><view class="kv__value kv__value--strong">{{effectiveEndText}}</view></view>
        <view class="muted small mt-8">{{zoneNote}}</view>
      </view>
    </view>

    <view class="section section--tight">
      <view class="card">
        <view class="subtitle">交付与归还</view>
        <view class="kv mt-8"><view class="kv__label">方式</view><view class="kv__value">{{fulfillmentMode}}</view></view>
        <view class="kv"><view class="kv__label">领取地点</view><view class="kv__value">{{order.fulfillmentLocationName}}</view></view>
        <view wx:if="{{order.returnLocationName}}" class="kv"><view class="kv__label">归还地点</view><view class="kv__value">{{order.returnLocationName}}</view></view>
        <button class="btn btn--secondary btn--block mt-16" hover-class="btn-hover" data-code="guide" bindtap="onAction">取还指引</button>
      </view>
    </view>

    <view class="section section--tight">
      <view class="card">
        <view class="subtitle">设备</view>
        <view class="cell" wx:for="{{lines}}" wx:key="key">
          <view class="cell__body">
            <view class="cell__title">{{item.name}} × {{item.quantity}}</view>
            <view class="cell__desc">{{item.option ? item.option + ' · ' : ''}}分配：{{item.allocation}}</view>
          </view>
          <money-text amount="{{item.amount}}" currency="{{currency}}" size="small"></money-text>
        </view>
        <view wx:if="{{fulfillment && fulfillment.allocations.length}}" class="muted small mt-8">实物交接由商户在现场登记；已还/未还数量以商户登记为准。</view>
      </view>
    </view>

    <view class="section section--tight">
      <view class="card">
        <view class="subtitle">费用</view>
        <view class="kv mt-8"><view class="kv__label">租金</view><view class="kv__value"><money-text amount="{{order.rentalAmount}}" currency="{{currency}}" size="small"></money-text></view></view>
        <view class="kv" wx:for="{{charges}}" wx:key="key"><view class="kv__label">{{item.label}}</view><view class="kv__value"><money-text amount="{{item.amount}}" currency="{{currency}}" size="small"></money-text></view></view>
        <view class="kv"><view class="kv__label">租赁应付</view><view class="kv__value kv__value--strong"><money-text amount="{{order.finalPayableAmount}}" currency="{{currency}}"></money-text></view></view>
        <view wx:if="{{funding}}" class="kv"><view class="kv__label">已付</view><view class="kv__value"><money-text amount="{{funding.rental.collected}}" currency="{{currency}}" size="small"></money-text></view></view>
        <view class="kv"><view class="kv__label">结算状态</view><view class="kv__value {{balance > 0 ? 'warning-text' : balance < 0 ? 'success-text' : ''}}">{{balanceText}}{{refundText ? ' · ' + refundText : ''}}</view></view>
      </view>
    </view>

    <view wx:if="{{funding}}" class="section section--tight">
      <view class="card">
        <view class="subtitle">押金与预授权</view>
        <view class="body mt-8">押金：{{depositText}}</view>
        <view class="body mt-8">预授权：{{preAuthText}}</view>
        <view class="muted small mt-8">押金退还与预授权释放分别显示，不以“租金退款成功”替代。</view>
      </view>
    </view>

    <view wx:if="{{extensions.length}}" class="section section--tight">
      <view class="card">
        <view class="subtitle">续租记录</view>
        <view class="cell" wx:for="{{extensions}}" wx:key="id">
          <view class="cell__body">
            <view class="cell__title">{{item.period}}</view>
            <view class="cell__desc">差额 <money-text amount="{{item.amount}}" currency="{{currency}}" size="small" signed="{{true}}"></money-text></view>
          </view>
          <status-tag label="{{item.label}}" tone="{{item.tone}}"></status-tag>
        </view>
      </view>
    </view>

    <view wx:if="{{feeAvailable && feeItems.length}}" class="section section--tight">
      <view class="card">
        <view class="row row--between">
          <view class="subtitle">检查费用确认</view>
          <status-tag wx:if="{{feePending}}" label="{{feePending}} 项待确认" tone="danger" small="{{true}}"></status-tag>
        </view>
        <view class="muted small mt-8">领取或归还检查产生的费用请逐项处理；提交异议后商户会复核，处理前不影响你已确认的部分。</view>
        <view class="cell" wx:for="{{feeItems}}" wx:key="key">
          <view class="cell__body">
            <view class="cell__title">{{item.stage}} · {{item.description}}</view>
            <view class="cell__desc">状态：{{item.statusLabel}}</view>
            <view wx:if="{{item.note}}" class="muted small mt-4">{{item.note}}</view>
            <view wx:if="{{item.actionable}}" class="row gap-8 mt-12">
              <button class="btn btn--small btn--secondary" hover-class="btn-hover" data-inspection="{{item.inspectionId}}" data-index="{{item.exceptionIndex}}" data-mode="confirm" bindtap="onFeeAction">确认</button>
              <button class="btn btn--small btn--outline" hover-class="btn-hover" data-inspection="{{item.inspectionId}}" data-index="{{item.exceptionIndex}}" data-mode="dispute" bindtap="onFeeAction">有异议</button>
            </view>
          </view>
          <money-text amount="{{item.amount}}" currency="{{item.currency}}" size="small"></money-text>
        </view>
      </view>
    </view>

    <view class="section section--tight">
      <view class="card">
        <view class="subtitle">规则与记录</view>
        <view class="muted mt-8">下单时的取消、逾期与损坏规则版本已随订单固化。</view>
        <view wx:if="{{!feeAvailable}}" class="muted mt-8">检查费用的在线确认与异议本商户暂未开通，如对费用有疑问请联系商户。</view>
        <view wx:elif="{{feeLoadError}}" class="muted mt-8">检查费用暂时无法读取（{{feeLoadError}}），下拉刷新可重试。</view>
        <view wx:elif="{{!feeItems.length}}" class="muted mt-8">目前没有需要你确认的检查费用。</view>
      </view>
    </view>

    <view class="bottom-bar">
      <button class="btn" hover-class="btn-hover" data-code="contact" bindtap="onAction">联系商户</button>
      <view class="grow"></view>
      <block wx:for="{{presentation.actions}}" wx:key="code">
        <button wx:if="{{item.code !== 'contact' && item.code !== 'guide'}}" class="btn {{item.code === 'pay' ? 'btn--primary' : item.code === 'cancel' ? 'btn--danger' : 'btn--secondary'}} ml-12" hover-class="btn-hover" data-code="{{item.code}}" bindtap="onAction">{{item.label}}</button>
      </block>
    </view>

    <sheet visible="{{showCancel}}" title="取消订单" closable="{{!cancelSubmitting}}" footer="{{true}}" bind:close="onCloseCancel">
      <view wx:if="{{cancelLoading}}" class="muted">正在计算取消费用…</view>
      <block wx:elif="{{cancelPreview}}">
        <view class="kv"><view class="kv__label">当前租赁应付</view><view class="kv__value"><money-text amount="{{order.finalPayableAmount}}" currency="{{currency}}" size="small"></money-text></view></view>
        <view wx:if="{{funding}}" class="kv"><view class="kv__label">已付</view><view class="kv__value"><money-text amount="{{funding.rental.collected}}" currency="{{currency}}" size="small"></money-text></view></view>
        <view wx:else class="kv"><view class="kv__label">已付</view><view class="kv__value muted">暂不可读</view></view>
        <view class="kv"><view class="kv__label">取消费（预估）</view><view class="kv__value danger-text"><money-text amount="{{cancelPreview.charge}}" currency="{{currency}}"></money-text></view></view>
        <view class="notice notice--neutral mt-8">取消后的最终应付、待补或待退金额由商户系统在确认时核算，并以取消后的资金记录为准；已发生的服务与履约成本可能不可退。押金与预授权按资金记录另行退还/释放。若规则或状态在确认前变化，会请你再次确认。</view>
        <view class="subtitle mt-24">取消原因</view>
        <view wx:if="{{pendingCancelKey}}" class="notice notice--warning mt-8 mb-16">上一次确认的结果尚未明确，原因已锁定；再次确认会沿用同一凭证。</view>
        <view class="chips mt-8">
          <view class="chip {{cancelReason === item ? 'chip--active' : ''}} {{pendingCancelKey ? 'option--disabled' : ''}}" wx:for="{{cancelReasons}}" wx:key="*this" data-reason="{{item}}" hover-class="btn-hover" bindtap="onPickReason">{{item}}</view>
        </view>
        <view class="input-box mt-16"><input placeholder="补充说明（可选）" maxlength="200" value="{{cancelReason}}" disabled="{{pendingCancelKey}}" bindinput="onReasonInput" /></view>
      </block>
      <view wx:if="{{cancelError}}" class="notice notice--danger mt-16">{{cancelError}}</view>
      <view slot="footer">
        <button class="btn btn--danger btn--cta btn--block" hover-class="btn-hover" bindtap="onConfirmCancel" disabled="{{cancelLoading || cancelSubmitting || !cancelPreview}}">{{cancelSubmitting ? '取消中…' : cancelPreview && cancelPreview.charge > 0 ? '确认取消（含取消费）' : '确认取消'}}</button>
      </view>
    </sheet>

    <sheet visible="{{showGuide}}" title="取还指引" footer="{{true}}" bind:close="onCloseGuide">
      <view class="kv"><view class="kv__label">去哪</view><view class="kv__value">{{order.fulfillmentLocationName}}{{order.returnLocationName && order.returnLocationName !== order.fulfillmentLocationName ? '（归还至 ' + order.returnLocationName + '）' : ''}}</view></view>
      <view class="kv"><view class="kv__label">何时</view><view class="kv__value">{{startText}} 领取，{{effectiveEndText}} 前归还</view></view>
      <view class="kv"><view class="kv__label">携带</view><view class="kv__value">本人身份证件；押金按商户要求办理</view></view>
      <view class="notice notice--neutral mt-16">实物领取与归还由商户在现场登记，小程序不提供自助确认；部分归还会显示已还/未还数量。</view>
      <view slot="footer">
        <button class="btn btn--primary btn--block" hover-class="btn-hover" bindtap="onCall">拨打商户电话</button>
      </view>
    </sheet>

    <sheet visible="{{showFee}}" title="{{feeMode === 'dispute' ? '对费用提出异议' : '确认费用'}}" closable="{{!feeSubmitting}}" footer="{{true}}" bind:close="onCloseFee">
      <view class="kv"><view class="kv__label">费用项</view><view class="kv__value">{{feeTargetLabel}}</view></view>
      <view class="kv"><view class="kv__label">金额</view><view class="kv__value"><money-text amount="{{feeTargetAmount}}" currency="{{currency}}"></money-text></view></view>
      <block wx:if="{{feeMode === 'dispute'}}">
        <view class="notice notice--neutral mt-8">提交异议后商户会复核，可能调整金额或补充凭证；处理完成前该费用不计入你的最终结算。</view>
        <view wx:if="{{feePendingKey}}" class="notice notice--warning mt-8 mb-16">上一次提交的结果尚未明确，原因已锁定；再次提交会沿用同一凭证，不会重复处理。</view>
        <view class="subtitle mt-24">异议原因</view>
        <view class="chips mt-8">
          <view class="chip {{feeReason === item ? 'chip--active' : ''}} {{feePendingKey ? 'option--disabled' : ''}}" wx:for="{{feeReasons}}" wx:key="*this" data-reason="{{item}}" hover-class="btn-hover" bindtap="onPickFeeReason">{{item}}</view>
        </view>
        <view class="input-box mt-16"><input placeholder="补充说明（可选）" maxlength="200" value="{{feeReason}}" disabled="{{feePendingKey}}" bindinput="onFeeReasonInput" /></view>
      </block>
      <view wx:else class="notice notice--neutral mt-8">确认后该费用将计入你的结算，且不可再改为异议；如有疑问请先选择“有异议”。</view>
      <view wx:if="{{feeError}}" class="notice notice--danger mt-16">{{feeError}}</view>
      <view slot="footer">
        <button class="btn {{feeMode === 'dispute' ? 'btn--danger' : 'btn--primary'}} btn--cta btn--block" hover-class="btn-hover" bindtap="onSubmitFee" disabled="{{feeSubmitting}}">{{feeSubmitting ? '提交中…' : feeMode === 'dispute' ? '提交异议' : '确认费用'}}</button>
      </view>
    </sheet>
  </block>
</view>
