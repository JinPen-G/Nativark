<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen {{themeClass}}">
  <nav-bar title="购物车"></nav-bar>

  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>

  <block wx:else>
    <view class="section section--tight">
      <view class="card cart-group" wx:for="{{groups}}" wx:for-item="group" wx:key="serviceCode">
        <view class="cart-group__head">
          <view class="pick {{group.selected ? 'pick--on' : ''}}" data-code="{{group.serviceCode}}" bindtap="onToggleGroup">
            <ui-icon wx:if="{{group.selected}}" name="check" size="28" color="onPrimary" stroke="2.4"></ui-icon>
          </view>
          <view class="cart-group__name grow ellipsis">{{group.serviceName}}</view>
          <view class="cart-group__clear" hover-class="btn-hover" data-code="{{group.serviceCode}}" bindtap="onClearGroup">清空</view>
        </view>
        <view class="cart-line" wx:for="{{group.lines}}" wx:for-item="line" wx:key="key">
          <view class="cart-line__thumb" data-service="{{group.serviceCode}}" data-item="{{line.itemGroupId}}" hover-class="btn-hover" bindtap="onItemTap">
            <lazy-image source="{{line.imageSource}}"></lazy-image>
          </view>
          <view class="cart-line__body">
            <view class="body strong clamp-2" data-service="{{group.serviceCode}}" data-item="{{line.itemGroupId}}" bindtap="onItemTap">{{line.itemName}}</view>
            <view wx:if="{{line.pricingGroupName}}" class="muted small mt-4 ellipsis">{{line.pricingGroupName}}</view>
            <view class="cart-line__foot">
              <view class="stepper">
                <view class="stepper__btn" data-service="{{group.serviceCode}}" data-key="{{line.key}}" bindtap="onDecrease">−</view>
                <view class="stepper__value">{{line.quantity}}</view>
                <view class="stepper__btn" data-service="{{group.serviceCode}}" data-key="{{line.key}}" bindtap="onIncrease">＋</view>
              </view>
              <view class="cart-line__del" hover-class="btn-hover" data-service="{{group.serviceCode}}" data-key="{{line.key}}" bindtap="onRemove">删除</view>
            </view>
          </view>
        </view>
      </view>
      <view class="muted small center mt-8">价格与库存以结算时的服务端报价为准；加入购物车不锁定库存。</view>
    </view>

    <view class="bottom-bar">
      <view class="cart-bar__check" hover-class="btn-hover" bindtap="onToggleAll">
        <view class="pick {{allSelected ? 'pick--on' : ''}}">
          <ui-icon wx:if="{{allSelected}}" name="check" size="28" color="onPrimary" stroke="2.4"></ui-icon>
        </view>
        <text>全选</text>
      </view>
      <view class="cart-bar__sum muted small">已选 {{selectedCount}} 件 · {{selectedServiceCount}} 个品类</view>
      <button class="btn btn--primary btn--cta bottom-bar__action" hover-class="btn-hover" bindtap="onCheckout">去结算</button>
    </view>
  </block>
</view>
