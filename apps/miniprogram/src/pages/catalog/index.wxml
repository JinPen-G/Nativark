<page-meta page-style="{{themeStyle}}" root-class="{{themeClass}}"></page-meta>
<view class="screen screen--flat {{themeClass}}">
  <nav-bar></nav-bar>

  <view class="section">
    <view class="search search--surface">
      <ui-icon name="search" size="34" color="secondary"></ui-icon>
      <input class="search__input" type="text" confirm-type="search" placeholder="搜索商品名称、品牌或型号" placeholder-class="search__placeholder" maxlength="50" value="{{query}}" bindinput="onSearchInput" />
      <view wx:if="{{query || activeFacet}}" class="search__clear" hover-class="btn-hover" bindtap="onClear">清除</view>
    </view>
  </view>

  <view wx:if="{{services.length > 1}}" class="section section--tight">
    <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tab {{item.active ? 'tab--active' : ''}}" wx:for="{{services}}" wx:key="code" data-code="{{item.code}}" hover-class="btn-hover" bindtap="onServiceTap">{{item.name}}</view>
    </scroll-view>
  </view>

  <scroll-view wx:if="{{facets.length}}" class="chips section section--tight" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="chip {{activeFacet === item ? 'chip--active' : ''}}" wx:for="{{facets}}" wx:key="*this" data-facet="{{item}}" hover-class="btn-hover" bindtap="onFacetTap">{{item}}</view>
  </scroll-view>

  <state-view wx:if="{{view.status !== 'ready'}}" state="{{view.status}}" skeleton="list" title="{{view.title}}" message="{{view.message}}" actionText="{{view.actionText}}" bind:action="onViewAction"></state-view>

  <view wx:else class="section">
    <view class="card card--flat list">
      <view class="item-row" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" hover-class="btn-hover" bindtap="onItemTap">
        <view class="item-row__thumb">
          <lazy-image source="{{item.imageSource}}"></lazy-image>
        </view>
        <view class="item-row__body">
          <view class="item-row__name clamp-2">{{item.name}}</view>
          <view class="item-row__desc ellipsis">{{item.desc || item.inventoryLabel}}</view>
          <view class="item-row__price">
            <view wx:if="{{item.hasPrice}}" class="price"><text class="price__symbol">{{item.priceSymbol}}</text><text class="price__number">{{item.priceNumber}}</text><text class="price__unit">{{item.priceUnit}}</text></view>
            <view wx:else class="price--pending">选租期查看报价</view>
          </view>
        </view>
        <ui-icon name="chevron-right" size="32" color="muted"></ui-icon>
      </view>
    </view>
    <view class="muted small center mt-16">共 {{cards.length}} 件 · 参考价以租期报价为准</view>
  </view>
  <view wx:if="{{publicServiceCode}}" class="section"><ai-public-browse service-code="{{publicServiceCode}}" kind="catalog"></ai-public-browse></view>
  <view wx:if="{{publicServiceCode}}" class="section">
    <block wx:if="{{goalOpen}}"><ai-goal-picker service-code="{{publicServiceCode}}" bind:handoff="onGoalHandoff"></ai-goal-picker><button class="btn btn--block mt-16" bindtap="onCloseGoal">返回普通选品</button></block>
    <button wx:else class="btn btn--block" bindtap="onOpenGoal">按使用目标选品</button>
  </view>
</view>
