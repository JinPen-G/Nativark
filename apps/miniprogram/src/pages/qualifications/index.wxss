.evidence { width: 240rpx; height: 180rpx; border: 1rpx dashed var(--line); border-radius: 12rpx; background: var(--page); display: flex; align-items: center; justify-content: center; overflow: hidden; flex: 0 0 auto; }
.evidence__img { width: 100%; height: 100%; }
.evidence__placeholder { color: var(--primary); font-size: var(--font-secondary); }
.cell .btn--small { margin-left: 16rpx; flex: 0 0 auto; }
