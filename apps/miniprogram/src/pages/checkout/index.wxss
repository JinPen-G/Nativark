.line { display: flex; align-items: center; padding: 8rpx 0; }
.line + .line { border-top: 1rpx solid var(--border); margin-top: 12rpx; padding-top: 20rpx; }
.line__thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: var(--page); overflow: hidden; margin-right: 20rpx; flex: 0 0 auto; position: relative; }
.line__thumb image { width: 100%; height: 100%; }
.line .stepper { margin-left: 12rpx; }
.store__icon { width: 80rpx; height: 80rpx; border-radius: 12rpx; background: var(--primary-weak); display: flex; align-items: center; justify-content: center; margin-right: 16rpx; flex: 0 0 auto; }
.toggle__item text { margin-left: 8rpx; }
.benefit { display: flex; align-items: flex-start; font-size: 24rpx; padding: 6rpx 0; color: var(--success); }
.benefit__dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--success); margin: 14rpx 12rpx 0 0; flex: 0 0 auto; }
.benefit--skipped { color: var(--secondary); }
.benefit--skipped .benefit__dot { background: var(--line); }
