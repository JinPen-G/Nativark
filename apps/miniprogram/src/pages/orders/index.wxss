.order__thumb { width: 144rpx; height: 144rpx; border-radius: 12rpx; background: var(--page); overflow: hidden; margin-right: 20rpx; flex: 0 0 auto; }
.order__thumb image { width: 100%; height: 100%; }
.order__thumb-icon { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.order__actions { display: flex; justify-content: flex-end; }
.order__actions .btn { min-width: 160rpx; }
