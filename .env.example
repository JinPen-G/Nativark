# 项目环境入口。本模板面向个人演示，部署前填写连接信息及独立密钥。
# RENTAL_ENV_FILE 可指定根目录相对路径或外部绝对路径，选择后只读取该文件和进程环境。
# RENTAL_ENV_FILE=/etc/rental-os/runtime.env
NODE_ENV=development
# 当前为个人演示，登录页的小窗口与演示重置均保留。正式经营部署改为 production。
RENTAL_DEPLOYMENT_PROFILE=personal-demo
DATABASE_URL="mysql://rental_os:replace-with-url-encoded-mysql-password@127.0.0.1:3306/rental_os"
PLATFORM_DATA_SOURCE=mysql
RENTAL_OS_DATA_SOURCE=mysql
INFRA_DATA_SOURCE=mysql
AUTH_TOKEN_SECRET="change-this-to-a-long-random-secret-before-production"
INTEGRATION_ENCRYPTION_KEY="change-this-to-a-dedicated-secret-before-production"
# 生产环境必须替换为独立随机密钥（至少 32 字节）；示例值、短密钥和明显重复值会被拒绝。
# 新凭据使用带 key ID 的 v2 AES-GCM；仍可读取原 v1。以下仅为轮换配置说明，不含真实密钥。
# INTEGRATION_ENCRYPTION_KEY_ID=key-2026-10
# 首次轮换前，把 INTEGRATION_FINGERPRINT_KEY 固定为原加密密钥，保持手机号/身份检索指纹不变。
# INTEGRATION_FINGERPRINT_KEY=<original-random-secret>
# INTEGRATION_PREVIOUS_ENCRYPTION_KEYS={"old-key-id":"<previous-random-secret>"}
# 历史密钥环最多 5 项；原 v1/v2 尚未完成受控重加密及核对前，不可移除旧密钥。
# 配置轮换不自动改写数据库。原操作结果不明时只核对原键，不替换凭据重发调用。
DATABASE_CONNECT_ON_START=false
# 个人演示显式启用登录前重置。未配置此项默认关闭，正式 production 用途必须关闭。
LOCAL_DEMO_PASSWORD_RESET_ENABLED=true
# Seed 账号口令：仓库不保存明文密码，必须在本地 .env 或环境变量中自行设置。
# 缺失时 `npm run db:seed` 会明确失败，不会用默认口令创建管理员账号。
# 兼容别名：E2E_PLATFORM_PASSWORD / E2E_DEMO_PASSWORD（MySQL E2E 使用同一组值登录）。
SEED_PLATFORM_PASSWORD=
SEED_DEMO_PASSWORD=
# Compose 初始化 MySQL 必填口令。应用连接串须与实际数据库账号匹配。
# 密码可用单引号包裹，保留 $ 字面值；写入 DATABASE_URL 前按 URL 规则编码。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=rental_os
MYSQL_USER=rental_os
# MySQL 与 Redis 默认仅映射本机端口。
MYSQL_BIND_HOST=127.0.0.1
MYSQL_HOST_PORT=3306
REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_URL="redis://127.0.0.1:6379"
API_PORT=3000
# 反向代理后的可信跳数（Express trust proxy）；不设或 0 = 直连、忽略 X-Forwarded-For。客户端限流按此取来源地址。
TRUST_PROXY_HOPS=0
# 跨域浏览器入口按 HTTPS origin 列出，同源 /api 部署可留空。
CORS_ALLOWED_ORIGINS=
# 每个租户每日短信验证码挑战预算（超出返回 429）；缺省 2000。
CLIENT_SMS_DAILY_BUDGET_PER_TENANT=2000
# Web 开发代理属于构建工具配置，浏览器只接收各端明确声明的公开字段。
API_PROXY_TARGET="http://127.0.0.1:3000"
REACT_ADMIN_PORT=5175
TENANT_WEBSITE_PORT=4186
ENTERPRISE_PORTAL_PORT=4191
VITE_API_BASE_URL="/api"
VITE_API_BASE="/api"
# 当前个人测试保留快捷账号选择，仍须输入密码并通过原登录。
VITE_SHOW_ACCOUNT_SHORTCUTS=true
VITE_RENTAL_CATEGORY_GOVERNANCE_PREVIEW=false
VITE_BASE_DOMAIN=
VITE_DEFAULT_TENANT=
VITE_ENTERPRISE_PUBLIC_HOSTS=

# 运维命令读取同一环境入口。目录覆盖值使用绝对路径。
OPS_MYSQL_CONTAINER=rental-os-mysql
# OPS_BACKUP_DIR=/var/lib/rental-os/backups
# OPS_ARTIFACT_DIR=/var/lib/rental-os/artifacts
# RENTAL_UPLOAD_DIR=/var/lib/rental-os/uploads
