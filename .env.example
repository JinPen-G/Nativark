DATABASE_URL="mysql://rental_os:rental_os@localhost:3306/rental_os"
PLATFORM_DATA_SOURCE=mysql
RENTAL_OS_DATA_SOURCE=mysql
INFRA_DATA_SOURCE=mysql
AUTH_TOKEN_SECRET="change-this-to-a-long-random-secret-before-production"
DATABASE_CONNECT_ON_START=false
# Seed 账号口令：仓库不保存明文密码，必须在本地 .env 或环境变量中自行设置。
# 缺失时 `npm run db:seed` 会明确失败，不会用默认口令创建管理员账号。
# 兼容别名：E2E_PLATFORM_PASSWORD / E2E_DEMO_PASSWORD（MySQL E2E 使用同一组值登录）。
SEED_PLATFORM_PASSWORD=
SEED_DEMO_PASSWORD=
# MySQL E2E 专用：容器 root 口令，仅用于创建和清理名字含 e2e 的专用测试库。
MYSQL_ROOT_PASSWORD=
REDIS_URL="redis://localhost:6379"
API_PORT=3000
REACT_ADMIN_PORT=5175
VITE_API_BASE_URL="http://localhost:3000/api"
