DATABASE_URL="mysql://rental_os:rental_os@localhost:3306/rental_os"
PLATFORM_DATA_SOURCE=mysql
RENTAL_OS_DATA_SOURCE=mysql
INFRA_DATA_SOURCE=mysql
AUTH_TOKEN_SECRET="change-this-to-a-long-random-secret-before-production"
INTEGRATION_ENCRYPTION_KEY="change-this-to-a-dedicated-secret-before-production"
# 生产环境必须替换为独立随机密钥（至少 32 字节）；示例值、短密钥和明显重复值会被拒绝。
# 新凭据使用带 key ID 的 v2 AES-GCM；仍可读取原 v1。以下仅为轮换配置说明，不含真实密钥。
# INTEGRATION_ENCRYPTION_KEY_ID=key-2026-10
# 首次轮换前，把 INTEGRATION_FINGERPRINT_KEY 固定为原加密密钥，保持手机号/身份检索指纹不变。
# INTEGRATION_FINGERPRINT_KEY=<original-random-secret>
# INTEGRATION_PREVIOUS_ENCRYPTION_KEYS={"old-key-id":"<previous-random-secret>"}
# 历史密钥环最多 5 项；原 v1/v2 尚未完成受控重加密及核对前，不可移除旧密钥。
# 配置轮换不自动改写数据库。原操作结果不明时只核对原键，不替换凭据重发调用。
DATABASE_CONNECT_ON_START=false
# 演示密码重置默认关闭。仅 development 且已登录的平台管理员拥有系统参数管理权限时可调用。
LOCAL_DEMO_PASSWORD_RESET_ENABLED=false
# Seed 账号口令：仓库不保存明文密码，必须在本地 .env 或环境变量中自行设置。
# 缺失时 `npm run db:seed` 会明确失败，不会用默认口令创建管理员账号。
# 兼容别名：E2E_PLATFORM_PASSWORD / E2E_DEMO_PASSWORD（MySQL E2E 使用同一组值登录）。
SEED_PLATFORM_PASSWORD=
SEED_DEMO_PASSWORD=
# MySQL E2E 专用：容器 root 口令，仅用于创建和清理名字含 e2e 的专用测试库。
MYSQL_ROOT_PASSWORD=
REDIS_URL="redis://localhost:6379"
API_PORT=3000
# 反向代理后的可信跳数（Express trust proxy）；不设或 0 = 直连、忽略 X-Forwarded-For。客户端限流按此取来源地址。
TRUST_PROXY_HOPS=0
# 每个租户每日短信验证码挑战预算（超出返回 429）；缺省 2000。
CLIENT_SMS_DAILY_BUDGET_PER_TENANT=2000
REACT_ADMIN_PORT=5175
VITE_API_BASE_URL="http://localhost:3000/api"
