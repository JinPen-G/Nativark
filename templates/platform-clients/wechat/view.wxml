<view class="client-shell" style="{{themeStyle}}">
  <view class="header"><text class="brand">{{brand || surfaceTitle}}</text><button size="mini" bindtap="changeLanguage">{{locale === 'en-US' ? '简体中文' : 'English'}}</button><button size="mini" bindtap="changeTheme">{{themeLabel}}</button></view>
  <view wx:if="{{!authenticated}}" class="login">
    <view class="title">{{surfaceTitle}}</view>
    <form wx:if="{{anonymous}}" bindsubmit="signIn">
      <label wx:for="{{loginFields}}" wx:key="name"><view>{{item.label}}</view><input name="{{item.name}}" password="{{item.kind === 'password'}}" value="{{item.value}}" /></label>
      <button form-type="submit" class="primary">{{copy.login}}</button>
    </form>
    <view wx:if="{{loadingSession}}" class="status">{{copy.loadingSession}}</view>
    <view wx:if="{{unavailable}}" class="status">{{copy.unavailable}}<button bindtap="reconnect">{{copy.reconnect}}</button><button bindtap="signOut">{{copy.relogin}}</button></view>
    <view aria-role="alert">{{feedback}}</view>
  </view>
  <block wx:else>
    <view class="context"><text>{{identity}}</text><button size="mini" bindtap="signOut">{{copy.logout}}</button></view>
    <picker wx:if="{{scopeChoices.length}}" range="{{scopeChoices}}" range-key="label" bindchange="selectScope"><view class="scope-control">{{copy.scopes}}</view></picker>
    <view class="navigation"><button wx:for="{{navigation}}" wx:key="id" class="{{item.current ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="navigate">{{item.label}}</button></view>
    <view class="page">
      <view class="page-heading"><view class="title">{{title}}</view><button size="mini" bindtap="reload" disabled="{{pageLoading}}">{{copy.refresh}}</button></view>
      <view wx:if="{{description}}" class="secondary">{{description}}</view>
      <view wx:if="{{searchable}}" class="tool"><label>{{copy.searchLabel}}</label><view class="input-action"><input value="{{searchValue}}" bindinput="searchInput" bindconfirm="search" maxlength="256" confirm-type="search" /><button bindtap="search">{{copy.search}}</button></view></view>
      <view wx:if="{{scannable}}" class="tool"><label>{{copy.scanLabel}}</label><view class="input-action"><input value="{{scanValue}}" bindinput="scanInput" bindconfirm="openCode" maxlength="2048" /><button bindtap="openCode">{{copy.open}}</button></view><button bindtap="scan">{{copy.scan}}</button></view>
      <view wx:if="{{pageLoading}}" class="status">{{copy.loading}}</view>
      <view wx:if="{{pageError}}" class="status" aria-role="alert">{{pageError}}<button bindtap="home">{{copy.home}}</button></view>
      <block wx:if="{{pageReady}}">
        <view wx:if="{{!items.length}}" class="status">{{emptyText}}</view>
        <view wx:for="{{items}}" wx:key="id" class="item">
          <button wx:if="{{item.destination}}" class="item-link" data-index="{{index}}" bindtap="openItem">{{item.title}}</button><view wx:else class="item-title">{{item.title}}</view>
          <view wx:if="{{item.detail}}" class="secondary">{{item.detail}}</view><view wx:if="{{item.status}}" class="secondary">{{item.status}}</view>
        </view>
        <view class="actions"><button wx:for="{{actions}}" wx:key="id" data-id="{{item.id}}" bindtap="openAction" disabled="{{item.disabled}}">{{item.label}}</button></view>
        <form wx:if="{{action}}" bindsubmit="execute" class="action-form">
          <view class="item-title">{{action.label}}</view><view class="secondary">{{copy.actionHint}}</view>
          <label wx:for="{{action.fields}}" wx:key="name"><view>{{item.label}}</view>
            <textarea wx:if="{{item.kind === 'textarea'}}" name="{{item.name}}" value="{{item.value}}" maxlength="{{item.maxLength || -1}}" />
            <input wx:else name="{{item.name}}" value="{{item.value}}" maxlength="{{item.maxLength || -1}}" />
          </label>
          <button form-type="submit" class="primary" disabled="{{busy}}">{{copy.confirm}}</button><button bindtap="cancelAction">{{copy.cancel}}</button>
        </form>
      </block>
      <view wx:if="{{feedback}}" class="status" aria-role="alert">{{feedback}}</view>
      <view wx:if="{{receiptError}}" class="status">{{receiptError}}</view>
      <view wx:if="{{pending.length}}" class="receipts"><view class="item-title">{{copy.pending}}</view>
        <view wx:for="{{pending}}" wx:key="operationKey" class="item"><view>{{item.label}}</view><view class="secondary">{{item.targetId}}</view><button data-index="{{index}}" bindtap="readReceipt" disabled="{{busy}}">{{copy.receipt}}</button></view>
      </view>
    </view>
  </block>
</view>
