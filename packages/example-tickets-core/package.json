{
  "name": "@rental-os/example-tickets-core",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "租户范围的轻量工单 Core 接入示范",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "contracts": [
        "dist/contracts.d.ts"
      ],
      "http": [
        "dist/http.d.ts"
      ],
      "package": [
        "dist/package.d.ts"
      ],
      "admin": [
        "admin/index.tsx"
      ],
      "mysql": [
        "dist/mysql.d.ts"
      ],
      "nest": [
        "dist/nest.d.ts"
      ],
      "platform-host": [
        "dist/platform-host.d.ts"
      ],
      "ai": [
        "dist-ai/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./package": {
      "types": "./dist/package.d.ts",
      "default": "./dist/package.js"
    },
    "./admin": "./admin/index.tsx",
    "./mysql": {
      "types": "./dist/mysql.d.ts",
      "default": "./dist/mysql.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "default": "./dist/nest.js"
    },
    "./platform-host": {
      "types": "./dist/platform-host.d.ts",
      "default": "./dist/platform-host.js"
    },
    "./ai": {
      "types": "./dist-ai/index.d.mts",
      "default": "./dist-ai/index.mjs"
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @rental-os/platform-core-host",
    "build": "tsc -p tsconfig.json",
    "build:ai": "tsc -p tsconfig.ai.json",
    "prelint": "npm run build -w @rental-os/platform-core-host",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack:core": "npm run build",
    "pack:core": "node dist/metadata.js package",
    "prepack:core:ai": "npm run build && npm run build:ai",
    "pack:core:ai": "node dist/metadata.js package:ai",
    "prelint:admin": "npm run build",
    "lint:admin": "tsc -p admin/tsconfig.json"
  },
  "dependencies": {
    "@rental-os/core-contracts": "0.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@prisma/client": "^5.22.0",
    "@nestjs/common": "^10.4.15",
    "react": "19.2.8",
    "@tanstack/react-query": "5.101.4",
    "@rental-os/platform-core-host": "0.1.0",
    "@rental-os/platform-server": "0.1.0",
    "@rental-os/platform-contracts": "0.1.0",
    "@rental-os/core-host": "0.1.0",
    "@rental-os/platform-admin": "0.1.0",
    "@rental-os/ai-native-server": "0.2.1"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@rental-os/platform-core-host": {
      "optional": true
    },
    "@rental-os/platform-server": {
      "optional": true
    },
    "@rental-os/platform-contracts": {
      "optional": true
    },
    "@rental-os/core-host": {
      "optional": true
    },
    "@rental-os/platform-admin": {
      "optional": true
    },
    "@rental-os/ai-native-server": {
      "optional": true
    }
  }
}
