{
  "name": "@rental-os/example-tickets-core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "租户范围的轻量工单 Core 接入示范",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./contracts": { "types": "./dist/contracts.d.ts", "default": "./dist/contracts.js" },
    "./mysql": { "types": "./dist/mysql.d.ts", "default": "./dist/mysql.js" }
  },
  "scripts": {
    "prebuild": "npm run build -w @rental-os/core-contracts",
    "build": "tsc -p tsconfig.json",
    "prelint": "npm run build -w @rental-os/core-contracts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rental-os/core-contracts": "0.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@prisma/client": "^5.22.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": { "optional": true }
  }
}
