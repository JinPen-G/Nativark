  runOverheads         AiTaskRunOverhead[]

  @@id([scopeId, taskId, chargeId])
  @@index([scopeId, taskId, status], map: "ai_task_execution_charges_status_idx")
  @@index([scopeId, taskId, runId], map: "ai_task_execution_charges_run_idx")
  @@map("ai_task_execution_charges")

}

