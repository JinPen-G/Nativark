  unknownReason        String? @db.VarChar(128)
  revision             Int @default(1) @db.UnsignedInt
  createdAt            DateTime @default(now()) @db.DateTime(3)
  updatedAt            DateTime @updatedAt @db.DateTime(3)
  budget               AiTaskExecutionBudget @relation(fields: [scopeId, taskId], references: [scopeId, taskId], onDelete: Restrict, onUpdate: Restrict)
  run                  AiRun @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  step                 AiStep? @relation(fields: [scopeId, taskId, stepId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
