/// Creation input is immutable; expiry/revocation never deletes the task or business receipt.
/// Owner-scoped conversation metadata, not a Task, business record or budget.
model AiConversation {
  id                String @id @db.VarChar(36)
  scopeId           String @db.VarChar(36)
  ownerId           String @db.VarChar(191)
  capabilityCode    String @db.VarChar(64)
  revision          Int @db.UnsignedInt
  status            String @db.VarChar(16)
  /// Remains occupied until original task/effect evidence permits a new turn.
  activeTurnId      String? @db.VarChar(36)
  createdAt         DateTime @db.DateTime(3)
  updatedAt         DateTime @db.DateTime(3)
  deletedAt         DateTime? @db.DateTime(3)
  scope             AiScope @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  turns             AiConversationTurn[]
  operations        AiConversationOperation[]

  @@unique([scopeId, ownerId, id], map: "ai_conversations_owner_key")
  @@index([scopeId, ownerId, status, id], map: "ai_conversations_owner_page")
  @@map("ai_conversations")
}

