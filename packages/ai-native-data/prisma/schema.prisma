  admissionRevision Int @db.UnsignedInt
  inputHash         String @db.Char(64)
  originalRequestId String @db.VarChar(36)
  originalRequestKey String @db.VarChar(128)
  capabilityCode    String @db.VarChar(64)
  capabilityVersion String @db.VarChar(64)
  createdAt         DateTime @db.DateTime(3)
  conversation      AiConversation @relation(fields: [scopeId, ownerId, conversationId], references: [scopeId, ownerId, id], onDelete: Restrict, onUpdate: Restrict)
  original          AiTaskOriginalRequest @relation(fields: [scopeId, originalRequestId], references: [scopeId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scopeId, ownerId, conversationId, admissionKey], map: "ai_conversation_turn_admission")
  @@unique([scopeId, originalRequestId], map: "ai_conversation_turn_original")
  @@index([scopeId, ownerId, conversationId, id], map: "ai_conversation_turn_page")
  @@map("ai_conversation_turns")
}

