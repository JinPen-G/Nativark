// AI Native persistence extracted from immutable source; compose after public + Rental.
// Source: a3ba65b408fbc1be97f0f6e1170330b256a1ab29 apps/api/prisma/schema.prisma

model AiDesktopBusinessPolicy {
  tenantId      String   @db.VarChar(36)
  workspaceId   String   @db.VarChar(36)
  revision      Int      @db.UnsignedInt
  policyJson    Json
  updatedBy     String   @db.VarChar(36)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  @@id([tenantId, workspaceId])
  @@map("ai_desktop_business_policies")
}

model AiDesktopBusinessPolicyOperation {
  tenantId       String   @db.VarChar(36)
  workspaceId    String   @db.VarChar(36)
  operationKey   String   @db.VarChar(128)
  actorId        String   @db.VarChar(36)
  payloadHash    String   @db.Char(64)
  resultJson     Json
  createdAt      DateTime @default(now()) @db.DateTime(3)

  @@id([tenantId, workspaceId, operationKey])
  @@index([tenantId, workspaceId, createdAt], map: "ai_desktop_business_operations_created_idx")
  @@map("ai_desktop_business_policy_operations")
}

enum AiProviderProfileRole {
  DEFAULT    @map("default")
  REASONING  @map("reasoning")
  VISION     @map("vision")
  EMBEDDING  @map("embedding")
}

/// Revisioned dual-mode tenant configuration; encrypted BYOK is retained when
/// platform mode is selected. Legacy system-rules data is never deleted here.
model AiTenantModelConfiguration {
  tenantId             String   @id @db.VarChar(191)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mode                 String   @default("platform_managed") @db.VarChar(32)
  revision             Int      @default(1) @db.UnsignedInt
  /// Null preserves legacy BYOK enabled semantics; explicit saves bind the
  /// service gate independently of retained BYOK fields and selected mode.
  serviceEnabled       Boolean?
  settings             Json?
  credentialsEncrypted String?  @db.Text
  createdAt            DateTime @default(now()) @db.DateTime(3)
  updatedAt            DateTime @updatedAt @db.DateTime(3)

  @@map("ai_tenant_model_configurations")
}

/// Immutable original configuration-save observation, committed with the config
/// and Profile/Vault CAS. Contains safe results and keyed input hashes, no keys.
model AiModelConfigurationOperation {
  id               String      @id @default(uuid()) @db.VarChar(36)
  scopeId          String      @db.VarChar(36)
  scopeKind        AiScopeKind
  targetId         String      @db.VarChar(191)
  operationKey     String      @db.VarChar(128)
  actorId          String      @db.VarChar(191)
  workspaceId      String?     @db.VarChar(191)
  expectedRevision Int         @db.UnsignedInt
  resultRevision   Int         @db.UnsignedInt
  commandHash      String      @db.Char(64)
  result           Json
  resultHash       String      @db.Char(64)
  recordedAt       DateTime    @default(now()) @db.DateTime(3)
  scope            AiScope     @relation(fields: [scopeId, scopeKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scopeId, scopeKind, targetId, operationKey], map: "ai_model_config_operation_original_key")
  @@unique([scopeId, scopeKind, targetId, resultRevision], map: "ai_model_config_operation_revision_key")
  @@map("ai_model_configuration_operations")
}

/// Server-resolved profile. credentialRef is a vault reference, never a key.
/// CAS is enforced by the revision predicate in the repository and migration
/// uniqueness prevents two profiles with the same role in one owner scope.
model AiProviderProfile {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  scopeId            String                 @db.VarChar(36)
  scopeKind          AiScopeKind
  profileKey         String                 @db.VarChar(64)
  role               AiProviderProfileRole  @default(DEFAULT)
  serviceMode        String                 @default("tenant_managed") @db.VarChar(32)
  protocol           String                 @db.VarChar(64)
  provider           String                 @db.VarChar(128)
  model              String                 @db.VarChar(256)
  credentialRef      String                 @db.VarChar(191)
  configRevision     Int                    @default(1) @db.UnsignedInt
  enabled            Boolean                @default(true)
  allowedCapabilities Json
  createdAt          DateTime               @default(now()) @db.DateTime(3)
  updatedAt          DateTime               @updatedAt
  disabledAt         DateTime?
  scope              AiScope                @relation(fields: [scopeId, scopeKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  capabilityEvidence  AiProviderCapabilityEvidence[]
  textProbeReceipts    AiTextCapabilityReceipt[]
  platformConnection  AiPlatformModelConnection?

  @@unique([scopeId, scopeKind, profileKey], map: "ai_provider_profiles_scope_key")
  @@unique([scopeId, scopeKind, role], map: "ai_provider_profiles_scope_role")
  @@index([scopeKind, serviceMode, enabled], map: "ai_provider_profiles_route_idx")
  @@map("ai_provider_profiles")
}

model AiTextCapabilityReceipt {
  id              String   @id @default(uuid()) @db.VarChar(36)
  scopeId         String   @db.VarChar(36)
  profileId       String   @db.VarChar(36)
  operationId     String   @db.VarChar(128)
  descriptor      Json
  descriptorHash  String   @db.Char(64)
  observation     Json?
  observationHash String?  @db.Char(64)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  profile         AiProviderProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ai_text_capability_profile_fk")

  @@unique([scopeId, operationId], map: "ai_text_capability_scope_operation_key")
  @@index([profileId], map: "ai_text_capability_profile_idx")
  @@map("ai_text_capability_receipts")
}

/// Server-only platform vault. Profile revision and this row are committed together.
model AiPlatformModelConnection {
  profileId            String            @id @db.VarChar(36)
  profile              AiProviderProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configRevision       Int               @db.UnsignedInt
  baseUrl              String            @db.VarChar(2048)
  maxOutputTokens      Int               @db.UnsignedInt
  credentialsEncrypted String            @db.Text
  createdAt            DateTime          @default(now()) @db.DateTime(3)
  updatedAt            DateTime          @updatedAt @db.DateTime(3)

  @@map("ai_platform_model_connections")
}

/// Capability evidence is revision-bound. A provider configuration change makes
/// older evidence stale without mutating history or granting an implicit fallback.
model AiProviderCapabilityEvidence {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  profileId          String             @db.VarChar(36)
  scopeId            String             @db.VarChar(36)
  scopeKind          AiScopeKind
  capability         String             @db.VarChar(64)
  status             String             @db.VarChar(32)
  source             String             @db.VarChar(32)
  observedRevision   Int                @db.UnsignedInt
  evidenceHash       String             @db.VarChar(128)
  checkedAt          DateTime           @db.DateTime(3)
  expiresAt          DateTime?
  details            Json?
  profile            AiProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt

  @@unique([profileId, capability], map: "ai_provider_capability_evidence_profile_capability_key")
  @@index([scopeId, scopeKind, capability, observedRevision], map: "ai_provider_capability_evidence_route_idx")
  @@map("ai_provider_capability_evidence")
}

/// Durable admission record for an AI dispatch. Unknown is a first-class state:
/// it cannot be silently retried or treated as a successful business action.
model AiInvocationAdmission {
  id             String   @id @default(uuid()) @db.VarChar(36)
  /// Explicit scope ownership: WORKSPACE keeps the legacy tenant attribution;
  /// PLATFORM rows carry null tenant/workspace and the platform dedup key.
  scopeKind      AiScopeKind @default(WORKSPACE)
  /// Non-null only for PLATFORM rows (callId under the single platform scope);
  /// unique-indexed so MySQL still enforces single-admission dedup where the
  /// nullable tenant columns cannot.
  platformDedupKey String? @unique(map: "ai_invocation_admission_platform_dedup_key") @db.VarChar(191)
  tenantId       String?  @db.VarChar(191)
  workspaceId    String?  @db.VarChar(191)
  actorId        String   @db.VarChar(191)
  callId         String   @db.VarChar(128)
  requestHash    String   @db.VarChar(128)
  profileId      String?  @db.VarChar(36)
  status         String   @db.VarChar(32)
  dispatchId     String?  @db.VarChar(128)
  unknownReason  String?  @db.VarChar(128)
  expiresAt      DateTime @db.DateTime(3)
  admittedAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt
  revokedAt      DateTime?
  completedAt    DateTime?
  accountingReceipts AiGatewayAccountingReceipt[]

  @@unique([tenantId, workspaceId, id], map: "ai_invocation_admission_scope_id")
  @@unique([tenantId, callId], map: "ai_invocation_admission_tenant_call_key")
  @@index([tenantId, workspaceId, status], map: "ai_invocation_admission_scope_status_idx")
  @@index([status, expiresAt], map: "ai_invocation_admission_expiry_idx")
  @@map("ai_invocation_admissions")
}

model AiUsageReservation {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tenantId        String   @db.VarChar(191)
  workspaceId     String   @db.VarChar(191)
  callId          String   @db.VarChar(128)
  idempotencyKey  String   @db.VarChar(128)
  status          String   @db.VarChar(32)
  reservedUnits   Int      @db.UnsignedInt
  actualInput     Int?     @db.UnsignedInt
  actualOutput    Int?     @db.UnsignedInt
  unknownReason   String?  @db.VarChar(128)
  expiresAt       DateTime @db.DateTime(3)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt
  settledAt       DateTime?

  @@unique([tenantId, idempotencyKey], map: "ai_usage_reservation_tenant_key")
  @@unique([tenantId, callId], map: "ai_usage_reservation_tenant_call_key")
  @@index([tenantId, workspaceId, status], map: "ai_usage_reservation_scope_status_idx")
  @@map("ai_usage_reservations")
}

model AiUsageLedgerEntry {
  id             String   @id @default(uuid()) @db.VarChar(36)
  reservationId  String   @db.VarChar(36)
  tenantId       String   @db.VarChar(191)
  eventKey       String   @db.VarChar(128)
  kind           String   @db.VarChar(32)
  inputUnits     Int      @default(0) @db.UnsignedInt
  outputUnits    Int      @default(0) @db.UnsignedInt
  createdAt      DateTime @default(now()) @db.DateTime(3)

  @@unique([reservationId, eventKey], map: "ai_usage_ledger_reservation_event_key")
  @@index([tenantId, createdAt], map: "ai_usage_ledger_tenant_created_idx")
  @@map("ai_usage_ledger_entries")
}

/// Non-financial binding for one already-authorized Gateway step; no prompt body is stored.
model AiGatewayInvocation {
  id                String   @id @default(uuid()) @db.VarChar(36)
  scopeId           String   @db.VarChar(36)
  taskId            String   @db.VarChar(36)
  runId             String   @db.VarChar(36)
  stepId            String   @db.VarChar(36)
  actionId          String   @db.VarChar(191)
  stepFingerprint   String   @db.Char(64)
  actorId           String   @db.VarChar(191)
  callId            String   @db.VarChar(128)
  sceneCode         String   @db.VarChar(128)
  mode              String   @db.VarChar(8)
  intentHash        String   @db.Char(64)
  registrationHash  String   @db.Char(64)
  configuration     Json
  configurationHash String   @db.Char(64)
  priceVersion      String   @db.VarChar(64)
  maxOutputTokens   Int      @db.UnsignedInt
  leaseOwnerId      String   @db.VarChar(191)
  fencingToken      Decimal  @db.Decimal(20, 0)
  expiresAt         DateTime @db.DateTime(3)
  createdAt         DateTime @default(now()) @db.DateTime(3)
  step              AiStep   @relation(fields: [scopeId, taskId, actionId, stepFingerprint], references: [scopeId, taskId, actionId, requestFingerprint], onDelete: Restrict, onUpdate: Restrict)
  run               AiRun    @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  executionCharges  AiTaskExecutionCharge[]
  accountingReceipts AiGatewayAccountingReceipt[]
  toolCallBindings   AiGatewayToolCallBinding[]

  @@unique([scopeId, taskId, id], map: "ai_gateway_invocations_scope_task_id")
  @@unique([scopeId, callId], map: "ai_gateway_invocations_scope_call_key")
  @@unique([scopeId, stepId], map: "ai_gateway_invocations_scope_step_key")
  @@index([scopeId, taskId, runId], map: "ai_gateway_invocations_task_run_idx")
  @@index([scopeId, createdAt, id], map: "ai_gateway_invocations_created_idx")
  @@map("ai_gateway_invocations")
}

/// Private protocol-call binding, not financial usage or a public tool grant.
/// Native IDs/arguments are encrypted; a completed original Task/Step and current
/// business authorization remain necessary before a successor can read it.
model AiGatewayToolCallBinding {
  scopeId           String   @db.VarChar(36)
  taskId            String   @db.VarChar(36)
  invocationId      String   @db.VarChar(36)
  callIndex         Int      @db.UnsignedTinyInt
  runId             String   @db.VarChar(36)
  stepId            String   @db.VarChar(36)
  actionId          String   @db.VarChar(191)
  stepFingerprint   String   @db.Char(64)
  actorId           String   @db.VarChar(191)
  configurationHash String   @db.Char(64)
  inputHash         String   @db.Char(64)
  bindingHash       String   @db.Char(64)
  encryptedPayload  String   @db.Text
  createdAt         DateTime @default(now()) @db.DateTime(3)
  invocation        AiGatewayInvocation @relation(fields: [scopeId, taskId, invocationId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_gateway_tool_calls_invocation_fkey")
  @@id([scopeId, taskId, invocationId, callIndex])
  @@index([scopeId, taskId, runId, stepId], map: "ai_gateway_tool_calls_step_idx")
  @@map("ai_gateway_tool_call_bindings")
}

model AiGatewayAccountingReceipt {
  id            String @id @default(uuid()) @db.VarChar(36)
  scopeId       String @db.VarChar(36)
  scopeKind     AiScopeKind
  taskId        String @db.VarChar(36)
  /// Null for PLATFORM rows; scopeKind is the authoritative attribution.
  tenantId      String? @db.VarChar(191)
  workspaceId   String? @db.VarChar(191)
  invocationId  String @unique @db.VarChar(36)
  reservationId String @unique @db.VarChar(36)
  admissionId   String @unique @db.VarChar(36)
  dispatchToken String @db.VarChar(128)
  requestHash   String @db.VarChar(128)
  state         String @default("reserved") @db.VarChar(16)
  inputTokens   BigInt? @db.UnsignedBigInt
  outputTokens  BigInt? @db.UnsignedBigInt
  /// Validated protocol billing dimensions, atomically bound by usageHash.
  usageDetails  Json?
  usageHash     String? @db.Char(64)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  invocation    AiGatewayInvocation @relation(fields: [scopeId, taskId, invocationId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  reservation   AiBudgetReservation @relation(fields: [scopeId, scopeKind, reservationId], references: [scopeId, scopeKind, id], onDelete: Restrict, onUpdate: Restrict)
  /// Optional because PLATFORM rows carry null tenant/workspace attribution.
  admission     AiInvocationAdmission? @relation(fields: [tenantId, workspaceId, admissionId], references: [tenantId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([scopeId, state], map: "ai_gateway_accounting_scope_state_idx")
  @@map("ai_gateway_accounting_receipts")
}

enum AiTaskExecutionResource {
  STEPS        @map("steps")
  CALLS        @map("calls")
  ACTIVE_MS    @map("active_ms")
  OUTPUT_BYTES @map("output_bytes")
}

enum AiTaskExecutionChargeStatus {
  RESERVED @map("reserved")
  RECORDED @map("recorded")
  UNKNOWN  @map("unknown")
}

/// Explicitly initialized task resource limits; absence disables execution, not unlimited usage.
model AiTaskExecutionBudget {
  scopeId             String @db.VarChar(36)
  taskId              String @db.VarChar(36)
  policyVersion       String @db.VarChar(64)
  policyFingerprint   String @db.Char(64)
  maxSteps            BigInt @db.UnsignedBigInt
  maxCalls            BigInt @db.UnsignedBigInt
  maxActiveMs         BigInt @db.UnsignedBigInt
  maxOutputBytes      BigInt @db.UnsignedBigInt
  reservedSteps       BigInt @default(0) @db.UnsignedBigInt
  consumedSteps       BigInt @default(0) @db.UnsignedBigInt
  reservedCalls       BigInt @default(0) @db.UnsignedBigInt
  consumedCalls       BigInt @default(0) @db.UnsignedBigInt
  reservedActiveMs    BigInt @default(0) @db.UnsignedBigInt
  consumedActiveMs    BigInt @default(0) @db.UnsignedBigInt
  reservedOutputBytes BigInt @default(0) @db.UnsignedBigInt
  consumedOutputBytes BigInt @default(0) @db.UnsignedBigInt
  revision            Int    @default(1) @db.UnsignedInt
  createdAt           DateTime @default(now()) @db.DateTime(3)
  updatedAt           DateTime @updatedAt @db.DateTime(3)
  task                AiTask @relation(fields: [scopeId, taskId], references: [scopeId, id], onDelete: Restrict, onUpdate: Restrict)
  charges             AiTaskExecutionCharge[]

  @@id([scopeId, taskId])
  @@map("ai_task_execution_budgets")
}

/// Resource occupancy/receipts only; never a second monetary ledger or dispatch permit.
model AiTaskExecutionCharge {
  scopeId              String @db.VarChar(36)
  taskId               String @db.VarChar(36)
  chargeId             String @db.VarChar(36)
  runId                String @db.VarChar(36)
  stepId               String? @db.VarChar(36)
  actionId             String? @db.VarChar(191)
  stepFingerprint      String? @db.Char(64)
  gatewayInvocationId  String? @db.VarChar(36)
  leaseOwnerId         String @db.VarChar(191)
  fencingToken         Decimal @db.Decimal(20, 0)
  requestFingerprint   String @db.Char(64)
  resource             AiTaskExecutionResource
  amount               BigInt @db.UnsignedBigInt
  actualAmount         BigInt? @db.UnsignedBigInt
  status               AiTaskExecutionChargeStatus @default(RESERVED)
  outcomeFingerprint   String? @db.Char(64)
  evidenceRef          String? @db.VarChar(191)
  unknownReason        String? @db.VarChar(128)
  revision             Int @default(1) @db.UnsignedInt
  createdAt            DateTime @default(now()) @db.DateTime(3)
  updatedAt            DateTime @updatedAt @db.DateTime(3)
  budget               AiTaskExecutionBudget @relation(fields: [scopeId, taskId], references: [scopeId, taskId], onDelete: Restrict, onUpdate: Restrict)
  run                  AiRun @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  step                 AiStep? @relation(fields: [scopeId, taskId, stepId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  gatewayInvocation    AiGatewayInvocation? @relation(fields: [scopeId, taskId, gatewayInvocationId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)

  phaseSteps           AiTaskExecutionPhaseStart[] @relation("ExecutionPhaseStepsCharge")
  phaseActiveMs        AiTaskExecutionPhaseStart[] @relation("ExecutionPhaseActiveCharge")
  phaseOutputBytes     AiTaskExecutionPhaseStart[] @relation("ExecutionPhaseOutputCharge")
  runPreparations      AiTaskRunPreparation[]
  runOverheads         AiTaskRunOverhead[]

  @@id([scopeId, taskId, chargeId])
  @@index([scopeId, taskId, status], map: "ai_task_execution_charges_status_idx")
  @@index([scopeId, taskId, runId], map: "ai_task_execution_charges_run_idx")
  @@map("ai_task_execution_charges")
}

/// Original Run preparation definition/measurement, not an executable plan or resource ledger.
/// An incomplete marker never permits re-publication or a guessed zero measurement.
model AiTaskRunPreparation {
  scopeId           String @db.VarChar(36)
  taskId            String @db.VarChar(36)
  id                String @db.VarChar(36)
  runId             String @db.VarChar(36)
  definition        Json
  definitionHash    String @db.Char(64)
  authorityHash     String @db.Char(64)
  policyVersion     String @db.VarChar(64)
  expiresAt         DateTime @db.DateTime(3)
  leaseOwnerId      String @db.VarChar(191)
  fencingToken      Decimal @db.Decimal(20, 0)
  runRevision       Int @db.UnsignedInt
  chargeId          String? @db.VarChar(36)
  requestFingerprint String? @db.Char(64)
  startedAt         DateTime @db.DateTime(3)
  completedAt       DateTime? @db.DateTime(3)
  activeMs          BigInt? @db.UnsignedBigInt
  prepared          Boolean @default(false)
  planHash          String? @db.Char(64)
  measurementHash   String? @db.Char(64)
  run               AiRun @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  charge            AiTaskExecutionCharge? @relation(fields: [scopeId, taskId, chargeId], references: [scopeId, taskId, chargeId], onDelete: Restrict, onUpdate: Restrict)

  @@id([scopeId, taskId, id])
  @@unique([scopeId, taskId, runId, fencingToken], map: "ai_task_run_preparations_generation_key")
  @@index([scopeId, taskId, runId], map: "ai_task_run_preparations_run_idx")
  @@map("ai_task_run_preparations")
}

/// Server-only orchestration time evidence linked to the original ACTIVE_MS charge.
/// No business result, plan, dispatch grant, counters or financial amounts are stored here.
model AiTaskRunOverhead {
  scopeId            String @db.VarChar(36)
  taskId             String @db.VarChar(36)
  id                 String @db.VarChar(36)
  runId              String @db.VarChar(36)
  segment            String @db.VarChar(191)
  originHash         String @db.Char(64)
  policyHash         String @db.Char(64)
  leaseOwnerId       String @db.VarChar(191)
  fencingToken       Decimal @db.Decimal(20, 0)
  runRevision        Int @db.UnsignedInt
  expiresAt          DateTime @db.DateTime(3)
  startedAt          DateTime @db.DateTime(3)
  completedAt        DateTime? @db.DateTime(3)
  chargeId           String? @db.VarChar(36)
  requestFingerprint String? @db.Char(64)
  activeMs           BigInt? @db.UnsignedBigInt
  measurementHash    String? @db.Char(64)
  run                AiRun @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict)
  charge             AiTaskExecutionCharge? @relation(fields: [scopeId, taskId, chargeId], references: [scopeId, taskId, chargeId], onDelete: Restrict, onUpdate: Restrict)

  @@id([scopeId, taskId, id])
  @@index([scopeId, taskId, runId], map: "ai_task_run_overheads_run_idx")
  @@map("ai_task_run_overheads")
}

/// Immutable server-authorized execution plan. No automatic plans for old runs.
model AiTaskRunPlan {
  scopeId String @db.VarChar(36)
  taskId String @db.VarChar(36)
  runId String @db.VarChar(36)
  planHash String @db.Char(64)
  authorityHash String @db.Char(64)
  policyVersion String @db.VarChar(64)
  payload Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  run AiRun @relation(fields: [scopeId, taskId, runId], references: [scopeId, taskId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_task_run_plans_run_fkey")
  inputRequests AiTaskInputRequest[]
  executionPhases AiTaskExecutionPhaseStart[]
  @@id([scopeId, taskId, runId])
  @@unique([scopeId, taskId, runId, planHash], map: "ai_task_run_plans_hash_key")
  @@map("ai_task_run_plans")
}

/// Server-owned scene policy. No implicit policy, no enabled seed or model-selected limits.
model AiTaskPlanPolicy {
  scopeId String @db.VarChar(36)
  sceneCode String @db.VarChar(64)
  sceneVersion String @db.VarChar(64)
  revision Int @db.UnsignedInt
  enabled Boolean @default(false)
  allowedTools Json
  limits Json
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt
  scope AiScope @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ai_task_plan_policies_scope_fkey")
  @@id([scopeId, sceneCode, sceneVersion])
  @@index([scopeId, expiresAt], map: "ai_task_plan_policies_expiry_idx")
  @@map("ai_task_plan_policies")
}

/// Minimal normalized read input, immutable after publication. No credentials or raw prompts.
model AiTaskActionInput {
  scopeId String @db.VarChar(36)
  taskId String @db.VarChar(36)
  runId String @db.VarChar(36)
  id String @db.VarChar(36)
