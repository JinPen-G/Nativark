{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": false,
    "paths": {
      "@/registry/*": ["../ui-arc/vendor/registry/*"],
      "@/lib/motion-tokens": ["../ui-arc/vendor/lib/motion-tokens.ts"],
      "@/lib/media": ["../ui-arc/vendor/lib/media.ts"],
      "@/lib/use-copy-feedback": ["../ui-arc/vendor/lib/use-copy-feedback.ts"],
      "@/lib/use-today": ["../ui-arc/vendor/lib/use-today.ts"],
      "@/lib/usePrefersReducedMotion": ["./src/lib/usePrefersReducedMotion.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "config"]
}
