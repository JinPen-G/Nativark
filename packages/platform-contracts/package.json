{
  "name": "@rental-os/platform-contracts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "不依赖业务Core的公共身份、人员和设置契约",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./subscription": {
      "types": "./dist/subscription.d.ts",
      "default": "./dist/subscription.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "typesVersions": {
    "*": {
      "subscription": [
        "dist/subscription.d.ts"
      ]
    }
  }
}
