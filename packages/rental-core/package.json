{
  "name": "@rental-os/rental-core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rental业务Core的独立领域合同与运行时，原组合通过兼容出口消费",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./business-day": {
      "types": "./dist/business-day.d.ts",
      "default": "./dist/business-day.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "default": "./dist/pricing.js"
    },
    "./equipment": {
      "types": "./dist/equipment.d.ts",
      "default": "./dist/equipment.js"
    },
    "./capabilities/camera-compatibility": {
      "types": "./dist/capabilities/camera-compatibility.d.ts",
      "default": "./dist/capabilities/camera-compatibility.js"
    },
    "./capabilities/camera-kit-handover": {
      "types": "./dist/capabilities/camera-kit-handover.d.ts",
      "default": "./dist/capabilities/camera-kit-handover.js"
    },
    "./capabilities/camping-cleaning-turnaround": {
      "types": "./dist/capabilities/camping-cleaning-turnaround.d.ts",
      "default": "./dist/capabilities/camping-cleaning-turnaround.js"
    },
    "./capabilities/camping-kit-integrity": {
      "types": "./dist/capabilities/camping-kit-integrity.d.ts",
      "default": "./dist/capabilities/camping-kit-integrity.js"
    },
    "./capabilities/kit-handover": {
      "types": "./dist/capabilities/kit-handover.d.ts",
      "default": "./dist/capabilities/kit-handover.js"
    }
  },
  "typesVersions": {
    "*": {
      "business-day": [
        "dist/business-day.d.ts"
      ],
      "pricing": [
        "dist/pricing.d.ts"
      ],
      "equipment": [
        "dist/equipment.d.ts"
      ],
      "capabilities/camera-compatibility": [
        "dist/capabilities/camera-compatibility.d.ts"
      ],
      "capabilities/camera-kit-handover": [
        "dist/capabilities/camera-kit-handover.d.ts"
      ],
      "capabilities/camping-cleaning-turnaround": [
        "dist/capabilities/camping-cleaning-turnaround.d.ts"
      ],
      "capabilities/camping-kit-integrity": [
        "dist/capabilities/camping-kit-integrity.d.ts"
      ],
      "capabilities/kit-handover": [
        "dist/capabilities/kit-handover.d.ts"
      ]
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @rental-os/platform-contracts",
    "build": "tsc -p tsconfig.json",
    "prelint": "npm run build -w @rental-os/platform-contracts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rental-os/platform-contracts": "0.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.15"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
