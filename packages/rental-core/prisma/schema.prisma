// Rental自有模型与枚举；公共模型和生成器由宿主按正式接点组合。

// 未装配AI时只省略AI反向关系，原物理列、默认值、索引与业务外键保持。

model BusinessWorkspace {
  id                                String                                  @id
  tenantId                          String
  tenant                            Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                              String
  name                              String
  /// 唯一经营品类。外键指向品类定义表，杜绝写入未定义品类。
  categoryCode                      String @db.VarChar(64)
  category                          RentalCategoryDefinition                @relation(fields: [categoryCode], references: [code])
  /// 当前采用的不可变品类定义；存量空间由兼容迁移绑定 legacy 基线。
  categoryVersionId                 String?                                 @db.VarChar(191)
  categoryVersion                   RentalCategoryVersion?                 @relation(fields: [categoryCode, categoryVersionId], references: [categoryCode, id])
  categoryAdoptionRevision          Int                                     @default(0)
  categoryAdoptions                 RentalCategoryAdoptionAudit[]
  categoryPreparations              RentalCategoryAdoptionPreparation[]
  status                            WorkspaceStatus                         @default(ACTIVE)
  /// 兼容层标记：升级前建立的既有业务全部归属租户的默认空间。
  /// 每租户至多一个，由下方 partial-unique 的替代方案（defaultMarker）保证。
  isDefault                         Boolean                                 @default(false)
  /// 用于"每租户只能有一个默认空间"的唯一约束。
  /// MySQL 没有部分索引，因此默认空间写 'default'、非默认写自身 id：
  /// 前者在租户内必然冲突，后者天然唯一。
  defaultMarker                     String
  /// CORE-EXT-02C：运行模式 production / demo / development。
  /// 决定「缺品类必选能力」是提示还是服务端拒绝业务写入。
  /// 默认 development：存量空间此前从未被门禁约束，直接标 production 会让它们立刻停业。
  /// 新建空间由应用层显式传 production（创建时会同事务初始化必选能力）。
  runMode                           String                                  @default("development")
  members                           WorkspaceMember[]
  authSessions                      AuthSession[]
  operationLogs                     OperationLog[]
  membershipReviews                 CustomerMembershipReview[]
  customerQualificationRevisions    CustomerQualificationRevision[]
  membershipQualificationTypes      CustomerMembershipQualificationType[]
  clientRegistrationChallenges      ClientRegistrationChallenge[]
  clientAuthSessions                ClientAuthSession[]
  enterpriseBookingApprovals         EnterpriseBookingApproval[]
  enterpriseExtensionApprovals       EnterpriseExtensionApproval[]
  enterpriseRentalHandoffs           EnterpriseRentalHandoffRequest[]
  clientChannelPublications         ClientChannelWorkspace[]
  clientOrderDeliverySnapshots      ClientOrderDeliverySnapshot[]
  coreStateSnapshot                 RentalCoreStateSnapshot?
  businessStateSnapshot             RentalBusinessStateSnapshot?
  approvedProfileChanges            CustomerApprovedProfileChange[]
  // SPACE-03：经营事实的反向关系。字段仅供 Prisma 关系解析，不用于查询。
  rentalCouponTemplates             RentalCouponTemplate[]
  rentalFulfillmentLocations        RentalFulfillmentLocation[]
  rentalItemGroups                  RentalItemGroup[]
  rentalPricingGroups               RentalPricingGroup[]
  rentalAssets                      RentalAsset[]
  rentalAssetStatusHistories        RentalAssetStatusHistory[]
  rentalStockBalances               RentalStockBalance[]
  rentalStockDispositions           RentalStockDisposition[]
  rentalStockLedgerEntries          RentalStockLedgerEntry[]
  rentalWorkOrders                  RentalWorkOrder[]
  rentalOrders                      RentalOrder[]
  rentalReservations                RentalReservation[]
  rentalInspectionTemplates         RentalInspectionTemplate[]
  rentalInspectionRecords           RentalInspectionRecord[]
  rentalFulfillmentOperators        RentalFulfillmentOperator[]
  rentalTenantBusinessSettingss     RentalTenantBusinessSettings[]
  approvedSettingsChanges           RentalApprovedSettingsChange[]
  rentalPricingPlans                RentalPricingPlan[]
  rentalDiscountPlans               RentalDiscountPlan[]
  rentalValueAddedServices          RentalValueAddedService[]
  rentalValueAddedServiceVersions   RentalValueAddedServiceVersion[]
  rentalServiceCapacities           RentalServiceCapacity[]
  rentalServiceReservations         RentalServiceReservation[]
  rentalRuleVersions                RentalRuleVersion[]
  rentalRuleVersionAudits           RentalRuleVersionAudit[]
  rentalFundingEvents               RentalFundingEvent[]
  rentalCarrierShipmentEvents       RentalCarrierShipmentEvent[]
  rentalOfflinePaymentRegistrations RentalOfflinePaymentRegistration[]
  rentalPaymentIntents              RentalPaymentIntent[]
  rentalPaymentRefunds              RentalPaymentRefund[]
  paymentReconciliationBatches      PaymentReconciliationBatch[]
  rentalOrderExtensions             RentalOrderExtension[]
  rentalOrderChanges                RentalOrderChange[]
  rentalOrderDocumentSnapshots      RentalOrderDocumentSnapshot[]
  rentalBusinessCalendars           RentalBusinessCalendar[]
  rentalCalendarOverrideAudits      RentalCalendarOverrideAuditEntry[]
  rentalPriceVersions               RentalPriceVersion[]
  rentalPriceAdjustmentPlans        RentalPriceAdjustmentPlan[]
  rentalNotificationTemplates       RentalNotificationTemplate[]
  rentalQuotes                      RentalQuote[]
  rentalCustomerCoupons             RentalCustomerCoupon[]
  rentalRewardLedgerEntrys          RentalRewardLedgerEntry[]
  rentalBenefitAccounts             RentalBenefitAccount[]
  rentalReferrals                   RentalReferral[]
  rentalNotificationLogs            RentalNotificationLog[]
  rentalNotificationRateBuckets     RentalNotificationRateBucket[]
  rentalOrderIdempotencyRecords     RentalOrderIdempotencyRecord[]
  workspaceCapabilityInstances      WorkspaceCapabilityInstance[]
  workspaceCapabilityAudits         WorkspaceCapabilityAuditEntry[]
  capabilityHookAudits              CapabilityHookAuditEntry[]
  attributeUniqueValues             RentalAttributeUniqueValue[]
  createdAt                         DateTime                                @default(now())
  updatedAt                         DateTime                                @updatedAt

  @@unique([tenantId, code], map: "business_workspaces_tenant_code_key")
  @@unique([tenantId, defaultMarker], map: "business_workspaces_tenant_default_key")
  /// 供成员关系的复合外键引用，保证成员只能指向同租户的空间。
  @@unique([tenantId, id], map: "business_workspaces_tenant_id_key")
  @@index([categoryCode], map: "business_workspaces_category_idx")
  @@index([tenantId, status], map: "business_workspaces_tenant_status_idx")
  @@map("business_workspaces")
}

model WorkspaceMember {
  tenantId    String
  workspaceId String
  userId      String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  user        User              @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  /// 该账号在本空间的角色。空表示沿用租户级默认角色（升级兼容）。
  roleId      String?
  role        Role?             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  /// 该账号在本空间的数据范围。空表示沿用角色自带范围。
  dataScope   SystemDataScope?
  /// STAFF-BE-01：履约地点数据范围。NULL/{"mode":"all"} 兼容既有成员；selected 按地点 ID 限定。
  locationScope Json?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@id([workspaceId, userId])
  @@index([tenantId, userId], map: "workspace_members_tenant_user_idx")
  @@index([tenantId, roleId], map: "workspace_members_role_idx")
  @@map("workspace_members")
}

model RentalCoreStateSnapshot {
  /// SPACE-03：主键改为经营空间。
  ///
  /// 原主键是 tenantId，于是同租户只有一份快照——非默认空间根本没有存档，
  /// 而 persist 又必须固定写默认空间，否则会互相覆盖（实测过：在第二空间触发
  /// persist 会把它的状态写进租户级行、抹掉默认空间的存档）。
  /// 主键换成空间后，每个空间各有自己的恢复副本，persist 也不必再挑空间。
  workspaceId String            @id
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  state       Json
  /// Original snapshot row revision, updated by its writer; not a readiness aggregate version.
  configurationRevision Int @default(1) @db.UnsignedInt
  updatedAt   DateTime          @updatedAt

  /// 一个经营空间至多一份快照；同时供 BusinessWorkspace 侧的一对一反向关系使用。
  @@unique([tenantId, workspaceId], map: "core_snapshot_tenant_ws_key")
  @@index([tenantId], map: "core_snapshot_tenant_idx")
  @@map("rental_core_state_snapshots")
}

model RentalBusinessStateSnapshot {
  /// SPACE-03：主键改为经营空间。
  ///
  /// 原主键是 tenantId，于是同租户只有一份快照——非默认空间根本没有存档，
  /// 而 persist 又必须固定写默认空间，否则会互相覆盖（实测过：在第二空间触发
  /// persist 会把它的状态写进租户级行、抹掉默认空间的存档）。
  /// 主键换成空间后，每个空间各有自己的恢复副本，persist 也不必再挑空间。
  workspaceId String            @id
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  state       Json
  updatedAt   DateTime          @updatedAt

  /// 一个经营空间至多一份快照；同时供 BusinessWorkspace 侧的一对一反向关系使用。
  @@unique([tenantId, workspaceId], map: "business_snapshot_tenant_ws_key")
  @@index([tenantId], map: "business_snapshot_tenant_idx")
  @@map("rental_business_state_snapshots")
}

model CustomerProfile {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerType         String
  name                 String
  phone                String
  phoneMasked          String
  email                String?
  /// 基础实名认证：租户内共享，不按空间重复认证。
  identityVerified     Boolean  @default(false)
  identityNoMasked     String?
  /// 基础画像主数据（全部选填）：性别、生日、来源渠道与常驻城市。
  /// 只用于运营检索与展示，不参与任何业务判定；未录入即为空，无需回填。
  gender               String?   @db.VarChar(16)
  birthday             DateTime? @db.Date
  sourceChannel        String?   @db.VarChar(32)
  region               String?   @db.VarChar(64)
  /// Opaque server-owned avatar key. Never an arbitrary URL or a client-provided path.
  avatarStorageKey     String?   @db.VarChar(191)
  /// 后台账号创建该共享主档时的审计归属；客户端自助注册与历史数据为空。
  createdByUserId      String?  @db.VarChar(191)
  createdInWorkspaceId String?  @db.VarChar(191)
  /// 品类资质原始事实（如驾驶证、操作资格证），适用性由目标空间品类规则判断。
  qualifications       Json
  corporateName        String?
  corporateTaxNo       String?
  status               String   @default("active")
  /// 回填来源：旧车辆域 Member 的主键。用于对账与幂等回填，不参与业务判定。
  sourceMemberId       String?
  /// CUSTOMER-01A：本主档已被合并进哪个主档。非空即终态，不得再产生新业务。
  /// 权威事实在 customer_merge_mappings，这里冗余一份供高频判定，避免漏查映射表。
  mergedIntoCustomerId String?
  /// 普通画像共享版本。唯一主档写入口为每次普通字段写入递增，不能以 updatedAt/姓名 hash 冒充 CAS。
  ordinaryRevision     Int      @default(1) @db.UnsignedInt
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  membership                     CustomerMembership?
  account                        CustomerAccount?
  corporateProfile               CustomerCorporateProfile?
  contacts                       CustomerContact[]
  authorizedAgents               CustomerAuthorizedAgent[]
  statusHistory                  CustomerStatusHistoryEntry[]
  riskRecords                    CustomerRiskRecord[]
  qualificationRefs              CustomerQualificationRef[]
  qualificationRevisions         CustomerQualificationRevision[]
  mergeAsSource                  CustomerMergeMapping[]             @relation("CustomerMergeSource")
  mergeAsTarget                  CustomerMergeMapping[]             @relation("CustomerMergeTarget")
  sensitiveAccess                CustomerSensitiveAccessAudit[]
  invoiceProfiles                CustomerCorporateInvoiceProfile[]
  contracts                      CustomerCorporateContract[]
  credit                         CustomerCorporateCredit?
  creditLedgerEntries            CustomerCorporateCreditLedger[]
  membershipReviews              CustomerMembershipReview[]
  clientAuthSessions             ClientAuthSession[]
  wechatIdentities               ClientWechatIdentity[]
  deliveryAddresses              CustomerDeliveryAddress[]
  deliverySnapshots              ClientOrderDeliverySnapshot[]
  enterprisePortal               EnterpriseCorporatePortal?
  enterpriseApplications         EnterpriseWorkflowRequest[] @relation("EnterpriseApplicant")
  enterpriseWorkflowCompany      EnterpriseWorkflowRequest[] @relation("EnterpriseWorkflowCompany")
  enterpriseInvites              EnterpriseInvite[]
  enterpriseScopePolicies        EnterpriseScopePolicy[]
  enterpriseApprovalApplicants   EnterpriseBookingApproval[] @relation("EnterpriseApprovalApplicant")
  enterpriseApprovalCompanies    EnterpriseBookingApproval[] @relation("EnterpriseApprovalCompany")
  enterpriseExtensionApplicants  EnterpriseExtensionApproval[] @relation("EnterpriseExtensionApplicant")
  enterpriseExtensionCompanies   EnterpriseExtensionApproval[] @relation("EnterpriseExtensionCompany")
  corporateMembershipsAsCompany  CustomerCorporateMembership[]      @relation("CorporateMembershipCompany")
  corporateMembershipsAsPersonal CustomerCorporateMembership[]      @relation("CorporateMembershipPersonal")
  corporateStatusRecipientsAsCompany EnterpriseCorporateStatusRecipient[] @relation("CorporateStatusRecipientCompany")
  corporateStatusMessagesReceived EnterpriseCorporateStatusRecipient[] @relation("CorporateStatusRecipientPersonal")
  membershipPlanAssignments      CustomerMembershipPlanAssignment[]
  identityVerifications          CustomerIdentityVerification[]
  approvedProfileChanges         CustomerApprovedProfileChange[]

  /// 供复合外键引用：让「权益/关系必须与客户同租户」可以在库层表达。
  /// 与 BusinessWorkspace 的 (tenantId, id) 同一手法。
  @@unique([tenantId, id], map: "customer_profiles_tenant_id_key")
  /// 同租户内手机号唯一 = 「同一客户不必重复注册」的库层保证。
  /// 不含 workspaceId：加了就等于允许同一手机号在两个空间各建一份主档，
  /// 与需求「租户内共享唯一客户主档」直接冲突。
  @@unique([tenantId, phone], map: "customer_profiles_tenant_phone_key")
  @@unique([tenantId, sourceMemberId], map: "customer_profiles_tenant_source_member_key")
  @@index([tenantId, status], map: "customer_profiles_tenant_status_idx")
  @@index([tenantId, createdInWorkspaceId, createdByUserId], map: "customer_profiles_creator_scope_idx")
  @@map("customer_profiles")
}

model CustomerApprovedProfileChange {
  id           String @id @default(uuid()) @db.VarChar(36)
  tenantId     String
  workspaceId  String
  customerId   String
  actorId      String @db.VarChar(191)
  changeKey    String @db.VarChar(128)
  baseRevision Int    @db.UnsignedInt
  beforeName   String @db.VarChar(191)
  afterName    String @db.VarChar(191)
  changeHash   String @db.Char(64)
  expiresAt    DateTime @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  customer     CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "customer_profile_change_customer_fk")
  workspace    BusinessWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "customer_profile_change_workspace_fk")
  operations   CustomerApprovedProfileOperation[]

  @@unique([tenantId, customerId, actorId, changeKey], map: "customer_profile_change_key")
  @@unique([tenantId, workspaceId, customerId, id, changeHash], map: "customer_profile_change_binding")
  @@map("customer_approved_profile_changes")
}

model CustomerApprovedProfileOperation {
  id             String @id @default(uuid()) @db.VarChar(36)
  tenantId       String
  workspaceId    String
  customerId     String
  actorId        String @db.VarChar(191)
  operationKey   String @db.VarChar(191)
  commandHash    String @db.Char(64)
  changeId       String @db.VarChar(36)
  changeHash     String @db.Char(64)
  baseRevision   Int    @db.UnsignedInt
  resultRevision Int    @db.UnsignedInt
  resultName     String @db.VarChar(191)
  resultHash     String @db.Char(64)
  approvalRef    Json
  createdAt      DateTime @default(now()) @db.DateTime(3)
  change CustomerApprovedProfileChange @relation(fields: [tenantId, workspaceId, customerId, changeId, changeHash], references: [tenantId, workspaceId, customerId, id, changeHash], onDelete: Restrict, onUpdate: Restrict, map: "customer_profile_operation_change_fk")

  @@unique([tenantId, customerId, operationKey], map: "customer_profile_operation_key")
  @@unique([tenantId, customerId, changeId], map: "customer_profile_change_once")
  @@map("customer_approved_profile_operations")
}

model CustomerIdentityVerification {
  id                   String          @id @default(uuid())
  tenantId             String          @db.VarChar(191)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId           String          @db.VarChar(191)
  customer             CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  credentialType       String          @db.VarChar(32)
  result               String          @db.VarChar(16)
  evidenceFileAssetIds Json
  reason               String          @db.VarChar(500)
  reviewerUserId       String          @db.VarChar(191)
  reviewerName         String          @db.VarChar(120)
  reviewedAt           DateTime        @db.DateTime(3)
  verifiedAt           DateTime?       @db.DateTime(3)
  createdAt            DateTime        @default(now()) @db.DateTime(3)

  @@index([tenantId, customerId, reviewedAt], map: "customer_identity_verifications_customer_time_idx")
  @@map("customer_identity_verifications")
}

model CustomerMembership {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// 租户级会员等级。
  levelName    String          @default("普通会员")
  /// pending_activation / active / suspended / risk_restricted / exited / closed。
  status       String          @default("active")
  firstOrderAt DateTime?
  /// 各限制态与终态的发生时间。解除限制不清空原时间戳，完整过程另追加状态历史。
  suspendedAt  DateTime?
  restrictedAt DateTime?
  exitedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tenantId, customerId], map: "customer_memberships_tenant_customer_key")
  @@index([tenantId, status], map: "customer_memberships_tenant_status_idx")
  @@map("customer_memberships")
}

model CustomerAccount {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           CustomerProfile @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  /// 登录标识（当前为手机号）。租户内唯一——同一手机号不得对应两个可登录账号。
  loginPhone         String
  loginPhoneMasked   String
  /// active / suspended / closed
  status             String          @default("active")
  suspendedAt        DateTime?
  closedAt           DateTime?
  /// 最近一次状态变更的原因与操作人。完整历史在 customer_status_history。
  lastReason         String?         @db.Text
  lastOperator       String?
  /// 新会员体系仅存口令哈希；管理端永不读取或回显原密码。
  passwordHash       String?
  passwordUpdatedAt  DateTime?
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  /// 一个客户主档至多一个账号：主档是身份，账号是该身份的登录方式。
  @@unique([tenantId, customerId], map: "customer_accounts_tenant_customer_key")
  @@unique([tenantId, loginPhone], map: "customer_accounts_tenant_login_key")
  @@index([tenantId, status], map: "customer_accounts_tenant_status_idx")
  @@map("customer_accounts")
}

model ClientChannelProfile {
  id                   String                   @id @default(uuid())
  tenantId             String                   @unique(map: "client_channel_profiles_tenant_key")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revision             Int                      @default(1)
  brandName            String?                  @db.VarChar(191)
  brandLogoUrl         String?                  @db.VarChar(512)
  faviconUrl           String?                  @db.VarChar(512)
  customerServicePhone String?                  @db.VarChar(32)
  customerServiceHours String?                  @db.VarChar(64)
  /// 协议：名称/版本/外链/正文。正文在客户端内直接渲染（简单富文本），不内置占位协议。
  userAgreementName    String?                  @db.VarChar(64)
  userAgreementVersion String?                  @db.VarChar(64)
  userAgreementUrl     String?                  @db.VarChar(512)
  userAgreementBody    String?                  @db.MediumText
  privacyPolicyName    String?                  @db.VarChar(64)
  privacyPolicyVersion String?                  @db.VarChar(64)
  privacyPolicyUrl     String?                  @db.VarChar(512)
  privacyPolicyBody    String?                  @db.MediumText
  /// 帮助与客服页：说明与常见问题（JSON 数组 {question, answer}）。
  helpIntro            String?                  @db.Text
  helpFaqJson          Json?
  bannerTitle          String?                  @db.VarChar(64)
  bannerSubtitle       String?                  @db.VarChar(120)
  /// 客户端主题色（#RRGGBB）；客户端覆盖 --primary 系列，未设置则用系统默认蓝。
  themeColor           String?                  @db.VarChar(16)
  /// 管理后台基础控件圆角（8-20px，或极致圆角离散档 999px，旧字段/回退基准）；胶囊页签、圆形图标按钮等保留形态不由此强行改变。
  adminCornerRadius    Int?                     @db.UnsignedSmallInt
  /// 容器（卡片/弹窗/抽屉/表格）圆角（8-20px 或 999px）；留空回退 adminCornerRadius。
  adminContainerRadius Int?                     @db.UnsignedSmallInt
  /// 按钮/分段/页签/选中菜单圆角（8-20px 或 999px）；留空回退 adminCornerRadius。
  adminButtonRadius    Int?                     @db.UnsignedSmallInt
  /// 输入/选择/日期等录入控件圆角（8-20px 或 999px）；留空回退 adminCornerRadius。
  adminInputRadius     Int?                     @db.UnsignedSmallInt
  smsLoginEnabled      Boolean                  @default(true)
  passwordLoginEnabled Boolean                  @default(true)
  defaultWorkspaceId   String?
  publishedWorkspaces  ClientChannelWorkspace[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@map("client_channel_profiles")
}

model ClientChannelWorkspace {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId   String
  profile     ClientChannelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workspaceId String
