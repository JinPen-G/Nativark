{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [],
    "rootDir": ".",
    "outDir": "dist-clients",
    "declaration": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "incremental": false
  },
  "include": [
    "clients/staff/**/*.ts",
    "clients/miniprogram/**/*.ts",
    "clients/time.ts"
  ]
}
