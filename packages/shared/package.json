{
  "name": "@rental-os/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./agent-desktop": {
      "types": "./dist-agent-desktop/agent-desktop.d.ts",
      "import": "./dist-agent-desktop/agent-desktop.js",
      "require": "./dist-agent-desktop/agent-desktop.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:agent-desktop",
    "build:agent-desktop": "tsc -p tsconfig.agent-desktop.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {}
}
