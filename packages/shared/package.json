{
  "name": "@rental-os/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./miniprogram-entry-actions": {
      "types": "./dist/miniprogram-entry-actions.d.ts",
      "import": "./dist/miniprogram-entry-actions.js",
      "require": "./dist/miniprogram-entry-actions.js"
    },
    "./miniprogram-client": {
      "types": "./dist/miniprogram-client.d.ts",
      "import": "./dist/miniprogram-client.js",
      "require": "./dist/miniprogram-client.js"
    },
    "./agent-desktop": {
      "types": "./dist-agent-desktop/agent-desktop.d.ts",
      "import": "./dist-agent-desktop/agent-desktop.js",
      "require": "./dist-agent-desktop/agent-desktop.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform-identity.d.ts",
      "import": "./dist/platform-identity.js",
      "require": "./dist/platform-identity.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build:contracts -w @rental-os/rental-core",
    "prelint": "npm run build:contracts -w @rental-os/rental-core",
    "build": "tsc -p tsconfig.json && npm run build:agent-desktop",
    "build:agent-desktop": "tsc -p tsconfig.agent-desktop.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rental-os/platform-contracts": "0.1.0",
    "zod": "3.25.76",
    "@rental-os/rental-core": "0.1.5"
  },
  "devDependencies": {},
  "typesVersions": {
    "*": {
      "platform": [
        "dist/platform-identity.d.ts"
      ]
    }
  }
}
