{
  "name": "rental-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:workspace-scope": "node tests/rental-workspace-scope.test.cjs",
    "test:membership-workspace": "node tests/membership-workspace-scope.test.cjs",
    "test:membership-selector-scope": "node tests/membership-selector-workspace.test.cjs",
    "test:qualification-gate": "npm run build -w @store-rental/shared && node tests/rental-qualification-gate.test.cjs",
    "test:rental-selector-scope": "node tests/rental-selector-workspace.test.cjs",
    "test:config-workspace": "node tests/config-workspace-scope.test.cjs",
    "test:business-customer-scope": "node tests/business-customer-workspace-scope.test.cjs",
    "test:order-allocation": "npm run build -w @store-rental/shared && node tests/rental-allocation.test.cjs",
    "test:order-allocation-db": "npm run build -w @store-rental/shared && node tests/helpers/run-assignment-db.cjs",
    "dev": "npm run build -w @store-rental/shared && concurrently -n api,admin -c blue,green \"npm run dev -w @store-rental/api\" \"npm run dev -w @store-rental/admin\"",
    "dev:api": "npm run build -w @store-rental/shared && npm run dev -w @store-rental/api",
    "dev:admin": "npm run build -w @store-rental/shared && npm run dev -w @store-rental/admin",
    "build": "npm run build -w @store-rental/shared && npm run build -w @store-rental/api && npm run build -w @store-rental/admin",
    "build:admin": "npm run build -w @store-rental/shared && npm run build -w @store-rental/admin",
    "lint": "npm run lint -w @store-rental/shared && npm run build -w @store-rental/shared && npm run lint -w @store-rental/api && npm run lint -w @store-rental/admin",
    "db:generate": "node scripts/run-api-with-root-env.cjs prisma:generate",
    "db:validate": "node scripts/run-api-with-root-env.cjs prisma:validate",
    "db:migrate": "node scripts/run-api-with-root-env.cjs prisma:migrate",
    "db:seed": "node scripts/run-api-with-root-env.cjs prisma:seed",
    "ops:mysql:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-mysql.ps1",
    "ops:preflight": "node scripts/ops/preflight.cjs",
    "ops:migration-status": "node scripts/ops/migration-status.cjs",
    "ops:backup": "node scripts/ops/backup.cjs",
    "ops:restore-drill": "node scripts/ops/restore-drill.cjs",
    "ops:release-build": "node scripts/ops/release-build.cjs",
    "ops:release-gate": "node scripts/ops/release-gate.cjs",
    "ops:upgrade-drill": "node scripts/ops/upgrade-drill.cjs",
    "ops:restore-source": "node scripts/ops/restore-source.cjs",
    "test:ops-dedicated": "node tests/ops-dedicated-env.test.cjs",
    "test:ops-release": "node tests/ops-release-gate.test.cjs",
    "test:ops-upgrade": "node tests/ops-upgrade-drill.test.cjs",
    "test:report-workspace": "npm run build -w @store-rental/shared && node tests/report-workspace-operations.test.cjs",
    "test:report-dimensions": "npm run build -w @store-rental/shared && node tests/report-workspace-dimensions.test.cjs",
    "ops:mysql:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-mysql.ps1",
    "ops:mysql:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-mysql.ps1",
    "test:admin": "node scripts/validate-react-admin.cjs",
    "test:ui-nav": "npm run build -w @store-rental/shared && node tests/admin-navigation-terminology.test.cjs",
    "test:mysql-e2e": "npm run build -w @store-rental/shared && npm run build -w @store-rental/api && node tests/mysql-e2e.test.cjs",
    "test:pricing-strategy": "npm run build -w @store-rental/shared && node tests/rental-pricing-strategy.test.cjs",
    "test:rental-core": "npm run build -w @store-rental/shared && node tests/rental-core-v01.test.cjs",
    "test:workspace-capability": "npm run build -w @store-rental/shared && node tests/workspace-capability.test.cjs",
    "test:capability-equipment": "npm run build -w @store-rental/shared && node tests/capability-equipment.test.cjs",
    "test:customer-master": "npm run build -w @store-rental/shared && node tests/customer-master-data.test.cjs",
    "test:customer-operations": "npm run build -w @store-rental/shared && node tests/customer-operations.test.cjs",
    "test:customer-corporate": "npm run build -w @store-rental/shared && node tests/customer-corporate.test.cjs",
    "test:customer-merge": "npm run build -w @store-rental/shared && node tests/customer-merge-closure.test.cjs",
    "test:customer-admin": "npm run build -w @store-rental/shared && node tests/customer-admin-acceptance.test.cjs",
    "test:customer-order-subjects": "npm run build -w @store-rental/shared && node tests/customer-order-subjects.test.cjs",
    "test:capability-hook": "npm run build -w @store-rental/shared && node tests/capability-hook-runtime.test.cjs",
    "test:extension-consistency": "npm run build -w @store-rental/shared && node tests/extension-consistency.test.cjs",
    "test:camera-compatibility": "npm run build -w @store-rental/shared && node tests/camera-compatibility.test.cjs",
    "test:rental-business": "npm run build -w @store-rental/shared && node tests/rental-business-v1.test.cjs",
    "test:rental-persistence": "npm run build -w @store-rental/shared && node tests/rental-state-persistence.test.cjs",
    "test:saas-foundation": "npm run build -w @store-rental/shared && node tests/saas-foundation.test.cjs",
    "test:rental-foundation": "npm run lint && npm run test:admin && npm run contract:validate && npm run db:validate && npm run test:seed-types && npm run test:pricing-strategy && npm run test:price-adjustment && npm run test:security-deposit && npm run test:rental-core && npm run test:calendar-range && npm run test:workspace-capability && npm run test:capability-hook && npm run test:capability-equipment && npm run test:extension-consistency && npm run test:camera-compatibility && npm run test:rental-business && npm run test:rental-persistence && npm run test:saas-foundation && npm run test:return-batch && npm run test:return-quarantine && npm run test:return-charge-race && npm run test:extension-services && npm run test:service-occurrence && npm run test:order-transaction-order && npm run test:extension-funding && npm run test:fee-review && npm run test:fee-review-permission && npm run test:early-return && npm run test:order-extension && npm run test:tax && npm run test:currency",
    "test:seed-types": "tsc --noEmit --skipLibCheck --target ES2022 --module commonjs --moduleResolution node --esModuleInterop apps/api/prisma/seed.ts",
    "contract:validate": "node scripts/validate-api-contracts.cjs && node scripts/validate-dto-coverage.cjs && node scripts/validate-route-permissions.cjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\"",
    "dto:validate": "node scripts/validate-dto-coverage.cjs",
    "test:calendar-range": "npm run build -w @store-rental/shared && node tests/rental-calendar-range.test.cjs",
    "test:price-adjustment": "npm run build -w @store-rental/shared && node tests/rental-price-adjustment.test.cjs",
    "test:discount-selection": "npm run build -w @store-rental/shared && node tests/rental-discount-selection.test.cjs",
    "test:service-catalog": "npm run build -w @store-rental/shared && node tests/rental-service-catalog.test.cjs",
    "test:service-capacity": "npm run build -w @store-rental/shared && node tests/rental-service-capacity.test.cjs",
    "test:coupon-budget": "npm run build -w @store-rental/shared && node tests/rental-coupon-budget.test.cjs",
    "test:coupon-budget-mutation": "node tests/rental-coupon-budget-mutation.test.cjs",
    "test:price-version": "npm run build -w @store-rental/shared && node tests/rental-price-version.test.cjs",
    "test:rule-version-chain": "npm run build -w @store-rental/shared && node tests/rental-rule-version-chain.test.cjs",
    "test:rule-version-chain-mutation": "node tests/helpers/rule-version-chain-mutation.cjs",
    "test:rule-permission-split": "npm run build -w @store-rental/shared && node tests/rental-rule-permission-split.test.cjs",
    "test:return-batch": "npm run build -w @store-rental/shared && node tests/rental-return-batch.test.cjs",
    "test:return-quarantine": "npm run build -w @store-rental/shared && node tests/rental-return-quarantine.test.cjs",
    "test:return-charge-race": "npm run build -w @store-rental/shared && node tests/rental-return-charge-race.test.cjs",
    "test:extension-services": "npm run build -w @store-rental/shared && node tests/rental-extension-services.test.cjs",
    "test:service-occurrence": "npm run build -w @store-rental/shared && node tests/rental-service-occurrence.test.cjs",
    "test:service-execution": "npm run build -w @store-rental/shared && node tests/rental-service-execution.test.cjs",
    "test:order-transaction-order": "npm run build -w @store-rental/shared && node tests/rental-order-transaction-order.test.cjs",
    "test:order-close-db": "npm run build -w @store-rental/shared && node tests/helpers/run-order-close-db.cjs",
    "test:stock-disposition": "npm run build -w @store-rental/shared && node tests/rental-stock-disposition.test.cjs",
    "test:work-order": "npm run build -w @store-rental/shared && node tests/rental-work-order.test.cjs",
    "test:work-order-db": "npm run build -w @store-rental/shared && node tests/rental-work-order-db.test.cjs",
    "test:tenant-access-db": "npm run build -w @store-rental/shared && node tests/tenant-access-db.test.cjs",
    "test:tenant-access-atomic": "npm run build -w @store-rental/shared && node tests/tenant-access-atomic.test.cjs",
    "test:rental-db-suites": "npm run test:order-allocation-db && npm run test:order-close-db",
    "test:extension-funding": "npm run build -w @store-rental/shared && node tests/rental-extension-funding.test.cjs",
    "test:fee-review": "npm run build -w @store-rental/shared && node tests/rental-fee-review.test.cjs",
    "test:fee-review-permission": "npm run build -w @store-rental/shared && node tests/rental-fee-review-permission.test.cjs",
    "test:early-return": "npm run build -w @store-rental/shared && node tests/rental-early-return.test.cjs",
    "test:funding-gates": "npm run build -w @store-rental/shared && node tests/rental-funding-gates.test.cjs",
    "test:funding-events": "node tests/rental-funding-events.test.cjs",
    "test:security-deposit": "npm run build -w @store-rental/shared && node tests/rental-security-deposit.test.cjs",
    "test:security-rule-form": "npm run build -w @store-rental/shared && node tests/rental-security-rule-form.test.cjs",
    "test:order-settlement": "npm run build -w @store-rental/shared && node tests/rental-order-settlement.test.cjs",
    "test:order-extension": "npm run build -w @store-rental/shared && node tests/rental-extension.test.cjs && node tests/rental-renewal-repricing.test.cjs",
    "test:tax": "npm run build -w @store-rental/shared && node tests/rental-tax.test.cjs",
    "test:currency": "npm run build -w @store-rental/shared && node tests/rental-currency.test.cjs",
    "test:workbench-todos": "npm run build -w @store-rental/shared && node tests/rental-workbench-todos.test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
