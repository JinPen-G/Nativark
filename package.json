{
  "name": "zelo",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/example-tickets-admin",
    "apps/example-tickets-api",
    "apps/platform-admin",
    "apps/platform-api",
    "packages/ai-native-admin",
    "packages/ai-native-data",
    "packages/ai-native-server",
    "packages/core-contracts",
    "packages/core-host",
    "packages/example-tickets-core",
    "packages/mcp-server",
    "packages/platform-admin",
    "packages/platform-contracts",
    "packages/platform-core-host",
    "packages/platform-server"
  ],
  "scripts": {
    "prepare:rental-workspace": "node scripts/prepare-rental-workspace.cjs",
    "docs:check": "node scripts/validate-docs.cjs",
    "test:docs": "node --test tests/docs-check.test.cjs",
    "test:demo-requests": "npm run build -w @rental-os/platform-server && node --test tests/demo-requests.test.cjs",
    "test:demo-requests:legacy": "node --test tests/demo-requests-legacy.test.cjs",
    "test:demo-requests-db": "node scripts/ops/legacy-checkout.cjs",
    "test:integrations-security": "npm run build -w @rental-os/platform-server && node tests/integrations-security.test.cjs",
    "test:oss-v4": "npm run build -w @rental-os/platform-server && node tests/aliyun-oss-v4.test.cjs",
    "test:integration-connectivity": "node scripts/ops/legacy-checkout.cjs",
    "test:sms-notification": "npm run build -w @rental-os/platform-server && node tests/tenant-sms-notification.test.cjs",
    "test:tenant-integration-default": "node scripts/ops/legacy-checkout.cjs",
    "test:payment-provider-currency": "node scripts/ops/legacy-checkout.cjs",
    "test:access-data-scope": "node scripts/ops/legacy-checkout.cjs",
    "test:tenant-admin-privilege": "node scripts/ops/legacy-checkout.cjs",
    "dev": "node scripts/ops/local-dev-preflight.cjs platform run dev",
    "dev:api": "node scripts/ops/local-dev-preflight.cjs platform run dev:api",
    "dev:admin": "node scripts/ops/local-dev-preflight.cjs platform run dev:admin",
    "dev:legacy": "node scripts/ops/legacy-checkout.cjs",
    "dev:legacy:api": "node scripts/ops/legacy-checkout.cjs",
    "dev:legacy:admin": "node scripts/ops/legacy-checkout.cjs",
    "build": "npm run build:platform-api && npm run build:admin",
    "build:admin": "npm run build:platform-admin",
    "build:legacy": "node scripts/ops/legacy-checkout.cjs",
    "build:legacy:admin": "node scripts/ops/legacy-checkout.cjs",
    "build:example-tickets-api": "npm run build -w @rental-os/example-tickets-api",
    "lint:example-tickets-api": "npm run lint -w @rental-os/example-tickets-api",
    "build:platform-api": "npm run build -w @rental-os/platform-api",
    "lint:platform-api": "npm run lint -w @rental-os/platform-api",
    "export:platform": "npm run export:platform -w @rental-os/core-contracts --",
    "api:document:platform": "node packages/platform-server/dist/platform-openapi.js",
    "db:platform:generate": "npm run db:generate",
    "db:platform:initialize": "npm run db:initialize",
    "db:platform:migrate:deploy": "npm run db:migrate:deploy",
    "test:production-data-source-guard": "node scripts/ops/legacy-checkout.cjs",
    "test:auth-login-lockout": "npm run build -w @rental-os/platform-server && node tests/auth-login-lockout.test.cjs",
    "lint": "npm run lint:platform-api && npm run lint:platform-admin",
    "lint:legacy": "node scripts/ops/legacy-checkout.cjs",
    "db:generate": "node scripts/ops/local-dev-preflight.cjs platform generate",
    "prepare:prisma:schema": "node scripts/prepare-selected-prisma-schema.cjs",
    "db:validate": "node scripts/ops/local-dev-preflight.cjs platform validate",
    "db:migrate": "npm run db:migrate:deploy",
    "db:migrate:deploy": "node scripts/ops/local-dev-preflight.cjs platform migrate",
    "db:migrate:status": "node scripts/ops/local-dev-preflight.cjs platform migration-status",
    "db:initialize": "node scripts/ops/local-dev-preflight.cjs platform initialize",
    "db:seed": "npm run db:initialize",
    "db:legacy:generate": "node scripts/ops/legacy-checkout.cjs",
    "db:legacy:validate": "node scripts/ops/legacy-checkout.cjs",
    "db:legacy:migrate": "node scripts/ops/legacy-checkout.cjs",
    "db:legacy:migrate:deploy": "node scripts/ops/legacy-checkout.cjs",
    "db:legacy:migrate:status": "node scripts/ops/legacy-checkout.cjs",
    "db:legacy:seed": "node scripts/ops/legacy-checkout.cjs",
    "db:comments": "node scripts/apply-column-comments.cjs",
    "db:comments:dry-run": "node scripts/apply-column-comments.cjs --dry-run",
    "db:comments:repair": "node scripts/apply-column-comments.cjs --repair-fallbacks",
    "db:comments:repair:dry-run": "node scripts/apply-column-comments.cjs --repair-fallbacks --dry-run",
    "db:seed:demo": "node scripts/seed-demo-tenant.cjs",
    "ops:mysql:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-mysql.ps1",
    "ops:preflight": "node scripts/ops/preflight.cjs",
    "ops:migration-status": "node scripts/ops/migration-status.cjs",
    "ops:backup": "node scripts/ops/backup.cjs",
    "ops:restore-drill": "node scripts/ops/restore-drill.cjs",
    "ops:release-build": "node scripts/ops/release-build.cjs",
    "ops:release-gate": "node scripts/ops/release-gate.cjs",
    "ops:upgrade-drill": "node scripts/ops/upgrade-drill.cjs",
    "ops:restore-source": "node scripts/ops/restore-source.cjs",
    "test:ops-dedicated": "node tests/ops-dedicated-env.test.cjs",
    "test:ops-release": "node tests/ops-release-gate.test.cjs",
    "test:ops-upgrade": "node tests/ops-upgrade-drill.test.cjs",
    "ops:mysql:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-mysql.ps1",
    "ops:mysql:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-mysql.ps1",
    "test:admin": "node scripts/validate-react-admin.cjs --source-root . --mode public --admin-root packages/platform-admin/src --host-root apps/platform-admin --server-root packages/platform-server/src --manifest package.json --manifest package-lock.json --manifest apps/platform-admin/package.json",
    "test:saas-foundation": "node scripts/ops/legacy-checkout.cjs",
    "test:saas-subscription-db": "node scripts/ops/legacy-checkout.cjs",
    "test:saas-subscription": "node scripts/ops/legacy-checkout.cjs",
    "test:saas-subscription:public": "npm run build -w @rental-os/platform-server && node --test tests/saas-subscription-calendar.test.cjs tests/saas-subscription-service.test.cjs tests/saas-subscription-admin.test.cjs",
    "test:seed-types": "node scripts/ops/legacy-checkout.cjs",
    "contract:validate": "node scripts/validate-api-contracts.cjs --source-root . --app-module apps/platform-api/src/app.module.ts --module-export PlatformAppModule --contracts @rental-os/platform-server --document-factory createPlatformOpenApi --document-transform @rental-os/platform-core-host#createPlatformCoreOpenApi --document-transform @rental-os/platform-core-host#createPlatformCorePackageOpenApi --offline-prisma --schema apps/platform-api/prisma/schema.prisma && npm run dto:validate && node scripts/validate-route-permissions.cjs --source-root . --controllers packages/platform-server/src --authority platform --permissions packages/platform-server/src/platform-http-policy.ts --permission-export PLATFORM_HTTP_PERMISSION_CATALOG --app-module apps/platform-api/src/app.module.ts --module-export PlatformAppModule --offline-prisma --schema apps/platform-api/prisma/schema.prisma",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\"",
    "dto:validate": "node scripts/validate-dto-coverage.cjs --source-root . --dto-root packages/platform-server/src --contracts packages/platform-contracts/src/index.ts --body-controller packages/platform-server/src/modules/auth/auth-session.controller.ts --body-controller packages/platform-server/src/modules/platform/platform-management.controller.ts",
    "test:access-page-mutations": "node scripts/ops/legacy-checkout.cjs",
    "dev:platform-admin": "npm run dev:admin",
    "build:platform-admin": "node scripts/ops/local-dev-preflight.cjs platform build-admin",
    "lint:platform-admin": "npm run lint -w @rental-os/platform-admin-app",
    "build:example-tickets-admin": "npm run build -w @rental-os/example-tickets-admin",
    "dev:example-tickets-admin": "npm run dev -w @rental-os/example-tickets-admin",
    "package:rental-host": "node scripts/package-rental-host.cjs",
    "prepare:public-ai": "node scripts/prepare-platform-public-ai.cjs",
    "test:tenant-admin-privilege-write": "npm run build -w @rental-os/platform-server && node tests/tenant-admin-privilege-write.test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "memfs": "3.5.3",
    "semver": "7.8.5"
  }
}
